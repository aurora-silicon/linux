# ./tools/testing/kunit/kunit.py run --arch=arm64 --kunitconfig=drivers/cpufreq/apple-soc-cpufreq.kunitconfig
CONFIG_KUNIT=y
CONFIG_ARCH_APPLE=y
CONFIG_OF=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_ARM_APPLE_SOC_CPUFREQ_KUNIT_TEST=y
