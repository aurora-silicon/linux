config VIDEO_APPLE_ISP
	tristate "Apple Silicon Image Signal Processor driver"
	select VIDEOBUF2_CORE
	select VIDEOBUF2_V4L2
	select VIDEOBUF2_DMA_SG
	select APPLE_PMP_REPORT
	depends on ARCH_APPLE || COMPILE_TEST
	depends on OF_ADDRESS
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV
	help
	  Driver for the image signal processor that runs the built-in
	  camera of Apple silicon machines. The ISP firmware is loaded by
	  the bootloader. When a stream starts, the driver loads the
	  calibration file for the detected camera module,
	  apple/isp_<module>_<revision>XX.dat, from the firmware search
	  path; if it is missing, the stream runs without calibration.
