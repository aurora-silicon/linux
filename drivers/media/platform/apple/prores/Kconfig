config VIDEO_APPLE_PRORES
	tristate "Apple Silicon ProRes codec"
	depends on VIDEO_DEV
	depends on ARCH_APPLE || (COMPILE_TEST && 64BIT)
	depends on OF && IOMMU_API && PM
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_DMA_CONTIG
	help
	  V4L2 memory-to-memory driver for the ProRes codec engine (APR)
	  in Apple M1 Pro (T6000), M4 Pro (T6041), and A18 Pro (T8140)
	  SoCs. T6041 additionally requires the per-machine
	  apple/prores-t6041-init.bin initialization firmware. It encodes and
	  decodes 8 and 16 bit 4:2:2 and 4:4:4 frames in the ProRes 422 Proxy,
	  LT, 422, HQ, 4444 and 4444 XQ profiles.

	  To compile this driver as a module, choose M here: the module
	  will be called apple-prores.

config VIDEO_APPLE_PRORES_KUNIT_TEST
	tristate "KUnit tests for the Apple ProRes codec" if !KUNIT_ALL_TESTS
	depends on KUNIT && VIDEO_APPLE_PRORES
	default KUNIT_ALL_TESTS
	help
	  Check the APRI firmware parser, quantisation tables, DC scale table,
	  encode/decode job descriptors, input parser and ring accounting. APRI
	  fixtures are wholly synthetic and contain no vendor initialization
	  values. No hardware is needed.
