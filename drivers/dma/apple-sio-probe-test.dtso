/dts-v1/;
/plugin/;

/*
 * SIO nodes for the probe test: an M1 one, and T6030 ones with the tables of a
 * T6030-aware boot loader and of an earlier one. The container is not a bus, so
 * nothing binds to them; the test calls the probe itself.
 */
&{/} {
	sio-probe-test {
		#address-cells = <2>;
		#size-cells = <2>;

		sio-probe-test-t8103 {
			compatible = "apple,t8103-sio", "apple,sio";
			dma-channels = <8>;
		};

		v10_w: v10-w {
			iommu-addresses = <&v10 0x0 0x30000 0x0 0x4000>, <&v10 0x0 0x34000 0x0 0x20000>,
					  <&v10 0x0 0x54000 0x0 0x4000>, <&v10 0x0 0x58000 0x0 0x4000>;
		};

		v10: sio-probe-test-t6030-v10 {
			compatible = "apple,t6030-sio", "apple,sio";
			dma-channels = <8>;
			memory-region = <&v10_w>;
			apple,sio-firmware-params = <0x1e 0x30 0x1f 0x300 0xb 0x31 0xc 0x1b80
						     0xf 0x34 0x10 0x1e000 0x30d 0x54 0x30e 0x4000
						     0x1a 0x58 0x1b 0x40 0x22 0x59 0x23 0xd8
						     0x1c 0x5a 0x1d 0x48>;
		};

		old_w: old-w { iommu-addresses = <&earlier 0x0 0x30000 0x0 0x2c000>; };

		earlier: sio-probe-test-t6030-earlier {
			compatible = "apple,t6030-sio", "apple,sio";
			dma-channels = <8>;
			memory-region = <&old_w>;
			apple,sio-firmware-params = <0x1e 0x30 0x1f 0x300 0xb 0x31 0xc 0x1b80
						     0xf 0x34 0x10 0x1e000 0x30d 0x54 0x30e 0x4000
						     0x1a 0x58 0x1b 0x40 0x22 0x59 0x23 0xa0
						     0x1c 0x5a 0x1d 0x40>;
		};
	};
};
