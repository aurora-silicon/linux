config WLAN_VENDOR_APPLE
	bool "Apple wireless devices"
	default y

if WLAN_VENDOR_APPLE
config APPLE_CENTAURI
	tristate "Apple N1 Centauri firmware and IPC transport"
	depends on ARCH_APPLE || COMPILE_TEST
	depends on PCI && CFG80211 && PCIE_APPLE
	select FW_LOADER
	help
	  Boot the shared N1 firmware and establish its PCI DMA contexts.
	  Requires the T6050 PCIe host's root-port reset on a bootloader-trained
	  port, to retrain the link after the ROM boot, and a DT-supplied
	  personalized firmware name and platform identifier.
	  The endpoint must start in the stopped ROM personality. Firmware
	  and per-device calibration are external inputs and are not included.

config APPLE_CENTAURI_WIFI
	bool "N1 Centauri cfg80211 station interface"
	depends on APPLE_CENTAURI
	default y
	help
	  Add Alpha command/data rings, scanning and WPA2-PSK/CCMP station
	  connections for the explicitly matched firmware protocol profile.
	  Radio firmware and calibration remain external inputs.
endif
