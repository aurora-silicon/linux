config WLAN_VENDOR_APPLE
	bool "Apple wireless devices"
	default y
	help
	  Support for Apple's wireless network devices.

if WLAN_VENDOR_APPLE
config APPLE_CENTAURI
	tristate "Apple N1 Centauri experimental J813 Wi-Fi"
	depends on ARCH_APPLE || COMPILE_TEST
	depends on PCI && CFG80211 && DEBUG_FS
	select FW_LOADER
	help
	  Experimental Apple N1 PCIe and ACIPC Wi-Fi support for the J813
	  MacBook Air. Firmware boot, ring setup and connection setup currently
	  use debugfs and the tools/aurora/j813 workbench. The tested single-link
	  WPA2 setup completes DHCP and bidirectional traffic. Suspend/resume,
	  roaming and automatic startup are not yet qualified.

	  The firmware and per-device calibration are private external inputs.
	  This driver does not include Bluetooth HCI support.

	  To build as a module, choose M; the module is apple_centauri.

config APPLE_CENTAURI_T6050
	tristate "Apple N1 Centauri T6050 firmware and IPC transport"
	depends on ARCH_APPLE || COMPILE_TEST
	depends on PCI && CFG80211 && PCIE_APPLE
	select FW_LOADER
	help
	  Boot the N1 firmware on a T6050 host that provides root-port reset.
	  The transport starts automatically from its device-tree firmware,
	  platform and protocol properties. It binds only behind a T6050 host;
	  the J813/J873 transport remains available independently.

config APPLE_CENTAURI_T6050_WIFI
	bool "T6050 N1 Centauri cfg80211 station interface"
	depends on APPLE_CENTAURI_T6050
	default y
	help
	  Add scanning and station connections for the T6050 protocol profile.

endif
