				apple,tunable-agx-dvfs-state-voltages = [7d 00 00 00 8f 02 00 00 b7 02 00 00 cb 02 00 00 ee 02 00 00 ee 02 00 00 2a 03 00 00 2a 03 00 00 6b 03 00 00 6b 03 00 00 9d 03 00 00 9d 03 00 00 bb 03 00 00 bb 03 00 00 7d 00 00 00 7d 00 00 00];
