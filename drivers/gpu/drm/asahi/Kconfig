config RUST_DRM_SCHED
	bool
	select DRM_SCHED

config RUST_DRM_GPUVM
	bool
	select DRM_GPUVM

config DRM_ASAHI
	tristate "Asahi (DRM support for Apple AGX GPUs)"
	depends on RUST
	depends on DRM=y
	depends on (ARM64 && ARCH_APPLE) || (COMPILE_TEST && !GENERIC_ATOMIC64)
	depends on MMU
	depends on IOMMU_SUPPORT
	depends on PAGE_SIZE_16KB
	select APPLE_PMP_REPORT
	select RUST_DRM_SCHED
	select RUST_DRM_GEM_SHMEM_HELPER
	select RUST_DRM_GPUVM
	select RUST_APPLE_RTKIT
	select WANT_DEV_COREDUMP
	help
	  DRM driver for Apple AGX GPUs (G13x, found in the M1 SoC family)

config DRM_ASAHI_G15
	bool "Apple M3 Pro/Max (G15S, G15C) support (experimental)"
	depends on DRM_ASAHI && ARM64
	depends on APPLE_PMP=y || APPLE_PMP=DRM_ASAHI
	select CRYPTO_LIB_SHA256
	select RUST_FW_LOADER_ABSTRACTIONS
	help
	  Support for the G15S GPU of the T6030 MacBook Pros (J514S, J516S)
	  and the G15C GPU of the T6031 MacBook Pros (J514C, J516C), whose
	  firmware (RTKit 2419) the boot loader leaves loaded. Only the
	  qualified firmware builds are admitted. The T6031 board images are
	  a firmware file (asahi/t6031-j516c-board.bin), to be built in with
	  CONFIG_EXTRA_FIRMWARE.

	  The G15 platform driver has no module alias: it binds when the
	  asahi module is loaded explicitly (modprobe asahi), after the
	  native display is up. The firmware session is retained until
	  reboot; the module cannot be unloaded once the GPU has started.

	  Say N unless you are bringing up the M3 Pro.

config DRM_ASAHI_DEBUG_ALLOCATOR
	bool "Use debug allocator"
	depends on DRM_ASAHI
	help
	  Use an alternate, simpler allocator which significantly reduces
	  performance, but can help find firmware- or GPU-side memory safety
	  issues. However, it can also trigger firmware bugs more easily,
	  so expect GPU crashes.

	  Say N unless you are debugging firmware structures or porting to a
	  new firmware version.
