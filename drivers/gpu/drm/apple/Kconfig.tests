config DRM_APPLE_FABRIC_CORE
	tristate

config DRM_APPLE_FABRIC_KUNIT_TEST
	tristate "KUnit tests for the Apple display fabric" if !KUNIT_ALL_TESTS
	depends on KUNIT
	select DRM_APPLE_FABRIC_CORE
	default KUNIT_ALL_TESTS
	help
	  Test Apple display pipeline allocation, connector ordering and fixed
	  output priority without DRM devices or Apple display hardware.
	  The suite covers direct DisplayPort and USB4 tunnel combinations,
	  immutable tunnel ownership and external display service readiness.

config DRM_APPLE_HDR_KUNIT_TEST
	tristate "KUnit tests for Apple DCPAV HDR metadata" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Test the HDR10 static metadata object encoder, DCPAV message envelope
	  and reply status validation without Apple display hardware.
	  Cover unsupported metadata types, CTA primary order, little-endian
	  luminance fields and malformed replies. No DRM device is required.
