			opp-microvolt = <0>;
		};
		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
