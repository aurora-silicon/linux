						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&gpu5_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu6-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <51300>;
			thermal-sensors = <&smc_hwmon 23>;	/* Tg1l */

			trips {
				gpu6_switch_on: trip-switch-on {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu6_passive: trip-passive {
					temperature = <101000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&gpu6_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&gpu6_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&gpu6_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

&smc_hwmon {
	/*
	 * TCMz and the 23 zone sensors after it must stay the first
	 * temperature children: the thermal zones name a sensor by its index,
	 * so the board's hwmon nodes only append after them.
	 */
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Die Max";
	};

	temperature-Tex0 {
		apple,key-id = "Tex0";
		label = "E-cluster Tex0";
	};

	temperature-Tex1 {
		apple,key-id = "Tex1";
		label = "E-cluster Tex1";
	};

	temperature-Tex2 {
