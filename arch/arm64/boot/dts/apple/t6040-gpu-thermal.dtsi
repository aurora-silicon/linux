	/*
	 * Zones on the SMC die-maximum sensors (smc_hwmon 0-23): TCMz for the
	 * die, Tex0-3, Tpx0-5 and Tpx8-D per CPU cluster, and the seven
	 * hottest GPU sensors. The PMP's loop holds the die at the ADT
	 * fast-die-ctrl-loop target of 110 C, as on macOS; these zones are
	 * the backstop behind it.
	 *
	 * - CPU zones run the power allocator from 75 C, control at 115 C and
	 *   throttle only the cluster their sensor sits on. The 1 s samples
	 *   jump by about 10 C, so the zones are integral-led.
	 * - GPU zones: the GPU firmware limits itself from 101 C; these shed
	 *   CPU power from the same point (on at 90 C) and shut down at 118 C
	 *   after three samples, as the CPU zones do. A powered-off GPU reads
	 *   -4 to 4 C.
	 * - Hot at 120 C only reports; critical is the ADT's 125 C sochot
	 *   level, after three samples (critical-samples).
	 * - The fans stay with the SMC, as on macOS: no active trips.
	 *
	 * sustainable-power is the J616s's: a 720 s all-core load held TCMz
	 * at 112-114 C with P0 25.3 W, P1 23.9 W and E 2.1 W on the SMC core
	 * rails. The J614s and J773s inherit these values until measured.
	 */
	thermal-zones {
		cpu-die-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <51300>;
			thermal-sensors = <&smc_hwmon 0>;	/* TCMz */

			trips {
				cpu_die_switch_on: cpu-die-switch-on {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_die_passive: cpu-die-passive {
					temperature = <115000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu-die-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				cpu-die-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e0-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
