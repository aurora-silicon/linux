// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * GPU operating points and thermal zones of the T6040 Macs, with the SMC
 * sensors the zones read. Shared by the J614s, J616s and J773s.
 *
 * Copyright The Asahi Linux Contributors
 */

#include <dt-bindings/thermal/thermal.h>

/ {
	/*
	 * GPU performance states, one opp-microvolt cell per cluster (ADT
	 * /arm-io/sgx perf-states and perf-states1). The operating points are
	 * binned per device: the loader fills these placeholders.
	 * The driver requires a completed calibration handoff. Entries keep the
	 * order of the GPU performance states, which is not sorted by frequency.
	 */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp08 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp09 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp10 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp11 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp12 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp13 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp14 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp15 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
	};

	/* The GPU's CS clock domain (ADT cs-perf-states) */
	gpu_cs_opp: opp-table-gpucs {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp01 {
