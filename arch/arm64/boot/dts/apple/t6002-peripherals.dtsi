	apr1: video-codec@489000000 {
		compatible = "apple,t6000-prores", "apple,prores";
		reg = <0x4 0x89000000 0x0 0x4000>,
		      <0x4 0x88000000 0x0 0x1000000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1514 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_prores>;
		iommus = <&apr1_dart 0>;
		reg-names = "core", "wrapper";
		status = "disabled";
	};

	apr1_dart: iommu@489008000 {
		compatible = "apple,t8110-dart";
		reg = <0x4 0x89008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1511 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_prores>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	scaler1: scaler@505000000 {
		compatible = "apple,t6000-scaler", "apple,scaler";
		reg = <0x5 0x05000000 0x0 0x28000>,
		      <0x5 0x05210000 0x0 0x4000>,
		      <0x5 0x05204000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1091 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1093 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_msr1>, <&ps_msr1_ase_core>;
		clocks = <&peripheral_clocks 356>;
		iommus = <&scaler1_dart 0>, <&scaler1_dart 1>;
		resets = <&ps_msr1>;
		status = "disabled";
	};

	scaler1_dart: iommu@505200000 {
		compatible = "apple,t8110-dart";
		reg = <0x5 0x05200000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1092 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_msr1>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ave1_dma: dma-controller@507020000 {
		compatible = "apple,t6000-ave-dma", "apple,ave-dma";
		reg = <0x5 0x07020000 0x0 0x4000>,
		      <0x5 0x07044000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1038 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc1_sys>;
		status = "disabled";
