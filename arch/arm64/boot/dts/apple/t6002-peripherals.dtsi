	ave1_dart1: iommu@507030000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x5 0x07030000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1038 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc1_sys>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ave1_dart0: iommu@507040000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x5 0x07040000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1038 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc1_sys>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ave1: video-codec@507100000 {
		compatible = "apple,t6000-ave";
		reg = <0x5 0x07100000 0x0 0x45c000>,
		      <0x5 0x07050000 0x0 0x8000>,
		      <0x5 0x07800000 0x0 0x800000>,
		      <0x2 0x8e680260 0x0 0x7dc4>,
		      <0x5 0x06000000 0x0 0x1000000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1041 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1035 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1034 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1037 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1036 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc1_dma>, <&ps_venc1_pipe4>, <&ps_venc1_pipe5>, <&ps_venc1_me0>, <&ps_venc1_me1>;
		clocks = <&peripheral_clocks 454>;
		iommus = <&ave1_dart0 0>, <&ave1_dart1 0>;
		reg-names = "codec", "mailbox", "coproc", "pmgr", "pio";
		power-domain-names = "dma", "pipe4", "pipe5", "me0", "me1";
		status = "disabled";
	};

