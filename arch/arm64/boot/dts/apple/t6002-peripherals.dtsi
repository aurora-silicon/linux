	ave0_dma: dma-controller@40d020000 {
		compatible = "apple,t6000-ave-dma", "apple,ave-dma";
		reg = <0x4 0x0d020000 0x0 0x4000>,
		      <0x4 0x0d044000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1028 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc_sys>;
		status = "disabled";
