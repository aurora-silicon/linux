/* Disabled resource descriptions for T6002. */

&die0 {
	ane0_dma: dma-controller@285804000 {
		compatible = "apple,t6000-ane-dma", "apple,ane-dma";
		reg = <0x2 0x85804000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 771 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_ane_sys>;
		status = "disabled";
	};

	aic_timebase: timer@28e148000 {
		compatible = "apple,t6000-aic-timebase", "apple,aic-timebase";
		reg = <0x2 0x8e148000 0x0 0x1000>;
		status = "disabled";
	};

	dwi: bus-controller@28e208000 {
		compatible = "apple,t6000-dwi", "apple,dwi";
		reg = <0x2 0x8e208000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 22 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_dwi>;
		status = "disabled";
	};

	/* The DebugUSB DockChannel serial channel; RX is drained in software. */
	dockchannel_uart: serial@29252c000 {
		compatible = "apple,t6000-dockchannel-uart", "apple,dockchannel-uart";
		reg = <0x2 0x9252c000 0x0 0x4000>,
		      <0x2 0x92528000 0x0 0x4000>,
		      <0x2 0x9250c000 0x0 0x18>;
		reg-names = "data", "config", "irq";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 620 IRQ_TYPE_LEVEL_HIGH>;
		apple,sw-drain;
		status = "disabled";
	};

	ausb_phy0: phy@30d000000 {
		compatible = "apple,t6000-ausb-phy", "apple,ausb-phy";
		reg = <0x3 0x0d000000 0x0 0x4000>;
		power-domains = <&ps_c0_usbctl>;
		#phy-cells = <0>;
		phys = <&ausb_usb3phy>;
		status = "disabled";
	};

	ausb_drd0: usb@30d010000 {
		compatible = "apple,t6000-ausb-drd", "apple,ausb-drd";
		reg = <0x3 0x0d010000 0x0 0x11800>,
		      <0x3 0x0d020000 0x0 0x4000>,
		      <0x3 0x0d01c100 0x0 0x4000>,
		      <0x3 0x0d000000 0x0 0x2c000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1155 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1156 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1157 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1158 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_c0_usb31drd>;
		iommus = <&ausb0_dart0 3>, <&ausb0_dart1 3>;
		phys = <&ausb_phy0>;
		status = "disabled";
	};

	ausb0_dart0: iommu@30d024000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x3 0x0d024000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1154 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ausb0_dart1: iommu@30d028000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x3 0x0d028000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1154 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ausb_phy1: phy@30d400000 {
		compatible = "apple,t6000-ausb-phy", "apple,ausb-phy";
		reg = <0x3 0x0d400000 0x0 0x4000>;
		power-domains = <&ps_c1_usbctl>;
		#phy-cells = <0>;
		phys = <&ausb_usb3phy>;
		status = "disabled";
	};

	ausb_drd1: usb@30d410000 {
		compatible = "apple,t6000-ausb-drd", "apple,ausb-drd";
		reg = <0x3 0x0d410000 0x0 0x11800>,
		      <0x3 0x0d420000 0x0 0x4000>,
		      <0x3 0x0d41c100 0x0 0x4000>,
		      <0x3 0x0d400000 0x0 0x2c000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1163 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1164 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1165 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1166 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_c1_usb31drd>;
		iommus = <&ausb1_dart0 3>, <&ausb1_dart1 3>;
		phys = <&ausb_phy1>;
		status = "disabled";
	};

	ausb1_dart0: iommu@30d424000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x3 0x0d424000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1162 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ausb1_dart1: iommu@30d428000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x3 0x0d428000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1162 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	ausb_usb3phy: phy@30d900000 {
		compatible = "apple,t6000-ausb-usb3-phy", "apple,ausb-usb3-phy";
		reg = <0x3 0x0d900000 0x0 0x4000>,
		      <0x3 0x0d980000 0x0 0x4000>,
		      <0x3 0x0d982000 0x0 0x4000>,
		      <0x3 0x0d982200 0x0 0x4000>,
		      <0x3 0x0d982800 0x0 0x4000>,
		      <0x3 0x0d982a00 0x0 0x4000>,
		      <0x3 0x0d980a00 0x0 0x4000>,
		      <0x3 0x0d980800 0x0 0x4000>,
		      <0x3 0x0d98d000 0x0 0x4000>,
		      <0x3 0x0d994000 0x0 0x4000>,
		      <0x3 0x0d98c000 0x0 0x4000>,
		      <0x3 0x0d993000 0x0 0x4000>,
		      <0x3 0x0d98b000 0x0 0x4000>,
		      <0x3 0x0d992000 0x0 0x4000>,
		      <0x3 0x0d989000 0x0 0x4000>,
		      <0x3 0x0d990000 0x0 0x4000>,
		      <0x3 0x0d981000 0x0 0x4000>,
		      <0x2 0x922bc000 0x0 0x2000>,
		      <0x3 0x0c000000 0x0 0x1000000>,
		      <0x3 0x0d98a000 0x0 0x4000>,
		      <0x3 0x0d991000 0x0 0x4000>;
		power-domains = <&ps_gp_usb_aon>, <&ps_usb>;
		#phy-cells = <0>;
		status = "disabled";
	};

	apr0: video-codec@311000000 {
		compatible = "apple,t6000-prores", "apple,prores";
		reg = <0x3 0x11000000 0x0 0x4000>,
		      <0x3 0x10000000 0x0 0x1000000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1482 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_scodec>;
		iommus = <&apr0_dart 0>;
		reg-names = "core", "wrapper";
		status = "disabled";
	};

	apr0_dart: iommu@311008000 {
		compatible = "apple,t8110-dart";
		reg = <0x3 0x11008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1479 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_scodec>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	aes: crypto@39b060000 {
		compatible = "apple,t6000-aes", "apple,aes";
		reg = <0x3 0x9b060000 0x0 0x4000>,
		      <0x2 0x922d0000 0x0 0x8000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1117 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_aes>;
		iommus = <&sio_dart_0 1>, <&sio_dart_1 1>;
	};

	jpeg0: jpeg@409000000 {
		compatible = "apple,t6000-jpeg", "apple,jpeg";
		reg = <0x4 0x09000000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1076 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		clocks = <&peripheral_clocks 354>, <&peripheral_clocks 355>;
		iommus = <&jpeg0_dart 0>;
		status = "okay";
	};

	jpeg0_dart: iommu@409004000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x4 0x09004000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1077 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		#iommu-cells = <1>;
		status = "okay";
	};

	jpeg1: jpeg@409008000 {
		compatible = "apple,t6000-jpeg", "apple,jpeg";
		reg = <0x4 0x09008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1081 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		clocks = <&peripheral_clocks 354>, <&peripheral_clocks 355>;
		iommus = <&jpeg1_dart 0>;
		status = "okay";
	};

	jpeg1_dart: iommu@40900c000 {
		compatible = "apple,t6000-dart", "apple,t8110-dart";
		reg = <0x4 0x0900c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1082 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		#iommu-cells = <1>;
		status = "okay";
	};

	scaler0: scaler@40b000000 {
		compatible = "apple,t6000-scaler", "apple,scaler";
		reg = <0x4 0x0b000000 0x0 0x28000>,
		      <0x4 0x0b210000 0x0 0x4000>,
		      <0x4 0x0b204000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1085 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1087 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_msr0>, <&ps_msr0_ase_core>;
		clocks = <&peripheral_clocks 356>;
		iommus = <&scaler0_dart 0>, <&scaler0_dart 1>;
		resets = <&ps_msr0>;
		status = "disabled";
	};

	scaler0_dart: iommu@40b200000 {
		compatible = "apple,t8110-dart";
		reg = <0x4 0x0b200000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1086 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_msr0>;
		#iommu-cells = <1>;
		status = "disabled";
