	power-PP0b {
		apple,key-id = "PP0b";
		label = "P-cluster PP0b";
	};

	power-PPbb {
		apple,key-id = "PPbb";
		label = "E-cluster PPbb";
	};

	power-PP1b {
		apple,key-id = "PP1b";
		label = "GPU PP1b";
	};

	power-PP2b {
		apple,key-id = "PP2b";
		label = "PMU PP2b";
	};

	power-PP4b {
		apple,key-id = "PP4b";
		label = "PMU PP4b";
	};

	power-PP7b {
		apple,key-id = "PP7b";
		label = "PMU PP7b";
	};

	power-PP7l {
		apple,key-id = "PP7l";
		label = "PMU PP7l";
	};

	power-PP8l {
		apple,key-id = "PP8l";
		label = "PMU PP8l";
	};

	power-PP9b {
		apple,key-id = "PP9b";
		label = "PMU PP9b";
	};

	power-PPBR {
		apple,key-id = "PPBR";
		label = "PMU PPBR";
	};

	power-PPkl {
		apple,key-id = "PPkl";
		label = "PMU PPkl";
	};

	power-PR4l {
		apple,key-id = "PR4l";
		label = "Rail PR4l";
	};

	power-PR5b {
		apple,key-id = "PR5b";
		label = "Rail PR5b";
	};

	power-PR8b {
		apple,key-id = "PR8b";
		label = "Rail PR8b";
	};

	power-PRcl {
		apple,key-id = "PRcl";
		label = "Rail PRcl";
	};
};
