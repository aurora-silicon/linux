// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (16-inch PROLED XDR, M5 Pro, 2026)
 *
 * target-type: K116s (Mac17,12)
 *
 * Preliminary: described from the ADT only, not yet booted on the hardware.
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t6050-k114-k116.dtsi"

/ {
	compatible = "apple,k116s", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch PROLED XDR, M5 Pro, 2026)";
};

&mtp_multitouch {
	firmware-name = "apple/tpmtfw-k116s.bin";
};

#define T6050_K116S
#include "t6050-peripherals.dtsi"

/ {
	aliases {
		/* The loader fills the N1's factory addresses through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};
};

/* Only PCIe port 0's PERST#, pin 80, is exposed */
&pinctrl_ap {
	/*
	 * Pin 112 takes an SError when read, so only the pins a node names are
	 * exposed: 80 (PCIe PERST#), 106/107 (amp fault, amp shutdown), 134/139
	 * (jack codec interrupt, reset) and 136/137 (speaker ID).
	 */
	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 1>, <138 1>, <140 81>;
};

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth), laid out as on J714s. ADT apcie0
 * gives port 0's registers and IRQ 1523, pci-bridge0's PERST# is GPIO 80, and
 * the N1's three functions are on DART streams 1-3. The platform ID is this
 * board's ADT /chosen board-id (0x16) << 16 | chip 0x6050.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 4>;
	status = "okay";

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#: ADT pci-bridge0 function-perst, GPIO 80 */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/k116s-ftab.bin";
			apple,centauri-platform-id = <0x00166050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/*
 * Type-C, from the ADT (as on J714s):
 *   ATC0 usb-drd0 left-back  hpm0 nub-spmi-a0 0x0c (the debug port, not described)
 *   ATC1 usb-drd1 left-front hpm1 nub-spmi-a0 0x0a
 *   ATC2 usb-drd2 right      hpm2 nub-spmi-a1 0x0c
 *   hpm5 nub-spmi-a0 0x08 (MagSafe, not a USB-C connector)
 */

/* Left-front port (ATC1): the SN201202x hpm1 and the connector graph */
&nub_spmi_a0 {
	status = "okay";

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_hs: endpoint {
						remote-endpoint = <&usb_drd1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_ss: endpoint {
						remote-endpoint = <&atc1_phy_typec>;
					};
				};
			};
		};
	};
};

&atc1_phy_mbox {
	status = "okay";
};

&atc1_phy {
	status = "okay";

	port {
		atc1_phy_typec: endpoint {
			remote-endpoint = <&typec1_ss>;
		};
	};
};

&usb_drd1 {
	status = "okay";

	port {
		usb_drd1_hs: endpoint {
			remote-endpoint = <&typec1_hs>;
		};
	};
};

&usb_drd1_dart_0 {
	status = "okay";
};

&usb_drd1_dart_1 {
	status = "okay";
};

/*
 * Right port (ATC2): hpm2 on nub-spmi-a1, USB only (dcpext0's DisplayPort route
 * through ATC2 stays off). The driver polls the generation 4 bus and refuses an
 * interrupt, so it takes the first register window only, as on J714s.
 */
&nub_spmi_a1 {
	reg = <0x2 0x8a1a8000 0x0 0x4000>;
	/delete-property/ interrupts;
	status = "okay";

	hpm2: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		typec2: connector {
			compatible = "usb-c-connector";
			label = "USB-C Right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec2_hs: endpoint {
						remote-endpoint = <&usb_drd2_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec2_ss: endpoint {
						remote-endpoint = <&atc2_phy_typec>;
					};
				};
			};
		};
	};
};

&ps_atc2_common {
	status = "okay";
};

&ps_atc2_usb_aon {
	status = "okay";
};

&ps_atc2_phymxwrap {
	status = "okay";
};

&ps_atc2_usb {
	status = "okay";
};

&atc2_phy_mbox {
	status = "okay";
};

&atc2_phy {
	status = "okay";

	port {
		atc2_phy_typec: endpoint {
			remote-endpoint = <&typec2_ss>;
		};
	};
};

&usb_drd2 {
	status = "okay";

	port {
		usb_drd2_hs: endpoint {
			remote-endpoint = <&typec2_hs>;
		};
	};
};

&usb_drd2_dart_0 {
	status = "okay";
};

&usb_drd2_dart_1 {
	status = "okay";
};

/*
 * SMC sensors, as on J714s: every readable float T* key is discovered through
 * apple,discover-temperatures in t6050-die0.dtsi, so the shared temperature
 * nodes and apple,soc-die-keys go. The T6050 SMC spells the fan mode keys
 * F0md/F1md and drives the fans itself.
 */
#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"
#include "hwmon-laptop.dtsi"

&smc_hwmon {
	status = "okay";
	/delete-property/ apple,soc-die-keys;
	/delete-node/ temperature-TH0x;
	/delete-node/ temperature-TB0T;
	/delete-node/ temperature-TCHP;
	/delete-node/ temperature-TW0P;
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};
	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};

/*
 * The internal panel and the display coprocessor, for the boot loader's display
 * hand-off (aura, chosen.aurora,t6050-display=1). Everything stays disabled: the
 * loader checks the ADT and the live DCP and DART state, publishes the DCP's
 * firmware properties, reserves the ADT /vram as the framebuffer and only then
 * enables dcp, its DARTs and mailbox and the display subsystem. A loader without
 * the hand-off leaves the boot framebuffer to simpledrm.
 */
/ {
	aliases {
		/* The loader writes apple,notch-height into the "dcp" alias */
		dcp = &dcp;
		disp0 = &display;
	};

	/* As on J714s, with the internal display's DART (disp0, SID 0) */
	display: display-subsystem {
		compatible = "apple,display-subsystem";
		iommus = <&disp0_dart 0>;
		status = "disabled";
	};
};

/* ADT dart-dcp and dart-disp0: vm-base 1 TiB, vm-size 3 TiB */
&dcp_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&disp0_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

/* The DCP firmware's clocks: ADT disp0 clock-ids; the loader fills the rates */
/ {
	dcp_clk_361: clock-dcp-firmware-361 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	dcp_clk_458: clock-dcp-firmware-458 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};
};

&dcp {
	/*
	 * The bandwidth request scratch: the PMC metadata (disp-4, register window
	 * 5) at the slot of PMGR bandwidth agent DISP_INT (ADT bwr-agent index 0,
	 * BIRQ 0x96 = disp0 function-bw_req_interrupt0): 0x20000 + 0 * 0x4000.
	 */
	apple,bw-scratch = <&dcpext0_pmc 0 5 0x20000>;
	/* ADT disp0 clock-ids */
	apple,clock-ids = <361 458>;
	clocks = <&dcp_clk_361>, <&dcp_clk_458>;

	/*
	 * The 16.2-inch 3456x2234 tandem OLED panel. The ADT carries no dimensions;
	 * these are the panel's active area, for the DPI only.
	 */
	panel {
		compatible = "apple,panel-k116", "apple,panel";
		width-mm = <345>;
		height-mm = <223>;
	};
};

/* The ADT lists no clocks for the external engines (clock-ids = []) */
&dcpext1 {
	apple,clock-ids;
};

&dcpext2 {
	apple,clock-ids;
};

&dcpext3 {
	apple,clock-ids;
};

/* ADT dart-dcpextN and dart-dispextN: vm-base 1 TiB, vm-size 3 TiB */
&dcpext1_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&dispext1_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&dcpext2_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&dispext2_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&dcpext3_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

&dispext3_dart {
	apple,dma-range = <0x100 0x0 0x300 0x0>;
};

/*
 * The trackpad's AFE reset. The ADT names the SMC pcIO template (0x10000,
 * 0x11c0000), the same line as SMC GPIO gp1c, active low, which gpio-macsmc
 * drives; through the pcIO outputs the multi-touch interface never comes up.
 * As on J714s: gp1c, and the pcIO outputs go. The keyboard alias lets the
 * loader fill the layout from the ADT.
 */
/delete-node/ &smc_pcio;

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio_low 28 GPIO_ACTIVE_LOW>;

	keyboard: keyboard {
	};

	/*
	 * The touchscreen's MTP interface. Its GPIO functions (reset, power, clock,
	 * display sync) are not described yet, so the interface stays off until
	 * they are, as a pending GPIO request from the firmware stalls the others.
	 */
	kiwi {
		status = "disabled";
	};
};

/ {
	aliases {
		keyboard = &keyboard;
		/* The loader fills the PHYs' tunables from the ADT through these */
		atcphy1 = &atc1_phy;
		atcphy2 = &atc2_phy;
	};
};

/* Sound: the J714s description, every value checked against the K116s ADT. */
/*
 * The amps' shared shutdown line (SDZ): ADT audio-speaker function-reset, AP pin 107. One
 * regulator as the SDZ supply of all six (not per-amp shutdown-gpios: with GPIO_SHARED six
 * references become a vote, and one amp driving the line low would not shut the others down).
 */
/ {
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

/*
 * The left amps: ADT /arm-io/i2c1. i2c1 is disabled by t6050-k114-k116.dtsi ("Audio is not
 * brought up"); re-enabled here. Sense slots from the ADT speaker-config (V at 4N, I at 4N+2
 * for group index N); the firmware's frame is 250 BCLKs of 12 MHz, which the amp driver's
 * ratio detection rejects, hence ti,bclk-ratio. Every amp joins the SDZ fail-closed group:
 * an over-temperature or over-current fault on any one forces the shared line low.
 *
 * Each amp's operating level (AMP_LEVEL 15 here) is its row of the ADT speaker-config,
 * which aura copies into the node as apple,speaker-config (aura commit "kboot: hand the
 * speaker amps' configuration from the ADT to the kernel", patches/aura/). macaudio
 * refuses to run the speakers on an SN012776 without it (the jack still works).
 */
&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <2>;
		ti,vmon-slot-no = <0>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <10>;
		ti,vmon-slot-no = <8>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <18>;
		ti,vmon-slot-no = <16>;
		ti,bclk-ratio = <250>;
	};
};

/*
 * The right amps: ADT /arm-io/i2c3. In t6050-peripherals.dtsi i2c3 is disabled, clocked from
 * peripheral_clocks 4 and powered by ps_i2c3 under ps_sio. The ADT gives i2c1, i2c2 and i2c3
 * the same clock-ids (4), so i2c3 takes clkref like i2c1/i2c2 in t6050-die0.dtsi; its power
 * state's parent (SIO) is left undescribed, as for i2c1 and i2c2 (same as J714s).
 */
&ps_i2c3 {
	/delete-property/ power-domains;
	status = "okay";
};

&i2c3 {
	clocks = <&clkref>;
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <6>;
		ti,vmon-slot-no = <4>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <14>;
		ti,vmon-slot-no = <12>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <22>;
		ti,vmon-slot-no = <20>;
		ti,bclk-ratio = <250>;
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c2/audio-codec-output, reg 0x4b): reset on AP
 * pin 139 (function-reset GPIO(0x8b, 0x1)), driven high to run; interrupt AP pin 134, level
 * low. i2c2 is disabled by t6050-k114-k116.dtsi; re-enabled here.
 */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Jack";
	};
};

/* ADT admac-base-ns: 0x293800000, IRQ 637, 13 TX + 13 RX channels, dart-aop stream 8 */
&admac_base_ns {
	status = "okay";
};

/*
 * The AOP audio service (apple,t6050-aop-audio, t6050-die0.dtsi: dmas cout/cin/spkr/sense =
 * base-ns 4/5/0/1). The chassis name is the microphone card's identity (AppleK116HPAI), the
 * machine kind the card's long name.
 */
&aop_audio {
	apple,chassis-name = "K116";
	apple,machine-kind = "MacBook Pro";
};

/*
 * The sound card. "apple,k116-macaudio" needs its macaudio.c entry (patches/0001-ASoC-apple-
 * macaudio-Add-K116.patch): the same amps, slots, frame and sense layout as J714
 * (macaudio_j714_cfg), a different chassis. Until that lands, "apple,j714-macaudio" as the
 * first compatible gives the same card under the J714 name.
 */
/ {
	sound {
		compatible = "apple,k116-macaudio", "apple,macaudio";
		model = "MacBook Pro K116";
		/* ADT audio-speaker function-speaker-id0 and -id1: gpio0 0x88, 0x89 */
		speaker-id-gpios = <&pinctrl_ap 136 GPIO_ACTIVE_HIGH>,
				   <&pinctrl_ap 137 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				/* T8152-style driver: DAI 0 is the jack ("cout"/"cin") back-end */
				sound-dai = <&aop_audio 0>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";
			/*
			 * Codecs in ADT speaker-config (group) order, so that macaudio gives them
			 * playback slots 0-5 as macOS does (left in slots 0, 2, 4; right in 1, 3, 5).
			 * The idle masks are ADT amp-tx-zd-config rows 0 and 1 (fff0f0f0, ff0f0f0f):
			 * left woofer 1 drives zeros in the right amps' sense slots, right woofer 1
			 * in the left amps'.
			 */
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xfff0f0f0>;
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-1 = <0xff0f0f0f>;

			cpu {
				/* DAI 3 is the "spkr" back-end (its V/I sense is the card's third PCM) */
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_right_woof1>,
					    <&speaker_left_woof2>, <&speaker_right_woof2>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};
};

/*
 * The AOP, booted through its setup port (ADT aop-exclave-mailbox at 0x2d067c000, dart-aop
 * stream 1), with its RTKit mailbox (ADT aop interrupts 578-581), dart-aop (0x290fc0000,
 * IRQ 616, 17 streams, locked tables on the ADT l1-tt-0 root) and the AOP itself
 * (0x290c00000 SRAM window, ASC 0x290600000). All four nodes are in t6050-die0.dtsi /
 * t6050-peripherals.dtsi of the PR tree, disabled.
 */
&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop {
	status = "okay";
};

#if 0
/*
 * OPTIONAL, second step: the microphone array, from branch m5-parity/t6050-mic-on-speakers
 * (commit 1026d291ef84, on top of PR #1554; not yet in the PR). ADT audio-hp-mic: three
 * microphones ("Digital Mic", input-data-selectors imi1/imi2/imi3) on leap-s ADMAC RX0,
 * reached through the proxy aperture ADT admac-hp-mic-ec-proxy at 0x2d3200000 (reg not
 * behind the arm-io translation; dart-aop stream 11, vm-base-11 0x10040000000,
 * vm-size-11 0xffff0000; admac-leap-s IRQ 638). That branch re-describes admac_ec_proxy in
 * t6050-peripherals.dtsi as a plain apple,t8140-admac at 0x2d3200000 on <&aop_dart 11>;
 * without that peripherals change this block must stay off.
 */
&admac_ec_proxy {
	status = "okay";
};

&aop_audio {
	/* hpai: leap-s RX0 = Linux channel 1 of the proxy ADMAC (odd = DEV_TO_MEM) */
	dmas = <&admac_base_ns 4>, <&admac_base_ns 5>,
	       <&admac_base_ns 0>, <&admac_base_ns 1>,
	       <&admac_ec_proxy 1>;
	dma-names = "cout", "cin", "spkr", "sense", "hpai";
};
#endif

#if 1
/*
 * OPTIONAL stop-gap, only while booting an aura without kboot_audio.c (the booted
 * aura-m5pro-v4.bin, aura main 58d65df, does not copy apple,speaker-config): the rows of the
 * K116s ADT speaker-config, byte for byte (rx_slot, amp_gain, vsense_slot, isense_slot),
 * group order LW1, RW1, LW2, RW2, LT, RT. macaudio takes byte 1 & 0x1f = 15 as the level.
 * Prefer the aura patch: this hard-codes one Mac's ADT into a shared tree. Remove once aura
 * fills the property (aura's copy overwrites it anyway).
 */
&speaker_left_woof1  { apple,speaker-config = /bits/ 8 <0x00 0x0f 0x00 0x02>; };
&speaker_right_woof1 { apple,speaker-config = /bits/ 8 <0x01 0x0f 0x04 0x06>; };
&speaker_left_woof2  { apple,speaker-config = /bits/ 8 <0x02 0x0f 0x08 0x0a>; };
&speaker_right_woof2 { apple,speaker-config = /bits/ 8 <0x03 0x0f 0x0c 0x0e>; };
&speaker_left_tweet  { apple,speaker-config = /bits/ 8 <0x04 0x0f 0x10 0x12>; };
&speaker_right_tweet { apple,speaker-config = /bits/ 8 <0x05 0x0f 0x14 0x16>; };
#endif
