// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Internal PCIe: BCM4388 Wi-Fi/Bluetooth on apcie port 0. As on J813, the
 * bootloader trains the link and Linux uses the root port as a generic ECAM
 * host that owns the DART and the endpoints. Nothing programs the port's
 * RID-to-SID table, so both functions use stream zero of the port's DART.
 * Ranges, the MSI map and the DART IRQ are from the J704 ADT; port 0
 * matches J813.
 *
 * The GL9755 SD card reader sits on port 2 (ADT pci-bridge2, bus 2, MSI map
 * at 0x48a028000, pcie2_dart). The bootloader trains port 0 only, so the
 * ECAM window and the MSI controller stop at port 0 until port 2 is
 * trained too.
 */

&{/} {
	pcie0: pcie@1cb0000000 {
		compatible = "pci-host-ecam-generic";
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 1>;
		reg = <0x1c 0xb0000000 0 0x200000>;
		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0 0x20000000>,
			 <0x02000000 0 0x80000000 0xb 0x80000000 0 0x40000000>;
		dma-coherent;
		msi-parent = <&pcie0_msi>;
		/*
		 * Port 2's root port (00:02.0) still enumerates on bus 0 and has no
		 * entry here, so "no iommu-map translation for id 0x10" is expected.
		 */
		iommu-map = <0x100 &pcie0_dart 0 1>,
			    <0x101 &pcie0_dart 0 1>;

		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			bus-range = <1 1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			wifi0: wifi@0,0 {
				compatible = "pci14e4,4434";
				reg = <0x10000 0x0 0x0 0x0 0x0>;
				brcm,board-type = "apple,linosa";
				/* To be filled by the loader */
				local-mac-address = [00 10 18 00 00 10];
				apple,antenna-sku = "XX";
			};

			bluetooth0: bluetooth@0,1 {
				compatible = "pci14e4,5f72";
				reg = <0x10100 0x0 0x0 0x0 0x0>;
				brcm,board-type = "apple,linosa";
				/* To be filled by the loader */
				local-bd-address = [00 00 00 00 00 00];
			};
		};
	};
};

&{/soc} {
	/*
	 * Port 0's MSI map (ADT msi-vector-offset 1741, port 0 owns the first
	 * 32 vectors).
	 */
	pcie0_msi: msi-controller@488028000 {
		compatible = "apple,t8142-pcie-msi";
		reg = <0x4 0x88028000 0x0 0x8000>;
		msi-controller;
		msi-ranges = <&aic AIC_IRQ 1741 IRQ_TYPE_EDGE_RISING 32>;
	};
};

&pcie0_dart {
	status = "okay";
};
