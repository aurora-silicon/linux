// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Air (15-inch, M5), J815.
 *
 * J815 is the 15-inch sibling of J813 on the same T8142 die. It uses the
 * J813 board fragments and overrides what the J815 ADT shows to be
 * different:
 *
 *  - /chosen board-id 0x26 (J813: 0x24)
 *  - 15.3" 2880x1864 panel (2880x1800 below the notch), 326 x 211 mm
 *  - six SN012776 speaker amplifiers on i2c3 (0x38-0x3d: two tweeters and
 *    four force-cancelling woofers); J813 has four
 *  - ISP sensor-type 0x72 (J813: 0x71)
 *  - MTP hid-merge-personality C1FD3,3 (J813: C1FD1,4)
 *
 * The rest of the J813/J815 ADT difference is firmware selection (AOP
 * j815aop, acoustic-id 0x2b), ADMAC speaker channel counts and higher
 * CLPC package power limits.
 */
/dts-v1/;

#include "t8142.dtsi"

/ {
	compatible = "apple,j815", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Air (15-inch, M5)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "disabled";
		};
	};
};

&cpu0 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu1 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu2 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu3 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu4 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu5 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu6 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu7 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu8 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu9 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&{/timer} {
	status = "okay";
};

&aic {
	status = "okay";
};

&dockchannel {
	status = "okay";
};

#include "t8142-j813-peripherals.dtsi"
#include "t8142-j813-j815.dtsi"

&mtp_hid {
	multi-touch {
		/* ADT hid-merge-personality C1FD3,3 (J813: C1FD1,4). */
		firmware-name = "apple/tpmtfw-j815.bin";
	};
};

&pmp {
	/* ADT /chosen board-id (J815) */
	apple,board-id = <38>;
};
