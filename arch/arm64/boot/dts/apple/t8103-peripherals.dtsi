/* Hardware resources retained for devices without a qualified OS handoff. */

&{/soc} {
	mcc: memory-controller@200100000 {
		compatible = "apple,t8103-mcc", "apple,mcc";
		reg = <0x2 0x00100000 0x0 0x100000>,
		      <0x2 0x00000000 0x0 0x100000>,
		      <0x2 0x00200000 0x0 0x200000>;
		status = "disabled";
	};


	mtrtempsensor8: temperature-sensor@210ee4000 {
		compatible = "apple,t8103-die-temperature-sensor", "apple,die-temperature-sensor";
		reg = <0x2 0x10ee4000 0x0 0x4>,
