	aes: crypto@23500c000 {
		compatible = "apple,t8103-aes", "apple,aes";
		reg = <0x2 0x3500c000 0x0 0x4000>,
		      <0x2 0x3d2d0000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 625 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_aes>;
		iommus = <&sio_dart 1>;
		status = "disabled";
	};

	pwm0: pwm@235040000 {
		compatible = "apple,t8103-pwm", "apple,pwm";
		reg = <0x2 0x35040000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 632 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_fpwm0>;
		status = "disabled";
	};

	spi4: spi@235110000 {
		compatible = "apple,t8103-spi", "apple,spi";
		reg = <0x2 0x35110000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 618 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_spi4>;
		clocks = <&peripheral_clocks 380>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	aic_timebase: timer@23b108000 {
		compatible = "apple,t8103-aic-timebase", "apple,aic-timebase";
		reg = <0x2 0x3b108000 0x0 0x1000>;
		status = "disabled";
	};

