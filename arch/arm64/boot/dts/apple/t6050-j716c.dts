// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (16-inch, M5 Max, 2026)
 *
 * target-type: J716c
 *
 * The M5 Max is one T6050 die, die 0 (t6050-max.dtsi). This file enables
 * and configures what has been brought up on this board; the SoC's other
 * ports and buses stay disabled until each is described for it.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6050-max.dtsi"

/ {
	compatible = "apple,j716c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M5 Max, 2026)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by the loader */
			/* Format properties will be added by the loader */
			status = "disabled";
		};
	};
};

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth), the only GP port this board uses besides the SD
 * reader on port 1 (not yet described). The boot loader trains the link after the SMC releases
 * the N1's reset and keeps power, clocks, the PHY and PERST; Linux owns the routing, MSI and
 * the DART. Disabled with its DART until the boot loader trains it, which also renumbers the
 * bus here to the PCI core's order.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 4>;

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, driven only by the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		/* platform ID (board 0x0e << 16) | chip 0x6050 */
		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/j716c-ftab.bin";
			apple,centauri-platform-id = <0x000e6050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/* ATC1, ATC3 and the PD controller buses nub-spmi-a0 and -a2: not yet described for this board */
&nub_spmi_a0 {
	status = "disabled";
};

&nub_spmi_a2 {
	status = "disabled";
};

&atc1_phy_mbox {
	status = "disabled";
};

&atc1_phy {
	status = "disabled";
};

&usb_drd1 {
	status = "disabled";
};

&usb_drd1_dart_0 {
	status = "disabled";
};

&usb_drd1_dart_1 {
	status = "disabled";
};

&atc3_phy_mbox {
	status = "disabled";
};

&atc3_phy {
	status = "disabled";
};

&usb_drd3 {
	status = "disabled";
};

&usb_drd3_dart_0 {
	status = "disabled";
};

&usb_drd3_dart_1 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

/*
 * Pin 112's register (0x29c0001c0) takes an SError when read, so only the pins a node
 * here names are exposed: 80 (PCIe port 0's PERST#, ADT pci-bridge0 function-perst).
 * A reserved line cannot be requested, so a node that names a new pin opens it here too.
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 80>, <81 140>;
};

/* This board's SMC fan and power keys are not yet checked */
&smc_hwmon {
	status = "disabled";
};

/*
 * The console is on the USB debug link, which drains only while a host reads
 * it; the machine also boots with nothing attached there.
 */
&dockchannel {
	apple,tx-never-wait;
	status = "okay";
};

/* The keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO */
&mtp_dockchannel {
	mtp_hid: input@8000 {
		compatible = "apple,dockchannel-hid";
		reg = <0x8000 0x1000>, <0xc000 0x1000>,
		      <0x0 0x1000>, <0x4000 0x1000>;
		reg-names = "config", "data", "rmt-config", "rmt-data";
		iommus = <&mtp_dart 0>;
		interrupt-parent = <&mtp_dockchannel>;
		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
			     <3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "tx", "rx";
		apple,fifo-size = <0x800>;
		apple,helper-cpu = <&mtp>;
		apple,afe-reset-gpios = <&smc_pcio 2 GPIO_ACTIVE_HIGH>;

		multi-touch {
			apple,power-method = <2>;
			firmware-name = "apple/tpmtfw-j716c.bin";
		};

		keyboard {
		};

		stm {
		};
	};
};

/* This board's PCIO outputs, the trackpad AFE reset (2) among them */
&smc_pcio {
	apple,output-commands = /bits/ 64 <0x001a000000000000 0x000f000000800000 0x011c000000010000>;
};

#define T6050_J716C
#include "t6050-peripherals.dtsi"

/*
 * ==== The right USB-C port (ATC2) ====
 *
 * ADT /arm-io/nub-spmi-a1/hpm2 (SN201202x, SPMI address 0xc, port-number 3, port-location
 * "right", acio-parent acio2), atc-phy2, usb-drd2 and dart-usb2. The HPM is on its own bus,
 * nub-spmi-a1, and nothing hands the port off, so the chain is enabled outright. Aura's
 * kboot_setup_atc() fills the PHY's tunables through the atcphy2 alias.
 */
/ {
	aliases {
		atcphy2 = &atc2_phy;
	};
};

&ps_atc2_common {
	status = "okay";
};

&ps_atc2_usb_aon {
	status = "okay";
};

&ps_atc2_phymxwrap {
	status = "okay";
};

&ps_atc2_usb {
	status = "okay";
};

&atc2_phy_mbox {
	status = "okay";
};

&atc2_phy {
	status = "okay";

	port {
		atc2_phy_ep: endpoint {
			remote-endpoint = <&hpm2_ss>;
		};
	};
};

&usb_drd2 {
	status = "okay";

	port {
		usb_drd2_hs: endpoint {
			remote-endpoint = <&hpm2_hs>;
		};
	};
};

&usb_drd2_dart_0 {
	status = "okay";
};

&usb_drd2_dart_1 {
	status = "okay";
};

/*
 * dcpext0's Type-C route stays off with dcpext0: a mode-switch endpoint whose mux is never
 * registered would defer the PD controller forever.
 */
&dcpext0 {
	typec-routes {
		route@0 {
			status = "disabled";

			port {
				dcpext0_typec: endpoint {
					remote-endpoint = <&hpm2_dp>;
				};
			};
		};
	};
};

&nub_spmi_a1 {
	hpm2: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C Right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					hpm2_hs: endpoint {
						remote-endpoint = <&usb_drd2_hs>;
					};
				};

				port@1 {
					reg = <1>;
					hpm2_ss: endpoint {
						remote-endpoint = <&atc2_phy_ep>;
					};
				};

				port@2 {
					reg = <2>;
					hpm2_dp: endpoint {
						remote-endpoint = <&dcpext0_typec>;
					};
				};
			};
		};
	};
};

/*
 * ==== The right USB-C port's USB4/Thunderbolt router (ATC2) ====
 *
 * Until the boot loader fills them, the router, NHI, PHY CIO and DART tunables and the host
 * DROM are this board's, from its ADT (the DROM's router UUID from an earlier boot).
 */
/* ATC2_CIO_AUSS's other parent; kept as the boot loader leaves it */
&ps_auss {
	status = "okay";
};

/* The CIO reconfig request, port 2 (clock gate CIO2_RECONFIG_V) */
&cio_reconfig0 {
	status = "okay";
};

/* The PHY's CIO80 RX_TOP tunables (ADT tunable_LN0/LN1_RX_TOP_CIO_DFLT); the other three are empty */
&atc2_phy {
	apple,tunable-lane0-rx-top-cio = <0x35c 0xe00 0x0>;
	apple,tunable-lane1-rx-top-cio = <0x35c 0xe00 0x0>;
};

/* Only the router's LSTX pin (81) of the AOP GPIO controller is exposed. */
&pinctrl_aop {
	gpio-reserved-ranges = <0 81>, <82 3>;
	status = "okay";
};

&hpm2 {
	connector {
		ports {
			port@3 {
				reg = <3>;
				hpm2_usb4: endpoint {
					remote-endpoint = <&acio2_tbt>;
				};
			};
		};
	};
};

&acio2 {
	apple,tunable-rc = <0x0 0xfff0 0x4020>,
			<0x2c 0x4 0x0>,
			<0x4004 0x1ff01ff 0x1000100>,
			<0x4008 0x801f 0x4>,
			<0x4010 0x7f 0x40>,
			<0x4014 0x801f 0x4>,
			<0x401c 0x7f 0x40>,
			<0x4024 0x801f 0x4>,
			<0x402c 0x7f 0x40>,
			<0x4030 0x801f 0x4>,
			<0x4038 0xffffffff 0x1010101>,
			<0x403c 0xffff 0x101>,
			<0x4040 0x1 0x1>,
			<0x4044 0xffffffff 0x1010101>,
			<0x4048 0x1 0x1>,
			<0x404c 0x801f 0x4>,
			<0x8004 0x70007 0x40004>,
			<0x8008 0x801f 0x4>,
			<0x8010 0x70007 0x40004>,
			<0x8018 0x801f 0x4>,
			<0x8020 0x70007 0x40004>,
			<0x8028 0x801f 0x4>,
			<0x8030 0x801f 0x4>,
			<0x8038 0x801f 0x4>,
			<0x8040 0x801f 0x4>,
			<0x8048 0x801f 0x4>,
			<0x8050 0x801f 0x4>,
			<0x8058 0x801f 0x4>,
			<0x8060 0x801f 0x4>;
	apple,tunable-pcie-adapter = <0x1008 0x6 0x6>;
	apple,tunable-router-ap-fw = <0x8 0xff2 0x482>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			acio2_tbt: endpoint {
				remote-endpoint = <&hpm2_usb4>;
			};
		};
	};
};

&acio2_dart {
	apple,tunable = <0x20c 0x80000121 0x80000121>,
		<0x220 0xf0f 0xf0f>,
		<0x224 0xffff 0x909>,
		<0x300 0x1f31 0x1>,
		<0x308 0x3ffffffc 0x10000000>,
		<0x310 0x3ffffffc 0x3ffffffc>,
		<0x800 0xf003f 0x10000>,
