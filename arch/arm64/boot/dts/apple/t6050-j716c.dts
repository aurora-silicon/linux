/*
 * MacBook Pro (16-inch, M5 Max, 2026)
 *
 * target-type: J716c
 *
 * The M5 Max is one T6050 die, die 0 (t6050-max.dtsi). This file enables
 * and configures what has been brought up on this board; the SoC's other
 * ports and buses stay disabled until each is described for it.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#define T6050_J716C
/* ADT /arm-io/acio2: the right port's USB4/Thunderbolt router */
#define T6050_ATC2_USB4_ROUTER
#include "t6050-max.dtsi"
#include "hwmon-fan-dual.dtsi"

/ {
	compatible = "apple,j716c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M5 Max, 2026)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};

	/* GPU aperture; its PMGR and coprocessors are described below. */
	j716c_gpu_bus: soc@2300000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0x23 0x0 0x23 0x0 0x0 0x4000000>;
		interrupt-parent = <&aic>;
		nonposted-mmio;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by the loader */
			/* Format properties will be added by the loader */
			/* Scanned out by the internal DCP, handed off or not. */
			display = <&dcp>;
			status = "disabled";
		};
	};
};

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth), the only GP port this board uses besides the SD
 * reader on port 1 (not yet described). The boot loader trains the link after the SMC releases
 * the N1's reset and keeps power, clocks, the PHY and PERST; Linux owns the routing, MSI and
 * the DART. Disabled with its DART until the boot loader trains it, which also renumbers the
 * bus here to the PCI core's order.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 4>;

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, driven only by the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		/* platform ID (board 0x0e << 16) | chip 0x6050 */
		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/j716c-ftab.bin";
			apple,centauri-platform-id = <0x000e6050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/* ATC1, ATC3 and the PD controller buses nub-spmi-a0 and -a2: not yet described for this board */
&nub_spmi_a0 {
	status = "disabled";
};

&nub_spmi_a2 {
	status = "disabled";
};

&atc1_phy_mbox {
	status = "disabled";
};

&atc1_phy {
	status = "disabled";
};

&usb_drd1 {
	status = "disabled";
};

&usb_drd1_dart_0 {
	status = "disabled";
};

&usb_drd1_dart_1 {
	status = "disabled";
};

&atc3_phy_mbox {
	status = "disabled";
};

&atc3_phy {
	status = "disabled";
};

&usb_drd3 {
	status = "disabled";
};

&usb_drd3_dart_0 {
	status = "disabled";
};

&usb_drd3_dart_1 {
	status = "disabled";
};

/*
 * Pin 112's register (0x29c0001c0) takes an SError when read, so only the pins a node
 * here names are exposed: 80 (PCIe port 0's PERST#, ADT pci-bridge0 function-perst),
 * 106 and 107 (the speaker amps' fault interrupt and shutdown line), 134 and 139 (the
 * jack codec's interrupt and reset), 136 and 137 (speaker ID) and 138 (the Touch ID
 * sensor's data-ready line).
 * A reserved line cannot be requested, so a node that names a new pin opens it here too.
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 1>, <140 81>;
};

/*
 * Inherit apple,discover-temperatures and apple,soc-die-keys ("TCMb") from
 * t6050-die0.dtsi so all readable T* float sensors are discovered and TCMb
 * supplies the macsmc_soc_die thermal zone for the GPU thermal governor.
 * T6050 spells the fan mode keys F0md/F1md and accepts manual fan targets.
 */
&smc_hwmon {
	status = "okay";

	fan-F0Ac {
		apple,fan-mode = "F0md";
		apple,fan-manual-control;
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
		apple,fan-manual-control;
	};
};

/*
 * The console is on the USB debug link, which drains only while a host reads
 * it; the machine also boots with nothing attached there.
 */
&dockchannel {
	apple,tx-never-wait;
	status = "okay";
};

/* The MTP and its DockChannel FIFO, which carry the keyboard and trackpad */
&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp {
	status = "okay";
};

/* The keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO */
&mtp_dockchannel {
	status = "okay";

	mtp_hid: input@8000 {
		compatible = "apple,dockchannel-hid";
		reg = <0x8000 0x1000>, <0xc000 0x1000>,
		      <0x0 0x1000>, <0x4000 0x1000>;
		reg-names = "config", "data", "rmt-config", "rmt-data";
		iommus = <&mtp_dart 0>;
		interrupt-parent = <&mtp_dockchannel>;
		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
			     <3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "tx", "rx";
		apple,fifo-size = <0x800>;
		apple,helper-cpu = <&mtp>;
		apple,afe-reset-gpios = <&smc_pcio 2 GPIO_ACTIVE_HIGH>;

		multi-touch {
			apple,power-method = <2>;
			firmware-name = "apple/tpmtfw-j716c.bin";
		};

		keyboard {
		};

		stm {
		};
	};
};

/* This board's PCIO outputs, the trackpad AFE reset (2) among them */
&smc_pcio {
	apple,output-commands = /bits/ 64 <0x001a000000000000 0x000f000000800000 0x011c000000010000>;
};

#include "t6050-peripherals.dtsi"

#include "t6050-max-atc2.dtsi"

/* This unit's host DROM (router UUID from an earlier boot) */
&acio2_nhi {
	apple,thunderbolt-drom = [ff 92 e6 6e ee 18 7c ac 05 90 19 c3 8c 00 5c 00
			00 00 00 00 00 00 08 81 82 02 82 00 00 00 08 82
			92 01 82 00 00 00 03 83 20 08 84 00 00 00 00 00
			00 08 85 00 00 00 00 00 00 05 86 09 01 00 08 87
			00 00 00 00 00 00 05 88 09 01 00 05 89 09 01 00
			05 8a 09 01 00 0e 01 41 70 70 6c 65 2c 20 49 6e
			63 2e 00 06 02 69 4f 53 00 00 00 00];
};

/*
 * Touch ID (ADT spi2/mesa), wired as on the J714s: the Mesa sensor (sensor-id
 * 0x3356) at 8 MHz on chip select 0, powered by NUB GPIO 21 (function-mesa_pwr),
 * data ready on AP GPIO 138. The controller's clock (ADT clock-ids 451) is the
 * 24 MHz reference.
 */
&ps_nub_gpio {
	status = "okay";
};

&nub_gpio0 {
	status = "okay";
};

&ps_spi2 {
	status = "okay";
};

&spi2 {
	clocks = <&clkref>;
	status = "okay";

	mesa: fingerprint@0 {
		compatible = "apple,mesa-fingerprint";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;
		enable-gpios = <&nub_gpio0 21 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <138 IRQ_TYPE_EDGE_RISING>;
		/* Per-device factory data from this Mac's own iBoot system container */
		firmware-name = "apple/mesacal-j716c.bin", "apple/msrk-j716c.bin";
	};
};

#include "t6050-j716c-isp.dtsi"
#include "t6050-j716c-gpu-panel.dtsi"

#include "t6050-j716c-display.dtsi"
#include "t6050-j716c-left-usb4.dtsi"
#include "t6050-j716c-sep.dtsi"

#include "t6050-j716c-sleep.dtsi"
#include "t6050-j716c-sleep-full.dtsi"

/*
 * The Neural Engine, started only after the boot loader's preload hand-off.
 * ANE_SYS sits behind FAB8_SOC (kept on for the SEP above) and FAB9_SOC (on for
 * the camera).
 */
#include "t6050-j714s-ane.dtsi"

/* The port controllers follow the sleep's command rules (tipd: woken first, read at intervals) */
&hpm0 {
	apple,sleep-ssps-rules;
};

&hpm1 {
	apple,sleep-ssps-rules;
};

&hpm2 {
	apple,sleep-ssps-rules;
};

&hpm5 {
	apple,sleep-ssps-rules;
};

/*
 * The PMP (ADT pmp0): iBoot loads its firmware and the boot loader fills
 * apple,board-id, apple,dram-vendor-id, apple,pmc, apple,pmc-pmgr, and
 * apple,tunable-* from the running machine's ADT onto pmp0. The AOP's audio
 * firmware requires the PMP to bring up its LEAP power domains so the audio
 * controller reaches systemReady.
 */
&ps_pms {
	status = "okay";
};

&ps_pmp {
	status = "okay";
};

&ps_pms_sram {
	status = "okay";
};

&pmp0_dart {
	status = "okay";
};

&pmp0_mbox {
	status = "okay";
};

&pmp0 {
	status = "okay";
};

&pmp0_report {
	status = "okay";
};

&pmc {
	/* PMP, CLPC and AP agents, once the PMP runs */
	apple,static-voters = <0 1 3>;
	apple,pmp = <&pmp0>;
};

/*
 * Sound through the AOP, as on J714s: its audio service runs the serializers, the
 * CS42L84 headphone jack on admac-base-ns TX2/RX2 and the six SN012776 speaker amps
 * on TX0, their voltage and current sense on RX0 (ADT iop-audio-controller).
 *
 * The amps (ADT /arm-io/i2c1/audio-speaker* and /arm-io/i2c3/audio-speaker*) share
 * one shutdown line, AP pin 107 (function-reset of the first), and one fault
 * interrupt, pin 106. The ADT's speaker-config gives amp N playback slot N, its
 * voltage sense in slot 4N and current sense in 4N+2, in the order of the first
 * amp's speakerN: left woofer 1, right woofer 1, left woofer 2, right woofer 2,
 * left tweeter, right tweeter. The firmware's speaker frame is 250 BCLKs of 12 MHz
 * (ADT audio-speaker stream), which the amps' ratio detection rejects.
 */
/ {
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <2>;
		ti,vmon-slot-no = <0>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <10>;
		ti,vmon-slot-no = <8>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <18>;
		ti,vmon-slot-no = <16>;
		ti,bclk-ratio = <250>;
	};
};

/* The I2C power states have no described parent (SIO), as for i2c1 and i2c2 */
&ps_i2c3 {
	/delete-property/ power-domains;
	status = "okay";
};

&i2c3 {
	/* The ADT gives i2c1, i2c2 and i2c3 the same clock-ids (4) */
	clocks = <&clkref>;
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <6>;
		ti,vmon-slot-no = <4>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <14>;
		ti,vmon-slot-no = <12>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <22>;
		ti,vmon-slot-no = <20>;
		ti,bclk-ratio = <250>;
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c2/audio-codec-output): its reset line
 * is AP pin 139, driven high to run the codec, and its interrupt AP pin 134, level
 * low.
 */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Jack";
	};
};

/ {
	sound {
		compatible = "apple,j716-macaudio", "apple,macaudio";
		model = "MacBook Pro J716";
		/* ADT audio-speaker function-speaker-id0 and -id1 */
		speaker-id-gpios = <&pinctrl_ap 136 GPIO_ACTIVE_HIGH>,
				   <&pinctrl_ap 137 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";
			/*
			 * Codecs in ADT speaker-config order so macaudio assigns
			 * playback slots 0-5 (left channels in slots 0, 2 and 4,
			 * right in 1, 3 and 5). Each side's first amp drives zeros
			 * on the opposite side's active sense byte slots (0..23)
			 * and both include the unused upper bytes (24..31) of the
			 * 32-byte TDM frame: left woofer 1 drives zeros on right
			 * slots 4..7, 12..15, 20..23 and upper bytes 24..31
			 * (0xfff0f0f0); right woofer 1 drives zeros on left slots
			 * 0..3, 8..11, 16..19 and upper bytes 24..31 (0xff0f0f0f).
			 * Active V/I slots 0..23 remain disjoint even without a
			 * loader apple,amp-tx-zd-config override.
			 */
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xfff0f0f0>;
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-1 = <0xff0f0f0f>;

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_right_woof1>,
					    <&speaker_left_woof2>, <&speaker_right_woof2>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};
};

/* The AOP, booted through its setup port, with its sensor and audio services. */
&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop {
	status = "okay";
};

/*
 * The microphone array: ADT audio-hp-mic, three microphones on leap-s RX0 through the
 * proxy ADMAC (Linux channel 1, as on J714s), captured by the AOP audio service's own card.
 */
&admac_base_ns {
	status = "okay";
};

&admac_ec_proxy {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J716";
	apple,machine-kind = "MacBook Pro";
	dmas = <&admac_base_ns 4>, <&admac_base_ns 5>,
	       <&admac_base_ns 0>, <&admac_base_ns 1>,
	       <&admac_ec_proxy 1>;
	dma-names = "cout", "cin", "spkr", "sense", "hpai";
};
