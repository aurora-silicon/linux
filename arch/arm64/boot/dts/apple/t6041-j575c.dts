/*
 * Three of the four back Thunderbolt ports, with the J773s's PD controllers
 * (nub-spmi-a0 0xc, 0xa and 0x8 for ATC0-2), as on the J616c.
 * t6041-j575c-atc3.dtsi adds the fourth (hpm3 at 0x6, ATC3), and
 * t6041-j575c-usb3.dtsi USB3 on all four.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 1";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";
		/* Retimer set up before Linux keeps SuperSpeed down until replugged. */
		apple,reset-inherited-usb2-connection;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 2";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};
			};
		};
	};

	hpm2: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <65 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";
		/* Retimer set up before Linux keeps SuperSpeed down until replugged. */
		apple,reset-inherited-usb2-connection;

		typec2: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 3";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec2_connector_hs: endpoint {
						remote-endpoint = <&dwc3_2_hs>;
					};
				};
			};
		};
	};
};

&atcphy0 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	maximum-speed = "high-speed";
	phys = <&atcphy0 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	maximum-speed = "high-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

&atcphy2 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	maximum-speed = "high-speed";
	phys = <&atcphy2 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_2_hs: endpoint {
				remote-endpoint = <&typec2_connector_hs>;
			};
		};
	};
};

/* The boot loader fills opp-hz and opp-microvolt from the ADT perf-states */
/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpu_uat_ttbs: uat-ttbs {
			no-map;
			status = "disabled";
		};

		gpu_uat_pagetables: uat-pagetables {
			no-map;
			status = "disabled";
		};

		gpu_uat_l2_pagetables: uat-l2-pagetables {
			no-map;
			status = "disabled";
		};

		gpu_uat_handoff: uat-handoff {
			no-map;
			status = "disabled";
		};

		gpu_fw_text: gpu-fw-text {
			no-map;
			status = "disabled";
		};

		gpu_fw_data: gpu-fw-data {
			no-map;
			status = "disabled";
		};
	};

	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <125000 125000 125000 125000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <600000 600000 600000 600000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <665000 665000 660000 660000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <705000 705000 700000 705000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <924000000>;
			opp-microvolt = <725000 725000 715000 730000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <952000000>;
			opp-microvolt = <770000 770000 770000 780000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1056000000>;
			opp-microvolt = <770000 770000 770000 780000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1062000000>;
			opp-microvolt = <810000 810000 805000 810000>;
		};

		opp08 {
			opp-hz = /bits/ 64 <1182000000>;
			opp-microvolt = <810000 810000 805000 810000>;
		};

		opp09 {
			opp-hz = /bits/ 64 <1182000000>;
			opp-microvolt = <860000 860000 860000 860000>;
		};

		opp10 {
			opp-hz = /bits/ 64 <1312000000>;
			opp-microvolt = <860000 860000 860000 860000>;
		};

		opp11 {
			opp-hz = /bits/ 64 <1242000000>;
			opp-microvolt = <900000 895000 900000 900000>;
		};

		opp12 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <900000 895000 900000 900000>;
		};

		opp13 {
			opp-hz = /bits/ 64 <1326000000>;
			opp-microvolt = <940000 925000 940000 940000>;
		};

		opp14 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <940000 925000 940000 940000>;
		};

		opp15 {
			opp-hz = /bits/ 64 <1578000000>;
			opp-microvolt = <1020000 1020000 1020000 1020000>;
		};
	};

	gpu_cs_opp: opp-table-gpucs {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <24000000>;
			opp-microvolt = <585000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <585000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <635000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <685000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <992000000>;
			opp-microvolt = <720000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <1188000000>;
			opp-microvolt = <770000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <855000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <885000>;
		};
	};

	gpu_afr_opp: opp-table-gpuafr {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <24000000>;
			opp-microvolt = <585000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <585000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <635000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <685000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <992000000>;
			opp-microvolt = <720000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <1188000000>;
			opp-microvolt = <770000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <855000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <885000>;
		};
	};
};

&gpu {
		memory-region = <&gpu_uat_ttbs>, <&gpu_uat_pagetables>,
				<&gpu_uat_handoff>, <&gpu_fw_data>,
				<&gpu_uat_l2_pagetables>, <&gpu_fw_text>;
		memory-region-names = "ttbs", "pagetables", "handoff", "fw-data",
				      "l2-pagetables", "fw-text";
		operating-points-v2 = <&gpu_opp>;
		apple,cs-opp = <&gpu_cs_opp>;
		apple,afr-opp = <&gpu_afr_opp>;
		apple,firmware-version = <26 5 2>;
};

/ {
	/* ADT audio-speaker function-reset: AP pin 54 (0x36) */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl 54 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The speaker: the AOP audio component's speaker back-end (DAI 3) to
	 * the SN012776. The card holds the amp at its lowest volume step until
	 * a protection daemon takes the volume lock.
	 */
	sound: sound {
		compatible = "apple,j575c-macaudio", "apple,macaudio";
		model = "Mac Studio J575";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker>;
			};
		};
	};

	sound_jack: sound-jack {
		compatible = "apple,j575c-macaudio-jack", "apple,macaudio";
		model = "Mac Studio J575 Jack";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 4>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

&aop {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&admac0 {
	status = "okay";
};

&admac1 {
	status = "okay";
};

/*
 * No microphones. ADT iop-audio-controller: the speaker stream on base-ns
 * ADMAC channel 0 (TX0), the jack's on channels 4 and 5. The firmware runs
 * the speaker serializer in the J616s frame, sense included, on RX0.
 */
&aop_audio {
	dmas = <&admac1 0>, <&admac1 1>, <&admac1 4>, <&admac1 5>;
	dma-names = "spkr", "sense", "cout", "cin";
	apple,chassis-name = "J575";
	apple,machine-kind = "Mac Studio";
};

/* ADT /arm-io/i2c1/audio-speaker: one SN012776 at 0x38, interrupt AP 55 */
&i2c1 {
	status = "okay";

	speaker: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl 55 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};
};

/* ADT i2c2/audio-codec-output: CS42L84 at 0x4b, reset nub pin 58, IRQ 106 */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 58 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl 106 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&aop {
	nonposted-mmio;
};

/* No ambient light sensor and no lid. */
&aop_als {
	status = "disabled";
};

&aop_las {
	status = "disabled";
};

&admac1 {
	dma-channels = <26>;
	nonposted-mmio;
};

&admac0 {
	nonposted-mmio;
};

&aop_dart {
	nonposted-mmio;
};

&i2c1 {
	nonposted-mmio;
};

&i2c2 {
	nonposted-mmio;
};

/ {
	reserved-memory {
		aop_mmio_pmgr: aop-mmio-pmgr@508304000 {
			reg = <0x5 0x08304000 0x0 0x4000>;
			iommu-addresses = <&aop 0x5 0x08304000 0x0 0x4000>;
			no-map;
		};
	};
};

&aop {
	memory-region = <&aop_mmio_pmgr>;
};

/*
 * iBoot leaves the external display processors running with their firmware
 * loaded. There is no panel, so the boot loader never hands the internal DCP
 * over: it hands over each external processor's firmware memory on its own
 * and then enables the display subsystem (found through the disp0 alias; dcp
 * has to be there too), and the display gate enables the chains that have
 * firmware memory.
 */
&display {
	phandle = <&display>;
};

&disp0_piodma {
	phandle = <&disp0_piodma>;
};

#include "t604x-extdisp.dtsi"

/*
 * Only typec1 carries an external display chain here. ATC3 is the fourth
 * back Type-C port, not the J616c's HDMI PHY: drop that description, and
 * t6041-j575c-atc3.dtsi describes the port instead.
 */
/delete-node/ &atcphy0_xbar;
/delete-node/ &atcphy2_xbar;
/delete-node/ &atcphy3_xbar;
/delete-node/ &atcphy3;
/delete-node/ &atcphy3_mbox;

#include "t6041-j575c-atc3.dtsi"
#include "t6041-j575c-usb3.dtsi"
#include "t6041-j575c-usbc.dtsi"
#include "t6041-j575c-hdmi.dtsi"

/* Not described: the SEP (no Touch ID sensor). */

/*
 * The PMP, as the M4 Max MacBook Pros run it. The pmp alias lets the loader
 * copy this Mac's PMP values from the ADT and enable the PMP. The GPU sits on
 * the PMP's GPU domain: a running PMP otherwise treats the GPU as off and
 * holds it at its lowest state.
 */
&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&pmc {
	apple,pmp = <&pmp>;
	status = "okay";
};

&gpu {
	power-domains = <&pmp_gfx>;
};
