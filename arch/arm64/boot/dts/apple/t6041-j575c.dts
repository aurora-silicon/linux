// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Mac Studio (M4 Max, 2025)
 *
 * target-type: J575c
 *
 * The J616c's T6041 wiring with the desktop layout of the J773s and the
 * other Mac Studio trees, checked against the J575c ADT (macOS 27.0.1,
 * 26A434). Comments name the ADT node a value comes from.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6041.dtsi"
#include "t6041-j614-j616-j575-scaler.dtsi"
#include "t604x-j575-j773.dtsi"
#include "t6041-j616c-ane.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j575c", "apple,t6041", "apple,arm-platform";
	model = "Apple Mac Studio (M4 Max, 2025)";

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
		wifi0 = "/pcie@1cb0000000/pci@0,0/wifi@0,0";
		bluetooth0 = "/pcie@1cb0000000/pci@0,0/bluetooth@0,1";
		ethernet0 = &ethernet0;
		gpu = &gpu;
		pmp = &pmp;
		aop = &aop;
		dcp = &dcp;
		disp0 = &display;
		disp0-piodma = &disp0_piodma;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	serial0: serial@429200000 {
		compatible = "apple,s5l-uart";
		reg = <0x4 0x29200000 0x0 0x1000>;
		reg-io-width = <4>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1559 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkref>, <&clkref>;
		clock-names = "uart", "clk_uart_baud0";
	};

	/*
	 * DockChannel channel 1, the console the USB debug link carries
	 * (macvdmtool debugusb). ADT /arm-io/dockchannel-uart: block at
	 * 0x5_0882_8000 with one 0x10000 stride per channel, interrupt window
	 * 0x5_0880_c000 (0x18), IRQ 360, enable-sw-drain. Nothing drains it
	 * unless a host reads the link, so TX must never wait.
	 */
	dockchannel: serial@50883c000 {
		compatible = "apple,dockchannel-uart";
		reg = <0x5 0x0883c000 0x0 0x4000>,
		      <0x5 0x08838000 0x0 0x4000>,
		      <0x5 0x0880c000 0x0 0x18>;
		reg-names = "data", "config", "irq";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 360 IRQ_TYPE_LEVEL_HIGH>;
		apple,channel = <1>;
		apple,sw-drain;
		apple,tx-never-wait;
	};

	/*
	 * The M4 Max MacBook Pros' CPU zones (t6041-j614c-j616c.dtsi): the same
	 * T6041, the same SMC sensor keys in the same order, the same ADT die
	 * limits. The PMP fast die loop runs in front of them, as there.
	 */
	thermal-zones {
		/*
		 * The PMP's fast die-temperature loop (apple,fast-die-effort)
		 * holds its hot-spot sensors at the ADT fast-die-ctrl-loop target
		 * of 110 C, as on macOS, and these zones are the backstop behind
		 * it. The ADT (temp-sensor) gives the J614c and J616c the M4
		 * Pro's die limits: 110 C target, 125 C maximum (sochot).
		 *
		 * - The SMC sensors read a few degrees above the PMP's: with the
		 *   PMP alone, an all-core load holds TCMz at 112 C. The zones
		 *   switch on at 112 C and control at 116 C, so the PMP keeps the
		 *   fast control. Switched on from 75 C, the power allocator
		 *   trimmed far below its control point and took over: it held
		 *   the E cluster at 1.02 GHz, which the PMP leaves at 2.59 GHz.
		 * - A zone per SMC core-die sensor throttles only the cluster its
		 *   sensor sits on: Tpx0-5 follow a load on P0, Tpx8-D one on P1,
		 *   Tex0-3 the E cluster. The die zone on TCMz, their maximum,
		 *   throttles all three. The 1 s samples jump by about 10 C, so
		 *   the zones are integral-led.
		 * - The SMC fans follow a power-weighted hot spot (dDT*), not
		 *   TCMz, and ramp once the CPU runs near 110 C at high power, as
		 *   on macOS.
		 * - sustainable-power is what macOS sustained on a J614c under an
		 *   all-core FMA load: 48-51 W, TCMz 105-110 C. The P clusters
		 *   share one rail meter (PHPC), which reads 25 W with either
		 *   cluster loaded alone, and the E cluster adds about 2 W: 24 W
		 *   per P cluster and 2 W for E.
		 * - Hot at 120 C only reports; critical is the sochot level, after
		 *   three samples.
		 */
		cpu-die-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <48000>;
			thermal-sensors = <&smc_hwmon 0>;	/* TCMz */

			trips {
				cpu_die_switch_on: cpu-die-switch-on {
					temperature = <112000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_die_passive: cpu-die-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu-die-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				cpu-die-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p05 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e0-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <2000>;
			thermal-sensors = <&smc_hwmon 14>;	/* Tex0 */

			trips {
