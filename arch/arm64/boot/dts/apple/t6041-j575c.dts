						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p11-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <24000>;
			thermal-sensors = <&smc_hwmon 9>;	/* Tpx9 */

			trips {
				cpu_p11_switch_on: trip-switch-on {
					temperature = <112000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p11_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p1 {
					trip = <&cpu_p11_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p12-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <24000>;
			thermal-sensors = <&smc_hwmon 10>;	/* TpxA */

			trips {
				cpu_p12_switch_on: trip-switch-on {
					temperature = <112000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p12_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p1 {
					trip = <&cpu_p12_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p13-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <24000>;
			thermal-sensors = <&smc_hwmon 11>;	/* TpxB */

			trips {
				cpu_p13_switch_on: trip-switch-on {
					temperature = <112000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p13_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p1 {
					trip = <&cpu_p13_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p14-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <24000>;
			thermal-sensors = <&smc_hwmon 12>;	/* TpxC */

			trips {
				cpu_p14_switch_on: trip-switch-on {
					temperature = <112000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p14_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p1 {
					trip = <&cpu_p14_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p15-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			sustainable-power = <24000>;
			thermal-sensors = <&smc_hwmon 13>;	/* TpxD */

			trips {
