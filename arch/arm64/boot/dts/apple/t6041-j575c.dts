// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Mac Studio (M4 Max, 2025)
 *
 * target-type: J575c
 *
 * The J616c's T6041 wiring with the desktop layout of the J773s and the
 * other Mac Studio trees. There is no J575c ADT yet: values marked "guess"
 * follow those boards.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6041.dtsi"
#include "t6041-j614-j616-j575-scaler.dtsi"
#include "t604x-j575-j773.dtsi"
#include "t6041-j616c-ane.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j575c", "apple,t6041", "apple,arm-platform";
	model = "Apple Mac Studio (M4 Max, 2025)";

	aliases {
		serial0 = &serial0;
		wifi0 = "/pcie@1cb0000000/pci@0,0/wifi@0,0";
		bluetooth0 = "/pcie@1cb0000000/pci@0,0/bluetooth@0,1";
		ethernet0 = &ethernet0;
		gpu = &gpu;
		aop = &aop;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	serial0: serial@429200000 {
		compatible = "apple,s5l-uart";
		reg = <0x4 0x29200000 0x0 0x1000>;
		reg-io-width = <4>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1559 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkref>, <&clkref>;
		clock-names = "uart", "clk_uart_baud0";
	};

	/* guess: the J616c's limits */
	thermal-zones {
		cpu-die-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			thermal-sensors = <&smc_hwmon 0>;

			trips {
				cpu_die_passive: cpu-die-passive {
					temperature = <113000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu-die-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p05 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

&cpufreq_e {
	/delete-property/ apple,fast-die-effort;
};

&cpufreq_p0 {
	/delete-property/ apple,fast-die-effort;
};

&cpufreq_p1 {
	/delete-property/ apple,fast-die-effort;
};

&cpuidle {
	status = "okay";
};

&wdt {
	timeout-sec = <140>;
};

&smc {
	status = "okay";
};

&smc_mbox {
	status = "okay";
};

&nub_spmi0 {
	status = "okay";
};

&mcc {
	status = "okay";
};

/* guess: the J616c's CPU keys, and two fans as on the J575d */
&smc_hwmon {
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Die Max";
	};

	temperature-TCMb {
		apple,key-id = "TCMb";
		label = "CPU TCMb";
	};

	temperature-Tpx0 {
		apple,key-id = "Tpx0";
		label = "CPU Tpx0";
	};

	temperature-Tpx1 {
		apple,key-id = "Tpx1";
		label = "CPU Tpx1";
	};

	temperature-Tpx2 {
		apple,key-id = "Tpx2";
		label = "CPU Tpx2";
	};

	temperature-Tpx3 {
		apple,key-id = "Tpx3";
		label = "CPU Tpx3";
	};

	temperature-Tpx4 {
		apple,key-id = "Tpx4";
		label = "CPU Tpx4";
	};

	temperature-Tpx5 {
		apple,key-id = "Tpx5";
		label = "CPU Tpx5";
	};

	temperature-Tpx8 {
		apple,key-id = "Tpx8";
		label = "CPU Tpx8";
	};

	temperature-Tpx9 {
		apple,key-id = "Tpx9";
		label = "CPU Tpx9";
	};

	temperature-TpxA {
		apple,key-id = "TpxA";
		label = "CPU TpxA";
	};

	temperature-TpxB {
		apple,key-id = "TpxB";
		label = "CPU TpxB";
	};

	temperature-TpxC {
		apple,key-id = "TpxC";
		label = "CPU TpxC";
	};

	temperature-TpxD {
		apple,key-id = "TpxD";
		label = "CPU TpxD";
	};

	temperature-Tex0 {
		apple,key-id = "Tex0";
		label = "CPU Tex0";
	};

	temperature-Tex1 {
		apple,key-id = "Tex1";
		label = "CPU Tex1";
	};

	temperature-Tex2 {
		apple,key-id = "Tex2";
		label = "CPU Tex2";
	};

	temperature-Tex3 {
		apple,key-id = "Tex3";
		label = "CPU Tex3";
	};

	temperature-TW0P {
		apple,key-id = "TW0P";
		label = "WiFi/BT Module Temp";
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"

&pinctrl {
	status = "okay";

	wifi_clkreq_pins: wifi-clkreq-pins {
		pinmux = <APPLE_PINMUX(0, 1)>;
	};

	/* guess: port N's CLKREQ is AP pin N, as on the J616c and J773s */
	sd_clkreq_pins: sd-clkreq-pins {
		pinmux = <APPLE_PINMUX(1, 1)>;
	};

	eth_clkreq_pins: eth-clkreq-pins {
		pinmux = <APPLE_PINMUX(2, 1)>;
	};

	xhci_clkreq_pins: xhci-clkreq-pins {
		pinmux = <APPLE_PINMUX(3, 1)>;
	};
};

&pinctrl_nub {
	status = "okay";
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupts;
};

&pcie_dart {
	status = "okay";
};

&apcie2_dart {
	status = "okay";
};

/ {
	/* The DART of port 1, the SD reader (J616c ADT dart-apcie1). */
	apcie1_dart: iommu@411000000 {
		compatible = "apple,t6041-dart", "apple,t8110-dart";
		reg = <0x4 0x11000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1733 IRQ_TYPE_LEVEL_HIGH>;
	};

	/* guess: the DART of port 3, after those of ports 0 to 2 */
	apcie3_dart: iommu@413000000 {
		compatible = "apple,t6041-dart", "apple,t8110-dart";
		reg = <0x4 0x13000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1751 IRQ_TYPE_LEVEL_HIGH>;
	};

	/*
	 * The Mac Studio layout of the J575d: Wi-Fi and Bluetooth on port 0,
	 * the SD reader on port 1, Ethernet on port 2 and the xHCI of the
	 * USB-A and front USB-C ports on port 3. The boot loader finds the
	 * Wi-Fi, Bluetooth and Ethernet nodes through the aliases.
	 */
	pcie0: pcie@1cb0000000 {
		compatible = "apple,t6041-pcie", "apple,t6020-pcie";
		reg = <0x1c 0xb0000000 0x0 0x1000000>,
		      <0x4 0x14000000 0x0 0x4000>,
		      <0x4 0x10028000 0x0 0x4000>,
		      <0x4 0x11028000 0x0 0x4000>,
		      <0x4 0x12028000 0x0 0x4000>,
		      <0x4 0x13028000 0x0 0x4000>,
		      <0x4 0x17020000 0x0 0x4000>,
		      <0x4 0x17024000 0x0 0x4000>,
		      <0x4 0x17028000 0x0 0x4000>,
		      <0x4 0x1702c000 0x0 0x4000>;
		reg-names = "config", "rc",
			    "port0", "port1", "port2", "port3",
			    "phy0", "phy1", "phy2", "phy3";
		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>,
			 <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_clkreq_pins &sd_clkreq_pins &eth_clkreq_pins &xhci_clkreq_pins>;
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 4>;
		iommu-map-mask = <0xffff>;
		iommu-map = <0x100 &pcie_dart 1 2>, <0x200 &apcie1_dart 1 1>,
			    <0x300 &apcie2_dart 1 1>, <0x400 &apcie3_dart 1 1>;
		msi-ranges = <&aic AIC_IRQ 2071 IRQ_TYPE_EDGE_RISING 32>;
		msi-parent = <&pcie0>;
		msi-controller;
		/* indexed by port, as in the J773s ADT */
		interrupts = <AIC_IRQ 1723 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1732 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1741 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1750 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-parent = <&aic>;
		device_type = "pci";

		port00: pci@0,0 {
			reg = <0 0 0 0 0>;
			ranges;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
					<0 0 0 2 &port00 0 0 0 1>,
					<0 0 0 3 &port00 0 0 0 2>,
					<0 0 0 4 &port00 0 0 0 3>;
			interrupt-map-mask = <0 0 0 7>;
			#interrupt-cells = <1>;
			interrupt-controller;
			#address-cells = <3>;
			#size-cells = <2>;
			pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			device_type = "pci";

			bluetooth@0,1 {
				compatible = "pci14e4,5f72";
				reg = <0x100 0 0 0 0>;
				local-bd-address = [00 00 00 00 00 00];
				/* guess: the J575d's Wi-Fi island */
				brcm,board-type = "apple,aruba";
				status = "okay";
			};

			wifi@0,0 {
				compatible = "pci14e4,4434", "brcm,bcm4329-fmac";
				reg = <0 0 0 0 0>;
				brcm,ccode-map-trivial;
				brcm,board-type = "apple,aruba";
			};
		};

		/* guess: the J616c's GL9755 reader, its power and reset */
		port01: pci@1,0 {
			device_type = "pci";
			reg = <0x800 0 0 0 0>;
			reset-gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			bus-range = <2 2>;
			pwren-gpios = <&smc_gpio 0x19 GPIO_ACTIVE_HIGH>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
					<0 0 0 2 &port01 0 0 0 1>,
					<0 0 0 3 &port01 0 0 0 2>,
					<0 0 0 4 &port01 0 0 0 3>;

			mmc@0,0 {
				compatible = "pci17a0,9755";
				reg = <0x20000 0 0 0 0>;
				cd-inverted;
				wp-inverted;
			};
		};

		/* guess: the J773s's Ethernet port */
		port02: pci@2,0 {
			device_type = "pci";
			reg = <0x1000 0 0 0 0>;
			reset-gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
			bus-range = <3 3>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port02 0 0 0 0>,
					<0 0 0 2 &port02 0 0 0 1>,
					<0 0 0 3 &port02 0 0 0 2>,
					<0 0 0 4 &port02 0 0 0 3>;

			ethernet0: ethernet@0,0 {
				reg = <0x30000 0x0 0x0 0x0 0x0>;
				/* To be filled by the loader */
				local-mac-address = [00 10 18 00 00 00];
			};
		};

		/* guess: PERST is AP pin 7, by the other ports; no power switch */
		port03: pci@3,0 {
			device_type = "pci";
			reg = <0x1800 0 0 0 0>;
			reset-gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			bus-range = <4 4>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port03 0 0 0 0>,
					<0 0 0 2 &port03 0 0 0 1>,
					<0 0 0 3 &port03 0 0 0 2>,
					<0 0 0 4 &port03 0 0 0 3>;
		};
	};
};

&ans_mbox {
	status = "okay";
};

&ans_sart {
	status = "okay";
};

&nvme {
	status = "okay";
};

/*
 * guess: three of the four back Thunderbolt ports, with the J773s's PD
 * controllers (nub-spmi-a0 0xc, 0xa and 0x8 for ATC0-2), at USB2 high speed
 * as on the J616c. The fourth port (ATC3) is not described.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 1";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 2";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};
			};
		};
	};

	hpm2: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <65 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec2: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back 3";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec2_connector_hs: endpoint {
						remote-endpoint = <&dwc3_2_hs>;
					};
				};
			};
		};
	};
};

&atcphy0 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	maximum-speed = "high-speed";
	phys = <&atcphy0 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	maximum-speed = "high-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

&atcphy2 {
	apple,tunable-usb2-host = <0x8 0x7003 0x3>;
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	maximum-speed = "high-speed";
	phys = <&atcphy2 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
		<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
		<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
		<0x52c 0xff0000ff 0x08000008>, <0x538 0x00000800 0x00000800>,
		<0x580 0xffffffff 0x6f000006>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_2_hs: endpoint {
				remote-endpoint = <&typec2_connector_hs>;
			};
		};
	};
};

/* guess: the J616c's operating points, binned per device */
/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpu_uat_ttbs: uat-ttbs {
			no-map;
			status = "disabled";
		};

		gpu_uat_pagetables: uat-pagetables {
			no-map;
			status = "disabled";
		};

		gpu_uat_l2_pagetables: uat-l2-pagetables {
			no-map;
			status = "disabled";
		};

		gpu_uat_handoff: uat-handoff {
			no-map;
			status = "disabled";
		};

		gpu_fw_text: gpu-fw-text {
			no-map;
			status = "disabled";
		};

		gpu_fw_data: gpu-fw-data {
			no-map;
			status = "disabled";
		};
	};

	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <125000 125000 125000 125000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <600000 600000 600000 600000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <665000 665000 660000 660000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <705000 705000 700000 705000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <924000000>;
			opp-microvolt = <725000 725000 715000 730000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <952000000>;
			opp-microvolt = <770000 770000 770000 780000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1056000000>;
			opp-microvolt = <770000 770000 770000 780000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1062000000>;
			opp-microvolt = <810000 810000 805000 810000>;
		};

		opp08 {
			opp-hz = /bits/ 64 <1182000000>;
			opp-microvolt = <810000 810000 805000 810000>;
		};

		opp09 {
			opp-hz = /bits/ 64 <1182000000>;
			opp-microvolt = <860000 860000 860000 860000>;
		};

		opp10 {
			opp-hz = /bits/ 64 <1312000000>;
			opp-microvolt = <860000 860000 860000 860000>;
		};

		opp11 {
			opp-hz = /bits/ 64 <1242000000>;
			opp-microvolt = <900000 895000 900000 900000>;
		};

		opp12 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <900000 895000 900000 900000>;
		};

		opp13 {
			opp-hz = /bits/ 64 <1326000000>;
			opp-microvolt = <940000 925000 940000 940000>;
		};

		opp14 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <940000 925000 940000 940000>;
		};

		opp15 {
			opp-hz = /bits/ 64 <1578000000>;
			opp-microvolt = <1020000 1020000 1020000 1020000>;
		};
	};

	gpu_cs_opp: opp-table-gpucs {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <24000000>;
			opp-microvolt = <585000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <585000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <635000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <685000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <992000000>;
			opp-microvolt = <720000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <1188000000>;
			opp-microvolt = <770000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <855000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <885000>;
		};
	};

	gpu_afr_opp: opp-table-gpuafr {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <24000000>;
			opp-microvolt = <585000>;
		};

		opp01 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <585000>;
		};

		opp02 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <635000>;
		};

		opp03 {
			opp-hz = /bits/ 64 <796000000>;
			opp-microvolt = <685000>;
		};

		opp04 {
			opp-hz = /bits/ 64 <992000000>;
			opp-microvolt = <720000>;
		};

		opp05 {
			opp-hz = /bits/ 64 <1188000000>;
			opp-microvolt = <770000>;
		};

		opp06 {
			opp-hz = /bits/ 64 <1380000000>;
			opp-microvolt = <855000>;
		};

		opp07 {
			opp-hz = /bits/ 64 <1470000000>;
			opp-microvolt = <885000>;
		};
	};
};

&gpu {
		memory-region = <&gpu_uat_ttbs>, <&gpu_uat_pagetables>,
				<&gpu_uat_handoff>, <&gpu_fw_data>,
				<&gpu_uat_l2_pagetables>, <&gpu_fw_text>;
		memory-region-names = "ttbs", "pagetables", "handoff", "fw-data",
				      "l2-pagetables", "fw-text";
		operating-points-v2 = <&gpu_opp>;
		apple,cs-opp = <&gpu_cs_opp>;
		apple,afr-opp = <&gpu_afr_opp>;
		apple,firmware-version = <26 5 2>;
};

/ {
	/* guess: the SDZ line of the J616c and J773s, AP pin 54 */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl 54 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The speaker stays off: it has no bring-up and no protection
	 * profile. The card, the amp and the AOP speaker stream are all left
	 * out or disabled.
	 */
	sound: sound {
		compatible = "apple,j575c-macaudio", "apple,macaudio";
		model = "Mac Studio J575";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		dai-link@0 {
			reg = <0>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker>;
			};
		};
	};

	sound_jack: sound-jack {
		compatible = "apple,j575c-macaudio-jack", "apple,macaudio";
		model = "Mac Studio J575 Jack";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 4>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

&aop {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&admac0 {
	status = "okay";
};

&admac1 {
	status = "okay";
};

/* No microphones: only the jack's streams, as on the J773s. */
&aop_audio {
	dmas = <&admac1 4>, <&admac1 5>;
	dma-names = "cout", "cin";
	apple,chassis-name = "J575";
	apple,machine-kind = "Mac Studio";
};

/* guess: one SN012776 at 0x38 as on the J773s and J575d, interrupt AP 55 */
&i2c1 {
	speaker: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
		interrupts-extended = <&pinctrl 55 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
		status = "disabled";
	};
};

/* guess: the J616c's and J773s's CS42L84 wiring */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 58 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl 106 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&aop {
	nonposted-mmio;
};

/* No ambient light sensor and no lid. */
&aop_als {
	status = "disabled";
};

&aop_las {
	status = "disabled";
};

&admac1 {
	dma-channels = <26>;
	nonposted-mmio;
};

&admac0 {
	nonposted-mmio;
};

&aop_dart {
	nonposted-mmio;
};

&i2c1 {
	nonposted-mmio;
};

&i2c2 {
	nonposted-mmio;
};

/ {
	reserved-memory {
		aop_mmio_pmgr: aop-mmio-pmgr@508304000 {
			reg = <0x5 0x08304000 0x0 0x4000>;
			iommu-addresses = <&aop 0x5 0x08304000 0x0 0x4000>;
			no-map;
		};
	};
};

&aop {
	memory-region = <&aop_mmio_pmgr>;
};

/*
 * Not described: HDMI and the external display chains (unknown PHY routing
 * on this board), the fourth back port and the SEP (no Touch ID sensor).
 */
