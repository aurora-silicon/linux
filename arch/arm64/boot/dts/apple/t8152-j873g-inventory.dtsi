		      <0x3 0x8a038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1589 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dt5_dart_apcie2 17>;
		status = "disabled";
	};

