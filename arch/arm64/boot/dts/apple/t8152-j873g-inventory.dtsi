/* Hardware resources only. Ownership and driver enables require qualification. */

&{/soc} {

	dt5_dart_apcie2: iommu@38a000000 {
		compatible = "apple,t8152-dart", "apple,t8110-dart";
		reg = <0x3 0x8a000000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1588 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_apciec0: iommu@404000000 {
