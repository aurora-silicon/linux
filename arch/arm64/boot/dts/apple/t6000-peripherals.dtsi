			     <AIC_IRQ 0 1068 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	soc_errors: error-handler@395440000 {
		compatible = "apple,t6000-error-handler", "apple,soc-error-handler";
		reg = <0x3 0x95440000 0x0 0x40000>,
		      <0x2 0x8e000000 0x0 0x80000>,
		      <0x2 0x8e080000 0x0 0x80000>,
		      <0x2 0x00000000 0x0 0x1000000>,
		      <0x2 0x01000000 0x0 0x1000000>,
		      <0x2 0x02000000 0x0 0x1000000>,
		      <0x2 0x03000000 0x0 0x1000000>,
		      <0x2 0x82000000 0x0 0x4000>,
		      <0x3 0x04000000 0x0 0x4000>,
		      <0x3 0x83000000 0x0 0x4000>,
		      <0x4 0x02000000 0x0 0x4000>,
		      <0x2 0x58d00000 0x0 0x20000>,
