		      <0x2 0x67032000 0x0 0x1000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 550 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 549 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 552 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 553 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 554 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 555 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 556 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 557 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 448 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 458 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 468 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 478 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 285 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 287 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 289 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 291 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 452 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 453 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 454 IRQ_TYPE_LEVEL_HIGH>,
