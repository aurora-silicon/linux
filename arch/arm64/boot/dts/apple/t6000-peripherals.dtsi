			     <AIC_IRQ 0 82 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 83 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 84 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 424 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 425 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 426 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 442 IRQ_TYPE_LEVEL_HIGH>,
