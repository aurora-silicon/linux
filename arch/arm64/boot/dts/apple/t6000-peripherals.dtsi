			     <AIC_IRQ 0 191 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 192 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	pwm1: timer-pwm@39b030000 {
		compatible = "apple,t6000-pwm", "apple,pwm";
		reg = <0x3 0x9b030000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1128 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_fpwm1>;
		status = "disabled";
	};
};

&ave {
	reg = <0x4 0x0d100000 0x0 0x45c000>,
	      <0x4 0x0d050000 0x0 0x8000>,
	      <0x4 0x0d800000 0x0 0x800000>,
	      <0x2 0x8e588000 0x0 0x24>,
	      <0x4 0x0c000000 0x0 0x1000000>;
	reg-names = "codec", "mailbox", "coproc", "pmgr", "pio";
	clocks = <&peripheral_clocks 350>;
};

/ {
	peripheral_clocks: clock-controller {
		compatible = "apple,t6000-pmgr-clocks", "apple,pmgr-clocks";
		#clock-cells = <1>;
		apple,pmgr = <&pmgr>;
		status = "disabled";
	};
};

/* CPU and cluster power states are described without granting control. */
&pmgr {
	power-controller@0 {
		compatible = "apple,t6000-pmgr-pwrstate", "apple,pmgr-pwrstate";
		reg = <0x0 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "ecpu0_0";
		status = "disabled";
	};
	power-controller@8 {
