		      <0x2 0x8e600000 0x0 0x4c000>,
		      <0x2 0x92280000 0x0 0x74000>,
		      <0x2 0x85838000 0x0 0x8000>,
		      <0x5 0x09838000 0x0 0x8000>,
		      <0x2 0x85868000 0x0 0x4000>,
		      <0x5 0x09868000 0x0 0x4000>,
		      <0x4 0x04e20000 0x0 0x4000>,
		      <0x4 0x04e20000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 444 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 445 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 446 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 70 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 71 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 72 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 73 IRQ_TYPE_LEVEL_HIGH>,
