			apple,thunderbolt-drom = [00];
			status = "disabled";
		};
	};

	usb4_0_pcie_tunnel: usb4-pcie-tunnel-0 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;
		status = "disabled";

		apciec0_dart: iommu@384000000 {
			compatible = "apple,t6041-dart", "apple,t8110-dart";
			reg = <0x3 0x84000000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1606 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		usb4_0_pcie: pcie@1c50000000 {
			compatible = "apple,t6040-pciec";
			device_type = "pci";
			reg = <0x1c 0x50000000 0x0 0x10000000>,
			      <0x3 0x84034000 0x0 0x4000>,
			      <0x3 0x84020000 0x0 0x8000>,
			      <0x3 0x84038000 0x0 0x4000>,
			      <0x3 0x84060000 0x0 0x4000>,
			      <0x3 0x80020000 0x0 0x4000>,
			      <0x3 0x8402c000 0x0 0x4000>,
			      <0x3 0x84028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug",
				    "ioa", "ltssm", "intr2axi";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1605 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1608 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1609 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1610 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1611 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1612 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port", "intx-a", "intx-b", "intx-c",
					  "intx-d", "parity";
			power-domains = <&ps_atc0_pcie>;
			msi-controller;
			msi-parent = <&usb4_0_pcie>;
			msi-ranges = <&aic AIC_IRQ 2103 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <0x20>;
			iommu-map = <0x0 &apciec0_dart 0x0 0x100>;
			iommu-map-mask = <0xff>;
			bus-range = <0x0 0x80>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0x8 0x0 0x8 0x0 0x2 0x0>,
				 <0x02000000 0x0 0x100000 0xa 0x100000 0x0 0x3ff00000>,
				 <0x42000000 0x0 0x40000000 0xa 0x40000000 0x0 0x40000000>;
			status = "disabled";

			usb4_0_pcie_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &usb4_0_pcie_port 0 0 0 0>,
						<0 0 0 2 &usb4_0_pcie_port 0 0 0 1>,
						<0 0 0 3 &usb4_0_pcie_port 0 0 0 2>,
						<0 0 0 4 &usb4_0_pcie_port 0 0 0 3>;
			};
		};
	};

	usb4_1_pcie_tunnel: usb4-pcie-tunnel-1 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;
		status = "disabled";

		apciec1_dart: iommu@38c000000 {
