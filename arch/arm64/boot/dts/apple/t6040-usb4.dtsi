		usb4_1_pcie: pcie@1c60000000 {
			compatible = "apple,t6040-pciec";
			device_type = "pci";
			reg = <0x1c 0x60000000 0x0 0x10000000>,
			      <0x3 0x8c034000 0x0 0x4000>,
			      <0x3 0x8c020000 0x0 0x8000>,
			      <0x3 0x8c038000 0x0 0x4000>,
			      <0x3 0x8c060000 0x0 0x4000>,
			      <0x3 0x88020000 0x0 0x4000>,
			      <0x3 0x8c02c000 0x0 0x4000>,
			      <0x3 0x8c028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug",
				    "ioa", "ltssm", "intr2axi";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1637 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1640 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1641 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1642 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1643 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1644 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port", "intx-a", "intx-b", "intx-c",
					  "intx-d", "parity";
			power-domains = <&ps_atc1_pcie>;
			msi-controller;
			msi-parent = <&usb4_1_pcie>;
			msi-ranges = <&aic AIC_IRQ 2135 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <0x40>;
			iommu-map = <0x0 &apciec1_dart 0x0 0x100>;
			iommu-map-mask = <0xff>;
			bus-range = <0x0 0x80>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0xc 0x0 0xc 0x0 0x2 0x0>,
				 <0x02000000 0x0 0x100000 0xe 0x100000 0x0 0x3ff00000>,
				 <0x42000000 0x0 0x40000000 0xe 0x40000000 0x0 0x40000000>;
			status = "disabled";

			usb4_1_pcie_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &usb4_1_pcie_port 0 0 0 0>,
						<0 0 0 2 &usb4_1_pcie_port 0 0 0 1>,
						<0 0 0 3 &usb4_1_pcie_port 0 0 0 2>,
						<0 0 0 4 &usb4_1_pcie_port 0 0 0 3>;
			};
		};
	};

	usb4_2_pcie_tunnel: usb4-pcie-tunnel-2 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;
		status = "disabled";

		apciec2_dart: iommu@394000000 {
