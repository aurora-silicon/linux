		usb4_2_pcie: pcie@1c70000000 {
			compatible = "apple,t6040-pciec";
			device_type = "pci";
			reg = <0x1c 0x70000000 0x0 0x10000000>,
			      <0x3 0x94034000 0x0 0x4000>,
			      <0x3 0x94020000 0x0 0x8000>,
			      <0x3 0x94038000 0x0 0x4000>,
			      <0x3 0x94060000 0x0 0x4000>,
			      <0x3 0x90020000 0x0 0x4000>,
			      <0x3 0x9402c000 0x0 0x4000>,
			      <0x3 0x94028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug",
				    "ioa", "ltssm", "intr2axi";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1669 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1672 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1673 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1674 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1675 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1676 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port", "intx-a", "intx-b", "intx-c",
					  "intx-d", "parity";
			power-domains = <&ps_atc2_pcie>;
			msi-controller;
			msi-parent = <&usb4_2_pcie>;
			msi-ranges = <&aic AIC_IRQ 2167 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <0x60>;
			iommu-map = <0x0 &apciec2_dart 0x0 0x100>;
			iommu-map-mask = <0xff>;
			bus-range = <0x0 0x80>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0x10 0x0 0x10 0x0 0x2 0x0>,
				 <0x02000000 0x0 0x100000 0x12 0x100000 0x0 0x3ff00000>,
				 <0x42000000 0x0 0x40000000 0x12 0x40000000 0x0 0x40000000>;
			status = "disabled";

			usb4_2_pcie_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &usb4_2_pcie_port 0 0 0 0>,
						<0 0 0 2 &usb4_2_pcie_port 0 0 0 1>,
						<0 0 0 3 &usb4_2_pcie_port 0 0 0 2>,
						<0 0 0 4 &usb4_2_pcie_port 0 0 0 3>;
			};
		};
	};
};

/ {
	/* ADT pmgr reg[44]: AppleT6041PMGR::enableCioReconfig at +0x2024. */
	pmgr_cio: power-management@502820000 {
		compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x5 0x02820000 0 0x4000>;
		/* Enabled together with the routers. */
		status = "disabled";

		cio_reset: reset-controller@2024 {
			compatible = "apple,t6041-cio-reset";
			reg = <0x2024 0x4>;
			#reset-cells = <1>;
		};
	};
};

&pinctrl_aop {
	/* ADT acioN gpio-lstx. */
	usb4_0_lstx_pins: usb4-0-lstx-pins {
		pinmux = <APPLE_PINMUX(49, 1)>;
	};

	usb4_1_lstx_pins: usb4-1-lstx-pins {
		pinmux = <APPLE_PINMUX(51, 1)>;
	};

	usb4_2_lstx_pins: usb4-2-lstx-pins {
		pinmux = <APPLE_PINMUX(53, 1)>;
	};
};
