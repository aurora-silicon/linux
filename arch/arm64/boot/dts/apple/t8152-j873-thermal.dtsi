			trips {
				m6_Ts08_passive: passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&m6_Ts08_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};
