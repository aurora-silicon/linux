/ {
	thermal-zones {
		smc-tcmb-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <500>;
			thermal-sensors = <&m6_smc_hwmon 0>;

			trips {
				m6_TCMb_passive: passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&m6_TCMb_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		smc-th0a-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <500>;
			thermal-sensors = <&m6_smc_hwmon 1>;

			trips {
