/ {
	thermal-zones {
		smc-te07-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <500>;
			thermal-sensors = <&m6_smc_hwmon 66>;

			trips {
				m6_Te07_passive: passive {
					temperature = <110000>;
					hysteresis = <5000>;
					type = "passive";
				};

				critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&m6_Te07_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		smc-te08-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <500>;
