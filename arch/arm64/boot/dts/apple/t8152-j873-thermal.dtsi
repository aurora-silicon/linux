/*
 * Apple Mac mini (M6, J873g): SMC temperature sensors and CPU thermal zones.
 *
 * The SMC float temperature channels that read back stable values on the
 * J873g; their physical locations are not established, so each keeps its SMC
 * key as label. TVMD and the Tz* channels that read zero are left out.
 *
 * The limits are the machine's own: the J873g ADT's PMP temp-sensor table
 * gives every CPU die sensor a 110 C target and a 125 C maximum, as on the
 * other M4/M5-class Macs. The SMC's CPU die channels, Te* for the E cluster
 * and Tp* for the P/M cluster, therefore each get a zone with a passive trip
 * at the target, throttling both CPU clusters through cpufreq cooling, and a
 * critical trip at the maximum. The other channels are reported only: the
 * ADT gives them no limit. The SMC's own fan policy is no limit either; in
 * its automatic mode it leaves the fan at its 1000 RPM minimum even at 93 C
 * under sustained full load.
 *
 * Sensor list from Acelogic's J873 bring-up (linux-aurora j873).
 */

#include <dt-bindings/thermal/thermal.h>

&m6_smc_hwmon {
	temperature-TCMb { apple,key-id = "TCMb"; label = "SMC TCMb"; };
	temperature-TH0a { apple,key-id = "TH0a"; label = "SMC TH0a"; };
	temperature-TH0b { apple,key-id = "TH0b"; label = "SMC TH0b"; };
