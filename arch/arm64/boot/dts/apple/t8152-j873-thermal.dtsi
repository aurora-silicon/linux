/*
 * Apple Mac mini (M6, J873g): SMC temperature sensors and CPU thermal zones.
 *
 * The SMC float temperature channels that read back stable values on the
 * J873g; their physical locations are not established, so each keeps its SMC
 * key as label. TVMD and the Tz* channels that read zero are left out.
 *
 * Every channel gets a 75 C passive trip with 5 C hysteresis that throttles
 * both CPU clusters through cpufreq cooling. That is a conservative policy,
 * not an Apple limit: in its automatic mode the SMC leaves the fan at its
 * 1000 RPM minimum even at 93 C under sustained full load, so the kernel has
 * to hold the temperature down itself. No critical trip is set, as there is
 * no known shutdown threshold.
 *
 * Sensor list and trips from Acelogic's J873 bring-up (linux-aurora j873).
 */

#include <dt-bindings/thermal/thermal.h>

&m6_smc_hwmon {
	temperature-TCMb { apple,key-id = "TCMb"; label = "SMC TCMb"; };
	temperature-TH0a { apple,key-id = "TH0a"; label = "SMC TH0a"; };
	temperature-TH0b { apple,key-id = "TH0b"; label = "SMC TH0b"; };
	temperature-TH0x { apple,key-id = "TH0x"; label = "SMC TH0x"; };
