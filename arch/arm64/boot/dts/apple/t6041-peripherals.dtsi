&pmgr_aux {
	ps_fab5_soc: power-controller@440 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x440 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "fab5_soc";
		power-domains = <&ps_afi>;
	status = "disabled";
	};
};

#include "t604x-peripherals.dtsi"
