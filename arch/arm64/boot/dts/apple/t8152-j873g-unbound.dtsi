		interrupts = <AIC_IRQ 1763 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1764 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1765 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1766 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1737 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_usb2 1>;
		status = "disabled";
	};

	hw_dart_usb3: dart-complex@413020000 {
		compatible = "apple,t8152-dart-complex", "apple,dart-complex";
		reg = <0x4 0x13020000 0x0 0xc000>,
		      <0x4 0x13040000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 1821 IRQ_TYPE_LEVEL_HIGH>;
