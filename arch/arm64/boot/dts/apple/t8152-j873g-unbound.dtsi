	hw_dptx_phy: dptx-phy-complex@31a740000 {
		compatible = "apple,t8152-dptx-phy-complex", "apple,dptx-phy-complex";
		reg = <0x3 0x1a740000 0x0 0x10000>,
		      <0x3 0x1a700000 0x0 0x4000>;
		status = "disabled";
	};

	hw_dart_usb0: dart-complex@403020000 {
		compatible = "apple,t8152-dart-complex", "apple,dart-complex";
		reg = <0x4 0x3020000 0x0 0xc000>,
		      <0x4 0x3040000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 1608 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dart_usb1: dart-complex@40b020000 {
		compatible = "apple,t8152-dart-complex", "apple,dart-complex";
		reg = <0x4 0xb020000 0x0 0xc000>,
		      <0x4 0xb040000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 1679 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dart_usb2: dart-complex@383020000 {
		compatible = "apple,t8152-dart-complex", "apple,dart-complex";
		reg = <0x3 0x83020000 0x0 0xc000>,
		      <0x3 0x83040000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 1750 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_usb_drd2: usb-drd-complex@382430000 {
		compatible = "apple,t8152-usb-drd-complex", "apple,usb-drd-complex";
		reg = <0x3 0x82430000 0x0 0x11800>,
		      <0x3 0x82440000 0x0 0x4000>,
		      <0x3 0x8243c000 0x0 0x5800>,
