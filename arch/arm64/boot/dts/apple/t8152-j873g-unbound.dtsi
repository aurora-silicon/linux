#include "t8152-peripherals.dtsi"

// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Register and interrupt resources; ownership-sensitive blocks stay disabled. */

&{/soc} {

	hw_spi3: spi-controller@33110c000 {
		compatible = "apple,t8152-spi-controller", "apple,spi-controller";
		reg = <0x3 0x3110c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1408 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_apcie0_piodma: pcie-piodma@388030000 {
		compatible = "apple,t8152-pcie-piodma", "apple,pcie-piodma";
		reg = <0x3 0x88030000 0x0 0x4000>,
		      <0x3 0x88034000 0x0 0x4000>,
		      <0x3 0x88038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1573 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&pcie0_dart 17>;
		status = "disabled";
	};

	hw_error_handler: error-monitor@288d80000 {
		compatible = "apple,t8152-error-monitor", "apple,error-monitor";
		reg = <0x2 0x88d80000 0x0 0x40000>,
		      <0x2 0x88980000 0x0 0x8000>,
		      <0x3 0x0 0x0 0x40000>,
		      <0x3 0x728000 0x0 0x4000>,
		      <0x3 0x768000 0x0 0x4000>,
