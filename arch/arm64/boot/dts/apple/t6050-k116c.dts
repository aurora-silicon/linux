/*
 * MacBook Pro (16-inch PROLED XDR, M5 Max, 2026)
 *
 * target-type: K116c (Mac17,10)
 *
 * Preliminary: described from the ADT only, not yet booted on the hardware.
 *
 * Copyright The Asahi Linux Contributors
 */

/* The Neural Engine (t6050-ane.dtsi, through t6050-peripherals.dtsi) */
#define T6050_ANE

#include "t6050-k114-k116.dtsi"

/ {
	compatible = "apple,k116c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch PROLED XDR, M5 Max, 2026)";
};

&mtp_multitouch {
	firmware-name = "apple/tpmtfw-k116c.bin";
};

#define T6050_K116C
/* The GPU in the M5 Max layout (t6050-gpu-g17c.dtsi), under its own bus */
#define T6050_GPU_BUS
#include "t6050-peripherals.dtsi"

#include "t6050-gpu-g17c.dtsi"

/* The camera. The loader sets the platform ID from the ADT isp0 sensor-type (0xbb). */
#include "t6050-isp.dtsi"

#include "t6050-media.dtsi"

/* The AOP, its sensors and the microphone array (t6050-aop.dtsi) */
&aop_audio {
	apple,chassis-name = "K116";
};

#include "t6050-aop.dtsi"
