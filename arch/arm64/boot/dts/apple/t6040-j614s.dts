// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (14-inch, M4 Pro, Nov 2024)
 *
 * target-type: J614s
 *
 * J614s uses the same T6040 platform topology as the supported J616s
 * board. Keep the shared SoC resources and driver bindings in one baseline;
 * board-specific firmware supplies the J614s identity at boot.
 */

#include "t6040-j616s.dts"

/ {
	compatible = "apple,j614s", "apple,t6040", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M4 Pro, Nov 2024)";
};

&dcp {
	panel {
		compatible = "apple,panel-j614", "apple,panel-mini-led", "apple,panel";
		width-mm = <302>;
		height-mm = <196>;
		/delete-property/ adj-height-mm;
	};
};

&aop_audio {
	apple,chassis-name = "J614";
};

&mtp_hid {
	multi-touch {
		firmware-name = "apple/tpmtfw-j614s.bin";
	};
};

&{/pcie@1cb0000000/pci@0,0/wifi@0,0} {
	brcm,board-type = "apple,mriya";
};

&{/pcie@1cb0000000/pci@0,0/bluetooth@0,1} {
	brcm,board-type = "apple,mriya";
};

&mesa {
	firmware-name = "apple/mesacal-j614s.bin", "apple/msrk-j614s.bin";
};
