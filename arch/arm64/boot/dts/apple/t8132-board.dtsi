/*
 * SoC-level wiring shared by the full T8132 board trees: the boot loader
 * handoffs, the coprocessors, the boot NOR, the radio port, the PMU and
 * the first two ATCs. The values match the J713, J604 and J773g ADTs.
 * The J713 still carries its own copy in its board file.
 *
 * Boards provide the Type-C connectors typec0 and typec1 (endpoint labels
 * typecN_connector_hs and typecN_connector_ss) and the radio's
 * brcm,board-type.
 *
 * Copyright The Asahi Linux Contributors
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	aliases {
		sep = &sep;
		ans = &nvme;
		ans-mbox = &ans_mbox;
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		bluetooth0 = &bluetooth0;
		nvram = &nvram;
		pmu-primary = &pmic1;
		pmp = &pmp;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	chosen {
		linux-enablement-mac,disk-boot;
		linux-enablement-mac,dapf-handoff = "/arm-io/aop", "/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";
	};

	/*
	 * The boot NOR runs from a PMU rail that is on whenever the SoC is
	 * and that no OS switches. The ADT gives the flash no supply.
	 */
	nor_flash_vcc: regulator-nor-flash-vcc {
		compatible = "regulator-fixed";
		regulator-name = "nor-flash-vcc";
		regulator-always-on;
	};
};

/*
 * m1n1 programs the AOP DART's DAPF and reserves the firmware segments and
 * the DAPF windows in memory-region when /chosen asks for the AOP's handoff,
 * or disables the AOP.
 */
&aop {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
	/* A periodic report need not wake the system. */
	apple,hold-rx-in-sleep;
};

&admac0 {
	status = "okay";
};

&admac1 {
	status = "okay";
};

/* These Macs have fans; the SMC owns their cooling. */
&cpufreq_e {
	status = "okay";
};

&cpufreq_p {
	status = "okay";
};

&cpuidle {
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		vcc-supply = <&nor_flash_vcc>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				/* ADT /arm-io/qspi/spinor/anvram, flash-relative. */
				reg = <0x700000 0x100000>;
			};
		};
	};
};

&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&mcc {
	status = "okay";
	apple,boot-dma-devices = <&pmp>;
};

&pmc {
	status = "okay";
	apple,static-voters = <3>;
};

&sep_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};

	reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			<&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
			"boot_error_count", "panic_count";
	};
};

&smc_mbox {
	status = "okay";
};

&nub_spmi {
	status = "okay";

	pmic1: pmic@0 {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0x0 SPMI_USID>; /* To be filled by loader */

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

/* The port controllers of ATC0 and ATC1 sit on this SPMI bus. */
&nub_spmi_a0 {
	status = "okay";
};

&atcphy0 {
	status = "okay";
	/* Leave the display crossbar at core + 0x4c000 to its own driver. */
	reg = <0x4 0x02a90000 0x0 0x4000>,
	      <0x4 0x02a84000 0x0 0x4000>,
	      <0x4 0x03000000 0x0 0x24000>,
	      <0x4 0x00000000 0x0 0x8000>,
	      <0x4 0x00020000 0x0 0x4000>,
	      <0x4 0x03044000 0x0 0x4000>,
	      <0x4 0x03050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy0 PHY_TYPE_USB2>, <&atcphy0 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	status = "okay";
	/* Leave the display crossbar at core + 0x4c000 to its own driver. */
	reg = <0x4 0x0aa90000 0x0 0x4000>,
	      <0x4 0x0aa84000 0x0 0x4000>,
	      <0x4 0x0b000000 0x0 0x24000>,
	      <0x4 0x08000000 0x0 0x8000>,
	      <0x4 0x08020000 0x0 0x4000>,
	      <0x4 0x0b044000 0x0 0x4000>,
	      <0x4 0x0b050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy1_typec_lanes: endpoint {
				remote-endpoint = <&typec1_connector_ss>;
			};
		};
	};
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>, <&atcphy1 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

/*
 * The radio port: m1n1 performs the T8132 controller and PHY
 * initialization, Linux adopts the trained link and owns only the radio's
 * ordinary streams (ADT mapper-apcie0-wlan and -bt), RID-to-SID routing
 * and MSI. Power is the SMC's gP13 (ADT /amfm function-reg_on), reset AP
 * GPIO 163 (pci-bridge0 function-perst).
 */
&dart_apcie0 {
	status = "okay";
	apple,managed-sids = <1 2>;
	apple,dma-range = <0x100 0x00100000 0x0 0x3fe00000>;
};

&pcie0 {
	status = "okay";
	apple,managed-sids = <1 2>;
	iommu-map = <0x100 &dart_apcie0 1 2>;
	iommu-map-mask = <0xffff>;
};

&port00 {
	pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* Per-machine address and calibration supplied by m1n1. */
		local-bd-address = [00 00 00 00 00 00];
	};

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
	};
};
