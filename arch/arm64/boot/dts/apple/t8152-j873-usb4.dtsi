// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * J873g rear USB-C ports in USB4 mode: three ACIO host routers with their
 * NHI, PCIe-C tunnel and DARTs, and the T8152 PSD services they need. Each
 * router's Thunderbolt switch is linked to the USB4 port (port@4) of its
 * port's usb-c-connector, whose PD controller driver starts and stops it
 * after it set the port's ATC PHY to CIO mode.
 *
 * Generated from the J873g ADT (27.2 iBoot): /arm-io/acio{0,1,3}, acio-cpuN,
 * dart-acioN, apciecN and dart-apciecN.
 *
 * Each router coprocessor's mailbox is the 0x80 window at +0x80 of its
 * acio-cpuN register block, with the SMC mailbox's counted FIFOs. Its
 * interrupts are acio-cpuN's two, in the order the SMC mailbox's ADT list
 * gives its own: send-empty, recv-not-empty.
 */

#include <dt-bindings/gpio/gpio.h>

/ {
	soc {
		cio_reset: reset-controller@300780000 {
			compatible = "apple,t8152-cio-reset";
			reg = <0x3 0x00780000 0x0 0x4000>;
			#reset-cells = <1>;
		};

		cio_psd59: power-controller@303a13b00 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a13b00 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd60: power-controller@303a13c00 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a13c00 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd62: power-controller@303a13e00 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a13e00 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd63: power-controller@303a13f00 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a13f00 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd64: power-controller@303a14000 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a14000 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd66: power-controller@303a14200 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a14200 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd67: power-controller@303a14300 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a14300 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd68: power-controller@303a14400 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a14400 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd70: power-controller@303a14600 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a14600 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd86: power-controller@303a15600 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a15600 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd87: power-controller@303a15700 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a15700 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio_psd89: power-controller@303a15900 {
			compatible = "apple,t8152-psd";
			reg = <0x3 0x3a15900 0x0 0x100>;
			#power-domain-cells = <0>;
		};

		cio0_mbox: mailbox@401178080 {
			compatible = "apple,t8152-cio-mailbox",
				     "apple,t8152-smc-mailbox";
			reg = <0x4 0x1178080 0x0 0x80>;
			interrupts = <AIC_IRQ 1660 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1659 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "send-empty", "recv-not-empty";
			#mbox-cells = <0>;
		};

		/* acio@ avoids the bootloader's legacy cio@ register-index fixup. */
		usb4_0: acio@401ac0000 {
			compatible = "apple,t8152-usb4-acio";
			reg = <0x4 0x1ac0000 0x0 0xc000>,
			      <0x4 0x1080000 0x0 0x26000>,
			      <0x4 0x1e44000 0x0 0x4000>,
			      <0x4 0x1c80000 0x0 0x4000>;
			reg-names = "rc", "sram", "pcie-adapter", "router-ap-fw";
			#address-cells = <1>;
			#size-cells = <1>;
			/* The router window and the shared Gen3 TLB invalidation aperture. */
			ranges = <0x0 0x4 0x1000000 0x1000000>,
				 <0x1000000 0x2 0x0 0x1000>;
			nonposted-mmio;
			mboxes = <&cio0_mbox>;
			resets = <&cio_reset 0>;
			power-domains = <&cio_psd59>, <&cio_psd63>, <&cio_psd67>, <&cio_psd86>;
			pinctrl-names = "lstx";
			pinctrl-0 = <&usb4_0_lstx_pins>;
			lstx-gpios = <&pinctrl_aop 19 GPIO_ACTIVE_HIGH>;
			thunderbolt-switch;
			apple,pcie-tunnel = <&usb4_0_tunnel>;
			apple,tunable-rc =
				<0x0 0xfff0 0x5010>,
				<0x2c 0x4 0x0>,
				<0xac 0xffffffff 0x84638463>,
				<0x4004 0x1ff01ff 0x1000100>,
				<0x4008 0x801f 0x4>,
				<0x4010 0x7f 0x40>,
				<0x4014 0x801f 0x4>,
				<0x401c 0x7f 0x40>,
				<0x4024 0x801f 0x4>,
				<0x402c 0x7f 0x40>,
				<0x4030 0x801f 0x4>,
				<0x4038 0xffffffff 0x1010101>,
				<0x403c 0xffff 0x101>,
				<0x4040 0x1 0x1>,
				<0x4044 0xffffffff 0x1010101>,
				<0x4048 0x1 0x1>,
				<0x404c 0x801f 0x4>,
				<0x8004 0x70007 0x40004>,
				<0x8008 0x801f 0x4>,
				<0x8010 0xf000f 0x80008>,
				<0x8018 0x801f 0x4>,
				<0x8020 0x70007 0x40004>,
				<0x8028 0x801f 0x4>,
				<0x8030 0x801f 0x4>,
				<0x8038 0x801f 0x4>,
				<0x8040 0x801f 0x4>,
				<0x8048 0x801f 0x4>,
				<0x8050 0x801f 0x4>,
				<0x8058 0x801f 0x4>,
				<0x8060 0x801f 0x4>;
			apple,tunable-pcie-adapter =
				<0x1008 0x6 0x6>;
			apple,tunable-router-ap-fw =
				<0x8 0xff2 0x482>;

			usb4_0_dart: iommu@a80000 {
				compatible = "apple,t8152-acio-dart";
				reg = <0xa80000 0xc000>,
				      <0x1000100 0x10>;
				reg-names = "dart", "tlbi";
				#iommu-cells = <1>;
				interrupt-parent = <&aic>;
				interrupts = <AIC_IRQ 1656 IRQ_TYPE_LEVEL_HIGH>;
				apple,dma-range = <0x100 0x0 0x10 0x0>;
				apple,tunable =
					<0x20c 0x80000121 0x80000121>,
					<0x220 0xf0f 0xf0f>,
					<0x224 0xffff 0x909>,
					<0x300 0x1f31 0x1>,
					<0x308 0x3ffffffc 0x10000000>,
					<0x310 0x3ffffffc 0x3ffffffc>,
					<0x800 0xf003f 0x10000>,
					<0x804 0xf003f 0x10002>,
					<0x808 0xf003f 0x10004>,
					<0x80c 0xf003f 0x20006>,
					<0x810 0xf003f 0x2000a>,
					<0x814 0xf003f 0x2000e>,
					<0x818 0xf003f 0x20012>,
					<0x81c 0xf003f 0x20016>,
					<0x820 0xf003f 0x2001a>,
					<0x824 0xf003f 0x2001e>,
					<0x828 0xf003f 0x20022>,
					<0x82c 0xf003f 0x20026>,
					<0x830 0xf003f 0x2002a>,
					<0x834 0xf003f 0x2002e>,
					<0x838 0xf003f 0x20032>,
					<0x83c 0xf003f 0x10036>,
					<0x4600 0x2 0x2>;
			};

			usb4_0_nhi: nhi@f00000 {
				compatible = "apple,t8152-usb4-nhi";
				reg = <0xf00000 0x100000>;
				reg-names = "nhi";
				interrupt-parent = <&aic>;
				interrupts = <AIC_IRQ 1629 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1630 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1631 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1632 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1633 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1634 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1635 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1636 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1637 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1638 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1639 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1640 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1641 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1642 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1643 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1644 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1645 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1646 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1647 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1648 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1649 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1650 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1651 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1652 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "txring0", "txring1", "txring2",
						  "txring3", "txring4", "txring5",
						  "txring6", "txring7", "txring8",
						  "txring9", "txring10", "txring11",
						  "rxring0", "rxring1", "rxring2",
						  "rxring3", "rxring4", "rxring5",
						  "rxring6", "rxring7", "rxring8",
						  "rxring9", "rxring10", "rxring11";
				iommus = <&usb4_0_dart 0>, <&usb4_0_dart 1>, <&usb4_0_dart 2>,
					 <&usb4_0_dart 3>, <&usb4_0_dart 4>, <&usb4_0_dart 5>,
					 <&usb4_0_dart 6>, <&usb4_0_dart 7>, <&usb4_0_dart 8>,
					 <&usb4_0_dart 9>, <&usb4_0_dart 10>, <&usb4_0_dart 11>,
					 <&usb4_0_dart 16>, <&usb4_0_dart 17>, <&usb4_0_dart 18>,
					 <&usb4_0_dart 19>, <&usb4_0_dart 20>, <&usb4_0_dart 21>,
					 <&usb4_0_dart 22>, <&usb4_0_dart 23>, <&usb4_0_dart 24>,
					 <&usb4_0_dart 25>, <&usb4_0_dart 26>, <&usb4_0_dart 27>;
				apple,thunderbolt-drom =
					[db 00 00 00 00 00 00 00 00 5d 2d 12 e9 01 42 00
					 01 00 0f 00 01 00 08 81 80 02 80 00 00 00 08 82
					 90 01 80 00 00 00 03 83 20 02 84 05 85 09 01 00
					 05 86 09 01 00 02 87 05 88 09 01 00 0d 01 41 70
					 70 6c 65 20 49 6e 63 2e 00 06 02 69 4f 53 00 00];
				apple,tunable-nhi =
					<0xf8004 0xff 0x80>,
					<0xf8008 0x801f 0x4>,
					<0xf8010 0x3f 0x20>,
					<0xf8014 0x801f 0x4>,
					<0xf801c 0x1f 0x10>,
					<0xf8020 0x801f 0x4>,
					<0xf8028 0xff 0x80>,
					<0xf802c 0x801f 0x4>,
					<0xf8034 0xff 0x80>,
					<0xf8038 0x801f 0x4>,
					<0xf8040 0x3f 0x20>,
					<0xf8044 0x801f 0x4>,
					<0xf804c 0x8007 0x1>,
					<0xfc004 0x7 0x4>,
					<0xfc008 0x801f 0x4>,
					<0xfc010 0x7 0x4>,
					<0xfc014 0x801f 0x4>,
					<0xfc01c 0x7 0x4>,
					<0xfc020 0x801f 0x4>,
					<0xfc028 0x7 0x4>,
					<0xfc02c 0x801f 0x4>,
					<0xfc034 0x7 0x4>,
					<0xfc038 0x801f 0x4>,
					<0xfc040 0x7 0x4>,
					<0xfc044 0x801f 0x4>,
					<0xfc04c 0x8007 0x1>,
					<0x4000 0x1000000f 0x10000002>,
					<0x4004 0x1000000f 0x10000002>,
					<0x4008 0x1000000f 0x10000002>,
					<0x400c 0x1000000f 0x10000002>,
					<0x4010 0x1000000f 0x10000002>,
					<0x4014 0x1000000f 0x10000002>,
					<0x4018 0x1000000f 0x10000002>,
					<0x401c 0x1000000f 0x10000002>,
					<0x4020 0x1000000f 0x10000002>,
					<0x4024 0x1000000f 0x10000002>,
					<0x4028 0x1000000f 0x10000002>,
					<0x402c 0x1000000f 0x10000002>,
					<0x4040 0x1000000f 0x10000002>,
					<0x4044 0x1000000f 0x10000002>,
					<0x4048 0x1000000f 0x10000002>,
					<0x404c 0x1000000f 0x10000002>,
					<0x4050 0x1000000f 0x10000002>,
					<0x4054 0x1000000f 0x10000002>,
					<0x4058 0x1000000f 0x10000002>,
					<0x405c 0x1000000f 0x10000002>,
					<0x4060 0x1000000f 0x10000002>,
					<0x4064 0x1000000f 0x10000002>,
					<0x4068 0x1000000f 0x10000002>,
					<0x406c 0x1000000f 0x10000002>,
					<0x4080 0x1000000f 0x10000002>,
					<0x4084 0x1000000f 0x10000002>,
					<0x4088 0x1000000f 0x10000002>,
					<0x408c 0x1000000f 0x10000002>,
					<0x4090 0x1000000f 0x10000002>,
					<0x4094 0x1000000f 0x10000002>,
					<0x4098 0x1000000f 0x10000002>,
					<0x409c 0x1000000f 0x10000002>,
					<0x40a0 0x1000000f 0x10000002>,
					<0x40a4 0x1000000f 0x10000002>,
					<0x40a8 0x1000000f 0x10000002>,
					<0x40ac 0x1000000f 0x10000002>,
					<0x40c0 0x1000000f 0x10000002>,
					<0x40c4 0x1000000f 0x10000002>,
					<0x40c8 0x1000000f 0x10000002>,
					<0x40cc 0x1000000f 0x10000002>,
					<0x40d0 0x1000000f 0x10000002>,
					<0x40d4 0x1000000f 0x10000002>,
					<0x40d8 0x1000000f 0x10000002>,
					<0x40dc 0x1000000f 0x10000002>,
					<0x40e0 0x1000000f 0x10000002>,
					<0x40e4 0x1000000f 0x10000002>,
					<0x40e8 0x1000000f 0x10000002>,
					<0x40ec 0x1000000f 0x10000002>,
					<0x4100 0x1000000f 0x10000002>,
					<0x4104 0x1000000f 0x10000002>,
					<0x4108 0x1000000f 0x10000002>,
					<0x410c 0x1000000f 0x10000002>,
					<0x4110 0x1000000f 0x10000002>,
					<0x4114 0x1000000f 0x10000002>,
					<0x4118 0x1000000f 0x10000002>,
					<0x411c 0x1000000f 0x10000002>,
					<0x4120 0x1000000f 0x10000002>,
					<0x4124 0x1000000f 0x10000002>,
					<0x4128 0x1000000f 0x10000002>,
					<0x412c 0x1000000f 0x10000002>,
					<0x4140 0x1000000f 0x10000002>,
					<0x4144 0x1000000f 0x10000002>,
					<0x4148 0x1000000f 0x10000002>,
					<0x414c 0x1000000f 0x10000002>,
					<0x4150 0x1000000f 0x10000002>,
					<0x4154 0x1000000f 0x10000002>,
					<0x4158 0x1000000f 0x10000002>,
					<0x415c 0x1000000f 0x10000002>,
					<0x4160 0x1000000f 0x10000002>,
					<0x4164 0x1000000f 0x10000002>,
					<0x4168 0x1000000f 0x10000002>,
					<0x416c 0x1000000f 0x10000002>,
					<0x43e4 0x7 0x7>;
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					usb4_0_sw: endpoint {
						remote-endpoint = <&typec0_usb4>;
					};
				};
			};
		};

		cio1_mbox: mailbox@409178080 {
			compatible = "apple,t8152-cio-mailbox",
				     "apple,t8152-smc-mailbox";
			reg = <0x4 0x9178080 0x0 0x80>;
			interrupts = <AIC_IRQ 1731 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1730 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "send-empty", "recv-not-empty";
			#mbox-cells = <0>;
		};

		/* acio@ avoids the bootloader's legacy cio@ register-index fixup. */
		usb4_1: acio@409ac0000 {
			compatible = "apple,t8152-usb4-acio";
			reg = <0x4 0x9ac0000 0x0 0xc000>,
			      <0x4 0x9080000 0x0 0x26000>,
			      <0x4 0x9e44000 0x0 0x4000>,
			      <0x4 0x9c80000 0x0 0x4000>;
			reg-names = "rc", "sram", "pcie-adapter", "router-ap-fw";
			#address-cells = <1>;
			#size-cells = <1>;
			/* The router window and the shared Gen3 TLB invalidation aperture. */
			ranges = <0x0 0x4 0x9000000 0x1000000>,
				 <0x1000000 0x2 0x0 0x1000>;
			nonposted-mmio;
			mboxes = <&cio1_mbox>;
			resets = <&cio_reset 1>;
			power-domains = <&cio_psd60>, <&cio_psd64>, <&cio_psd68>, <&cio_psd87>;
			pinctrl-names = "lstx";
			pinctrl-0 = <&usb4_1_lstx_pins>;
			lstx-gpios = <&pinctrl_aop 21 GPIO_ACTIVE_HIGH>;
			thunderbolt-switch;
			apple,pcie-tunnel = <&usb4_1_tunnel>;
			apple,tunable-rc =
				<0x0 0xfff0 0x5010>,
				<0x2c 0x4 0x0>,
				<0xac 0xffffffff 0x84638463>,
				<0x4004 0x1ff01ff 0x1000100>,
				<0x4008 0x801f 0x4>,
				<0x4010 0x7f 0x40>,
				<0x4014 0x801f 0x4>,
				<0x401c 0x7f 0x40>,
				<0x4024 0x801f 0x4>,
				<0x402c 0x7f 0x40>,
				<0x4030 0x801f 0x4>,
				<0x4038 0xffffffff 0x1010101>,
				<0x403c 0xffff 0x101>,
				<0x4040 0x1 0x1>,
				<0x4044 0xffffffff 0x1010101>,
				<0x4048 0x1 0x1>,
				<0x404c 0x801f 0x4>,
				<0x8004 0x70007 0x40004>,
				<0x8008 0x801f 0x4>,
				<0x8010 0xf000f 0x80008>,
				<0x8018 0x801f 0x4>,
				<0x8020 0x70007 0x40004>,
				<0x8028 0x801f 0x4>,
				<0x8030 0x801f 0x4>,
				<0x8038 0x801f 0x4>,
				<0x8040 0x801f 0x4>,
				<0x8048 0x801f 0x4>,
				<0x8050 0x801f 0x4>,
				<0x8058 0x801f 0x4>,
				<0x8060 0x801f 0x4>;
			apple,tunable-pcie-adapter =
				<0x1008 0x6 0x6>;
			apple,tunable-router-ap-fw =
				<0x8 0xff2 0x482>;

			usb4_1_dart: iommu@a80000 {
				compatible = "apple,t8152-acio-dart";
				reg = <0xa80000 0xc000>,
				      <0x1000180 0x10>;
				reg-names = "dart", "tlbi";
				#iommu-cells = <1>;
				interrupt-parent = <&aic>;
				interrupts = <AIC_IRQ 1727 IRQ_TYPE_LEVEL_HIGH>;
				apple,dma-range = <0x100 0x0 0x10 0x0>;
				apple,tunable =
					<0x20c 0x80000121 0x80000121>,
					<0x220 0xf0f 0xf0f>,
					<0x224 0xffff 0x909>,
					<0x300 0x1f31 0x1>,
					<0x308 0x3ffffffc 0x10000000>,
					<0x310 0x3ffffffc 0x3ffffffc>,
					<0x800 0xf003f 0x10000>,
					<0x804 0xf003f 0x10002>,
					<0x808 0xf003f 0x10004>,
					<0x80c 0xf003f 0x20006>,
					<0x810 0xf003f 0x2000a>,
					<0x814 0xf003f 0x2000e>,
					<0x818 0xf003f 0x20012>,
					<0x81c 0xf003f 0x20016>,
					<0x820 0xf003f 0x2001a>,
					<0x824 0xf003f 0x2001e>,
					<0x828 0xf003f 0x20022>,
					<0x82c 0xf003f 0x20026>,
					<0x830 0xf003f 0x2002a>,
					<0x834 0xf003f 0x2002e>,
					<0x838 0xf003f 0x20032>,
					<0x83c 0xf003f 0x10036>,
					<0x4600 0x2 0x2>;
			};

			usb4_1_nhi: nhi@f00000 {
				compatible = "apple,t8152-usb4-nhi";
				reg = <0xf00000 0x100000>;
				reg-names = "nhi";
				interrupt-parent = <&aic>;
				interrupts = <AIC_IRQ 1700 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1701 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1702 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1703 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1704 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1705 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1706 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1707 IRQ_TYPE_LEVEL_HIGH>,
					     <AIC_IRQ 1708 IRQ_TYPE_LEVEL_HIGH>,
