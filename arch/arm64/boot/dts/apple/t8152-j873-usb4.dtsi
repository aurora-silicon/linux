&pinctrl_aop {
	usb4_0_lstx_pins: usb4-0-lstx-pins {
		pinmux = <0x10013>;
	};

	usb4_1_lstx_pins: usb4-1-lstx-pins {
		pinmux = <0x10015>;
	};

	usb4_3_lstx_pins: usb4-3-lstx-pins {
		pinmux = <0x10019>;
	};
};

/* USB-C Back-middle: its router */
&typec0 {
	ports {
		port@4 {
			reg = <4>;

			typec0_usb4: endpoint {
				remote-endpoint = <&usb4_0_sw>;
			};
		};
	};
};

/* USB-C Back-left: its router */
&typec1 {
	ports {
		port@4 {
			reg = <4>;

			typec1_usb4: endpoint {
				remote-endpoint = <&usb4_1_sw>;
			};
		};
	};
};

/* USB-C Back-right: its router */
&typec3 {
	ports {
		port@4 {
			reg = <4>;

			typec3_usb4: endpoint {
				remote-endpoint = <&usb4_3_sw>;
			};
		};
	};
};
