		cio3_mbox: mailbox@411178080 {
			compatible = "apple,t8152-cio-mailbox",
				     "apple,t8152-smc-mailbox";
			reg = <0x4 0x11178080 0x0 0x80>;
			interrupts = <AIC_IRQ 1873 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1872 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "send-empty", "recv-not-empty";
			#mbox-cells = <0>;
		};

		/* acio@ avoids the bootloader's legacy cio@ register-index fixup. */
		usb4_3: acio@411ac0000 {
			compatible = "apple,t8152-usb4-acio";
			reg = <0x4 0x11ac0000 0x0 0xc000>,
			      <0x4 0x11080000 0x0 0x26000>,
			      <0x4 0x11e44000 0x0 0x4000>,
			      <0x4 0x11c80000 0x0 0x4000>;
			reg-names = "rc", "sram", "pcie-adapter", "router-ap-fw";
			#address-cells = <1>;
			#size-cells = <1>;
			/* The router window and the shared Gen3 TLB invalidation aperture. */
			ranges = <0x0 0x4 0x11000000 0x1000000>,
				 <0x1000000 0x2 0x0 0x1000>;
			nonposted-mmio;
			mboxes = <&cio3_mbox>;
			resets = <&cio_reset 3>;
			power-domains = <&cio_psd62>, <&cio_psd66>, <&cio_psd70>, <&cio_psd89>;
			pinctrl-names = "lstx";
			pinctrl-0 = <&usb4_3_lstx_pins>;
			lstx-gpios = <&pinctrl_aop 25 GPIO_ACTIVE_HIGH>;
			thunderbolt-switch;
			apple,pcie-tunnel = <&usb4_3_tunnel>;
