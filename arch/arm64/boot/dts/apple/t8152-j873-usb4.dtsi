	usb4_0_tunnel: usb4-pcie-tunnel-0 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		usb4_0_pcie_dart: iommu@404000000 {
			compatible = "apple,t8152-pciec-dart";
			reg = <0x4 0x4000000 0x0 0xc000>,
			      <0x2 0x100 0x0 0x10>;
			reg-names = "dart", "tlbi";
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1610 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&cio_psd86>;
			apple,dma-range = <0x100 0x80000000 0x0 0x7ff00000>;
			apple,tunable =
				<0x20c 0x80000121 0x80000121>,
				<0x220 0xf0f 0xf0f>,
				<0x224 0xffff 0x909>,
				<0x300 0x1f31 0x1>,
				<0x308 0x3ffffffc 0x10000000>,
				<0x310 0x3ffffffc 0x3ffffffc>,
				<0x4600 0x2 0x2>;
		};

		usb4_0_pcie: pcie@1c50000000 {
			compatible = "apple,t8152-pciec";
			device_type = "pci";
