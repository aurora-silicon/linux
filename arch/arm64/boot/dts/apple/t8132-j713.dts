/*
 * Apple MacBook Air (13-inch, M4, 2025)
 *
 * target-type: J713
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include "t8132-j713-pmgr.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j713", "apple,t8132", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M4, 2025)";

	aliases {
		ans = &nvme;
		ans-mbox = &ans_mbox;
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		bluetooth0 = &bluetooth0;
		keyboard = &keyboard;
		nvram = &nvram;
		pmu-primary = &pmic1;
		pmp = &pmp;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	/*
	 * The speaker amps' shared shutdown line (SDZ, AP GPIO 15, the ADT
	 * function-reset; low = shutdown). One fixed regulator, the SDZ supply
	 * of all four, so one amp's fault takes the whole group down.
	 */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The AOP firmware runs the stream (MCA cluster 0, one serializer for
	 * the four amps); macaudio's J713 variant links the AOP audio
	 * component's speaker back-end (DAI 3) to them. The codecs are listed in
	 * the ADT provider order, so each gets its native playback slot (LW 0,
	 * RW 1, LT 2, RT 3). The idle masks are the ADT amp-tx-zd-config rows 0
	 * and 1 over the 16 sense byte slots: the left woofer drives zeros in
	 * the right amps' sense slots, the right woofer in the left amps'.
	 */
	sound: sound {
		compatible = "apple,j713-macaudio", "apple,macaudio";
		model = "MacBook Air J713";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0>;
			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f>;

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof>, <&speaker_right_woof>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};

	/*
	 * The headphone jack: the AOP audio component's jack back-end (DAI 4)
	 * to the CS42L84, as a card of its own.
	 */
	sound_jack: sound-jack {
		compatible = "apple,j713-macaudio-jack", "apple,macaudio";
		model = "MacBook Air J713 Jack";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 4>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};

	chosen {
		linux-enablement-mac,disk-boot;
		linux-enablement-mac,dapf-handoff = "/arm-io/aop", "/arm-io/mtp",
			"/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/*
 * m1n1 programs the AOP DART's DAPF and reserves the firmware segments and
 * the DAPF windows in memory-region when /chosen asks for the AOP's handoff,
 * or disables the AOP.
 */
&aop {
	status = "okay";
};

&aop_audio {
	/*
	 * The microphones on LEAP; the speakers and their sense on base-ns TX0
	 * and RX0 (the J616s stream: six playback and twelve sense slots, of
	 * which the four amps take the first four and eight), the jack on TX2
	 * and RX2.
	 */
	dmas = <&admac0 1>, <&admac1 0>, <&admac1 1>, <&admac1 4>, <&admac1 5>;
	dma-names = "dma", "spkr", "sense", "cout", "cin";
	apple,chassis-name = "J713";
	apple,machine-kind = "MacBook Air";
};

/*
 * The four SN012776 speaker amps, held in hardware shutdown until the sound
 * card enables them (ADT /arm-io/i2c3/audio-speaker at 0x38 and its
 * speaker1..3): one interrupt line on AP GPIO 14, level low; sense slots from
 * speaker-config (amp i at RX bytes 4i and 4i + 2, order LW RW LT RT). Names
 * as speakersafetyd's j413/j613 profiles use them. Every amp joins the SDZ
 * fail-closed group.
 */
&i2c3 {
	status = "okay";

	speaker_left_woof: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	speaker_left_tweet: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <8>;
		ti,vmon-slot-no = <10>;
	};

	speaker_right_woof: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <4>;
		ti,vmon-slot-no = <6>;
	};

	speaker_right_tweet: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <12>;
		ti,vmon-slot-no = <14>;
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c1/audio-codec-output at 0x4b).
 * Its reset line is nub GPIO 17, driven high to run the codec; its interrupt
 * is AP GPIO 98, level low. The AOP firmware runs the jack's stream.
 */
&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
	/* A periodic report need not wake the system. */
	apple,hold-rx-in-sleep;
};

&admac0 {
	status = "okay";
};

&admac1 {
	status = "okay";
};

/* Enable DVFS only with the J713 board thermal owner. */
&cpufreq_e {
	status = "okay";
};

&cpufreq_p {
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				/* J713 ADT /arm-io/qspi/spinor/anvram, flash-relative. */
				reg = <0x700000 0x100000>;
			};
		};
	};
};

/*
 * m1n1 performs the T8132 controller and PHY initialization. Linux adopts
 * the trained link and owns DART stream 16, RID-to-SID routing and MSI.
 *
 * The DART fault interrupt is taken from the J713 ADT, independently of
 * the PCIe port and MSI interrupts.
 */
&nub_spmi_a0 {
	status = "okay";
	hpm1: usb-pd@a {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C MagSafe-adjacent";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};
	hpm0: usb-pd@c {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C native client";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&atcphy0 {
	status = "okay";
	/* Retain USB2 until this port's common-power handoff is qualified. */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	status = "okay";
	dr_mode = "host";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	status = "okay";
	/* Leave the display crossbar at core + 0x4c000 to its own driver. */
	reg = <0x4 0x0aa90000 0x0 0x4000>,
	      <0x4 0x0aa84000 0x0 0x4000>,
	      <0x4 0x0b000000 0x0 0x24000>,
	      <0x4 0x08000000 0x0 0x8000>,
	      <0x4 0x08020000 0x0 0x4000>,
	      <0x4 0x0b044000 0x0 0x4000>,
	      <0x4 0x0b050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy1_typec_lanes: endpoint {
				remote-endpoint = <&typec1_connector_ss>;
			};
		};
	};
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>, <&atcphy1 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

&dart_apcie0 {
	status = "okay";
	apple,managed-sids = <1 2>;
	apple,dma-range = <0x100 0x00100000 0x0 0x3fe00000>;
};

&pcie0 {
	status = "okay";
	apple,managed-sids = <1 2>;
	iommu-map = <0x100 &dart_apcie0 1 2>;
	iommu-map-mask = <0xffff>;
	pci@0,0 {
		pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;
		bluetooth0: bluetooth@0,1 {
			compatible = "pci14e4,5f72";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			brcm,board-type = "apple,garden";
			/* Per-machine address and calibration supplied by m1n1. */
			local-bd-address = [00 00 00 00 00 00];
		};
		wifi0: wifi@0,0 {
			compatible = "pci14e4,4434";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "apple,garden";
			local-mac-address = [00 00 00 00 00 00];
			apple,antenna-sku = "XX";
		};
	};
};


&fpwm1 {
	status = "okay";
};

&mcc {
	status = "okay";
	apple,boot-dma-devices = <&pmp>;
};

&pmc {
	status = "okay";
	apple,static-voters = <3>;
};

&smc {
	status = "okay";

	hwmon {
		compatible = "apple,smc-hwmon";

		current-ID0R {
			apple,key-id = "ID0R";
			label = "AC Input Current";
		};

		/* Panel and backlight supply; tracks brightness, idles when blanked. */
		current-Ib8f {
			apple,key-id = "Ib8f";
			label = "Display Supply Current";
		};

		power-PDTR {
			apple,key-id = "PDTR";
			label = "AC Input Power";
		};

		power-PMVC {
			apple,key-id = "PMVC";
			label = "3.8 V Rail Power";
		};

		power-PSTR {
			apple,key-id = "PSTR";
			label = "Total System Power";
		};

		temperature-TB0T {
			apple,key-id = "TB0T";
			label = "Battery Hotspot";
		};

		temperature-TCHP {
			apple,key-id = "TCHP";
			label = "Charge Regulator Temp";
		};

		temperature-TH0x {
			apple,key-id = "TH0x";
			label = "NAND Flash Temperature";
		};

		temperature-TW0P {
			apple,key-id = "TW0P";
			label = "WiFi/BT Module Temp";
		};

		voltage-SBAV {
			apple,key-id = "SBAV";
			label = "Battery Voltage";
		};

		voltage-VD0R {
			apple,key-id = "VD0R";
			label = "Charger Input Voltage";
		};
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};

	reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			<&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
			"boot_error_count", "panic_count";
	};
};

&smc_mbox {
	status = "okay";
};

&nub_spmi {
	status = "okay";

	pmic1: pmic@0 {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0x0 SPMI_USID>; /* To be filled by loader */

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 29 GPIO_ACTIVE_LOW>;

	multi-touch {
		firmware-name = "apple/tpmtfw-j713.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};
};

/*
 * These blocks are initialized and retained by iBoot/DCP. Linux does not yet
 * own the T8132 display power sequence, and the GPIO block must remain live
 * for inherited firmware and input state.
 */
&framebuffer0 {
	/delete-property/ power-domains;
	panel = <&fb_panel>;
};

/ {
	/*
	 * Physical size of the firmware framebuffer's 2560x1600 area below the
	 * notch (13.6" panel, 224 ppi), so simpledrm reports the real DPI.
	 */
	fb_panel: panel {
		width-mm = <290>;
		height-mm = <181>;
		status = "disabled";
	};
};
#include "t8132-j713-gpu.dtsi"
#include "t8132-j713-display.dtsi"
