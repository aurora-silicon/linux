&cpu_p00 {
	enable-method = "spin-table";
	cpu-release-addr = <0 0>;
};

&aic {
	reg = <0x5 0x02400000 0x0 0x1cc000>,
	      <0x5 0x02440000 0x0 0x4>;
};

&smc {
	reg = <0x5 0x0c600000 0x0 0x4000>,
	      <0x5 0x0de00000 0x0 0x170000>;
};

&pmc {
	apple,static-voters = <1 3>;
};

/ {
	/*
	 * The loader fills the operating points, the CS and AFR tables and the
	 * memory regions, and disables the GPU again on anything unexpected.
	 */
	gpu: gpu@288000000 {
		compatible = "apple,agx-t6041";
		reg = <0x2 0x8a600000 0x0 0x88000>,
		      <0x2 0x88000000 0x0 0x3758000>;
		reg-names = "asc", "sgx";
		mboxes = <&agx_mbox>;
		power-domains = <&ps_gfx>;
	};

	agx_mbox: mailbox@28a600000 {
		compatible = "apple,t6040-ascwrap-v6";
		reg = <0x2 0x8a600000 0x0 0x88000>,
		      <0x2 0x8a050000 0x0 0x8>;
		reg-names = "wrapper", "iop-vbar";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1501 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1504 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "recv-not-empty";
		apple,firmware-role = "GFX";
		power-domains = <&ps_gfx>;
		#mbox-cells = <0>;
	};
};

&ps_afr {
	apple,always-on;
	apple,no-auto-pm;
};

&ps_gfx {
	apple,always-on;
	apple,no-auto-pm;
};

/*
 * Four cache planes per AMCC, eight AMCCs on the full part and six on the
 * binned one (ADT amcc-enable-mask 0x3f). List the six every T6041 has.
 */
&mcc {
	reg = <0x2 0x20000000 0x0 0x4000>,
	      <0x2 0x20040000 0x0 0x4000>,
	      <0x2 0x20080000 0x0 0x4000>,
	      <0x2 0x200c0000 0x0 0x4000>,
	      <0x2 0x22000000 0x0 0x4000>,
	      <0x2 0x22040000 0x0 0x4000>,
	      <0x2 0x22080000 0x0 0x4000>,
	      <0x2 0x220c0000 0x0 0x4000>,
	      <0x2 0x24000000 0x0 0x4000>,
	      <0x2 0x24040000 0x0 0x4000>,
	      <0x2 0x24080000 0x0 0x4000>,
	      <0x2 0x240c0000 0x0 0x4000>,
	      <0x2 0x26000000 0x0 0x4000>,
	      <0x2 0x26040000 0x0 0x4000>,
	      <0x2 0x26080000 0x0 0x4000>,
	      <0x2 0x260c0000 0x0 0x4000>,
	      <0x2 0x28000000 0x0 0x4000>,
	      <0x2 0x28040000 0x0 0x4000>,
	      <0x2 0x28080000 0x0 0x4000>,
	      <0x2 0x280c0000 0x0 0x4000>,
	      <0x2 0x2a000000 0x0 0x4000>,
	      <0x2 0x2a040000 0x0 0x4000>,
	      <0x2 0x2a080000 0x0 0x4000>,
	      <0x2 0x2a0c0000 0x0 0x4000>;
};

/*
 * CPU energy model: the T6040 one (t6040.dtsi), measured on a J616s, which
 * has the same E and P cores. Without opp-microwatt no energy model
 * registers, power_allocator has no power actors and the CPU thermal zones
 * never throttle. The P states T6040 lacks (3828, 3888, 3948 MHz) are
 * interpolated in frequency between its neighbours.
 */

&{/opp-table-e/opp01} {
	opp-microwatt = <81900>;
};

&{/opp-table-e/opp02} {
	opp-microwatt = <133100>;
};

&{/opp-table-e/opp03} {
	opp-microwatt = <209400>;
};

&{/opp-table-e/opp04} {
	opp-microwatt = <301400>;
};

&{/opp-table-e/opp05} {
	opp-microwatt = <383900>;
};

&{/opp-table-e/opp06} {
	opp-microwatt = <478500>;
};

&{/opp-table-e/opp07} {
	opp-microwatt = <531000>;
};
