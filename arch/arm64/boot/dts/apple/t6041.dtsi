/*
 * Apple T6041 "M4 Max" SoC
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t604x.dtsi"

&avd {
	compatible = "apple,t6041-max-avd", "apple,t6041-avd", "apple,t8132-avd";
	power-domains = <&ps_avd_sys>;
};

/*
 * The main PMIC is a Chapel at 0xb (ADT nub-spmi0 spmi-chapelL1-b), not the
 * J616s's Abbey at 0xe. Its nvmem cells and RTC alarm registers are at the
 * Abbey offsets (ADT info-rtc_alarm_*).
 */
&nub_spmi0 {
	pmic@b {
		compatible = "apple,chapel-pmic", "apple,spmi-nvmem";
		reg = <0xb SPMI_USID>;

		pmu_rtc: rtc {
			compatible = "apple,t6041-pmu-rtc";
			interrupt-parent = <&nub_spmi0>;
			interrupts = <2 IRQ_TYPE_EDGE_RISING>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
			wakeup-source;
		};

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

/ {
	opp_p0: opp-table-p0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <1260000000>;
			opp-level = <1>;
			opp-microwatt = <513000>;
			clock-latency-ns = <7200>;
		};
		opp02 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-level = <2>;
			opp-microwatt = <715000>;
			clock-latency-ns = <19000>;
