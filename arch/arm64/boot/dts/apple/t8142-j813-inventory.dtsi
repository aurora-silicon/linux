		interrupts = <AIC_IRQ 455 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_sio: iommu@3a5060000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xa5060000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1259 IRQ_TYPE_LEVEL_HIGH>;
