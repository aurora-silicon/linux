		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_scaler: iommu@305260000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x5260000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1208 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_jpeg: iommu@301020000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x1020000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1157 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_apr: iommu@3a1020000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xa1020000 0x0 0xc000>,
		      <0x3 0xa1034000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1381 IRQ_TYPE_LEVEL_HIGH>;
