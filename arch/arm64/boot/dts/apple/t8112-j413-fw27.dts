/* J413 with macOS 27 system firmware (27.2 stub). */
#include "t8112-j413.dts"

/*
 * The 27.x MTP firmware cannot be restarted once quiesced: a boot stage that
 * starts it hands it over running (apple,rtkit-handoff).
 */
&mtp {
	apple,rtkit-keep-running;
};

/* The 27.x trackpad firmware answers only the two-stage power command. */
&mtp_hid {
	multi-touch {
		apple,power-method = <2>;
	};
};

/*
 * The 27.2 GPU firmware keeps running through suspend-to-idle. Gating the GFX
 * domain under it leaves the domain unable to power on at the wake (as on T8132
 * and T6050).
 */
&ps_gfx {
	apple,sleep-retained;
};
