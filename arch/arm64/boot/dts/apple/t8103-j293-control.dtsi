/* Populated board control clients. Transport ownership is not transferred. */

&spi4 {
	panel_controller: panel-timing-controller@0 {
		compatible = "parade,dp855";
		reg = <0>;
		status = "disabled";

		i2c {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			temperature-sensor@70 {
				compatible = "ti,tmp103";
				reg = <0x70>;
				status = "disabled";
			};
			temperature-sensor@71 {
				compatible = "ti,tmp103";
				reg = <0x71>;
				status = "disabled";
			};
			temperature-sensor@72 {
				compatible = "ti,tmp103";
				reg = <0x72>;
				status = "disabled";
			};
		};
	};
};

/ {
	alc0: microphone-service {
		compatible = "apple,t8103-alc", "apple,alc";
		apple,dma-controller = <&aop_admac>;
		apple,instance-id = <0>;
		status = "disabled";
	};
};
