		cpu-p14-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <11600>;
			thermal-sensors = <&smc_hwmon (T600X_CPU_TEMP_BASE + 33)>;	/* Tp0c */

			trips {
