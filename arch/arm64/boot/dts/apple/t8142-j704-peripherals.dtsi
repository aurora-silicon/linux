		      <0x2 0x113f0000 0x0 0x10000>,
		      <0x2 0x10ff0000 0x0 0x10000>,
		      <0x2 0x11ff0000 0x0 0x10000>,
		      <0x2 0x10e40000 0x0 0x10000>,
		      <0x2 0x11e40000 0x0 0x10000>,
		      <0x2 0x10e50000 0x0 0x10000>,
		      <0x2 0x11e50000 0x0 0x10000>,
		      <0x2 0x10e90000 0x0 0x10000>,
		      <0x2 0x11e90000 0x0 0x10000>,
		      <0x2 0x10eb0000 0x0 0x10000>,
		      <0x2 0x11eb0000 0x0 0x10000>;
		status = "disabled";
	};

	hw_hib_exclave_watchdog: hibernation-watchdog@5d82b0000 {
		compatible = "apple,t8142-hibernation-watchdog", "apple,hibernation-watchdog";
		reg = <0x5 0xd82b0000 0x0 0x4000>;
		status = "disabled";
	};

};

