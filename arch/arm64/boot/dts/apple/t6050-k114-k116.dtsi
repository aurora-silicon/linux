/*
 * MacBook Pro (14-inch and 16-inch PROLED XDR, M5 Pro and M5 Max, 2026)
 *
 * Shared by K114c, K114s, K116c and K116s. These are the J714/J716 MacBook Pros
 * with a tandem OLED panel that takes touch input, and a rear Apple logo that is
 * lit by its own light. Everything here comes from the boards' Apple device tree
 * (ADT) as shipped with macOS 27.2. None of it has been tested on the hardware yet.
 *
 * Against J716c the ADT differs in:
 *  - the panel: no I2C backlight driver (i2c7 disp-bklt) and no dp855 TCON; an
 *    "ixora" TCON and a display NAND on spi4 instead. The OLED needs no separate
 *    backlight controller, so the panel only ever runs through the display
 *    coprocessor here, as the boot framebuffer for now.
 *  - the MTP transport: a "kiwi" interface (the touchscreen) next to the trackpad.
 *  - the FPWM channels: pwm1 (fpwm,s5l8920x at 0x305044000) drives the rear logo
 *    ("bklb-backlight", 25 kHz), and pwm2 (0x305048000, "mesa-backlight", 100 Hz)
 *    exists only on these boards.
 *
 * The M5 Pro boards (K114s, K116s) use the same die and, in the static ADT, the
 * same CPU list as the M5 Max ones; the boot loader drops the cores a part does
 * not have from this tree using the ADT the Mac boots with.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include <dt-bindings/leds/common.h>

#include "t6050-max.dtsi"

/ {
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		/* The boot loader fills the N1's factory addresses through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by the loader */
			/* Format properties will be added by the loader */
			/* Scanned out by the internal DCP, handed off or not. */
			display = <&dcp>;
			status = "disabled";
		};
	};

	led-controller {
		compatible = "pwm-leds";

		/* ADT /arm-io/pwm0/kbd-backlight: default-hz 25000 */
		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "apple::kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
		};

		/*
		 * The rear Apple logo, ADT /arm-io/pwm1/bklb-backlight: default-hz 25000.
		 * Keep whatever state the boot loader left it in. The ADT's brightness
		 * mapping (nits-to-pwm-percentage, calibrated per device through syscfg
		 * CGBl) is policy for user space, and its use-enable-pulse is not
		 * handled yet.
		 */
		led-1 {
			pwms = <&fpwm1 0 40000>;
			label = "apple::logo";
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/*
 * ATC3 and the PD controller bus nub-spmi-a2: not described for these boards. The
 * USB-C ports ATC1 and ATC2 are in t6050-k114-k116-usb.dtsi.
 */
&nub_spmi_a2 {
	status = "disabled";
};

&atc3_phy_mbox {
	status = "disabled";
};

&atc3_phy {
	status = "disabled";
};

&usb_drd3 {
	status = "disabled";
};

&usb_drd3_dart_0 {
	status = "disabled";
};

&usb_drd3_dart_1 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

/*
 * As on J716c, where reading pin 112 takes an SError, only the pins a node
 * names are exposed: 80 and 81, PCIe ports 0 and 1's PERST#; 134 and 139, the jack
 * codec's interrupt and reset; 138, the Touch ID sensor's data-ready line
 * (t6050-touchid.dtsi). A board that names more pins replaces the list.
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 80>, <82 52>, <135 3>, <140 81>;
};

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth), the same on all four boards and
 * laid out as on J716c: the boot loader trains the link and keeps power,
 * clocks, the PHY and PERST; Linux owns the routing, MSI and the DART. The
 * port stays disabled until the loader trains it. From the boards' ADT:
 * apcie0 gives port 0's registers and IRQ 1523, pci-bridge0's PERST# is GPIO
 * 80, and the N1's three functions are on DART streams 1-3.
 *
 * The board file defines, before including this file, the N1's personalized
 * firmware (T6050_K_N1_FIRMWARE) and its ADT /chosen board-id
 * (T6050_K_BOARD_ID). The N1's platform ID is board-id << 16 | chip 0x6050.
 * aura's T6050 hand-off wants the host's iommu-map to mark the ports as it
 * found them.
 *
 * PCIe port 1: the SD card reader (ADT apcie0/pci-bridge1/pcie-sdreader, a
 * GL9755), the same on all four boards' ADTs and laid out as on J714s. The
 * boot loader leaves the port down, so the kernel trains it. From the ADTs:
 *   port1, phy1, intr2axi1: apcie0 reg[22], reg[24], reg[25] (port 0's are
 *     reg[16], reg[18], reg[19]), behind /arm-io's ranges (+0x200000000)
 *   phy-shared: apcie0 reg[3], the shared PHY's state, which the train reads;
 *     the boot loader leaves the PHY up with port 0
 *   IRQ 1531: apcie0 interrupts[1]
 *   PERST#: pci-bridge1 function-perst, gpio0 pin 0x51 (81)
 *   power: pcie-sdreader function-sd_pwr_en, SMC pcIO (0x0, 0x190000), output
 *     3 of smc_pcio below
 *   link tunables: pci-bridge1's apcie-config-tunables, pcie-rc-tunables and
 *     pcie-rc-gen{3,4,5}-shadow-tunables, as (offset, size, mask, value)
 * The reader is behind dart-apcie1 (0x211000000, IRQ 1532; manual-availability:
 * it answers only once the root complex is up). The ADT's mapper-apcie1 names
 * no stream (the bridge requests one at run time), so stream 1 is this tree's
 * choice, below the DART's first bypass stream (16), as on J714s.
 * pci-bridge1's function-clkreq (gpio0 pin 0x4d) is not described: the
 * driver does not take CLKREQ# lines.
 */
&pcie0 {
	iommu-map = <0x100 &dart_apcie0 1 3>,
		    <0x200 &dart_apcie1 1 1>;
	bus-range = <0 4>;
	status = "okay";
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>,
	      <0x4 0x11028000 0x0 0x8000>,
	      <0x4 0x17014000 0x0 0x4000>,
	      <0x4 0x11024000 0x0 0x4000>,
	      <0x4 0x17020000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0", "port1", "phy1", "intr2axi1",
		    "phy-shared";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 0 1531 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0", "port1";
	/* dart_apcie1 probes only once port 1 is up: the host must not wait for it */
	post-init-providers = <&dart_apcie1>;

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, driven only by the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = T6050_K_N1_FIRMWARE;
			apple,centauri-platform-id = <((T6050_K_BOARD_ID << 16) | 0x6050)>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};

	port01: pci@1,0 {
		device_type = "pci";
		reg = <0x800 0 0 0 0>;
		bus-range = <2 2>;
		/* Down at boot: the kernel trains it, powering the reader first */
		apple,link-trained-by-bootloader;
		/* ADT pcie-sdreader function-sd_pwr_en: SMC pcIO output 3 below */
		pwren-gpios = <&smc_pcio 3 GPIO_ACTIVE_HIGH>;
		/* PERST#: ADT pci-bridge1 function-perst, GPIO 81 */
		reset-gpios = <&pinctrl_ap 81 GPIO_ACTIVE_LOW>;
		/* ADT pci-bridge1 */
		apple,apcie-config-tunables = <0x140 4 0x1 0x1>,
			<0x144 4 0xffffff 0x253770>,
			<0x8a8 4 0x1 0x1>,
			<0x8ac 4 0x1 0x1>;
		apple,pcie-rc-tunables = <0x78 4 0x7000 0x0>,
			<0x194 4 0x2 0x2>,
			<0xb80 4 0x7f3f3f 0x7f1e1e>,
			<0xb88 4 0x7f3f3f 0x7f1e1e>;
		apple,pcie-rc-gen3-shadow-tunables = <0x154 4 0xf0f0f0f 0x5050505>,
			<0x890 4 0x3000000 0x0>,
			<0x8a8 4 0xffff0f 0x1>;
		apple,pcie-rc-gen4-shadow-tunables = <0x178 4 0xffff 0x5555>,
			<0x890 4 0x3000000 0x1000000>,
			<0x8a8 4 0xffff0f 0x1>;
		apple,pcie-rc-gen5-shadow-tunables = <0x1ac 4 0xffff 0x5555>,
			<0x890 4 0x3000000 0x2000000>,
			<0x8a8 4 0xffff0f 0x1>;

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
				<0 0 0 2 &port01 0 0 0 1>,
				<0 0 0 3 &port01 0 0 0 2>,
				<0 0 0 4 &port01 0 0 0 3>;

		/*
		 * The GL9755. Card detect and write protect are active high: ADT
		 * pcie-sdreader card-detect-polarity and write-protect-polarity = 1.
		 */
		sdhci0: mmc@0,0 {
			compatible = "pci17a0,9755";
			reg = <0x20000 0x0 0x0 0x0 0x0>;
			cd-inverted;
			wp-inverted;
		};
	};
};

/*
 * ADT dart-apcie1 manual-availability: pcie-apple enables it once port 1 is up. It sits in
 * the same apcie block as port 0's DART and takes the same APCIE_SYS_GP (enabled in
 * t6050-k114-k116-usb.dtsi), as the T6040's apcie1_dart at the same address does.
 */
&dart_apcie1 {
	power-domains = <&ps_apcie_sys_gp>;
	apple,manual-availability;
	status = "okay";
};

/*
 * The PMU's RTC and its alarm. The four boards' ADTs (27.2) give the PMU
 * (nub-spmi0/spmi-abbeyL1) the same registers: info-rtc (0x2002),
 * info-rtc_alarm_offset (0x2008), info-rtc_irq_mask_offset (0x200e),
 * info-rtc_alarm_ctrl (0x2000) and info-rtc_scrpad (0x2100), the registers of
 * the T6041 PMU. It raises no interrupt on this SoC: an armed alarm can only
 * wake the machine from a firmware sleep, not from s2idle.
 */
&pmu {
	pmu_rtc: rtc {
		compatible = "apple,t6050-pmu-rtc", "apple,t6041-pmu-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
		wakeup-source;
	};
};

/*
 * SMC sensors, as on J714s: the shared fan, power, voltage and current keys,
 * plus every readable float T* key through apple,discover-temperatures in
 * t6050-die0.dtsi. A key this SMC lacks only drops its channel. Discovery
 * refuses to run once any temperature channel exists, so the shared
 * temperature nodes and apple,soc-die-keys go.
 *
 * The four boards' ADTs carry the same SMC node; all four are dual-fan
 * MacBook Pros like J714s and J716s. The T6050 SMC spells the fan mode keys
 * F0md/F1md and drives the fans itself (no apple,fan-manual-control). The
 * keys are read on K116s; on K114c, K114s and K116c they are assumed the same.
 */
#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"
#include "hwmon-laptop.dtsi"

&smc_hwmon {
	status = "okay";
	/delete-property/ apple,soc-die-keys;
	/delete-node/ temperature-TH0x;
	/delete-node/ temperature-TB0T;
	/delete-node/ temperature-TCHP;
	/delete-node/ temperature-TW0P;
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};
	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};

/*
 * The console is on the USB debug link, which drains only while a host reads
 * it; the machine also boots with nothing attached there.
 */
&dockchannel {
	apple,tx-never-wait;
	status = "okay";
};

&fpwm0 {
	status = "okay";
};

&ps_fpwm1 {
	status = "okay";
};

&fpwm1 {
	status = "okay";
};

/*
 * ADT /arm-io/pwm2/mesa-backlight (default-hz 100), next to the Touch ID sensor
 * (spi2/mesa). What it lights and how macOS drives it is not known yet.
 */
&fpwm2 {
	status = "disabled";
};

/* The MTP and its DockChannel FIFO, which carry the keyboard and trackpad */
&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp {
	status = "okay";
	/* The helper and its HID transport share one IOMMU group, so both list streams 0 and 1. */
	iommus = <&mtp_dart 0>, <&mtp_dart 1>;
};

/*
 * The keyboard, trackpad and touchscreen: the HID transport on the MTP's
 * DockChannel FIFO, laid out as on J716c (ADT dockchannel-mtp/mtp-transport).
 */
&mtp_dockchannel {
	status = "okay";

	mtp_hid: input@8000 {
		compatible = "apple,dockchannel-hid";
		reg = <0x8000 0x1000>, <0xc000 0x1000>,
		      <0x0 0x1000>, <0x4000 0x1000>;
		reg-names = "config", "data", "rmt-config", "rmt-data";
		/*
		 * The coprocessor writes the MTP receive ring over DART stream 1. Both
		 * streams must be in one IOMMU group, so the helper lists the same two.
		 */
		iommus = <&mtp_dart 0>, <&mtp_dart 1>;
		interrupt-parent = <&mtp_dockchannel>;
		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
			     <3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "tx", "rx";
		apple,fifo-size = <0x800>;
		apple,helper-cpu = <&mtp>;
		/* ADT multi-touch function-afe-reset: pKW8('pcIO', 0x10000, 0x11c0000) */
		apple,afe-reset-gpios = <&smc_pcio 2 GPIO_ACTIVE_HIGH>;

		mtp_multitouch: multi-touch {
			apple,power-method = <2>;
		};

		keyboard {
		};

		stm {
		};

		/*
		 * The trackpad's haptic engine (ADT mtp-transport/actuator). The
		 * ADT gives it no click strength, so the firmware's is kept.
		 */
		actuator {
		};

		/*
		 * The touchscreen (ADT mtp-transport/kiwi, image-tag "fsat"). macOS
		 * sends it firmware through the same CBOR bootloader as the trackpad.
		 * Its power, reset, 24 MHz clock and display-sync lines are SoC GPIOs
		 * (nub-gpio0 0x1a, 0x19, 0x16; gpio0 0xb), with an SMC power reference
		 * (pKW4('rCIO', 0x20000)) and the TSRC clock source. How that load and
		 * the report format map onto this transport is still being worked
		 * out, so the interface stays off until it has been tested.
		 */
		kiwi: kiwi {
			status = "disabled";
		};
	};
};

/*
 * The board's pcIO outputs, from the ADT: dp2hdmi_pwr_en pKW8('pcIO', 0, 0x1a0000),
 * hdmi_pwr_en pKW8('pcIO', 0x800000, 0xf0000), and the trackpad AFE reset (2),
 * pKW8('pcIO', 0x10000, 0x11c0000), the same as on J716c; then the SD reader's
 * power (3), sd_pwr_en pKW8('pcIO', 0x0, 0x190000): ADT pcie-sdreader
 * function-sd_pwr_en.
 */
&smc_pcio {
	apple,output-commands = /bits/ 64 <0x001a000000000000 0x000f000000800000
					   0x011c000000010000 0x0019000000000000>;
};

/*
 * Port 0's power: the ADT's apcie0 power-gates are APCIE_GP (137), APCIE_SYS_GP (143) and the
 * fabric; APCIE_SYS_GP sits on APCIE_GP and FAB6_SOC. Its DART (dart-apcie0, which the N1 uses
 * through the host's iommu-map) takes APCIE_SYS_GP, as the T600x/T602x PCIe DARTs do. The loader
 * trains port 0 and keeps it powered for the hand-off, so these stay firmware-owned
 * (enabled in t6050-k114-k116-usb.dtsi, which boards include after t6050-peripherals.dtsi).
 */
&dart_apcie0 {
	power-domains = <&ps_apcie_sys_gp>;
};

/ {
	aliases {
		/* asahi-bless and the boot loader find the NVRAM partition by this alias */
		nvram = &nvram;
	};
};

/*
 * The boot NOR's NVRAM partition, the same in the live K114s, K116s and J716c ADTs and the
 * K114c and K116c 27.2 DeviceTrees: /arm-io/qspi/spinor/anvram, 0x700000, 0xc0000 bytes, 12
 * banks of 64 KiB. Only this partition is described, so the rest of the NOR has no device
 * node. Single-wire, as on the J775D: spi-nor then sends no quad-enable status write at probe.
 *
 * The partition is writable, as on the J616s, J713 and J700, so asahi-bless and aurora-bless
 * can set the next boot. spi-apple-qspi still starts read-only and, once root
 * opts in, admits only bounded, verified programs and 4 KiB erases of a known part inside it.
 */
&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				reg = <0x700000 0xc0000>;
			};
		};
	};
};
