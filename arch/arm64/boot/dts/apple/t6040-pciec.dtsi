/*
 * T6040 PCIe-C (tunneled PCIe) on the three Thunderbolt ports, e.g. a
 * Studio Display's xHCI. No boot loader hands the ports over: the kernel
 * cold-initializes them. The tunnels are part of the SoC and have no board
 * wiring, so they are enabled on every T6040 (the ADT of every T6040 Mac
 * lists apciec0-2 and dart-apciec0-2). The controller only comes up when its
 * USB4 router, which the board enables, asks for a PCIe tunnel.
 *
 * From the ADT (macOS 26 IODeviceTree), identical for apciec0-2 and
 * dart-apciec0-2 and between the J614s and J616s:
 * - the DART's DMA window: vm-base 1 TiB + 2 GiB, vm-size 0x7ff00000, its
 *   first 16 KiB a dead mapping;
 * - bypass-253 and bypass-255: the port's own writes (MSIs turned into AIC
 *   writes) use those reserved streams, which must bypass, as on T6050;
 * - the DART tunables, the controller's debug, rc and fabric tunables and
 *   the port's config tunables.
 * Full error reporting, CTC flush and the ATC PCIe power domain as on
 * T6050's PCIe-C DART.
 */

#define T6040_PCIEC(n)								\
&usb4_##n##_pcie_tunnel {							\
	status = "okay";							\
};										\
										\
&apciec##n##_dart {								\
	apple,dma-range = <0x100 0x80004000 0x0 0x7fefc000>;			\
	power-domains = <&ps_atc##n##_pcie>;					\
	apple,bypass-sids = <253 255>;						\
	apple,full-error-reporting;						\
	apple,ctc-flush;							\
	apple,tunable = <0x20c 0x80000121 0x80000121>,				\
			<0x220 0xf0f0f 0xf0f0f>,				\
			<0x224 0xffffff 0x80808>,				\
			<0x300 0x1f31 0x1>,					\
			<0x308 0x3ffffffc 0x10000000>,				\
			<0x310 0x3ffffffc 0x3ffffffc>;				\
	status = "okay";							\
};										\
										\
&usb4_##n##_pcie {								\
	apple,pciec-kernel-init;						\
	apple,tunable-debug = <0x1000 0x1 0x0>;					\
	apple,tunable-rc = <0x78 0x7000 0x0>,					\
			   <0x718 0x7c000 0x0>,					\
			   <0x814 0xffffffff 0x2000f060>,			\
			   <0x8bc 0x1 0x0>;					\
	apple,tunable-fabric = <0x4 0x1f001f 0x100010>,				\
			       <0x8 0x1 0x1>,					\
			       <0xc 0x1 0x1>,					\
			       <0x10 0x801f 0x4>,				\
			       <0x18 0xff 0xe0>,				\
			       <0x1c 0x1 0x1>,					\
			       <0x20 0x801f 0x4>,				\
			       <0x28 0x1f 0x10>,				\
			       <0x2c 0x801f 0x4>,				\
			       <0x34 0x3f 0x20>,				\
			       <0x38 0x801f 0x4>,				\
			       <0x40 0x3f 0x20>,				\
			       <0x44 0x801f 0x4>,				\
			       <0x4c 0x10001 0x10001>,				\
			       <0x50 0x1 0x1>,					\
			       <0x54 0x1 0x1>,					\
			       <0x58 0x801f 0x4>,				\
			       <0x60 0x7f007f 0x450045>,			\
			       <0x64 0x801f 0x4>,				\
			       <0x6c 0x1f001f 0x100010>,			\
			       <0x70 0xf1 0x1>,					\
			       <0x74 0x801f 0x4>,				\
			       <0x7c 0x801f 0x4>,				\
			       <0x84 0x1 0x1>,					\
			       <0x88 0x1 0x1>,					\
			       <0x8c 0x801f 0x4>,				\
			       <0x94 0x1 0x1>,					\
			       <0x98 0x801f 0x4>,				\
			       <0xa0 0x1 0x1>,					\
			       <0xa4 0x801f 0x4>,				\
			       <0xac 0x1 0x1>,					\
			       <0xb0 0x1 0x1>,					\
			       <0xb4 0x801f 0x4>,				\
			       <0xbc 0x801f 0x4>,				\
			       <0xc4 0x801f 0x4>;				\
	status = "okay";							\
};										\
										\
&usb4_##n##_pcie_port {								\
	apple,tunable = <0x140 0x1 0x1>,					\
			<0x2a0 0x7e 0xa>,					\
			<0x1090 0x1 0x0>;					\
};

T6040_PCIEC(0)
T6040_PCIEC(1)
T6040_PCIEC(2)

#undef T6040_PCIEC
