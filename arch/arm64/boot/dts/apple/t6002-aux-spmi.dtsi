		};
	};

	clvr_spmi2_die1: spmi@28e511100 {
		compatible = "apple,t6000-spmi", "apple,spmi";
		reg = <0x2 0x8e511100 0x0 0x100>,
		      <0x2 0x8e510e00 0x0 0x100>,
		      <0x2 0x8e510400 0x0 0x78>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1 344 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;
		#address-cells = <2>;
		#size-cells = <0>;
		status = "disabled";
		pmic@f {
			compatible = "apple,monaco-pmic", "apple,spmi-nvmem";
			reg = <0xf SPMI_USID>;
			status = "disabled";
		};
	};

	clvr_spmi3_die1: spmi@28e519100 {
		compatible = "apple,t6000-spmi", "apple,spmi";
		reg = <0x2 0x8e519100 0x0 0x100>,
		      <0x2 0x8e518e00 0x0 0x100>,
		      <0x2 0x8e518400 0x0 0x78>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1 346 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;
		#address-cells = <2>;
