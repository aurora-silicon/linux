/* The Abbey PMICs on the two other NUB SPMI buses (ADT spmi-abbeyF1/F2). */
&nub_spmi1 {
	status = "okay";

	pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;
	};
};

&nub_spmi2 {
	status = "okay";

	pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;
	};
};

&ps_nub_spmi_ahb {
	status = "okay";
};

&ps_nub_spmi1 {
	status = "okay";
};

&ps_nub_spmi2 {
	status = "okay";
};

/* As on the J616s: idle until the loader fills the preload reservations. */
&ane0_dart0 {
	status = "okay";
};

&ane0_dart1 {
	status = "okay";
};

&ane0_dart2 {
	status = "okay";
};

&ane {
	memory-region = <&ane_fw_text>, <&ane_fw_data>;
	memory-region-names = "firmware-text", "firmware-data";
	power-domains = <&ps_ane_sys>, <&ps_ane_cpu>, <&ps_ane_mpm>,
			<&ps_ane_td>, <&ps_ane_base>, <&pmc_soc_max>;
	power-domain-names = "sys", "cpu", "mpm", "td", "base", "perf";
	status = "okay";
};

/*
 * HDMI is not described: it runs through the LPDPTX PHY (ADT lpdptx-phy0,
 * display crossbar output 4) and a converter on i2c8, which have no T6040
 * driver. The SEP stays off: its driver only runs on boards whose Touch ID
 * wiring was read.
 */
