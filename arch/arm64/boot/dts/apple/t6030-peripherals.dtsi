		reg = <0x2 0xca4b0000 0x0 0x4000>;
		status = "disabled";
	};

	dart_isp_companion4: iommu@2ca4b8000 {
		compatible = "apple,t6030-dart-smmu", "apple,dart-smmu";
		reg = <0x2 0xca4b8000 0x0 0x4000>;
		status = "disabled";
	};

	dart_isp_companion5: filter@2ca4ac000 {
		compatible = "apple,t6030-dapf", "apple,dapf";
		reg = <0x2 0xca4ac000 0x0 0x4000>;
		status = "disabled";
	};

	dart_ane_companion3: filter@309804000 {
		compatible = "apple,t6030-dapf", "apple,dapf";
		reg = <0x3 0x09804000 0x0 0x4000>;
		status = "disabled";
	};

	apcie1_piodma: dma-controller@595010000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0x5 0x95010000 0x0 0x4000>,
		      <0x5 0x95014000 0x0 0x4000>,
		      <0x5 0x95018000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1049 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&pcie0_dart_1 15>;
		status = "disabled";
	};

	apcie0_piodma: dma-controller@594010000 {
