// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Additional T6030 hardware interfaces. Keep unclaimed engines disabled. */

&soc {
	dart_rsm: iommu@36433c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x6433c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 345 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_scaler: iommu@391200000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x91200000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 861 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_msr>;
		status = "disabled";
	};

	dart_jpeg0: iommu@299004000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0x99004000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 853 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_jpg>;
		status = "okay";
	};

	dart_jpeg1: iommu@29900c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0x9900c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 856 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_jpg>;
		status = "okay";
	};

	dart_ave0: iommu@2cd030000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0xcd030000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 807 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_ave1: iommu@2cd040000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0xcd040000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 807 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_ave2: iommu@2cd020000 {
		compatible = "apple,t6030-dart-smmu", "apple,dart-smmu";
		reg = <0x2 0xcd020000 0x0 0x4000>;
		status = "disabled";
	};

	dart_ave3: filter@2cd044000 {
		compatible = "apple,t6030-dapf", "apple,dapf";
		reg = <0x2 0xcd044000 0x0 0x4000>;
		status = "disabled";
	};

	dart_apr0: iommu@30d028000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x0d028000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 971 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_apr1: iommu@30d02c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x0d02c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 971 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_aop_companion1: filter@37481c000 {
		compatible = "apple,t6030-dapf", "apple,dapf";
		reg = <0x3 0x7481c000 0x0 0x4000>;
