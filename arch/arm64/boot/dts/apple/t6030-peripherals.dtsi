// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Additional T6030 hardware interfaces. Keep unclaimed engines disabled. */

&soc {
	dart_rsm: iommu@36433c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x6433c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 345 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_scaler: iommu@391200000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x91200000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 861 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_jpeg0: iommu@299004000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0x99004000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 853 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_jpeg1: iommu@29900c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0x9900c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 856 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_ave0: iommu@2cd030000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0xcd030000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 807 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_ave1: iommu@2cd040000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x2 0xcd040000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 807 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_ave2: iommu@2cd020000 {
		compatible = "apple,t6030-dart-smmu", "apple,dart-smmu";
		reg = <0x2 0xcd020000 0x0 0x4000>;
		status = "disabled";
	};

	dart_ave3: filter@2cd044000 {
		compatible = "apple,t6030-dapf", "apple,dapf";
		reg = <0x2 0xcd044000 0x0 0x4000>;
		status = "disabled";
	};

	dart_apr0: iommu@30d028000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x0d028000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 971 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dart_apr1: iommu@30d02c000 {
		compatible = "apple,t6030-dart", "apple,t8110-dart";
		reg = <0x3 0x0d02c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 971 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	apcie1_piodma: dma-controller@595010000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0x5 0x95010000 0x0 0x4000>,
		      <0x5 0x95014000 0x0 0x4000>,
		      <0x5 0x95018000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1049 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	apcie0_piodma: dma-controller@594010000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0x5 0x94010000 0x0 0x4000>,
		      <0x5 0x94014000 0x0 0x4000>,
		      <0x5 0x94018000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1040 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	apciec0_piodma: dma-controller@722000000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0x7 0x22000000 0x0 0x4000>,
		      <0x7 0x22004000 0x0 0x4000>,
		      <0x7 0x22008000 0x0 0x4000>,
		      <0x7 0x20008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1078 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc0_dpin0: displayport@701e50000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0x7 0x01e50000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1123 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc0_dpin1: displayport@701e58000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0x7 0x01e58000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1124 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	apciec1_piodma: dma-controller@b22000000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0xb 0x22000000 0x0 0x4000>,
		      <0xb 0x22004000 0x0 0x4000>,
		      <0xb 0x22008000 0x0 0x4000>,
		      <0xb 0x20008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1136 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc1_dpin0: displayport@b01e50000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0xb 0x01e50000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1181 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc1_dpin1: displayport@b01e58000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0xb 0x01e58000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1182 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	apciec2_piodma: dma-controller@f22000000 {
		compatible = "apple,t6030-pcie-piodma", "apple,pcie-piodma";
		reg = <0xf 0x22000000 0x0 0x4000>,
		      <0xf 0x22004000 0x0 0x4000>,
		      <0xf 0x22008000 0x0 0x4000>,
		      <0xf 0x20008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1194 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc2_dpin0: displayport@f01e50000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0xf 0x01e50000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1239 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	atc2_dpin1: displayport@f01e58000 {
		compatible = "apple,t6030-dp-in", "apple,dp-in";
		reg = <0xf 0x01e58000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1240 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	mcc: memory-controller@3503c0000 {
		compatible = "apple,t6030-mcc", "apple,mcc";
		reg = <0x3 0x503c0000 0x0 0x20000>,
		      <0x3 0x50478000 0x0 0x149c>,
		      <0x3 0x50780000 0x0 0x4000>,
		      <0x2 0x20000000 0x0 0x2000000>,
		      <0x2 0x22000000 0x0 0x2000000>;
		status = "disabled";
	};

	aes: crypto@28900c000 {
		compatible = "apple,t6030-aes", "apple,aes";
		reg = <0x2 0x8900c000 0x0 0x4000>,
		      <0x3 0x642dc000 0x0 0x8000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 887 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_aes>;
		status = "disabled";
	};

	rsm: rsm@364325000 {
		compatible = "apple,t6030-rsm", "apple,rsm";
		reg = <0x3 0x64325000 0x0 0x4000>,
		      <0x3 0x643c0000 0x0 0x4>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 342 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dart_rsm 0>;
		status = "disabled";
	};

	scaler0: scaler@391000000 {
		compatible = "apple,t6030-scaler", "apple,scaler";
		reg = <0x3 0x91000000 0x0 0x30000>,
		      <0x3 0x91210000 0x0 0x4000>,
		      <0x3 0x91204000 0x0 0x4000>,
		      <0x3 0x90000000 0x0 0x8000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 860 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 862 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_msr>, <&ps_msr_ase_core>;
		iommus = <&dart_scaler 0>, <&dart_scaler 1>;
		status = "disabled";
	};

	jpeg0: jpeg@299000000 {
		compatible = "apple,t6030-jpeg", "apple,jpeg";
		reg = <0x2 0x99000000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 852 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		iommus = <&dart_jpeg0 0>;
		status = "disabled";
	};

	jpeg1: jpeg@299008000 {
		compatible = "apple,t6030-jpeg", "apple,jpeg";
		reg = <0x2 0x99008000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 855 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_jpg>;
		iommus = <&dart_jpeg1 0>;
		status = "disabled";
	};

	ave: video-encoder@2cd100000 {
		compatible = "apple,t6030-ave", "apple,ave";
		reg = <0x2 0xcd100000 0x0 0x45c000>,
		      <0x2 0xcd800000 0x0 0x800000>,
		      <0x2 0xcd050000 0x0 0x4000>,
		      <0x3 0x507003d0 0x0 0x7c54>,
		      <0x2 0xcc000000 0x0 0x1000000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 810 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 804 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 803 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 806 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 805 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_venc_sys>, <&ps_venc_pipe4>, <&ps_venc_pipe5>, <&ps_venc_me0>, <&ps_venc_me1>, <&ps_venc_dma>;
		iommus = <&dart_ave0 0>, <&dart_ave1 0>;
		status = "disabled";
	};

	apr: video-codec@30d000000 {
		compatible = "apple,t6030-prores", "apple,prores";
		reg = <0x3 0x0d000000 0x0 0x4000>,
		      <0x3 0x0c000000 0x0 0x8000>,
		      <0x3 0x0d078000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 972 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1009 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_scodec>;
		iommus = <&dart_apr0 1>, <&dart_apr1 1>;
		status = "disabled";
	};

};
