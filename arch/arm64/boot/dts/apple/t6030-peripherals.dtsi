	mcc: memory-controller@3503c0000 {
		compatible = "apple,t6030-mcc", "apple,mcc";
		reg = <0x3 0x503c0000 0x0 0x20000>,
		      <0x3 0x50478000 0x0 0x149c>,
		      <0x3 0x50780000 0x0 0x4000>,
		      <0x2 0x20000000 0x0 0x2000000>,
		      <0x2 0x22000000 0x0 0x2000000>;
		status = "disabled";
	};

