/*
 * J714s left-front USB-C port (ATC1): the USB4/Thunderbolt router and its PCIe tunnel.
 *
 * The same router and tunnel as J716c's ATC1 (t6050-j716c-left-usb4.dtsi), at the J714sAP ADT's
 * addresses and interrupts (/arm-io/acio1, acio-cpu1, dart-acio1, apciec1, dart-apciec1). Like
 * the right port's (t6050-max-atc2.dtsi), it is powered per connection and nothing is touched at
 * boot. The router, DART and tunnel tunables are this board's, from its ADT; they equal ATC2's.
 */

&ps_atc1_cio {
	power-domains = <&ps_atc1_common>;
	status = "okay";
};

&ps_atc1_cio_pcie {
	power-domains = <&ps_atc1_cio>;
	status = "okay";
};

&ps_atc1_cio_usb {
	power-domains = <&ps_atc1_cio>;
	status = "okay";
};

&ps_atc1_cio_auss {
	power-domains = <&ps_atc1_cio>, <&ps_auss>;
	status = "okay";
};

/* With the ATC1 USB always-on clock gate, as ATC2_PCIE */
&ps_atc1_pcie {
	power-domains = <&ps_atc1_common>, <&ps_atc1_usb_aon>;
	status = "okay";
};

/* LSTX: /arm-io/acio1 gpio-lstx, AOP GPIO pin 79 (0x4f), function 1 for the router */
&pinctrl_aop {
	acio1_lstx_pins: acio1-lstx-pins {
		pinmux = <0x1004f>;	/* APPLE_PINMUX(79, 1) */
	};
};

/* The two routers' LSTX pins (79 and 81) are the only AOP GPIOs exposed. */
&pinctrl_aop {
	gpio-reserved-ranges = <0 79>, <80 1>, <82 3>;
};

&{/soc@200000000} {
	/* /arm-io/acio-cpu1 reg[0]: the router CPU's mailbox, inside its wrapper */
	acio1_mbox: mailbox@2a9108000 {
		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x2 0xa9108000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 847 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 848 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 849 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 850 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
	};

	acio1: acio@2a9ac0000 {
		compatible = "apple,t6050-usb4-acio";
		reg = <0x2 0xa9ac0000 0x0 0xc000>,
		      <0x2 0xa9080000 0x0 0x26000>,
		      <0x2 0xa9e44000 0x0 0x4000>,
		      <0x2 0xa9100000 0x0 0x4000>,
		      <0x2 0xa9c80000 0x0 0x4000>;
		reg-names = "rc", "sram", "pcie-adapter", "cpu", "router-ap-fw";
		mboxes = <&acio1_mbox>;
		resets = <&cio_reconfig0 1>;
		/* ATC1_PCIE last: the PCIe tunnel root port, set up before it is populated */
		power-domains = <&ps_atc1_cio>, <&ps_atc1_cio_pcie>,
				<&ps_atc1_cio_usb>, <&ps_atc1_cio_auss>, <&ps_atc1_pcie>;
		thunderbolt-switch;
		apple,pcie-tunnel = <&acio1_pcie_tunnel>;
		pinctrl-0 = <&acio1_lstx_pins>;
		pinctrl-names = "lstx";
		lstx-gpios = <&pinctrl_aop 79 GPIO_ACTIVE_HIGH>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x2 0xa9000000 0x1000000>;
		nonposted-mmio;

		acio1_dart: iommu@a80000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0xa80000 0xc000>;
			interrupts = <AIC_IRQ 0 1638 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc1_cio>;
			#iommu-cells = <1>;
			apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
			apple,bypass-sids = <15>;
			apple,full-error-reporting;
			apple,ctc-flush;
		};

		/* Interrupts 0x64b.. are the TX rings and 0x657.. the RX rings */
		acio1_nhi: nhi@f00000 {
			compatible = "apple,t6050-usb4-nhi";
			reg = <0xf00000 0x100000>;
			reg-names = "nhi";
			interrupts = <AIC_IRQ 0 1611 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1612 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1613 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1614 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1615 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1616 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1617 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1618 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1619 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1620 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1621 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1622 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1623 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1624 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1625 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1626 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1627 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1628 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1629 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1630 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1631 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1632 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1633 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1634 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 1640 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "txring0", "txring1", "txring2", "txring3",
					  "txring4", "txring5", "txring6", "txring7",
					  "txring8", "txring9", "txring10", "txring11",
					  "rxring0", "rxring1", "rxring2", "rxring3",
					  "rxring4", "rxring5", "rxring6", "rxring7",
					  "rxring8", "rxring9", "rxring10", "rxring11",
					  "parity";
			iommus = <&acio1_dart 0>,
				 <&acio1_dart 1>,
				 <&acio1_dart 2>,
				 <&acio1_dart 3>,
				 <&acio1_dart 4>,
				 <&acio1_dart 5>,
				 <&acio1_dart 6>,
				 <&acio1_dart 7>,
				 <&acio1_dart 8>,
				 <&acio1_dart 9>,
				 <&acio1_dart 10>,
				 <&acio1_dart 11>,
				 <&acio1_dart 16>,
				 <&acio1_dart 17>,
				 <&acio1_dart 18>,
				 <&acio1_dart 19>,
				 <&acio1_dart 20>,
				 <&acio1_dart 21>,
				 <&acio1_dart 22>,
				 <&acio1_dart 23>,
				 <&acio1_dart 24>,
				 <&acio1_dart 25>,
				 <&acio1_dart 26>,
				 <&acio1_dart 27>;
		};
	};
};

/*
 * ATC1's PCIe tunnel: /arm-io/apciec1 and dart-apciec1, the PCIe-C root port behind the router's
 * PCIe down adapter, set up as ATC2's. MSIs use the bridge's 32-vector slice (160-191).
 */
/ {
	acio1_pcie_tunnel: pcie-tunnel-1 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		apciec1_dart: iommu@2ac000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0xac000000 0x0 0x20000>;
			interrupts = <AIC_IRQ 0 1438 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc1_pcie>;
			#iommu-cells = <1>;
			apple,bypass-sids = <253 255>;
			apple,full-error-reporting;
			apple,ctc-flush;
		};

		apciec1: pcie@1c60000000 {
			compatible = "apple,t6050-pciec";
			device_type = "pci";
			reg = <0x1c 0x60000000 0x0 0x10000000>,
			      <0x2 0xac034000 0x0 0x4000>,
			      <0x2 0xac020000 0x0 0x8000>,
			      <0x2 0xac038000 0x0 0x4000>,
			      <0x2 0xac060000 0x0 0x4000>,
			      <0x2 0xac02c000 0x0 0x4000>,
			      <0x2 0xac028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug", "ltssm", "intr2axi";
			/* The port's: link events and INTx */
			interrupts = <AIC_IRQ 0 1437 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port0";
			power-domains = <&ps_atc1_pcie>;
			/* No boot loader hands the port over: the kernel cold-initializes it. */
			apple,pciec-kernel-init;

			msi-controller;
			msi-parent = <&apciec1>;
			msi-ranges = <&aic AIC_IRQ 0 1984 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <160>;

			iommu-map = <0x0 &apciec1_dart 0x0 0x40>;
			iommu-map-mask = <0x3f>;
			linux,pci-domain = <2>;
			bus-range = <0x0 0x7f>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0xc 0x0 0xc 0x0 0x2 0x0>,
				 <0x02000000 0x0 0x00100000 0xe 0x00100000 0x0 0x3ff00000>,
				 <0x42000000 0x0 0x40000000 0xe 0x40000000 0x0 0x40000000>;

			apciec1_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;

				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &apciec1_port 0 0 0 0>,
						<0 0 0 2 &apciec1_port 0 0 0 1>,
						<0 0 0 3 &apciec1_port 0 0 0 2>,
						<0 0 0 4 &apciec1_port 0 0 0 3>;
			};
		};
	};
};

/*
 * The PHY's CIO80 RX_TOP tunables (ADT atc-phy1 tunable_LN0/LN1_RX_TOP_CIO_DFLT). Unlike
 * ATC2's, this port's set the field to 0x200.
 */
&atc1_phy {
	apple,tunable-lane0-rx-top-cio = <0x35c 0xe00 0x200>;
	apple,tunable-lane1-rx-top-cio = <0x35c 0xe00 0x200>;
};

&typec1 {
	ports {
		port@3 {
			reg = <3>;
			typec1_usb4: endpoint {
				remote-endpoint = <&acio1_tbt>;
			};
		};
	};
};

&acio1 {
	apple,tunable-rc = <0x0 0xfff0 0x4020>,
			   <0x2c 0x4 0x0>,
			   <0x4004 0x1ff01ff 0x1000100>,
			   <0x4008 0x801f 0x4>,
			   <0x4010 0x7f 0x40>,
			   <0x4014 0x801f 0x4>,
			   <0x401c 0x7f 0x40>,
			   <0x4024 0x801f 0x4>,
			   <0x402c 0x7f 0x40>,
			   <0x4030 0x801f 0x4>,
			   <0x4038 0xffffffff 0x1010101>,
			   <0x403c 0xffff 0x101>,
			   <0x4040 0x1 0x1>,
			   <0x4044 0xffffffff 0x1010101>,
			   <0x4048 0x1 0x1>,
			   <0x404c 0x801f 0x4>,
			   <0x8004 0x70007 0x40004>,
			   <0x8008 0x801f 0x4>,
			   <0x8010 0x70007 0x40004>,
			   <0x8018 0x801f 0x4>,
			   <0x8020 0x70007 0x40004>,
			   <0x8028 0x801f 0x4>,
			   <0x8030 0x801f 0x4>,
			   <0x8038 0x801f 0x4>,
			   <0x8040 0x801f 0x4>,
			   <0x8048 0x801f 0x4>,
			   <0x8050 0x801f 0x4>,
			   <0x8058 0x801f 0x4>,
			   <0x8060 0x801f 0x4>;
	apple,tunable-pcie-adapter = <0x1008 0x6 0x6>;
	apple,tunable-router-ap-fw = <0x8 0xff2 0x482>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			acio1_tbt: endpoint {
				remote-endpoint = <&typec1_usb4>;
			};
		};
	};
};

&acio1_dart {
	apple,tunable = <0x20c 0x80000121 0x80000121>,
			<0x220 0xf0f 0xf0f>,
			<0x224 0xffff 0x909>,
			<0x300 0x1f31 0x1>,
			<0x308 0x3ffffffc 0x10000000>,
			<0x310 0x3ffffffc 0x3ffffffc>,
			<0x800 0xf003f 0x10000>,
			<0x804 0xf003f 0x10002>,
			<0x808 0xf003f 0x10004>,
			<0x80c 0xf003f 0x20006>,
			<0x810 0xf003f 0x2000a>,
			<0x814 0xf003f 0x2000e>,
			<0x818 0xf003f 0x20012>,
			<0x81c 0xf003f 0x20016>,
			<0x820 0xf003f 0x2001a>,
			<0x824 0xf003f 0x2001e>,
			<0x828 0xf003f 0x20022>,
			<0x82c 0xf003f 0x20026>,
			<0x830 0xf003f 0x2002a>,
			<0x834 0xf003f 0x2002e>,
			<0x838 0xf003f 0x20032>,
			<0x83c 0xf003f 0x10036>;
};

