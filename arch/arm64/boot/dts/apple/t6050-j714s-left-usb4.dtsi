/* The tunnel's tunables: this board's, equal to ATC2's */
&apciec1_dart {
	apple,tunable = <0x20c 0x80000121 0x80000121>,
			<0x220 0xf0f 0xf0f>,
			<0x224 0xffff 0x909>,
			<0x300 0x1f31 0x1>,
			<0x308 0x3ffffffc 0x10000000>,
			<0x310 0x3ffffffc 0x3ffffffc>;
};

