/*
 * Apple MacBook Neo
 *
 * target-type: J700
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8140.dtsi"
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j700", "apple,t8140", "apple,arm-platform";
	model = "Apple MacBook Neo";

	aliases {
		serial0 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};
};

#include "isp-imx558.dtsi"

&serial0 {
	status = "okay";
};

&pinctrl_ap {
	status = "okay";
};

&i2c0 {
	status = "okay";

	jack_codec: codec@48 {
		compatible = "cirrus,cs42l83";
		reg = <0x48>;
		reset-gpios = <&pinctrl_ap 103 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <104 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		cirrus,ts-inv = <1>;
		sound-name-prefix = "Jack";
	};
};

&isp {
	apple,platform-id = <0x70>;
	apple,temporal-filter = <1>;
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J700";
	apple,machine-kind = "MacBook Neo";
};

&admac_leap_ns {
	status = "okay";
};

&admac_base_ns {
	status = "okay";
};

&admac_leap_s {
	status = "okay";
};

/ {
	speaker_amp: audio-amplifier {
		compatible = "maxim,max98360a";
		sdmode-gpios = <&pinctrl_ap 105 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
	};
	sound {
		compatible = "apple,j700-macaudio", "apple,macaudio";
		model = "MacBook Neo J700";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};


		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 4>;
			};
			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};
};

/* Keep the state-preserving idle path; a boot-time frequency setting alone
 * does not replace the live SMC thermal policy. The optional PMP thermal
 * policy is disabled here because its current sampler requires awake cores.
 */
/ {
	chosen {
		bootargs = "idle=wfi arm64.nowfxt pmp_v2.thermal_policy=0";
	};
};

&smc_mbox {
	status = "okay";
};

/* Baku's legacy scratchpad starts at the own-device ADT's 0xf700.
 * The cell offsets and bitfields follow the existing Apple SMC boot-state
 * layout. The shutdown flag is needed for power-off rather than reboot.
 */
&{/soc} {
	nub_spmi0: spmi@308714000 {
		compatible = "apple,t8140-spmi", "apple,t8103-spmi";
		reg = <0x3 0x08714000 0x0 0x100>;
		#address-cells = <2>;
		#size-cells = <0>;
		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_nub_spmi0>;

		pmic@e {
			compatible = "apple,baku-pmic", "apple,spmi-nvmem";
			reg = <0xe SPMI_USID>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				boot_stage: boot-stage@f701 {
					reg = <0xf701 0x1>;
				};

				boot_error_count: boot-error-count@f702,0 {
					reg = <0xf702 0x1>;
					bits = <0 4>;
				};

				panic_count: panic-count@f702,4 {
					reg = <0xf702 0x1>;
					bits = <4 4>;
				};

				shutdown_flag: shutdown-flag@f70f,3 {
					reg = <0xf70f 0x1>;
					bits = <3 1>;
				};
			};
		};
	};
};

&smc {
	status = "okay";

	reboot {
		compatible = "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			      <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
				   "boot_error_count", "panic_count";
	};

	hwmon {
		compatible = "apple,smc-hwmon";
		apple,cpu-thermal-policy;
		/* First six channels feed CPU protection; the rest report only. */
		temperature-Te05 {
			apple,key-id = "Te05";
			label = "E-cluster Temperature 1";
		};

		temperature-Te0S {
			apple,key-id = "Te0S";
			label = "E-cluster Temperature 2";
		};

		temperature-Tp01 {
			apple,key-id = "Tp01";
			label = "P-cluster Temperature 1";
		};

		temperature-Tp05 {
			apple,key-id = "Tp05";
			label = "P-cluster Temperature 2";
		};

		temperature-Tp09 {
			apple,key-id = "Tp09";
			label = "P-cluster Temperature 3";
		};

		temperature-Tp0D {
			apple,key-id = "Tp0D";
			label = "P-cluster Temperature 4";
		};

		/*
		 * Whole-machine power telemetry (the keys hwmon-common.dtsi
		 * expects everywhere; a key the J700 SMC lacks is skipped).
		 * The backlight work reads these to show the panel power
		 * following the brightness with the machine on AC.
		 */
		power-PSTR {
			apple,key-id = "PSTR";
			label = "Total System Power";
		};

		power-PDTR {
			apple,key-id = "PDTR";
			label = "AC Input Power";
		};

		/*
		 * Reporting-only channels.  They must stay after the six policy
		 * die temperatures above, which the CPU thermal policy samples by
		 * position.  Every key here was read back live from the SMC on
		 * this machine and tracks plausibly; the placement implied by
		 * each label follows Apple's SMC key conventions and has not been
		 * cross-checked against macOS.
		 */
		temperature-TB0T {
			apple,key-id = "TB0T";
			label = "Battery";
		};

		temperature-TH0p {
			apple,key-id = "TH0p";
			label = "Storage (NAND)";
		};

		temperature-TW0p {
			apple,key-id = "TW0p";
			label = "Wi-Fi Module";
		};

		temperature-TUCp {
			apple,key-id = "TUCp";
			label = "USB-C Port";
		};

		temperature-TaTp {
			apple,key-id = "TaTp";
			label = "Ambient";
		};

		temperature-TCMz {
			apple,key-id = "TCMz";
			label = "Charger";
		};

		temperature-Ts0A {
			apple,key-id = "Ts0A";
			label = "Chassis 1";
		};

		temperature-Ts0I {
			apple,key-id = "Ts0I";
			label = "Chassis 2";
		};

		temperature-Ts0M {
			apple,key-id = "Ts0M";
			label = "Chassis 3";
		};

		/*
		 * The rest of the SMC's live temperature channels, enumerated from
		 * the firmware's own key table (see smc-keyspace/ in the session
		 * findings): every key here read back in a plausible range and moved
		 * between samples.  Apple's placement for these is unknown, so they
		 * carry the raw key as their label rather than an invented name.
		 */
		temperature-TBLp {
			apple,key-id = "TBLp";
			label = "SMC TBLp";
		};

		temperature-TCMb {
			apple,key-id = "TCMb";
			label = "SMC TCMb";
		};

		temperature-TPD0 {
			apple,key-id = "TPD0";
			label = "SMC TPD0";
		};

		temperature-TPD1 {
			apple,key-id = "TPD1";
			label = "SMC TPD1";
		};

		temperature-TPD2 {
			apple,key-id = "TPD2";
			label = "SMC TPD2";
		};

		temperature-TPD3 {
			apple,key-id = "TPD3";
			label = "SMC TPD3";
		};

		temperature-TPD4 {
			apple,key-id = "TPD4";
			label = "SMC TPD4";
		};

		temperature-TPD5 {
			apple,key-id = "TPD5";
			label = "SMC TPD5";
		};

		temperature-TPD6 {
			apple,key-id = "TPD6";
			label = "SMC TPD6";
		};

		temperature-TR5p {
			apple,key-id = "TR5p";
			label = "SMC TR5p";
		};

		temperature-TRD0 {
			apple,key-id = "TRD0";
			label = "SMC TRD0";
		};

		temperature-TRD1 {
			apple,key-id = "TRD1";
			label = "SMC TRD1";
		};

		temperature-TRD2 {
			apple,key-id = "TRD2";
			label = "SMC TRD2";
		};

		temperature-TRD3 {
			apple,key-id = "TRD3";
			label = "SMC TRD3";
		};

		temperature-TS0p {
			apple,key-id = "TS0p";
			label = "SMC TS0p";
		};

		temperature-TS1p {
			apple,key-id = "TS1p";
			label = "SMC TS1p";
		};

