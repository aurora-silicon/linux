/*
 * Apple MacBook Neo
 *
 * target-type: J700
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8140.dtsi"

/ {
	compatible = "apple,j700", "apple,t8140", "apple,arm-platform";
	model = "Apple MacBook Neo";

	aliases {
		atcphy0 = &atcphy0;
		keyboard = &keyboard;
		serial0 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0";
		/*
		 * Temporary: the secondary cores lose state in WFIT and the
		 * kernel does not yet stop using WFxT on T8140 by itself.
		 */
		bootargs = "arm64.nowfxt";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};
};

#include "isp-imx558.dtsi"

&serial0 {
	status = "okay";
};

&pinctrl_ap {
	status = "okay";
};

&i2c0 {
	status = "okay";

	jack_codec: codec@48 {
		compatible = "cirrus,cs42l83";
		reg = <0x48>;
		reset-gpios = <&pinctrl_ap 103 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <104 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		cirrus,ts-inv = <1>;
		sound-name-prefix = "Jack";
	};
};

&isp {
	apple,platform-id = <0x70>;
	apple,temporal-filter = <1>;
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_als {
	firmware-name = "apple/j700-aop-als-cal.bin";
};

&aop_audio {
	apple,chassis-name = "J700";
	apple,machine-kind = "MacBook Neo";
};

&admac_leap_ns {
	status = "okay";
};

&admac_base_ns {
	status = "okay";
};

&admac_leap_s {
	status = "okay";
};

/ {
	speaker_amp: audio-amplifier {
		compatible = "maxim,max98360a";
		sdmode-gpios = <&pinctrl_ap 105 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
	};
	sound {
		compatible = "apple,j700-macaudio", "apple,macaudio";
		model = "MacBook Neo J700";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 4>;
			};
			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};
};

&smc {
	status = "okay";
};

&smc_hwmon {
	/* interim J700 CPU thermal policy over the CPU die channels */
	apple,cpu-thermal-policy;
};

&smc_mbox {
	status = "okay";
};

&ans_mbox {
	status = "okay";
};

&sart {
	status = "okay";
};

&nvme {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,no-stm;
	/* SMC pcIO output 19; level 1 asserts the reset */
	apple,afe-reset-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;

	multi-touch {
		compatible = "apple,j700-multitouch";
		firmware-name = "apple/tpmtfw-j700.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};
};

/* USB PD controllers, on the nub SPMI A0 bus */
&nub_spmi_a0 {
	status = "okay";

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			/* USB 2.0 only, through the fixed hub */
			port {
				typec1_connector_hs: endpoint {
					remote-endpoint = <&hub_front>;
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-back";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					typec0_connector_hs: endpoint {
						remote-endpoint = <&hub_rear>;
					};
				};

				port@1 {
					reg = <1>;

					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

/*
 * The controller's USB 2.0 pairs go to a VIA VL122 two-port hub on the
 * board (USB ID 2109:2122) whose downstream ports serve the two Type-C
 * connectors; only the back connector also has SuperSpeed lanes, wired
 * straight to the PHY. The controller is therefore always a host.
 */
&dwc3_0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	hub@1 {
		compatible = "usb2109,2122";
		reg = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				hub_front: endpoint {
					remote-endpoint = <&typec1_connector_hs>;
				};
			};

			port@2 {
				reg = <2>;

				hub_rear: endpoint {
					remote-endpoint = <&typec0_connector_hs>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dwc3_0_ss: endpoint {
				remote-endpoint = <&atcphy0_usb3>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&atcphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;

			atcphy0_usb3: endpoint {
				remote-endpoint = <&dwc3_0_ss>;
			};
		};
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-laptop.dtsi"
