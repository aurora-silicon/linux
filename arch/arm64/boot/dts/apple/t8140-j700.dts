&ps_smc_i2cm1 {
	apple,always-on;
};

&ps_smc_i2cm2 {
	apple,always-on;
};

/* The bootloader enables PMP only after forwarding this machine's complete
 * validated metadata. No vendor-policy or per-device ADT payload is embedded.
 */
