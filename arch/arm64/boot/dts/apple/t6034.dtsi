/*
 * Apple T6034 "M3 Max" SoC
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t6031.dtsi"

/ {
	compatible = "apple,t6034", "apple,arm-platform";
};

/*
 * The 14-core M3 Max has its own GPU (30 cores), whose clusters and core masks
 * the T6031 description does not give. Its own compatible keeps the T6031 GPU
 * support from binding to it even if a boot loader enabled the node.
 */
&gpu {
	compatible = "apple,agx-t6034";
};

// Disable power-states for memory channels not present on the 14-core variant.
&ps_amcc6 {
	status = "disabled";
};

&ps_amcc7 {
	status = "disabled";
};

&ps_dcs_24 {
	status = "disabled";
};

&ps_dcs_25 {
	status = "disabled";
};

&ps_dcs_26 {
	status = "disabled";
};

&ps_dcs_27 {
	status = "disabled";
};

&ps_dcs_28 {
	status = "disabled";
};

&ps_dcs_29 {
	status = "disabled";
};

&ps_dcs_30 {
	status = "disabled";
};

&ps_dcs_31 {
	status = "disabled";
};

/* The harvested die exposes six AMCC register windows. */
&mcc {
	reg = <0x2 0x903c0000 0x0 0x20000>,
	      <0x2 0x904d0000 0x0 0x149c>,
	      <0x2 0x92818000 0x0 0x4000>,
	      <0x2 0x20000000 0x0 0x2000000>,
	      <0x2 0x22000000 0x0 0x2000000>,
	      <0x2 0x24000000 0x0 0x2000000>,
	      <0x2 0x26000000 0x0 0x2000000>,
	      <0x2 0x28000000 0x0 0x2000000>,
	      <0x2 0x2a000000 0x0 0x2000000>;
};
