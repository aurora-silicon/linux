/dts-v1/;

#include "t6050-max.dtsi"

/ {
	model = "Apple Mac mini (J873s)";
	compatible = "apple,j873s", "apple,t6050", "apple,arm-platform";
	chassis-type = "desktop";

	aliases {
		serial0 = &dockchannel;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>;
			status = "disabled";
		};
	};
};

&dockchannel {
	status = "okay";
};

&cpufreq_mc0 {
	status = "disabled";
};

&cpufreq_mc1 {
	status = "disabled";
};

&cpufreq_pc {
	status = "disabled";
};

#include "t6050-j873s-peripherals.dtsi"

/* Board-specific storage and SMC handoff still require qualification. */

&nvme {
	status = "disabled";
};

&ans_mbox {
	status = "disabled";
};

&smc {
	status = "disabled";
};

&smc_mbox {
	status = "disabled";
};
