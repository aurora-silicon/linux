/*
 * The 14-inch K boards' ports beyond t6050-k114-k116-usb.dtsi: the MagSafe 3 PD controller
 * on nub-spmi-a0 and ATC2's USB4/Thunderbolt router with its PCIe tunnel. The live K114s ADT
 * (27.2) and the K114c's have the same nodes and values here, phandles aside.
 *
 * Included after t6050-k114-k116-usb.dtsi. t6050-max.dtsi describes the ATC2 router for the
 * boards that define T6050_K114C or T6050_K114S before including it.
 */

/*
 * nub-spmi-a0's generation 4 fault queue: ADT reg[1] 0x8a184000 + 0x4000, which macOS empties
 * when the controller starts.
 */
&nub_spmi_a0 {
	reg = <0x2 0x8a188000 0x0 0x4000>,
	      <0x2 0x8a184000 0x0 0x4000>;

	/*
	 * The MagSafe 3 port's PD controller (ADT hpm5, port-type 0x11). It has no USB data
	 * path, so it gets no connector node; tipd registers a Type-C port and a power supply
	 * for it. Its ADT features-supported is <3>, "Power In" only: no liquid detection.
	 */
	hpm5: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		apple,no-liquid-detection;
	};
};

/*
 * The right port's USB4/Thunderbolt router (acio2) and PCIe tunnel; the DisplayPort route
 * is not described.
 */
#include "t6050-max-atc2-router.dtsi"

/*
 * The host DROM from the ADT (/arm-io/acio2 thunderbolt-drom, the same on the K114c and the
 * K114s); the boot loader replaces it
 */
&acio2_nhi {
	apple,thunderbolt-drom = [fd 02 00 00 00 00 00 00 00 90 19 c3 8c 00 5c 00
			00 00 00 00 00 00 08 81 82 02 82 00 00 00 08 82
			92 01 82 00 00 00 03 83 20 08 84 00 00 00 00 00
			00 08 85 00 00 00 00 00 00 05 86 09 01 00 08 87
			00 00 00 00 00 00 05 88 09 01 00 05 89 09 01 00
			05 8a 09 01 00 0e 01 41 70 70 6c 65 2c 20 49 6e
			63 2e 00 06 02 69 4f 53 00 00 00 00];
};

/* The right router's suppliers, disabled in the inventory (as t6050-j714s-display.dtsi enables them) */
&ps_atc2_cio {
	status = "okay";
};

&ps_atc2_cio_pcie {
	status = "okay";
};

&ps_atc2_cio_usb {
	status = "okay";
};

&ps_atc2_cio_auss {
	status = "okay";
};

&ps_atc2_pcie {
	status = "okay";
};

/*
 * The router and its mailbox are on, with all five domains and the PCIe tunnel, whether or not
 * t6050-max.dtsi leaves acio2 disabled and without the fifth domain for boards outside its list.
 */
&acio2_mbox {
	status = "okay";
};

&acio2 {
	status = "okay";
	power-domains = <&ps_atc2_cio>, <&ps_atc2_cio_pcie>,
			<&ps_atc2_cio_usb>, <&ps_atc2_cio_auss>, <&ps_atc2_pcie>;
	apple,pcie-tunnel = <&acio2_pcie_tunnel>;
};
