/dts-v1/;

#include "t8112.dtsi"
#include "t8112-jxxx.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j413", "apple,t8112", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M2, 2022)";

	chassis-type = "laptop";

	aliases {
		bluetooth0 = &bluetooth0;
		keyboard = &keyboard;
		rtc0 = &smc_rtc;
		rtc1 = &pmu_rtc;
		sep = &sep;
		wifi0 = &wifi0;
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&dcp {
	panel: panel {
		compatible = "apple,panel-j413", "apple,panel";
		width-mm = <290>;
		height-mm = <189>;
		adj-height-mm = <181>;
		apple,max-brightness = <525>;
	};
};

&framebuffer0 {
	panel = <&panel>;
	post-init-providers = <&panel>;
};

/*
 * Force the bus number assignments so that we can declare some of the
 * on-board devices and properties that are populated by the bootloader
 * (such as MAC addresses).
 */
&port00 {
	bus-range = <1 1>;
	pwren-gpios = <&smc_gpio 13 GPIO_ACTIVE_HIGH>;
	wifi0: wifi@0,0 {
		compatible = "pci14e4,4433";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		wakeup-source;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 10];
		apple,antenna-sku = "XX";
		brcm,board-type = "apple,hokkaido";
		brcm,ccode-map-trivial;
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f71";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
		brcm,board-type = "apple,hokkaido";
	};
};

/*
 * Provide labels for the USB type C ports.
 */

&typec0 {
	label = "USB-C Left-back";
};

&typec1 {
	label = "USB-C Left-front";
};

&i2c0 {
	/* MagSafe port */
	hpm5: usb-pd@3a {
		compatible = "apple,cd321x";
		reg = <0x3a>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <8 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "irq";
	};
};

&i2c1 {
	speaker_left_woof: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		shutdown-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer";
		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	speaker_left_tweet: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		shutdown-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <8>;
		ti,vmon-slot-no = <10>;
	};
};

&i2c3 {
	speaker_right_woof: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		shutdown-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer";
		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <4>;
		ti,vmon-slot-no = <6>;
	};

	speaker_right_tweet: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		shutdown-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <12>;
		ti,vmon-slot-no = <14>;
	};

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 12 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 149 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&i2c4 {
	status = "okay";
};

/* A spare PWM channel for developers; no consumer is known. */
&fpwm0 {
	status = "okay";
};

&fpwm1 {
	status = "okay";
};

&aop_mbox {
       status = "okay";
};

&aop_dart {
       status = "okay";
};

&aop_admac {
       status = "okay";
};

&aop {
	status = "okay";

	accel {
		compatible = "apple,t8112-aop-accel", "apple,aop-accel";
	};

	gyro {
		compatible = "apple,t8112-aop-gyro", "apple,aop-gyro";
	};
};

&aop_audio {
	apple,chassis-name = "J413";
	apple,machine-kind = "MacBook Air";
};

/ {
	sound {
		compatible = "apple,j413-macaudio", "apple,macaudio";
		model = "MacBook Air J413";

		dai-link@0 {
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-2 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0>;
			dai-tdm-slot-tx-idle-mask-2 = <0x0f0f>;

			cpu {
				sound-dai = <&mca 0>, <&mca 1>;
			};
			codec {
				sound-dai = <&speaker_left_woof>, <&speaker_left_tweet>,
					    <&speaker_right_woof>, <&speaker_right_tweet>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&mca 2>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

&mtp {
	status = "okay";
};
&mtp_mbox {
	status = "okay";
};
&mtp_dart {
	status = "okay";
};
&mtp_dockchannel {
	status = "okay";
};
&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 8 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 24 GPIO_ACTIVE_LOW>;

	multi-touch {
		firmware-name = "apple/tpmtfw-j413.bin";
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
		apple,click-strength = <0xc0 0x6e>;
	};

	tp_accel {
	};
};

#include "hwmon-laptop.dtsi"
#include "t8112-j413-hwmon-rails.dtsi"

/*
 * GPU temperatures, after the channels the thermal zones index. The SMC
 * publishes them only while the GPU is powered: with the GPU off, Tg0e,
 * Tg0m and Tg0q read 0 C and Tg0f, Tg0n and Tg0r 4.6 C (they track the
 * first three plus a fixed 4.6 C). Those placeholders are no data.
 */
&smc_hwmon {
	temperature-Tg0e {
		apple,key-id = "Tg0e";
		label = "GPU Tg0e";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0f {
		apple,key-id = "Tg0f";
		label = "GPU Tg0f";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0m {
		apple,key-id = "Tg0m";
		label = "GPU Tg0m";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0n {
		apple,key-id = "Tg0n";
		label = "GPU Tg0n";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0q {
		apple,key-id = "Tg0q";
		label = "GPU Tg0q";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0r {
		apple,key-id = "Tg0r";
		label = "GPU Tg0r";
		apple,no-data-below-millicelsius = <10000>;
	};
};

/*
 * The other CPU temperatures, read-only, after the GPU channels. Each
 * sensor site has a reading, the same plus a fixed offset and a hotspot
 * estimate; the zones above use the offset keys of four P sites and Te05.
 * Te04-Te06 follow the E cluster, every Tp key the P cluster, TCMz is the
 * hottest hotspot key and TCMb the hottest offset key.
 */
&smc_hwmon {
	temperature-TCMb {
		apple,key-id = "TCMb";
		label = "SoC Die TCMb";
	};

	temperature-Te04 {
		apple,key-id = "Te04";
		label = "E-cluster Te04";
	};

	temperature-Te06 {
		apple,key-id = "Te06";
		label = "E-cluster Te06";
	};

	temperature-Tp00 {
		apple,key-id = "Tp00";
		label = "P-cluster Tp00";
	};

	temperature-Tp02 {
		apple,key-id = "Tp02";
		label = "P-cluster Tp02";
	};

	temperature-Tp04 {
		apple,key-id = "Tp04";
		label = "P-cluster Tp04";
	};

	temperature-Tp06 {
		apple,key-id = "Tp06";
		label = "P-cluster Tp06";
	};

	temperature-Tp08 {
		apple,key-id = "Tp08";
		label = "P-cluster Tp08";
	};

	temperature-Tp0A {
		apple,key-id = "Tp0A";
		label = "P-cluster Tp0A";
	};

	temperature-Tp0C {
		apple,key-id = "Tp0C";
		label = "P-cluster Tp0C";
	};

	temperature-Tp0E {
		apple,key-id = "Tp0E";
		label = "P-cluster Tp0E";
	};

	temperature-Tp0a {
		apple,key-id = "Tp0a";
		label = "P-cluster Tp0a";
	};

	temperature-Tp0b {
		apple,key-id = "Tp0b";
		label = "P-cluster Tp0b";
	};

	temperature-Tp0c {
		apple,key-id = "Tp0c";
		label = "P-cluster Tp0c";
	};

	temperature-Tp0e {
		apple,key-id = "Tp0e";
		label = "P-cluster Tp0e";
	};

	temperature-Tp0f {
		apple,key-id = "Tp0f";
		label = "P-cluster Tp0f";
	};

	temperature-Tp0g {
		apple,key-id = "Tp0g";
		label = "P-cluster Tp0g";
	};

	temperature-Tp0i {
		apple,key-id = "Tp0i";
		label = "P-cluster Tp0i";
	};

	temperature-Tp0j {
		apple,key-id = "Tp0j";
		label = "P-cluster Tp0j";
	};

	temperature-Tp0k {
		apple,key-id = "Tp0k";
		label = "P-cluster Tp0k";
	};

	temperature-Tp0m {
		apple,key-id = "Tp0m";
		label = "P-cluster Tp0m";
	};

	temperature-Tp0n {
		apple,key-id = "Tp0n";
		label = "P-cluster Tp0n";
	};

	temperature-Tp0o {
		apple,key-id = "Tp0o";
		label = "P-cluster Tp0o";
	};

	temperature-Tp0q {
		apple,key-id = "Tp0q";
		label = "P-cluster Tp0q";
	};

	temperature-Tp0r {
		apple,key-id = "Tp0r";
		label = "P-cluster Tp0r";
	};

	temperature-Tp0s {
		apple,key-id = "Tp0s";
		label = "P-cluster Tp0s";
	};
};

/*
 * Mesa fingerprint sensor on spi2. The J413 platform device tree
 * (/arm-io/spi2/mesa) describes it as J415's does: power on AP GPIO 178,
 * active high, data-ready on AP GPIO 177. The data-ready edge only wakes the
 * capture early; every frame is still gated on the sensor's SPI status.
 * Native chip select only.
 */
&spi2 {
	status = "okay";
};

&mesa {
	status = "okay";
	enable-gpios = <&pinctrl_ap 178 GPIO_ACTIVE_HIGH>;
	interrupt-parent = <&pinctrl_ap>;
	interrupts = <177 IRQ_TYPE_EDGE_RISING>;
	spi-cs-setup-delay-ns = <20>;
	spi-cs-hold-delay-ns = <20>;
	/* Per-device factory data from this Mac's own iBoot system container. */
	firmware-name = "apple/mesacal-j413.bin";
};

#include "isp-imx558-cfg0.dtsi"

&isp {
	apple,platform-id = <14>;
	apple,temporal-filter = <1>;
};

&pmp_report_isp_sys {
	status = "okay";
};

&nub_spmi1 {
	status = "okay";

	pmic@e {
		compatible = "apple,vale-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;
		read-only;
	};
};

&i2c2 {
	retimer@18 {
		compatible = "apple,t8112-atcrt", "apple,atcrt";
		reg = <0x18>;
		status = "disabled";
	};
	retimer@19 {
		compatible = "apple,t8112-atcrt", "apple,atcrt";
		reg = <0x19>;
		status = "disabled";
	};
};

&spi4 {
	panel_controller: panel-timing-controller@0 {
		compatible = "parade,dp855";
		reg = <0>;
		status = "disabled";
	};
};

&i2c4 {
	avellino@44 {
		compatible = "apple,t8112-avellino", "apple,avellino";
		reg = <0x44>;
		status = "disabled";
	};

	avellino@77 {
		compatible = "apple,t8112-avellino", "apple,avellino";
		reg = <0x77>;
		status = "disabled";
	};
};

&aop_spmi0 {
	radio-pmu@e {
		compatible = "apple,t8112-wifibt-pmu", "apple,radio-pmu";
		reg = <0xe SPMI_USID>;
		status = "disabled";
	};
};

/* NFC controller (Stockholm): identified once, then kept off. */
&smc_gpio {
	apple,output-templates = <0xf 0x00800000>;
};

&aop_spmi1 {
	interrupt-controller;
	#interrupt-cells = <2>;
	status = "okay";

	nfc@c {
		compatible = "apple,t8112-stockholm-spmi", "apple,stockholm-spmi";
		reg = <0xc SPMI_USID>;
		interrupt-parent = <&aop_spmi1>;
		interrupts = <160 IRQ_TYPE_NONE>,
			     <161 IRQ_TYPE_NONE>,
			     <162 IRQ_TYPE_NONE>,
			     <163 IRQ_TYPE_NONE>,
			     <164 IRQ_TYPE_NONE>,
			     <165 IRQ_TYPE_NONE>,
			     <166 IRQ_TYPE_NONE>;
		interrupt-names = "event0", "event1", "event2", "error",
				  "event4", "host-wake", "data-ready";
		enable-gpios = <&smc_gpio 15 GPIO_ACTIVE_HIGH>;
	};
};

/ {
	/*
	 * Fanless: every die sensor throttles both clusters, E weighted 3:1
	 * and capped at state 3, as on the J613, with its alert and control
	 * trips. No critical trip: boot load bursts briefly read past 100 C,
	 * and the SMC keeps its own protection.
	 */
	thermal-zones {
		cpu-e0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 1>;	/* Te05 */
			sustainable-power = <6000>;

			trips {
				cpu_e0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 2>;	/* Tp01 */
			sustainable-power = <6000>;

			trips {
				cpu_p0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 3>;	/* Tp05 */
			sustainable-power = <6000>;

			trips {
				cpu_p1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p2-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 4>;	/* Tp09 */
			sustainable-power = <6000>;

			trips {
				cpu_p2_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p2_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p3-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 5>;	/* Tp0D */
			sustainable-power = <6000>;

			trips {
				cpu_p3_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p3_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};
	};
};

/* Read-only fault counter views (apple-regview); nothing writes these windows. */
&m2_nub_spmi0_sideband {
	status = "okay";
};

&m2_nub_spmi1_sideband {
	status = "okay";
};

&m2_aop_spmi0_sideband {
	status = "okay";
};

&m2_aop_spmi1_sideband {
	status = "okay";
};
