/* Shared disabled peripheral resources. */

&{/soc} {
	hw_spi2: spi-controller@3a5108000 {
		compatible = "apple,t8142-spi-controller", "apple,spi-controller";
		reg = <0x3 0xa5108000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1241 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&hw_ps_116>;
		status = "disabled";
	};

	hw_spi4: spi-controller@3a5110000 {
		compatible = "apple,t8142-spi-controller", "apple,spi-controller";
		reg = <0x3 0xa5110000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1243 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&hw_ps_118>;
		status = "disabled";
	};

	hw_aop_spmi0: spmi-complex@390914000 {
		compatible = "apple,t8142-spmi-complex", "apple,spmi-complex";
		reg = <0x3 0x90914000 0x0 0x4000>,
		      <0x3 0x90904000 0x0 0x4000>,
		      <0x3 0x90900000 0x0 0x4000>;
		status = "disabled";
	};

