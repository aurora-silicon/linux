/*
 * J713 power-domain ownership.
 *
 * Only the domains whose Linux power/reset contract is qualified are enabled.
 * Retained core, GPIO and display domains are firmware-owned: neither state
 * reads nor power/reset writes are permitted. Other domains stay unavailable
 * until their consumer and power sequence are implemented. This board policy
 * is also used by the adapter for the original J713 loader tree.
 */

&ps_msg {
	status = "disabled";
};

&ps_aic {
	status = "okay";
	apple,firmware-owned;
};

&ps_dwi {
	status = "disabled";
};

