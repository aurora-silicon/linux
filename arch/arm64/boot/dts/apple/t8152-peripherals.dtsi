// SPDX-License-Identifier: GPL-2.0-only OR MIT
/* Firmware/descriptor scaler family. No direct-MMIO scaler driver fallback. */

&{/soc} {
	dt5_scaler0: scaler@3a7000000 {
		compatible = "apple,t8152-scaler", "apple,scaler-v23";
		reg = <0x3 0xa7000000 0x0 0x14000>,
		      <0x3 0xa7210000 0x0 0x4000>,
		      <0x3 0xa7204000 0x0 0x4000>,
		      <0x3 0xa6000000 0x0 0x1000000>,
		      <0x3 0xa72c0000 0x0 0x40000>,
		      <0x3 0xa7340000 0x0 0x23c000>,
		      <0x3 0xa72a0000 0x0 0x4000>,
		      <0x3 0xa7208000 0x0 0x4000>,
		      <0x3 0x700000 0x0 0xd0000>,
		      <0x3 0xa7210000 0x0 0x4000>,
		      <0x3 0xa7220000 0x0 0x4000>,
		      <0x3 0x16020000 0x0 0x10000>;
		interrupts = <AIC_IRQ 1359 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1361 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1362 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1363 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1367 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1368 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1369 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1370 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1371 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1372 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1373 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 1374 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 269 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 309 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 229 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dt5_dart_scaler 0>, <&dt5_dart_scaler 1>;
		/* PMGR2 clock, power and reset providers need qualification. */
		status = "disabled";
	};
};
