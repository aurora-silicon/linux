		      <0x4 0x403c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1611 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_apciec0 254>;
		status = "disabled";
	};

