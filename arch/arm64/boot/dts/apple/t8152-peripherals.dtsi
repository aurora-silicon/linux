/* Shared disabled peripheral resources. */

&{/soc} {
	hw_i2c0: i2c@331010000 {
		compatible = "apple,t8152-i2c", "apple,t8103-i2c";
		reg = <0x3 0x31010000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1413 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_i2c1: i2c@331014000 {
		compatible = "apple,t8152-i2c", "apple,t8103-i2c";
		reg = <0x3 0x31014000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1414 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_i2c3: i2c@33101c000 {
		compatible = "apple,t8152-i2c", "apple,t8103-i2c";
		reg = <0x3 0x3101c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1416 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_dart_apcie2: iommu@38a000000 {
		compatible = "apple,t8152-dart", "apple,dart";
		reg = <0x3 0x8a000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 1588 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_apcie2_piodma: dma-controller@38a030000 {
		compatible = "apple,t8152-pcie-piodma", "apple,pcie-piodma";
		reg = <0x3 0x8a030000 0x0 0x4000>,
		      <0x3 0x8a034000 0x0 0x4000>,
		      <0x3 0x8a038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1589 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_apcie2 17>;
		status = "disabled";
	};

	hw_nub_spmi_a0: spmi@308908000 {
		compatible = "apple,t8152-spmi", "apple,spmi";
		reg = <0x3 0x8908000 0x0 0x4000>,
		      <0x3 0x8904000 0x0 0x4000>,
		      <0x3 0x8900000 0x0 0x4000>;
		status = "disabled";
		interrupts = <AIC_IRQ 682 IRQ_TYPE_LEVEL_HIGH>;
	};

	hw_aop_spmi0: spmi@310914000 {
		compatible = "apple,t8152-spmi", "apple,spmi";
		reg = <0x3 0x10914000 0x0 0x4000>,
		      <0x3 0x10904000 0x0 0x4000>,
		      <0x3 0x10900000 0x0 0x4000>;
		status = "disabled";
		interrupts = <AIC_IRQ 609 IRQ_TYPE_LEVEL_HIGH>;
	};

	hw_acio_cpu0: usb4-coproc@401178000 {
		compatible = "apple,t8152-usb4-acio", "apple,usb4-acio";
		reg = <0x4 0x1178000 0x0 0x4000>,
		      <0x4 0x1100000 0x0 0x4000>,
		      <0x4 0x1000000 0x0 0x17c000>;
		interrupts = <AIC_IRQ 1660 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1659 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_apciec0: pcie@1c50000000 {
		compatible = "apple,t8152-pciec", "apple,pciec";
		reg = <0x1c 0x50000000 0x0 0x10000000>,
		      <0x4 0x4034000 0x0 0x4000>,
		      <0x4 0x4020000 0x0 0x8000>,
		      <0x4 0x4038000 0x0 0x4000>,
		      <0x4 0x4060000 0x0 0x4000>,
		      <0x4 0x20000 0x0 0x4000>,
		      <0x4 0x402c000 0x0 0x4000>,
		      <0x4 0x4028000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1609 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1612 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1613 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1614 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1615 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1616 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
