		status = "disabled";

		pmic@b {
			compatible = "apple,mirabeau-pmic", "apple,spmi-nvmem";
			reg = <0xb SPMI_USID>;
			read-only;
			status = "disabled";
		};
	};

	m2_clvr_spmi4_sideband: spmi-sideband@290104000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x90104000 0x0 0x4000>;
		status = "disabled";
	};

	m2_clvr_spmi4: spmi@29010c000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x9010c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 362 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		pmic@b {
			compatible = "apple,mirabeau-pmic", "apple,spmi-nvmem";
			reg = <0xb SPMI_USID>;
			read-only;
			status = "disabled";
		};
	};

	m2_nub_spmi0_sideband: spmi-sideband@29e104000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x9e104000 0x0 0x4000>;
		status = "disabled";
	};

	m2_nub_spmi1_sideband: spmi-sideband@29e144000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x9e144000 0x0 0x4000>;
		status = "disabled";
	};

	m2_nub_spmi1: spmi@29e154000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x9e154000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 728 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		pmic@a {
			compatible = "apple,maverick-pmic", "apple,spmi-nvmem";
			reg = <0xa SPMI_USID>;
			read-only;
			status = "disabled";
		};

		peripheral@d {
			compatible = "apple,t6021-spmi-peripheral",
				"apple,spmi-peripheral";
			reg = <0xd SPMI_USID>;
			status = "disabled";
		};
	};

	m2_dockchannel_uart: serial@29e52c000 {
		compatible = "apple,t6021-dockchannel-uart", "apple,dockchannel-uart";
		reg-names = "data", "config", "irq";
		reg = <0x2 0x9e52c000 0x0 0x4000>,
			<0x2 0x9e528000 0x0 0x4000>,
			<0x2 0x9e50c000 0x0 0x18>;
		apple,sw-drain;
		status = "disabled";
	};

	m2_aop_spmi0_sideband: spmi-sideband@2a6884000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0xa6884000 0x0 0x4000>;
		status = "disabled";
	};

	m2_aop_spmi0: spmi@2a6894000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0xa6894000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 635 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		nfc@8 {
			compatible = "apple,t6021-spmi-nfc",
				"apple,spmi-nfc";
			reg = <0x8 SPMI_USID>;
			interrupt-parent = <&m2_aop_spmi0>;
			interrupts = <176 IRQ_TYPE_LEVEL_HIGH>,
				<177 IRQ_TYPE_LEVEL_HIGH>,
				<178 IRQ_TYPE_LEVEL_HIGH>,
				<179 IRQ_TYPE_LEVEL_HIGH>,
				<180 IRQ_TYPE_LEVEL_HIGH>,
				<181 IRQ_TYPE_LEVEL_HIGH>,
				<182 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		peripheral@e {
			compatible = "apple,t6021-spmi-peripheral",
				"apple,spmi-peripheral";
			reg = <0xe SPMI_USID>;
			status = "disabled";
		};
	};

	m2_aop_spmi1_sideband: spmi-sideband@2a68c4000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0xa68c4000 0x0 0x4000>;
		status = "disabled";
	};

	m2_aop_spmi1: spmi@2a68d4000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0xa68d4000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 644 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		nfc@8 {
			compatible = "apple,t6021-spmi-nfc",
				"apple,spmi-nfc";
			reg = <0x8 SPMI_USID>;
			interrupt-parent = <&m2_aop_spmi1>;
			interrupts = <176 IRQ_TYPE_LEVEL_HIGH>,
				<177 IRQ_TYPE_LEVEL_HIGH>,
				<178 IRQ_TYPE_LEVEL_HIGH>,
				<179 IRQ_TYPE_LEVEL_HIGH>,
				<180 IRQ_TYPE_LEVEL_HIGH>,
				<181 IRQ_TYPE_LEVEL_HIGH>,
				<182 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};
	};

	m2_apr0: video-codec@311000000 {
		compatible = "apple,t6021-prores", "apple,prores";
		reg-names = "core", "wrapper";
		reg = <0x3 0x11000000 0x0 0x4000>,
			<0x3 0x10000000 0x0 0x1000000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1558 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&m2_dart_apr0_0 1>;
		power-domains = <&ps_scodec>, <&ps_afr>;
		status = "disabled";
	};

	m2_dart_apr0_0: iommu@311028000 {
		compatible = "apple,t6020-dart", "apple,t8110-dart";
		reg = <0x3 0x11028000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1557 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_scodec>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	m2_dart_scdc0: iommu@31102c000 {
		compatible = "apple,t6020-dart", "apple,t8110-dart";
		reg = <0x3 0x1102c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1557 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_scodec>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	m2_scdc0: coprocessor@312400000 {
		compatible = "apple,t6021-scdc", "apple,scdc";
		reg = <0x3 0x12400000 0x0 0x6c000>,
			<0x3 0x12050000 0x0 0x4000>,
			<0x3 0x10000000 0x0 0x1000000>,
			<0x3 0x11040000 0x0 0x1c000>,
			<0x3 0x11070000 0x0 0x4000>,
			<0x3 0x11074000 0x0 0x4000>,
			<0x3 0x11100000 0x0 0x3c000>,
			<0x3 0x11140000 0x0 0x20000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 1553 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1552 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1555 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1554 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1556 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&m2_dart_scdc0 0>, <&m2_dart_apr0_0 0>;
		power-domains = <&ps_scodec>, <&ps_afr>;
		status = "disabled";
	};

	m2_dart_dispext1_1: iommu@315300000 {
		compatible = "apple,t6020-dart", "apple,t8110-dart";
		reg = <0x3 0x15300000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 986 IRQ_TYPE_LEVEL_HIGH>;
