// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Additional T6021 hardware resources. Keep unqualified blocks disabled. */

&{/soc} {
	m2_dart_dispext0_1: iommu@289300000 {
		compatible = "apple,t6020-dart", "apple,t8110-dart";
		reg = <0x2 0x89300000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 950 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	m2_event_log_handler: event-log@28e080000 {
		compatible = "apple,t6021-event-log", "apple,soc-event-log";
		reg = <0x2 0x8e080000 0x0 0x8000>,
			<0x2 0x8e08c000 0x0 0x4000>,
			<0x2 0x8e0d4000 0x0 0x4000>,
			<0x2 0x8e094000 0x0 0x4000>,
			<0x2 0x8e0a0000 0x0 0x1c000>,
			<0x2 0x8e0cc000 0x0 0x4000>,
			<0x2 0x8e0f0000 0x0 0x8000>,
			<0x2 0x8e0ec000 0x0 0x4000>,
			<0x2 0x8e09c000 0x0 0x4000>,
			<0x2 0x8e0e0000 0x0 0xc000>,
			<0x2 0x90280000 0x0 0x10000>,
			<0x2 0x90290000 0x0 0x4000>,
			<0x2 0x90298000 0x0 0x4000>,
			<0x2 0x9029c000 0x0 0x4000>,
			<0x2 0x902b0000 0x0 0x4000>,
			<0x2 0x902b8000 0x0 0x8000>,
			<0x2 0x902ac000 0x0 0x4000>,
			<0x2 0x8e680000 0x0 0xc000>,
			<0x2 0x8e68c000 0x0 0x4000>,
			<0x2 0x8e6a0000 0x0 0x8000>,
			<0x2 0x8e69c000 0x0 0x4000>,
			<0x2 0x8e424000 0x0 0x4000>,
			<0x2 0x8e428000 0x0 0x4000>,
			<0x2 0x8e42c000 0x0 0x4000>,
			<0x2 0x8e430000 0x0 0x4000>,
			<0x2 0x8e434000 0x0 0x4000>,
			<0x2 0x8e440000 0x0 0x4000>,
			<0x2 0x8e444000 0x0 0x4000>,
			<0x2 0x8e448000 0x0 0x4000>,
			<0x2 0x8e420000 0x0 0x4000>,
			<0x2 0x8e400000 0x0 0x8000>,
			<0x2 0x8e408000 0x0 0x8000>,
			<0x2 0x9e200000 0x0 0x80000>,
			<0x2 0x8e000000 0x0 0x80000>,
			<0x2 0x8e600000 0x0 0x58000>,
			<0x2 0x9e280000 0x0 0x58000>,
			<0x2 0x85838000 0x0 0x8000>,
			<0x2 0x85868000 0x0 0x4000>,
			<0x4 0x4e1c000 0x0 0x4000>,
			<0x4 0x4e5c000 0x0 0x4000>,
			<0x4 0x4ea8000 0x0 0x4000>,
			<0x4 0x4eac000 0x0 0x4000>,
			<0x4 0x4e8c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 475 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 476 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 477 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 49 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 50 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 51 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 52 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 53 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 54 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 55 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 56 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 57 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 58 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 59 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 454 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 455 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 456 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 473 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 871 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 879 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1151 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1153 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1155 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1157 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1159 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1161 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1164 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1168 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	m2_dwi: dwi@28e0fc000 {
		compatible = "apple,t6021-dwi", "apple,dwi";
		reg = <0x2 0x8e0fc000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 22 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_dwi>;
		status = "disabled";
	};

	m2_aic_timebase: timer@28e148000 {
		compatible = "apple,t6021-aic-timebase", "apple,aic-timebase";
		reg = <0x2 0x8e148000 0x0 0x1000>;
		status = "disabled";
	};

	m2_mcc: memory-controller@28e3c0000 {
		compatible = "apple,t6021-mcc", "apple,mcc";
		reg = <0x2 0x8e3c0000 0x0 0x20000>,
			<0x2 0x8e4d0000 0x0 0x149c>,
			<0x2 0x0 0x0 0x1000000>,
			<0x2 0x1000000 0x0 0x1000000>,
			<0x2 0x2000000 0x0 0x1000000>,
			<0x2 0x3000000 0x0 0x1000000>,
			<0x2 0x4000000 0x0 0x1000000>,
			<0x2 0x5000000 0x0 0x1000000>,
			<0x2 0x6000000 0x0 0x1000000>,
			<0x2 0x7000000 0x0 0x1000000>;
		status = "disabled";
	};

	m2_clvr_spmi0_sideband: spmi-sideband@290004000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x90004000 0x0 0x4000>;
		status = "disabled";
	};

	m2_clvr_spmi0: spmi@29000c000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x9000c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 354 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		pmic@b {
			compatible = "apple,mirabeau-pmic", "apple,spmi-nvmem";
			reg = <0xb SPMI_USID>;
			read-only;
			status = "disabled";
		};
	};

	m2_clvr_spmi1_sideband: spmi-sideband@290044000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x90044000 0x0 0x4000>;
		status = "disabled";
	};

	m2_clvr_spmi1: spmi@29004c000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x9004c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 356 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		pmic@b {
			compatible = "apple,mirabeau-pmic", "apple,spmi-nvmem";
			reg = <0xb SPMI_USID>;
			read-only;
			status = "disabled";
		};
	};

	m2_clvr_spmi2_sideband: spmi-sideband@290084000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x90084000 0x0 0x4000>;
		status = "disabled";
	};

	m2_clvr_spmi2: spmi@29008c000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x9008c000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 358 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "disabled";

		pmic@b {
			compatible = "apple,mirabeau-pmic", "apple,spmi-nvmem";
			reg = <0xb SPMI_USID>;
			read-only;
			status = "disabled";
		};
	};

	m2_clvr_spmi3_sideband: spmi-sideband@2900c4000 {
		compatible = "apple,t6021-spmi-sideband", "apple,spmi-sideband";
		reg = <0x2 0x900c4000 0x0 0x4000>;
		status = "disabled";
	};

	m2_clvr_spmi3: spmi@2900cc000 {
		compatible = "apple,t6020-spmi", "apple,t8103-spmi";
		reg = <0x2 0x900cc000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0 360 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <2>;
