						<&cpu2 THERMAL_NO_LIMIT 5>,
						<&cpu3 THERMAL_NO_LIMIT 5>,
						<&cpu4 THERMAL_NO_LIMIT 5>,
						<&cpu5 THERMAL_NO_LIMIT 5>;
					contribution = <3072>;
				};
			};
		};

		cpu-p2-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			thermal-sensors = <&smc_hwmon 10>;	/* Tp0C */
			sustainable-power = <13000>;

			trips {
				cpu_p2_switch_on: trip-switch-on {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p2_passive: trip-passive {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p2_passive>;
					cooling-device =
						<&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu8 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu9 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p2_passive>;
					cooling-device =
						<&cpu0 THERMAL_NO_LIMIT 5>,
						<&cpu1 THERMAL_NO_LIMIT 5>,
						<&cpu2 THERMAL_NO_LIMIT 5>,
						<&cpu3 THERMAL_NO_LIMIT 5>,
						<&cpu4 THERMAL_NO_LIMIT 5>,
						<&cpu5 THERMAL_NO_LIMIT 5>;
					contribution = <3072>;
				};
			};
		};

		cpu-p3-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			integral-time-constant-ms = <20000>;
			critical-samples = <3>;
			thermal-sensors = <&smc_hwmon 11>;	/* Tp0G */
			sustainable-power = <13000>;

			trips {
				cpu_p3_switch_on: trip-switch-on {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p3_passive: trip-passive {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p3_passive>;
