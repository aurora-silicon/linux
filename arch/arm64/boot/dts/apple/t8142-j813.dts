/*
 * Apple MacBook Air (13-inch, M5, 2026), J813.
 *
 * Initial RAM boot resources measured from the J813 Apple Device Tree.
 * The loader supplies usable memory, CPU release addresses and framebuffer
 * geometry. Peripheral power management is left with the boot firmware.
 */
/dts-v1/;

#include "t8142.dtsi"

/ {
	compatible = "apple,j813", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M5, 2026)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "disabled";
		};
	};

	memory@10000000000 {
		reg = <0x100 0 0x4 0>; /* Filled by the loader. */
	};
};

&cpu0 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu1 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu2 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu3 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu4 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu5 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu6 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu7 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu8 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu9 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&{/timer} {
	status = "okay";
};

&aic {
	status = "okay";
};

&dockchannel {
	status = "okay";
};

#include "t8142-j813-display.dtsi"
#include "t8142-j813-gpu.dtsi"
#include "t8142-j813-peripherals.dtsi"
#include "t8142-j813-j815.dtsi"
#include "t8142-j813-usb.dtsi"
#include "t8142-j813-avd.dtsi"
#include "t8142-j813-isp.dtsi"
#include "t8142-j813-n1.dtsi"
#include "t8142-j813-audio.dtsi"

/*
 * N1 functions behind apcie port 0 (0000:00:00.0 -> 01:00.{0,1,2}), so the
 * loader has somewhere to put the factory addresses: it copies ADT /chosen
 * mac-address-wifi0 and mac-address-bluetooth0 into the wifi0/bluetooth0
 * alias targets. Same nodes as t8142-j815.dts (same N1, same PCI IDs).
 */
/ {
	aliases {
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
		/*
		 * The loader finds the SEP through this alias: it reserves SEPFW
		 * and copies the boot's local-policy and iBoot manifests onto
		 * the node.
		 */
		sep = &sep;
	};
};

&pcie0 {
	n1_port: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <1 1>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		n1_control: control@0,0 {
			compatible = "apple,t8142-centauri-control", "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

&mtp_hid {
	multi-touch {
		firmware-name = "apple/tpmtfw-j813.bin";
	};
};

/* Unexposed chassis port instances remain described and disabled. */

/*
 * Secure Enclave and the Touch ID sensor. All values are from the J813 ADT
 * (macOS 27.0) and are the same as J815's:
 *  - sep: iop-sep,ascwrap-v6 at 0x30a600000 (0x88000), sepfw-booted, so
 *    apple_sep warm-attaches; ASC mailbox at +0x8000, AIC 445-448.
 *  - dart-sep: t8110 at 0x308b80000, irq 455; vm-base-0 0x10000004000,
 *    vm-size-0 0xffff0000.
 *  - spi2 at 0x3a5108000, irq 1241; PMGR device SPI2 at +0x440, parent SPI_P.
 *  - mesa: "biosensor,mesa", sensor-id 0x3356, 8 MHz, CS0; power
 *    function-mesa_pwr = NUB GPIO pin 36; data-ready interrupt on AP GPIO
 *    pin 200.
 * The SEP and its DART stay disabled here: apple_sep enables them at module
 * init (drivers/soc/apple/dt.rs).
 */
&pmgr {
	ps_spi2: power-controller@440 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x440 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_spi_p>;
		label = "spi2";
	};
};

&{/soc} {
	sep: sep@30a600000 {
		compatible = "apple,sep";
		reg = <0x3 0x0a600000 0x0 0x88000>;
		mboxes = <&sep_mbox>;
		mbox-names = "mbox";
		iommus = <&sep_dart 0>;
		status = "disabled";
	};

	sep_mbox: mbox@30a608000 {
		compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x3 0x0a608000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 445 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 446 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 447 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 448 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
		status = "okay";
	};

	spi2: spi@3a5108000 {
		compatible = "apple,t8142-spi", "apple,t8103-spi";
		reg = <0x3 0xa5108000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1241 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkref>;
		power-domains = <&ps_spi2>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		mesa: fingerprint@0 {
			compatible = "apple,mesa-fingerprint";
			reg = <0>;
			spi-max-frequency = <8000000>;
			spi-cpol;
			spi-cs-setup-delay-ns = <20>;
			spi-cs-hold-delay-ns = <20>;
			enable-gpios = <&pinctrl_nub 36 GPIO_ACTIVE_HIGH>;
			interrupt-parent = <&pinctrl_ap>;
			interrupts = <200 IRQ_TYPE_EDGE_RISING>;
			/* Per-device files, built from the Mac's own factory records. */
			firmware-name = "apple/mesacal-j813.bin", "apple/msrk-j813.bin";
			status = "okay";
		};
	};
};

&sep_dart {
	apple,dma-range = /bits/ 64 <0x10000004000 0xffff0000>;
	apple,dma-offset = /bits/ 64 <0x0>;
};

/* Expose the sensor's two pins next to the ones sound uses. */
&pinctrl_ap {
	gpio-reserved-ranges = <0 100>, <101 49>, <152 48>, <201 23>;
};

&pinctrl_nub {
	gpio-reserved-ranges = <0 18>, <19 17>, <37 3>;
};
