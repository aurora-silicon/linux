/*
 * Apple MacBook Air (13-inch, M5, 2026), J813.
 *
 * Initial RAM boot resources measured from the J813 Apple Device Tree.
 * The loader supplies usable memory, CPU release addresses and framebuffer
 * geometry. Peripheral power management is left with the boot firmware.
 */
/dts-v1/;

#include "t8142.dtsi"

/ {
	compatible = "apple,j813", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M5, 2026)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
		/* The name loaders before aurora-silicon/aura#165 look up. */
		disp0_piodma = &disp0_piodma;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "disabled";
		};
	};

	memory@10000000000 {
		reg = <0x100 0 0x4 0>; /* Filled by the loader. */
	};
};

&cpu0 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu1 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu2 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu3 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu4 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu5 {
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu6 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu7 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu8 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu9 {
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&{/timer} {
	status = "okay";
};

&aic {
	status = "okay";
};

&cpu_pmu {
	status = "okay";
};

&dockchannel {
	status = "okay";
};

#include "t8142-j813-display.dtsi"
#include "t8142-j813-gpu.dtsi"
#include "t8142-j813-peripherals.dtsi"
#include "t8142-j813-j815.dtsi"
#include "t8142-j813-usb.dtsi"
#include "t8142-j813-avd.dtsi"
#include "t8142-j813-isp.dtsi"
#include "t8142-j813-n1.dtsi"
#include "t8142-j813-audio.dtsi"

/*
 * Ambient light sensor, the AOP's "als" service: an ST VD6286, as on J815
 * (same ADT node, /arm-io/aop/iop-aop-nub/als). aop_als sends it the
 * per-device calibration (apple/aop-als-cal.bin). No firmware-name: that
 * names the CT817 setup-port message, which this sensor does not take.
 */
&aop {
	aop_als: als {
		compatible = "apple,t8142-aop-als", "apple,aop-als";
	};

	/*
	 * Lid angle: the J813 AOP firmware announces a "las" service, as the
	 * J815's does, and aop_las reads the hinge angle from it.
	 */
	aop_las: las {
		compatible = "apple,t8142-aop-las", "apple,aop-las";
	};
};

/*
 * N1 functions behind apcie port 0 (0000:00:00.0 -> 01:00.{0,1,2}), so the
 * loader has somewhere to put the factory addresses: it copies ADT /chosen
 * mac-address-wifi0 and mac-address-bluetooth0 into the wifi0/bluetooth0
 * alias targets. Same nodes as t8142-j815.dts (same N1, same PCI IDs).
 */
/ {
	aliases {
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};
};

&pcie0 {
	n1_port: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <1 1>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		n1_control: control@0,0 {
			compatible = "apple,t8142-centauri-control", "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/*
 * N1 functions behind apcie port 0 (0000:00:00.0 -> 01:00.{0,1,2}), so the
 * loader has somewhere to put the factory addresses: it copies ADT /chosen
 * mac-address-wifi0 and mac-address-bluetooth0 into the wifi0/bluetooth0
 * alias targets. Same nodes as t8142-j815.dts (same N1, same PCI IDs).
 */
/ {
	aliases {
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};
};

&pcie0 {
	n1_port: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <1 1>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		n1_control: control@0,0 {
			compatible = "apple,t8142-centauri-control", "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

&mtp_hid {
	multi-touch {
		firmware-name = "apple/tpmtfw-j813.bin";
	};
};

&{/soc} {
	/*
	 * The CPU clusters' power-gate enables, in /arm-io/pmgr reg[34]: E at
	 * +0x0 and P at +0x60, the offsets T8132 has and the two words
	 * AppleT8142PMGR's restoreHW sets. iBoot leaves P's clear, and the
	 * boot core (P core 0) then never powers down in WFI.
	 */
	cluster_pwrgate: power-gate@380724000 {
		compatible = "apple,t8142-cluster-pwrgate", "apple,cluster-pwrgate";
		reg = <0x3 0x80724000 0x0 0x4>,
		      <0x3 0x80724060 0x0 0x4>;
	};
};

/* Unexposed chassis port instances remain described and disabled. */

/*
 * aura (mcc_init_m5) turns the system level cache on; the driver confirms it
 * and flushes on shutdown.
 */
&mcc {
	status = "okay";
};

#include "t8142-j813-sep.dtsi"
#include "t8142-j813-j815-sleep.dtsi"

#include "t8142-j813-dcpext.dtsi"

&sleep {
	/* PMU RTC: peripheral source 2, routed through NUB.SPMI0.SW3. */
	apple,spmi-pmu-sources = <0x600 0x4>;
};

&{/soc} {
	/*
	 * The internal display's power words for a DCP firmware stop (DPMS off):
	 * /arm-io/pmgr reg[34] (pwrgate: DISP_CPU's retention words 0x11cc and
	 * 0x11f0, the pmgr's retention_config_ff/_mem) and reg[32] (ps: DISP_CPU
	 * 0x10000, DISP_FE 0x318, DISP_SYS 0x290). T8142's PMC keeps no count of
	 * powered DCPs, so there is no pmc-dcp word.
	 */
	dcp_power: display-power@380724000 {
		compatible = "apple,t8142-display-power";
		reg = <3 0x80724000 0 0x2000>,
		      <3 0x80700000 0 0x14000>;
		reg-names = "pwrgate", "ps";
	};
};

&dcp {
	apple,display-power = <&dcp_power>;
};

&dcp_dart {
	/* PMGR PS write-disable for DISP_CPU: offset 0x3fdc, bit 6. */
	reg = <2 0x86340000 0 0x20000>,
	      <3 0x80717fdc 0 0x4>;
	reg-names = "dart", "ps-wr-dis";
	apple,ps-wr-dis-bit = <6>;
};

&{/reserved-memory} {
	/*
	 * Both roles' __TEXT, contiguous (ADT gfx-asc and gfx1-asc segment-ranges),
	 * which the driver identifies before it starts the firmware. Fixed at the
	 * macOS 27.0 address like fw-data, until the bootloader fills it in; under
	 * 27.2 (26B123) iBoot loads it at 0x100_00e5_4000 and the DATA at
	 * 0x100_0245_8000.
	 */
	gpu_fw_text: fw-text {
		reg = <0x100 0x00e44000 0x0 0x9c000>;
		no-map;
	};
};

&gpu {
	memory-region = <&uat_ttbs>, <&uat_pagetables>, <&uat_handoff>,
			<&uat_l2_pagetables>, <&gfx_data>, <&gfx1_data>,
			<&gpu_fw_data>, <&gpu_fw_text>;
	memory-region-names = "ttbs", "pagetables", "handoff",
			      "shared-l2", "gfx-data", "gfx1-data", "fw-data",
			      "fw-text";
};
