// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Air (13-inch, M5, 2026), J813.
 *
 * Initial RAM boot resources measured from the J813 Apple Device Tree.
 * The loader supplies usable memory, CPU release addresses and framebuffer
 * geometry. Peripheral power management is left with the boot firmware.
 */
/dts-v1/;

#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "apple,j813", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M5, 2026)";
	chassis-type = "laptop";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&aic>;

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* Filled by the loader. */
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x4 0>; /* Filled by the loader. */
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x0>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu1: cpu@1 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x1>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu2: cpu@2 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x2>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu3: cpu@3 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x3>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu4: cpu@4 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x4>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu5: cpu@5 {
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0 0x5>;
			operating-points-v2 = <&ecluster_opp>;
			performance-domains = <&cpufreq_e>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu6: cpu@10100 {
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0 0x10100>;
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_p>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu7: cpu@10101 {
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0 0x10101>;
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_p>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu8: cpu@10102 {
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0 0x10102>;
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_p>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};

		cpu9: cpu@10103 {
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0 0x10103>;
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_p>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* Filled by the loader. */
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
	};

	/* State 1 is 300 MHz; firmware SRAM OPP tables begin at state 2. */
	/* Cap each cluster at its measured J813 firmware handoff state. */
	ecluster_opp: opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-level = <1>;
		};

		opp-972000000 {
			opp-hz = /bits/ 64 <972000000>;
			opp-level = <2>;
		};

		opp-1152000000 {
			opp-hz = /bits/ 64 <1152000000>;
			opp-level = <3>;
		};

		opp-1584000000 {
			opp-hz = /bits/ 64 <1584000000>;
			opp-level = <4>;
		};

		opp-1992000000 {
			opp-hz = /bits/ 64 <1992000000>;
			opp-level = <5>;
		};

		opp-2352000000 {
			opp-hz = /bits/ 64 <2352000000>;
			opp-level = <6>;
		};

		opp-2700000000 {
			opp-hz = /bits/ 64 <2700000000>;
			opp-level = <7>;
		};

		opp-2964000000 {
			opp-hz = /bits/ 64 <2964000000>;
			opp-level = <8>;
		};
	};

	pcluster_opp: opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-level = <1>;
		};

		opp-1308000000 {
			opp-hz = /bits/ 64 <1308000000>;
			opp-level = <2>;
		};

		opp-1608000000 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-level = <3>;
		};

		opp-1932000000 {
			opp-hz = /bits/ 64 <1932000000>;
			opp-level = <4>;
		};

		opp-2220000000 {
			opp-hz = /bits/ 64 <2220000000>;
			opp-level = <5>;
		};

		opp-2508000000 {
			opp-hz = /bits/ 64 <2508000000>;
			opp-level = <6>;
		};

		opp-2820000000 {
			opp-hz = /bits/ 64 <2820000000>;
			opp-level = <7>;
		};

		opp-3072000000 {
			opp-hz = /bits/ 64 <3072000000>;
			opp-level = <8>;
		};

		opp-3300000000 {
			opp-hz = /bits/ 64 <3300000000>;
			opp-level = <9>;
		};

		opp-3516000000 {
			opp-hz = /bits/ 64 <3516000000>;
			opp-level = <10>;
		};

		/* ADT levels 11-20, measured on J813 (level 19, 4416 MHz, is below
		 * level 18 and left out). The SoC throttles them when hot. */
		opp-3720000000 {
			opp-hz = /bits/ 64 <3720000000>;
			opp-level = <11>;
		};

		opp-3876000000 {
			opp-hz = /bits/ 64 <3876000000>;
			opp-level = <12>;
		};

		opp-4020000000 {
			opp-hz = /bits/ 64 <4020000000>;
			opp-level = <13>;
		};

		opp-4176000000 {
			opp-hz = /bits/ 64 <4176000000>;
			opp-level = <14>;
		};

		opp-4248000000 {
			opp-hz = /bits/ 64 <4248000000>;
			opp-level = <15>;
		};

		opp-4272000000 {
			opp-hz = /bits/ 64 <4272000000>;
			opp-level = <16>;
		};

		opp-4332000000 {
			opp-hz = /bits/ 64 <4332000000>;
			opp-level = <17>;
		};

		opp-4428000000 {
			opp-hz = /bits/ 64 <4428000000>;
			opp-level = <18>;
		};

		opp-4464000000 {
			opp-hz = /bits/ 64 <4464000000>;
			opp-level = <20>;
		};
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		cpufreq_e: performance-controller@210e20000 {
			compatible = "apple,t8142-cluster-cpufreq";
			reg = <0x2 0x10e20000 0 0x1000>;
			#performance-domain-cells = <0>;
		};

		cpufreq_p: performance-controller@211e20000 {
			compatible = "apple,t8142-cluster-cpufreq";
			reg = <0x2 0x11e20000 0 0x1000>;
			#performance-domain-cells = <0>;
		};

		/*
		 * PMC voter interface (AppleT8142PMC, ADT pmc-pmgr 31 + 0x700000):
		 * floors at 0x382700000 + agent * 0x4000, per-agent states at
		 * +0x106000, rail enables at +0x108000. Agents (ADT voter-agent):
		 * PMP 0, CLPC 1, GFX 2, AP 3. iBoot leaves every enable at 0, so
		 * no vote is honoured and DRAM and fabric stay at their lowest
		 * states (CPU DRAM latency 171 ns instead of 70 ns).
		 */
		pmc: power-management@382700000 {
			compatible = "apple,t8142-pmc";
			reg = <0x3 0x82700000 0x0 0x10000>,
			      <0x3 0x82806000 0x0 0x3000>;
			reg-names = "voters", "rails";
			#address-cells = <1>;
			#size-cells = <0>;
			/* PMP, CLPC and AP agents */
			apple,static-voters = <0 1 3>;

			clpc: performance-controller@1 {
				compatible = "apple,t8142-clpc";
				reg = <1>;
			};
		};

		aic: interrupt-controller@381000000 {
			compatible = "apple,t8142-aic3", "apple,t8122-aic3";
			interrupt-controller;
			#interrupt-cells = <3>;
			reg = <3 0x81000000 0 0x1cc000>,
			      <3 0x81040000 0 0x4000>;
			reg-names = "core", "event";
		};

		serial0: serial@3a5200000 {
			compatible = "apple,s5l-uart";
			reg = <3 0xa5200000 0 0x4000>;
			reg-io-width = <4>;
			interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "uart", "clk_uart_baud0";
			status = "disabled";
		};

		dockchannel: serial@38812c000 {
			compatible = "apple,dockchannel-uart";
			reg = <3 0x8812c000 0 0x4000>,
			      <3 0x88128000 0 0x4000>,
			      <3 0x8810c000 0 0x1000>;
			reg-names = "data", "config", "irq";
			interrupts = <AIC_IRQ 571 IRQ_TYPE_LEVEL_HIGH>;
		};
	};
};

#include "t8142-j813-display.dtsi"
#include "t8142-j813-gpu.dtsi"
#include "t8142-j813-peripherals.dtsi"
#include "t8142-j813-usb.dtsi"
#include "t8142-j813-avd.dtsi"
#include "t8142-j813-isp.dtsi"
#include "t8142-j813-psci-idle.dtsi"
#include "t8142-j813-nvme.dtsi"
#include "t8142-j813-n1.dtsi"
#include "t8142-j813-power.dtsi"
#include "t8142-j813-audio.dtsi"

/* Hardware resources only. Ownership and driver enables require qualification. */

&{/soc} {

	dt5_dart_apciec0: iommu@404000000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x4 0x4000000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1500 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_acio0: iommu@401a80000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x4 0x1a80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1546 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_apciec1: iommu@40c000000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x4 0xc000000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1563 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_acio1: iommu@409a80000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x4 0x9a80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1609 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_sep: iommu@308b80000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x8b80000 0x0 0x20000>;
		interrupts = <AIC_IRQ 455 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_sio: iommu@3a5060000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xa5060000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1259 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_rsm: iommu@3899a0000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x899a0000 0x0 0xc000>;
		interrupts = <AIC_IRQ 406 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_disp0_isoc: iommu@286180000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x2 0x86180000 0x0 0x20000>;
		interrupts = <AIC_IRQ 823 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dcpext0: iommu@506340000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x5 0x6340000 0x0 0x20000>;
		interrupts = <AIC_IRQ 872 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dispext0: iommu@506300000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x5 0x6300000 0x0 0xc000>,
		      <0x5 0x6314000 0x0 0x4000>;
		interrupts = <AIC_IRQ 872 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dispext0_isoc: iommu@506180000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x5 0x6180000 0x0 0x20000>;
		interrupts = <AIC_IRQ 895 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dcpext1: iommu@3aa340000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xaa340000 0x0 0x20000>;
		interrupts = <AIC_IRQ 947 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dispext1: iommu@3aa300000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xaa300000 0x0 0xc000>,
		      <0x3 0xaa314000 0x0 0x4000>;
		interrupts = <AIC_IRQ 947 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_dispext1_isoc: iommu@3aa180000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xaa180000 0x0 0x20000>;
		interrupts = <AIC_IRQ 970 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_scaler: iommu@305260000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x5260000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1208 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		/* A dedicated scaler-DART gate mapping is not published by this ADT. */
		status = "disabled";
	};

	dt5_dart_jpeg: iommu@301020000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0x1020000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1157 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_apr: iommu@3a1020000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xa1020000 0x0 0xc000>,
		      <0x3 0xa1034000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1381 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_dart_scdc: iommu@3a1040000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <0x3 0xa1040000 0x0 0x20000>;
		interrupts = <AIC_IRQ 1381 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	dt5_apcie0_piodma: dma-controller@488030000 {
		compatible = "apple,t8142-pcie-piodma", "apple,pcie-piodma";
		reg = <0x4 0x88030000 0x0 0x4000>,
		      <0x4 0x88034000 0x0 0x4000>,
		      <0x4 0x88038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1464 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dart_apcie0 17>;
		status = "disabled";
	};

	dt5_apciec0_piodma: dma-controller@404068000 {
		compatible = "apple,t8142-pciec-piodma", "apple,pciec-piodma";
		reg = <0x4 0x4068000 0x0 0x4000>,
		      <0x4 0x406c000 0x0 0x4000>,
		      <0x4 0x4070000 0x0 0x4000>,
		      <0x4 0x403c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1501 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dt5_dart_apciec0 254>;
		status = "disabled";
	};

	dt5_apciec1_piodma: dma-controller@40c068000 {
		compatible = "apple,t8142-pciec-piodma", "apple,pciec-piodma";
		reg = <0x4 0xc068000 0x0 0x4000>,
		      <0x4 0xc06c000 0x0 0x4000>,
		      <0x4 0xc070000 0x0 0x4000>,
		      <0x4 0xc03c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 1564 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dt5_dart_apciec1 254>;
		status = "disabled";
	};

	dt5_aic_timebase: aic-timebase@591180000 {
		compatible = "apple,t8142-aic-timebase", "apple,aic-timebase";
		reg = <0x5 0x91180000 0x0 0x1000>;
		status = "disabled";
	};

	dt5_error_handler: error-handler@308d00000 {
		compatible = "apple,t8142-error-handler", "apple,soc-error-handler";
		reg = <0x3 0x8d00000 0x0 0x40000>,
		      <0x3 0x8900000 0x0 0x8000>,
		      <0x3 0x80000000 0x0 0x3c000>,
		      <0x3 0x80728000 0x0 0x4000>,
		      <0x3 0x80768000 0x0 0x4000>,
		      <0x3 0x882c8000 0x0 0x4000>,
		      <0x3 0x82000000 0x0 0x1000000>,
		      <0x3 0x803d0000 0x0 0x4000>,
		      <0x2 0x20000000 0x0 0x140000>,
		      <0x2 0x21000000 0x0 0x3c000>,
		      <0x2 0x21200000 0x0 0x3c000>,
		      <0x2 0x21400000 0x0 0x3c000>,
		      <0x2 0x21600000 0x0 0x3c000>,
		      <0x2 0x21800000 0x0 0x3c000>,
		      <0x2 0x21a00000 0x0 0x3c000>,
		      <0x2 0x21c00000 0x0 0x3c000>,
		      <0x2 0x21e00000 0x0 0x3c000>,
		      <0x2 0x4f000000 0x0 0x8000>,
		      <0x2 0x50000000 0x0 0x8000>,
		      <0x2 0x51000000 0x0 0x8000>,
		      <0x2 0x52000000 0x0 0x8000>,
		      <0x2 0x53000000 0x0 0x8000>,
		      <0x2 0x54000000 0x0 0x8000>,
		      <0x2 0x55000000 0x0 0x8000>,
		      <0x2 0x56000000 0x0 0x8000>,
		      <0x2 0x5f000000 0x0 0x8000>,
		      <0x2 0x6f000000 0x0 0x8000>,
		      <0x2 0x57000000 0x0 0x1000000>,
		      <0x2 0x58000000 0x0 0x1000000>,
		      <0x2 0x59000000 0x0 0x1000000>,
		      <0x3 0x80770000 0x0 0x4000>,
		      <0x3 0x80771000 0x0 0x4000>,
		      <0x2 0x5b000000 0x0 0x24000>;
		interrupts = <AIC_IRQ 454 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 457 IRQ_TYPE_LEVEL_HIGH>,
