/dts-v1/;

#include "t8142.dtsi"
#include "t8142-j704-peripherals.dtsi"

/ {
	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
	};
	model = "Apple MacBook Pro (14-inch, M5)";
	compatible = "apple,j704", "apple,t8142", "apple,arm-platform";
};

&cpufreq_e {
	status = "disabled";
};

&cpufreq_p {
	status = "disabled";
};

&pmc {
	status = "disabled";
};

#include "t8142-j704-audio-topology.dtsi"


#include "t8142-j704-power-domains.dtsi"
