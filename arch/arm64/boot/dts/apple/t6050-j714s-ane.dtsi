/*
 * The J714s Neural Engine. iBoot preloads the personalized firmware (ADT ane0
 * segment-ranges, TEXT 0xc0000 and DATA 0x2ac000 bytes). The boot loader fills
 * the two reservations from that boot's ADT, renames them to their physical
 * addresses and enables them; until then the ANE driver leaves the engine off.
 */

/ {
	reserved-memory {
		ane_fw_text: ane-firmware-text@0 {
			compatible = "apple,asc-mem";
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		ane_fw_data: ane-firmware-data@0 {
			compatible = "apple,asc-mem";
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};
	};
};

&ane0 {
	memory-region = <&ane_fw_text>, <&ane_fw_data>;
	memory-region-names = "firmware-text", "firmware-data";
	status = "okay";
};

&ane0_dart {
	status = "okay";
};

&ane0_dart1 {
	status = "okay";
};

&ane0_dart2 {
	status = "okay";
};

&ps_ane_sys {
	status = "okay";
};
