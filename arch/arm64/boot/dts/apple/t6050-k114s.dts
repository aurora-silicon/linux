// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (14-inch PROLED XDR, M5 Pro, 2026)
 *
 * target-type: K114s (Mac17,13)
 *
 * Preliminary: described from the ADT. Only the NVRAM partition (t6050-k114-k116.dtsi) has been run
 * on a K114s, from the boot loader's tree; this file as a whole has not been booted.
 *
 * Copyright The Asahi Linux Contributors
 */

/* Defined before the includes, which select this board's blocks on it. */
#define T6050_K114S
/* ADT /arm-io/acio2: the right port's USB4/Thunderbolt router */
#define T6050_ATC2_USB4_ROUTER
/* The N1's firmware and this board's ADT board-id, for t6050-k114-k116.dtsi */
#define T6050_K_N1_FIRMWARE	"apple/centauri/k114s-ftab.bin"
#define T6050_K_BOARD_ID	0x14
#include "t6050-k114-k116.dtsi"

/ {
	compatible = "apple,k114s", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch PROLED XDR, M5 Pro, 2026)";
};

&mtp_multitouch {
	firmware-name = "apple/tpmtfw-k114s.bin";
};

#include "t6050-peripherals.dtsi"

/* The 14-inch chassis: the Neural Engine, pins, the jack, the card and the AOP; no speakers */
#include "t6050-k114.dtsi"

/* The GPU, handed over by the boot loader */
#include "t6050-k114-k116-gpu.dtsi"

/* The internal panel, handed over by the boot loader */
#include "t6050-k114-k116-display.dtsi"

/*
 * The 14.2-inch 3024x1986 panel's active area (254 dpi, the notch rows included), for the
 * DPI only (the ADT carries none)
 */
&panel {
	compatible = "apple,panel-k114", "apple,panel";
	width-mm = <302>;
	height-mm = <199>;
};

/* Touch ID: the SEP and the Mesa sensor, with this Mac's own calibration and root key */
#define T6050_TOUCHID_FIRMWARE	"apple/mesacal-k114s.bin", "apple/msrk-k114s.bin"
#include "t6050-touchid.dtsi"

/*
 * The USB-C ports ATC1 and ATC2, as on the other K boards (t6050-k114-k116-usb.dtsi), then the
 * 14-inch chassis' MagSafe 3 PD controller and the right port's USB4/Thunderbolt router
 * (t6050-k114-usb.dtsi).
 */
#include "t6050-k114-k116-usb.dtsi"
#include "t6050-k114-usb.dtsi"

/*
 * The PMP (ADT pmp0, /chosen, /arm-io/pmgr), as on the K116s and the J714s: iBoot loads its
 * firmware and the driver starts it with these boot arguments and the firmware properties in
 * the tunables file. Its report tells it which devices are on; the PMC honours its votes next
 * to the CLPC.
 */
&ps_pms {
	status = "okay";
};

&ps_pmp {
	status = "okay";
};

&ps_pms_sram {
	status = "okay";
};

&pmp0_dart {
	status = "okay";
};

&pmp0_mbox {
	status = "okay";
};

&pmp0 {
	/* ADT /chosen board-id, dram-vendor-id */
	apple,board-id = <20>;
	apple,dram-vendor-id = <1>;
	/* ADT /arm-io/pmgr pmc, pmc-pmgr */
	apple,pmc = <1>;
	apple,pmc-pmgr = <63>;
	status = "okay";
};

&pmp0_report {
	status = "okay";
};

&pmc {
	/* PMP, CLPC and AP agents, once the PMP runs */
	apple,static-voters = <0 1 3>;
	apple,pmp = <&pmp0>;
};

#include "t6050-k114s-pmp-tunables.dtsi"
