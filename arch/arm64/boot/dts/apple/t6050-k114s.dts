// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (14-inch PROLED XDR, M5 Pro, 2026)
 *
 * target-type: K114s (Mac17,13)
 *
 * Preliminary: described from the ADT. Only the NVRAM partition below has been run on a K114s,
 * from the boot loader's tree; this file as a whole has not been booted.
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t6050-k114-k116.dtsi"

/ {
	compatible = "apple,k114s", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch PROLED XDR, M5 Pro, 2026)";
};

&mtp_multitouch {
	firmware-name = "apple/tpmtfw-k114s.bin";
};

#define T6050_K114S
#include "t6050-peripherals.dtsi"

/ {
	aliases {
		/* asahi-bless and the boot loader find the NVRAM partition by this alias */
		nvram = &nvram;
		/* The boot loader reserves SEP firmware and adds its manifests. */
		sep = &sep;
	};
};

/*
 * The boot NOR's NVRAM partition (ADT /arm-io/qspi/spinor/anvram: reg 0x700000, 0xc0000, 12
 * banks of 64 KiB). Only this partition is described, so the rest of the NOR has no device
 * node. Single-wire, as on the J775D: spi-nor then sends no quad-enable status write at probe.
 * The partition is read-only, as on the K114c.
 */
&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				reg = <0x700000 0xc0000>;
				read-only;
			};
		};
	};
};

/*
 * Expose AP GPIO 138 for Touch ID data ready. Keep all other AP pins
 * reserved (reading pin 112 takes an SError).
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 138>, <139 82>;
};

/*
 * Enable the SEP mailbox and power domain. Leave both fabric parents
 * under firmware control, so genpd can vote on them without turning them
 * off. apple_sep enables SEP and its DART when the mailbox is available.
 */
&sep_mbox {
	status = "okay";
};

&ps_sep {
	status = "okay";
};

&ps_fab8_soc {
	apple,firmware-owned;
	status = "okay";
};

&ps_fab0_piogw {
	apple,firmware-owned;
	status = "okay";
};

/*
 * Touch ID (ADT spi2/mesa): the Mesa sensor on spi2 at 8 MHz, chip select 0,
 * powered by NUB GPIO 21 (function-mesa_pwr), data ready on AP GPIO 138, as
 * on the J714s and K116s. spi2 runs from the 24 MHz reference (ADT clock-ids 451).
 */
&ps_nub_gpio {
	status = "okay";
};

&nub_gpio0 {
	status = "okay";
};

&ps_spi2 {
	status = "okay";
};

&spi2 {
	clocks = <&clkref>;
	status = "okay";

	mesa: fingerprint@0 {
		compatible = "apple,mesa-fingerprint";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;
		enable-gpios = <&nub_gpio0 21 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <138 IRQ_TYPE_EDGE_RISING>;
		/* Per-device factory data from this Mac's own iBoot system container */
		firmware-name = "apple/mesacal-k114s.bin", "apple/msrk-k114s.bin";
	};
};
