#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/apple.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

#include "multi-die-cpp.h"

#ifndef GPU_REPEAT
# define GPU_REPEAT(x) <x x x x>
#endif

#define APPLE_T600X_NON_ULTRA

#include "t600x-common.dtsi"

/ {
	compatible = "apple,t6001", "apple,arm-platform";

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;

		ranges;
		nonposted-mmio;
		/* Required to get >32-bit DMA via DARTs */
		dma-ranges = <0 0 0 0 0xffffffff 0xffffc000>;

		// filled via templated includes at the end of the file
	};
};

#define DIE
#define DIE_NO 0
#define SOC_NODE {/soc}

#include "t600x-die0.dtsi"
#include "t600x-dieX.dtsi"

&SOC_NODE {
#include "t600x-pciec.dtsi"
};

#include "t600x-nvme.dtsi"
#include "t600x-gpio-pins.dtsi"
#include "t600x-pmgr.dtsi"

#undef DIE
#undef DIE_NO
#undef SOC_NODE


&aic {
	affinities {
		e-core-pmu-affinity {
			apple,fiq-index = <AIC_CPU_PMU_E>;
			cpus = <&cpu_e00 &cpu_e01>;
		};

		p-core-pmu-affinity {
			apple,fiq-index = <AIC_CPU_PMU_P>;
			cpus = <&cpu_p00 &cpu_p01 &cpu_p02 &cpu_p03
				&cpu_p10 &cpu_p11 &cpu_p12 &cpu_p13>;
		};
	};
};

&pmp {
	apple,pio-ranges = <0x2 0x82000000 0x0 0x1000000>,
		<0x3 0x4000000 0x0 0x1000000>,
		<0x3 0x83000000 0x0 0x1000000>,
		<0x4 0x2000000 0x0 0x1000000>,
		<0x2 0x10e70000 0x0 0x90000>,
		<0x2 0x11e70000 0x0 0x90000>,
		<0x2 0x12e70000 0x0 0x90000>,
		<0x4 0x82000000 0x0 0x1000000>,
		<0x5 0x2000000 0x0 0x1000000>;
};

&gpu {
	compatible = "apple,agx-t6001", "apple,agx-g13c", "apple,agx-g13s";
};

#include "hwmon-common.dtsi"
/*
 * The ANE has run on the M1 Pro and the M1 Max, so enable it here with its
 * DARTs and the power states only it uses. t6000.dtsi includes this file.
 */
&ane {
	status = "okay";
};

&ane_dart0 {
	status = "okay";
};

&ane_dart1 {
	status = "okay";
};

&ane_dart2 {
	status = "okay";
};

&ps_ane_base {
	status = "okay";
};

&ps_ane_set0 {
	status = "okay";
};

&ps_ane_set1 {
	status = "okay";
};

&ps_ane_set2 {
	status = "okay";
};

&ps_ane_set3 {
	status = "okay";
};

&ps_ane_set4 {
	status = "okay";
};

&pmp_report {
	reg = <0x2 0x8e3c0000 0x0 0x20000>,
	      <0x2 0x85868000 0x0 0x4000>;
	reg-names = "report", "ane-dvfs";
};

&ane {
	apple,performance-controller = <&pmp_report>;
	power-domains = <&ps_ane_sys_cpu>, <&ps_ane_set1>,
		<&ps_ane_set2>, <&ps_ane_set3>, <&ps_ane_set4>, <&ps_pms_sram>;
};

#ifndef APPLE_T6000_SUBSET
/*
 * DRAM interface class for M1 Max (512-bit LPDDR5-6400, 400 GB/s class).
 * State IDs below describe firmware DCS states, not PMGR codes.
 */
/ {
	dram_opp: opp-table-dram {
		compatible = "operating-points-v2-apple-dram";
		opp-shared;

		opp-0 {
			opp-level = <0>;
		};

		opp-1 {
			opp-level = <1>;
		};

		opp-2 {
			opp-level = <2>;
		};

		opp-3 {
			opp-level = <3>;
			opp-hz = /bits/ 64 <3200000000>;
			apple,data-rate = /bits/ 64 <6400000000>;
		};
	};
};

&pmp_report {
	operating-points-v2 = <&dram_opp>;
	apple,dram-type = "lpddr5";
	apple,data-bus-width = <512>;
	apple,dcs-state-count = <4>;
	apple,peak-bandwidth-bytes-per-second = /bits/ 64 <409600000000>;
	apple,bandwidth-class-bytes-per-second = /bits/ 64 <400000000000>;
};

#ifdef APPLE_USE_PMP
/*
 * With the PMP managing DCS and fabric, request the CPU memory floor (DRAM
 * class 0x21 level 3, fabric class 0x25 level 2) and attach media blocks to
 * their PMP report entries, matching t6000.dtsi.
 */
&pmp_report {
	apple,pmp-tables = <&pmp>;
	apple,cpu-memory-floor = <0x21 3 0x25 2>;
};

&pmp_report_venc_sys {
	apple,adt-dvfs;
	status = "okay";
};

&pmp_report_avd_sys {
	apple,adt-dvfs;
};

&pmp_report_jpg {
	apple,adt-dvfs;
};

&pmp_report_msr0 {
	apple,adt-dvfs;
	status = "okay";
};

&pmp_report_scodec {
	apple,adt-dvfs;
	status = "okay";
};
#endif

#include "t6001-peripherals.dtsi"
#include "t6001-aux-spmi.dtsi"
#include "t6001-display-extra.dtsi"

/*
 * The die 0 video encoder is the M1 Pro's: the bootloader hands it the
 * firmware iBoot preloads, and without that handoff the driver refuses
 * the reservation and the encoder stays off.
 */
&ave_dart0 {
	status = "okay";
};

&ave_dart1 {
	status = "okay";
};

&ave {
	status = "okay";
#ifdef APPLE_USE_PMP
	power-domains = <&ps_venc_dma>, <&ps_venc_pipe4>,
			<&ps_venc_pipe5>, <&ps_venc_me0>, <&ps_venc_me1>,
			<&pmp_report_venc_sys>;
	power-domain-names = "dma", "pipe4", "pipe5", "me0", "me1", "perf";
#endif
};

#ifdef APPLE_USE_PMP
&scaler0 {
	power-domains = <&pmp_report_msr0>, <&ps_msr0_ase_core>;
};

&apr0 {
	power-domains = <&pmp_report_scodec>;
};
#endif
#endif
