/*
 * M4 Pro (T6040) USB4/Thunderbolt on every Type-C port. Each port's
 * connector is linked to the USB4 router behind the same ATC PHY. Every
 * T6040 board's ADT has the same acio0-2, dart-acio0-2 and acio-cpu0-2, pairs
 * acioN with atc-phyN (atc-phy-parent) and with the port controller whose
 * acio-parent is acioN, and the boards name that connector typecN:
 *   MacBook Pro 14/16 (J614s, J616s): typec0 left back, typec1 left front,
 *     typec2 right;
 *   Mac mini (J773s): typec0 back middle, typec1 back left, typec2 back
 *     right.
 *
 * The loader hands each router its router, adapter and NHI tuning and its
 * DROM over. No PCIe tunnels yet: host-to-host (XDomain, thunderbolt-net) and
 * USB4 links only.
 */

&pmgr_cio {
	status = "okay";
};

&ps_atc0_cio {
	status = "okay";
};

&ps_atc0_pcie {
	status = "okay";
};

&ps_atc0_cio_pcie {
	status = "okay";
};

&ps_atc0_cio_usb {
	status = "okay";
};

&usb4_0_mbox {
	status = "okay";
};

&usb4_0_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_0_dart {
	/* ADT dart-acio0 vm-base: the NHI addresses its rings below 1 TiB + 4 GiB. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_0_nhi {
	status = "okay";
};

&ps_atc1_cio {
	status = "okay";
};

&ps_atc1_pcie {
	status = "okay";
};

&ps_atc1_cio_pcie {
	status = "okay";
};

&ps_atc1_cio_usb {
	status = "okay";
};

&usb4_1_mbox {
	status = "okay";
};

&usb4_1_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_1_dart {
	/* The same DVA window as the ACIO0 router DART. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_1_nhi {
	status = "okay";
};

&ps_atc2_cio {
	status = "okay";
};

&ps_atc2_pcie {
	status = "okay";
};

&ps_atc2_cio_pcie {
	status = "okay";
};

&ps_atc2_cio_usb {
	status = "okay";
};

&usb4_2_mbox {
	status = "okay";
};

&usb4_2_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_2_dart {
	/* The same DVA window as the ACIO0 router DART. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_2_nhi {
	status = "okay";
};


&usb4_0_acio_tbt {
	remote-endpoint = <&typec0_con_tbt>;
};

&usb4_1_acio_tbt {
	remote-endpoint = <&typec1_con_tbt>;
};

&usb4_2_acio_tbt {
	remote-endpoint = <&typec2_con_tbt>;
};

&typec0 {
	ports {
		port@2 {
			reg = <2>;
			typec0_con_tbt: endpoint {
				remote-endpoint = <&usb4_0_acio_tbt>;
			};
		};
	};
};

&typec1 {
	ports {
		port@2 {
			reg = <2>;
			typec1_con_tbt: endpoint {
				remote-endpoint = <&usb4_1_acio_tbt>;
			};
		};
	};
};

&typec2 {
	ports {
		port@2 {
			reg = <2>;
			typec2_con_tbt: endpoint {
				remote-endpoint = <&usb4_2_acio_tbt>;
			};
		};
	};
};
