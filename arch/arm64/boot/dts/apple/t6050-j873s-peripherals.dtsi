		interrupts = <AIC_IRQ 0 985 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dcp: display-coproc@48ae00000 {
		compatible = "apple,t6050-display-coproc", "apple,display-coproc";
		reg = <0x4 0x8ae00000 0x0 0x88000>,
		      <0x4 0x8a850000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1044 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1043 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1046 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1045 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1048 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1047 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1050 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1049 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_dcp 23>, <&hw_dart_dcp 24>;
		status = "disabled";
	};

	hw_dart_dcp: dart-complex@48a340000 {
		compatible = "apple,t6050-dart-complex", "apple,dart-complex";
		reg = <0x4 0x8a340000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 0 990 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dart_disp0_isoc: dart-complex@48a180000 {
		compatible = "apple,t6050-dart-complex", "apple,dart-complex";
		reg = <0x4 0x8a180000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 0 1013 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_admac_disp0: admac-complex@48a140000 {
		compatible = "apple,t6050-admac-complex", "apple,admac-complex";
		reg = <0x4 0x8a140000 0x0 0x24000>,
		      <0x2 0x88328000 0x0 0x8>;
		interrupts = <AIC_IRQ 0 1012 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_disp0_isoc 30>;
		status = "disabled";
	};

	hw_admac_disp0_ced_ssw: admac-control@48a2f4000 {
		compatible = "apple,t6050-admac-control", "apple,admac-control";
		reg = <0x4 0x8a2f4000 0x0 0x4000>,
		      <0x4 0x8a1a0000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1014 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_avd0: video-decoder-complex@2308000000 {
		compatible = "apple,t6050-video-decoder-complex", "apple,video-decoder-complex";
		reg = <0x23 0x8000000 0x0 0x1404000>,
		      <0x23 0x88090000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 2417 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 2418 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dart_avd0: dart-complex@2309020000 {
		compatible = "apple,t6050-dart-complex", "apple,dart-complex";
		reg = <0x23 0x9020000 0x0 0x20000>,
		      <0x2 0x74000000 0x0 0x4000>;
		#iommu-cells = <1>;
