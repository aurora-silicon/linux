#include "t6050-peripherals.dtsi"

// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Register and interrupt resources; ownership-sensitive blocks stay disabled. */

&die0 {

	hw_i2c5: i2c-controller@505024000 {
		compatible = "apple,t6050-i2c-controller", "apple,i2c-controller";
		reg = <0x5 0x5024000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1380 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkref>;
		status = "disabled";
	};

	hw_apcie2_piodma: pcie-piodma@412030000 {
		compatible = "apple,t6050-pcie-piodma", "apple,pcie-piodma";
		reg = <0x4 0x12030000 0x0 0x4000>,
		      <0x4 0x12034000 0x0 0x4000>,
		      <0x4 0x12038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1541 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dart_apcie2 17>;
		status = "disabled";
	};

	hw_acio0: usb4-router@2a1f00000 {
		compatible = "apple,t6050-usb4-router", "apple,usb4-router";
		reg = <0x2 0xa1f00000 0x0 0x100000>,
		      <0x2 0xa1ac0000 0x0 0x4000>,
		      <0x2 0xa1ac4000 0x0 0x4000>,
		      <0x2 0xa1ac8000 0x0 0x4000>,
		      <0x2 0xa1e44000 0x0 0x4000>,
		      <0x2 0xa1c80000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1591 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1592 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1593 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1594 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1595 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1596 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1597 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1598 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1599 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1600 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1601 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1602 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1579 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1580 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1581 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1582 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1583 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1584 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1585 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1586 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1587 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1588 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1589 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1590 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1608 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_acio1: usb4-router@2a9f00000 {
		compatible = "apple,t6050-usb4-router", "apple,usb4-router";
		reg = <0x2 0xa9f00000 0x0 0x100000>,
		      <0x2 0xa9ac0000 0x0 0x4000>,
		      <0x2 0xa9ac4000 0x0 0x4000>,
		      <0x2 0xa9ac8000 0x0 0x4000>,
		      <0x2 0xa9e44000 0x0 0x4000>,
		      <0x2 0xa9c80000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1623 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1624 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1625 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1626 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1627 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1628 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1629 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1630 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1631 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1632 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1633 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1634 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1611 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1612 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1613 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1614 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1615 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1616 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1617 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1618 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1619 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1620 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1621 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1622 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1640 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_acio2: usb4-router@381f00000 {
		compatible = "apple,t6050-usb4-router", "apple,usb4-router";
		reg = <0x3 0x81f00000 0x0 0x100000>,
		      <0x3 0x81ac0000 0x0 0x4000>,
		      <0x3 0x81ac4000 0x0 0x4000>,
		      <0x3 0x81ac8000 0x0 0x4000>,
		      <0x3 0x81e44000 0x0 0x4000>,
		      <0x3 0x81c80000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1655 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1656 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1657 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1658 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1659 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1660 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1661 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1662 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1663 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1664 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1665 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1666 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1643 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1644 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1645 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1646 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1647 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1648 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1649 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1650 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1651 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1652 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1653 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1654 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1672 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_spi3: spi-controller@50510c000 {
		compatible = "apple,t6050-spi-controller", "apple,spi-controller";
		reg = <0x5 0x510c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1370 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_disp0: display-engine@488000000 {
		compatible = "apple,t6050-display-engine", "apple,display-engine";
		reg = <0x4 0x88000000 0x0 0x4000000>,
		      <0x4 0x8a240000 0x0 0x10000>,
		      <0x4 0x8a3ac000 0x0 0x4000>,
		      <0x4 0x8a800000 0x0 0x800000>,
		      <0x2 0x86700000 0x0 0x114000>;
		interrupts = <AIC_IRQ 0 981 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 980 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 981 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 982 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 983 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 984 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 985 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 986 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 987 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 988 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 989 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 990 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1000 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_disp0 0>, <&hw_dart_disp0 16>;
		status = "disabled";
	};

	hw_dart_disp0: dart-complex@48a300000 {
		compatible = "apple,t6050-dart-complex", "apple,dart-complex";
		reg = <0x4 0x8a300000 0x0 0xc000>,
		      <0x4 0x8a314000 0x0 0x4000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 0 990 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dcp0_expert: display-expert@48a3ac058 {
		compatible = "apple,t6050-display-expert", "apple,display-expert";
		reg = <0x4 0x8a3ac058 0x0 0x4>,
		      <0x4 0x8a374000 0x0 0x40>,
		      <0x4 0x8a370000 0x0 0x40>,
		      <0x4 0x8a388000 0x0 0x40>,
		      <0x4 0x8a38c000 0x0 0x40>,
		      <0x4 0x8a394000 0x0 0x40>,
		      <0x4 0x8a398000 0x0 0x40>,
		      <0x4 0x8a39c000 0x0 0x40>,
		      <0x4 0x8a3a0000 0x0 0x40>,
		      <0x4 0x88208000 0x0 0x40>,
		      <0x4 0x8820c000 0x0 0x40>,
		      <0x4 0x88210000 0x0 0x40>,
