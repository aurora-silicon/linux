// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * DPA1 and DPA2 belong to DCPEXT0 and DCPEXT1, respectively. SIO supplies
 * their sample streams; neither interface has AP-side registers.
 *
 * The first chain is enabled: the SIO DART, mailbox and CPU domain, DPA1
 * and its client. The SIO itself stays disabled here: iBoot has loaded its
 * firmware, and the boot loader enables the node once it has reserved that
 * firmware and published the T6041 boot tables (it finds it by the alias).
 * Without a T6041-aware loader DPA1 waits for its DMA channel and nothing
 * else changes. The DCP side starts only with appledrm.hdmi_audio=1.
 * DPA2 (DCPEXT1, SIO channel 0x68) stays disabled until it is qualified.
 */

/ {
	aliases {
		sio = &sio;
	};

	dpaudio1: audio-controller-1 {
		compatible = "apple,t6041-dpaudio", "apple,dpaudio";
		dmas = <&sio 0x66>;
		dma-names = "tx";
		power-domains = <&ps_dpa1>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dpaudio1_dcpext: endpoint {
					remote-endpoint = <&dcpext0_audio>;
				};
			};
		};
	};

	dpaudio2: audio-controller-2 {
		compatible = "apple,t6041-dpaudio", "apple,dpaudio";
		dmas = <&sio 0x68>;
		dma-names = "tx";
		power-domains = <&ps_dpa2>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dpaudio2_dcpext: endpoint {
					remote-endpoint = <&dcpext1_audio>;
				};
			};
		};
	};
};

&dcpext0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dcpext0_audio: endpoint {
				remote-endpoint = <&dpaudio1_dcpext>;
			};
		};
	};
};

&dcpext1 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dcpext1_audio: endpoint {
				remote-endpoint = <&dpaudio2_dcpext>;
			};
		};
	};
};

&ps_sio_cpu {
	status = "okay";
};

&sio_dart {
	status = "okay";
};

&sio_mbox {
	status = "okay";
};

&ps_dpa_p {
	status = "okay";
};

&ps_dpa1 {
	status = "okay";
};
