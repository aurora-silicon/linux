// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * T6041-specific PMGR power domains for hardware auto-managed DCS channels
 * and memory/SoC fabrics.
 *
 * Offsets and parent links verified against the J616c ADT (/arm-io/pmgr
 * devices and ps-groups). The DCS nodes omit their ADT parents, the AMCC
 * power states, which are not described in this device tree. All 32 DCS
 * channels (24 present on binned parts, 32 on full parts) and 12 fabrics
 * are hardware auto-managed: the boot loader may leave them forced on, and
 * they must be switched to hardware AUTO_ENABLE early at boot, before the
 * PMP starts. On binned parts dcs_24-31 are fused off and read as off.
 *
 * Copyright The Asahi Linux Contributors
 */

&pmgr_aux {
	ps_fab0_soc: power-controller@168 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x168 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "fab0_soc";
		power-domains = <&ps_afi>;
		apple,always-on;
		apple,auto-managed;
	};

	ps_dcs_00: power-controller@188 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x188 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "dcs_00";
		apple,auto-managed;
	};

	ps_dcs_01: power-controller@1a0 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x1a0 4>;
