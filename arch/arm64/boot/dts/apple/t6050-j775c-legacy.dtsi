		};

		cpu9: cpu@40103 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40103>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu10: cpu@40104 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40104>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m01>;
		};
		cpu11: cpu@40105 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40105>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu12: cpu@10200 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <1024>;
			device_type = "cpu";
			reg = <0x0 0x10200>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_p0_0>;
		};

		cpu13: cpu@10201 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <1024>;
