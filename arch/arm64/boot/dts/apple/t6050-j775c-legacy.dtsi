			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_p0_5>;
		};

		cpu18: cpu@41000 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x41000>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc01>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m10>;
		};

		cpu19: cpu@41001 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x41001>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc01>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m10>;
		};

		cpu20: cpu@41002 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x41002>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc01>;
			cpu-release-addr = <0 0>;
