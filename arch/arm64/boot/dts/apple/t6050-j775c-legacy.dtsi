// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple T6050 "M5 Ultra" SoC
 *
 * Two dies. Die 0's MMIO window is 0x2_00000000 and die 1's 0x42_00000000
 * (die stride 0x40_00000000); each has its own simple-bus, which the boot
 * loader looks up by unit address. Unit addresses are CPU physical
 * addresses. The boot loader starts the secondary CPUs and fills in their
 * release addresses, the memory node and its own reservations.
 *
 * Copyright The Asahi Linux Contributors
 */

#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/* Reuse integration's common nodes; retain the booted peripheral inventory below. */
#include "t6050-base.dtsi"

/ {
	compatible = "apple,t6050", "apple,arm-platform";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&aic>;

	/* The boot loader replaces reg with the usable RAM. */

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* The boot loader adds its own reservations. */

		/*
		 * The GPU's, all filled in and enabled by Aura's dt_set_gpu_t6050 from /arm-io/sgx and
		 * the gfx(1)-asc segment-ranges. Each lies outside /memory (below and above Linux's RAM).
		 * The UAT ranges (gpu-region, gfx-shared-region, gfx-shared-l2-region, gfx-handoff):
		 * both firmware roles publish their kernel roots into uat-pagetables while they boot.
		 */
		uat_handoff: uat-handoff {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		uat_l2_pagetables: uat-l2-pagetables {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		uat_pagetables: uat-pagetables {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		uat_ttbs: uat-ttbs {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		/* Both roles' __TEXT, contiguous: GFX's, then GFX1's. */
		gpu_fw_text: gpu-fw-text {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		/*
		 * Both roles' __DATA and __DATA_SHARED_RO, contiguous (gfx-data, gfx-data-shared-ro,
		 * gfx1-data, gfx1-data-shared-ro). Each role asks for its crash log at the physical
		 * address of its __DATA_SHARED_RO (evidence/gpu/2026-10-31-gfx-rtkit-boot.md).
		 */
		gpu_fw_data: gpu-fw-data {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		/*
		 * The ANE firmware preload. The loader fills reg from the ADT
		 * /arm-io/ane0 segment-ranges (TEXT 0xc0000 bytes, DATA 0x2ac000
		 * bytes), renames each node to its physical address and enables
		 * it, together with /chosen/apple,ane-cold-boot (Aura's
		 * dt_set_ane_node). Left disabled, the ANE driver does not start
		 * the engine. Neither segment may be reclaimed before reboot.
		 */
		ane_fw_text: ane-firmware-text@0 {
			compatible = "apple,asc-mem";
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		ane_fw_data: ane-firmware-data@0 {
			compatible = "apple,asc-mem";
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		/*
		 * Die d, cluster c, core n has MPIDR Aff2 4 for the two M-tier
		 * (apple,sawtooth) clusters and 1 for the P-tier (apple,everest)
		 * cluster, Aff1 0x10 * d + c and Aff0 n. Labels number the cores
		 * 18 * d + 6 * c + n. Die 0 comes first, so nr_cpus= brings the
		 * CPUs up in that order. The boot loader removes the nodes of the
		 * cores it did not start.
		 */
		cpu0: cpu@40000 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40000>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>; /* to be filled by the loader */
		};

		cpu1: cpu@40001 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40001>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu2: cpu@40002 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40002>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu3: cpu@40003 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40003>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu4: cpu@40004 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40004>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>;
		};
		cpu5: cpu@40005 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40005>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu6: cpu@40100 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40100>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu7: cpu@40101 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40101>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu8: cpu@40102 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <794>;
			device_type = "cpu";
			reg = <0x0 0x40102>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
