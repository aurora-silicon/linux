			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc1>;
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_p1_4>;
		};

		/*
		 * Caches beyond L1. Each Sawtooth (M) cluster shares an 8 MiB L2.
		 * An Everest (S) core has a private L2, and its cluster shares a
		 * 16 MiB L3. CLIDR_EL1 reports three cache levels on Everest and
		 * two on Sawtooth; macOS reports 16 MiB and 8 MiB per six cores
		 * (hw.perflevelN.l2cachesize, cpusperl2); dependent loads on J775c
		 * take 0.7 ns up to 128 KiB, 2.8 ns up to 512 KiB and 5-11 ns up
		 * to 8 MiB on an Everest core, and 1.0 ns up to 64 KiB and 4.7 ns
		 * up to 3 MiB on a Sawtooth core. The size of the Everest L2 is
		 * not established. Every CPU node must reach as many levels as
		 * CLIDR_EL1 reports, or cacheinfo ignores these nodes and treats
		 * every level above L1 as shared by all CPUs, which makes the
		 * scheduler's last-level-cache domain span all the clusters.
		 */
		l2_cache_m00: l2-cache-m00 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l2_cache_m01: l2-cache-m01 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l3_cache_p0: l3-cache-p0 {
			compatible = "cache";
			cache-level = <3>;
			cache-unified;
			cache-size = <0x1000000>;
		};

		l2_cache_p0_0: l2-cache-p0-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_1: l2-cache-p0-1 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_2: l2-cache-p0-2 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_3: l2-cache-p0-3 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_4: l2-cache-p0-4 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_5: l2-cache-p0-5 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_m10: l2-cache-m10 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l2_cache_m11: l2-cache-m11 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l3_cache_p1: l3-cache-p1 {
			compatible = "cache";
			cache-level = <3>;
			cache-unified;
			cache-size = <0x1000000>;
		};

		l2_cache_p1_0: l2-cache-p1-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p1>;
