		l2_cache_p1_1: l2-cache-p1-1 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p1>;
		};

		l2_cache_p1_2: l2-cache-p1-2 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			next-level-cache = <&l3_cache_p1>;
