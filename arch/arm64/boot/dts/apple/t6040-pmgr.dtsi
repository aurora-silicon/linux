// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * T6040 PMGR power domains the T6041 tree does not describe yet.
 *
 * The J773s and J616c ADTs list the same domains at the same offsets;
 * t604x-pmgr.dtsi holds the ones the J616c has qualified.
 *
 * Copyright The Asahi Linux Contributors
 */

&pmgr {
	ps_apcie_gp: power-controller@100 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x100 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_gp";
		status = "disabled";
	};

	ps_fab4_soc: power-controller@128 {
		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x128 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "fab4_soc";
		power-domains = <&ps_afc>;
		apple,always-on;
	};

