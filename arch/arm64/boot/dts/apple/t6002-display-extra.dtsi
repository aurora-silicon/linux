		      <0x4 0x8b800000 0x0 0x800000>,
		      <0x2 0x8e3d0000 0x0 0x4000>,
		      <0x4 0x8b850000 0x0 0x4000>;
		reg-names = "coproc", "disp-0", "disp-1", "disp-2",
			    "disp-3", "disp-4", "coproc-aux";
		mboxes = <&dcpext6_mbox>;
		mbox-names = "mbox";
		iommus = <&dcpext6_dart 0 0x0 0x0 0x0 0xfc000000>;
		power-domains = <&ps_dispext2_cpu0_die1>;
		resets = <&ps_dispext2_cpu0_die1>;
		apple,dcp-index = <3>;
