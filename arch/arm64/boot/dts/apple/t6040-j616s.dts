&atcphy1_mbox {
	status = "okay";
};

&usb_drd1_dart_0 {
	status = "okay";
};

&usb_drd1_dart_1 {
	status = "okay";
};

&usb_drd1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			usb_drd1_hs: endpoint {
				remote-endpoint = <&typec1_con_hs>;
			};
		};
	};
};

&atcphy2 {
	status = "okay";

	port {
		atcphy2_ss: endpoint {
			remote-endpoint = <&typec2_con_ss>;
		};
	};
};

&atcphy2_mbox {
	status = "okay";
};

&usb_drd2_dart_0 {
	status = "okay";
};

&usb_drd2_dart_1 {
	status = "okay";
};

&usb_drd2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			usb_drd2_hs: endpoint {
				remote-endpoint = <&typec2_con_hs>;
