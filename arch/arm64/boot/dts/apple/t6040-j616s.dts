/dts-v1/;

#include "t6040.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j616s", "apple,t6040", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M4 Pro, Nov 2024)";
	chassis-type = "laptop";

	aliases {
		keyboard = &keyboard;
		nvram = &nvram;
		spi0 = &qspi;
		wifi0 = "/pcie@1cb0000000/pci@0,0/wifi@0,0";
		bluetooth0 = "/pcie@1cb0000000/pci@0,0/bluetooth@0,1";
		/* used by the loader to hand over the display */
		dcp = &dcp;
		disp0 = &display;
		disp0-piodma = &disp0_piodma;
		/* the boot loader finds the GPU node through this alias */
		gpu = &gpu;
		pmp = &pmp;
		/* the boot loader reserves the SEP firmware through this alias */
		sep = &sep;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* The loader adds its own reservations */

		/*
		 * iBoot loads the ISP firmware below the kernel's memory. Its
		 * segments are the ADT's isp0 segment-ranges (macOS 26.6.2,
		 * iBoot mBoot-18000.161.10), mapped where the firmware runs them:
		 * 0x100_0000_0000 onwards, its 32 MiB main memory. The driver
		 * checks that the coprocessor's reset vector is this text before
		 * it starts the firmware.
		 */
		isp_fw_text: isp-firmware-text@10000c44000 {
			reg = <0x100 0x00c44000 0x0 0xca8000>;
			iommu-addresses = <&isp 0x100 0x0 0x0 0xca8000>;
			no-map;
		};

		isp_fw_data: isp-firmware-data@10001e7c000 {
			reg = <0x100 0x01e7c000 0x0 0x1344000>;
			iommu-addresses = <&isp 0x100 0xca8000 0x0 0x1344000>;
			no-map;
		};

		/* the firmware's main memory, the driver allocates above it */
		isp_heap: isp-heap {
			iommu-addresses = <&isp 0x100 0x0 0x0 0x2000000>;
		};

		/*
		 * Text segment of the loaded GPU firmware (ADT gfx-asc
		 * segment-ranges[0]); the driver identifies the build from it.
		 */
		gpu_fw_text: gpu-fw-text {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};

		/*
		 * Data segment of the loaded GPU firmware (ADT sgx gfx-data-*); it
		 * places its crash log here.
		 */
		gpu_fw_data: gpu-fw-data {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};

		/*
		 * The UAT ranges (ADT sgx gpu-region-*, gfx-shared-region-*,
		 * gfx-shared-l2-region-*, gfx-handoff-*). They stay no-map until
		 * the boot loader adds them to /memory.
		 */
		uat_ttbs: uat-ttbs {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};

		uat_pagetables: uat-pagetables {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};

		uat_l2_pagetables: uat-l2-pagetables {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};

		uat_handoff: uat-handoff {
			reg = <0 0 0 0>;
			status = "disabled";
			no-map;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0 0 0>; /* To be filled by loader */
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "apple::kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
		};
	};

	/*
	 * GPU performance states, one opp-microvolt cell per cluster (ADT
	 * /arm-io/sgx perf-states and perf-states1). The operating points are
	 * binned per device: the loader fills these placeholders.
	 * The driver requires a completed calibration handoff. Entries keep the
	 * order of the GPU performance states, which is not sorted by frequency.
	 */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp08 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp09 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp10 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp11 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp12 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp13 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp14 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
		opp15 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0>;
		};
	};

	/* The GPU's CS clock domain (ADT cs-perf-states) */
	gpu_cs_opp: opp-table-gpucs {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
	};

	/* The GPU's AFR clock domain (ADT afr-perf-states) */
	gpu_afr_opp: opp-table-gpuafr {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
	};

	/*
	 * CPU die temperature: SMC key TCMz (CPU die max), sensor 0 of
	 * smc_hwmon. The PMP's fast die-temperature limit regulates: its loop
	 * holds its own hot-spot sensors at 110 C (ADT fast-die-ctrl-loop),
	 * and under a sustained all-core load TCMz then settles at 113.4 to
	 * 114.7 C with the fans running. This zone is the backstop above that:
	 * passive at 116 C, critical (orderly shutdown) at 118 C, polled once a
	 * second as the SMC refreshes TCMz. The cpufreq cooling device sits on a
	 * cluster's policy CPU, so each map lists every CPU of its cluster.
	 *
	 * Per-cluster and GPU zones follow, one per SMC die-maximum sensor
	 * (smc_hwmon channels 1-23, in the order of the temperature nodes
	 * below): Tex0-3 throttle the E cluster, Tpx0-5 the first P cluster
	 * and Tpx8-D the second, with the same 116/118 C backstop as TCMz.
	 * Unlike the fanless J700, this machine has two SMC-driven fans and
	 * the PMP regulates the dies itself, so these zones only catch a
	 * failure of that loop; they never act in normal use.
	 *
	 * The GPU has no cooling device of its own: its firmware sets the GPU
	 * performance state and starts limiting at 101 C. So when a GPU die
	 * sensor reaches the GPU firmware's limit, the seven
	 * hottest ones (Tg05, Tg0S, Tg0Y, Tg0k, Tg0z, Tg1V, Tg1l) also shed
	 * CPU power through the CPU clusters, from the same 101 C, leaving the
	 * shared heat budget to the GPU. They shut down at 118 C. While the
	 * GPU is powered off its sensors report placeholder values from -4 to
	 * 4 C.
	 *
	 * The fans: left to themselves (SMC mode 3, with no OS asking for
	 * cooling) they stay off, or switch on late and ramp slowly, while the
	 * dies heat up under load. So the CPU die zone and the GPU zones also
	 * run both fans through a ladder of active trips; a fan takes the
	 * highest state any zone asks for and goes back to the SMC once no
	 * zone asks for anything. States 1-8 of a fan run it from its minimum
	 * (1350 rpm) to its maximum (5777 rpm) in even steps.
	 *
	 * sustainable-power is what the CPUs dissipate with the die held at
	 * its operating point: 720 s of all-core load (10 P, 4 E busy loops),
	 * headless, SMC fans in their own mode. Over the last 600 s TCMz held
	 * 112.0 to 113.8 C with the PMP limiting the P clusters to a mean of
	 * about 3.7 GHz and the fans at 3450/3730 rpm (where macOS settles
	 * too). The SMC core rails then read P0 25.3 W, P1 23.9 W and E 2.1 W
	 * on average, the units of the energy model. Each zone gets the sum
	 * over the clusters it throttles. Without it the power allocator
	 * estimates a budget from the cooling devices' lowest states, which
	 * throttles far below what this machine sustains.
	 */
#define J616S_FAN_TRIP(label, node, temp, hyst)	\
	label: node {					\
		temperature = <temp>;			\
		hysteresis = <hyst>;			\
		type = "active";			\
	};

#define J616S_FAN_TRIPS(zone)					\
	J616S_FAN_TRIP(zone##_fan1, trip-fan1, 75000, 10000)	\
	J616S_FAN_TRIP(zone##_fan2, trip-fan2, 80000, 5000)	\
	J616S_FAN_TRIP(zone##_fan3, trip-fan3, 85000, 5000)	\
	J616S_FAN_TRIP(zone##_fan4, trip-fan4, 90000, 5000)	\
	J616S_FAN_TRIP(zone##_fan5, trip-fan5, 95000, 5000)

#define J616S_FAN_MAP(trip_label, node, state)			\
	node {							\
		trip = <&trip_label>;				\
		cooling-device = <&smc_hwmon 0 state state>,	\
				 <&smc_hwmon 1 state state>;	\
	};

#define J616S_FAN_MAPS(zone)				\
	J616S_FAN_MAP(zone##_fan1, map-fan1, 1)		\
	J616S_FAN_MAP(zone##_fan2, map-fan2, 2)		\
	J616S_FAN_MAP(zone##_fan3, map-fan3, 3)		\
	J616S_FAN_MAP(zone##_fan4, map-fan4, 5)		\
	J616S_FAN_MAP(zone##_fan5, map-fan5, 8)

	thermal-zones {
		cpu-die-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <51300>;
			thermal-sensors = <&smc_hwmon 0>;	/* TCMz */

			trips {
				J616S_FAN_TRIPS(cpu_die)

				cpu_die_passive: cpu-die-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu-die-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				J616S_FAN_MAPS(cpu_die)

				map-e {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&cpu_die_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e0-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <2100>;
			thermal-sensors = <&smc_hwmon 1>;	/* Tex0 */

			trips {
				cpu_e0_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_e0_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e1-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <2100>;
			thermal-sensors = <&smc_hwmon 2>;	/* Tex1 */

			trips {
				cpu_e1_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_e1_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e2-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <2100>;
			thermal-sensors = <&smc_hwmon 3>;	/* Tex2 */

			trips {
				cpu_e2_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_e2_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-e3-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <2100>;
			thermal-sensors = <&smc_hwmon 4>;	/* Tex3 */

			trips {
				cpu_e3_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_e3_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p00-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <25300>;
			thermal-sensors = <&smc_hwmon 5>;	/* Tpx0 */

			trips {
				cpu_p00_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p0 {
					trip = <&cpu_p00_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p01-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <25300>;
			thermal-sensors = <&smc_hwmon 6>;	/* Tpx1 */

			trips {
				cpu_p01_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p0 {
					trip = <&cpu_p01_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p02-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <25300>;
			thermal-sensors = <&smc_hwmon 7>;	/* Tpx2 */

			trips {
				cpu_p02_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p0 {
					trip = <&cpu_p02_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p03-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <25300>;
			thermal-sensors = <&smc_hwmon 8>;	/* Tpx3 */

			trips {
				cpu_p03_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p0 {
					trip = <&cpu_p03_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
