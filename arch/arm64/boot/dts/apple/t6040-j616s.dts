						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	/*
	 * The speaker amps' shared shutdown line (SDZ, AP pin 54, low =
	 * shutdown). One fixed regulator, the SDZ supply of all six, not
	 * per-amp shutdown-gpios: with GPIO_SHARED six references become a
	 * vote, and one amp driving the line low would not shut the other
	 * five down.
	 */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl 54 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The AOP firmware runs the stream (MCA cluster 0, one serializer for
	 * all six amps); the J616 variant of macaudio links the AOP audio
	 * component's speaker back-end (DAI 3) to the amps. The codecs are
	 * listed in the ADT provider order, so each gets its native playback
	 * slot (LW1 0, RW1 1, LW2 2, RW2 3, LT 4, RT 5). The idle masks are the
	 * ADT amp-tx-zd-config rows 0 and 1: LW1 drives zeros in the right
	 * amps' sense slots, RW1 in the left amps'.
	 */
	sound: sound {
		compatible = "apple,j616-macaudio", "apple,macaudio";
		model = "MacBook Pro J616";
		speaker-id-gpios = <&pinctrl 52 GPIO_ACTIVE_HIGH>,
				   <&pinctrl 53 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f0f>;

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_right_woof1>,
					    <&speaker_left_woof2>, <&speaker_right_woof2>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};

	/*
	 * The headphone jack: the AOP audio component's jack back-end (DAI 4)
	 * to the CS42L84. A card of its own, so a codec that does not answer
	 * costs the jack only, never the speakers.
	 */
	sound_jack: sound-jack {
		compatible = "apple,j616-macaudio-jack", "apple,macaudio";
		model = "MacBook Pro J616 Jack";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 4>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

&cpuidle {
	status = "okay";
};

&smc {
	status = "okay";
};

&smc_mbox {
	status = "okay";
};

&nub_spmi0 {
	status = "okay";
};

&pinctrl {
	status = "okay";

	wifi_clkreq_pins: wifi-clkreq-pins {
		pinmux = <APPLE_PINMUX(0, 1)>;
	};
};

/*
 * The AP takes none of the always-on bank's interrupts: the AOP firmware
 * owns some of its pins and interrupt registers, and a chained handler here
 * would see their pending bits without a handler of ours.
 */
&pinctrl_nub {
	status = "okay";
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupts;
};

&fpwm0 {
	status = "okay";
};

/* apple_sep enables the SEP and its DART when it loads. */
&sep_mbox {
	status = "okay";
};

/*
 * Boot NOR. The partition is the J616s ADT /arm-io/qspi/spinor/anvram,
 * flash-relative; asahi-bless and asahi-nvram find it by its label.
 */
&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				reg = <0x700000 0x100000>;
			};
		};
	};
};

/* The QSPI controller cannot probe while its power state is disabled. */
&ps_qspi {
	status = "okay";
};

/*
 * Touch ID sensor (Mesa 0x3356). Its power is NUB GPIO 53 and its
 * data-ready line is AP GPIO 116, as the J616s ADT describes them.
 */
&spi2 {
	status = "okay";
};

&mesa {
	status = "okay";
	enable-gpios = <&pinctrl_nub 53 GPIO_ACTIVE_HIGH>;
	interrupt-parent = <&pinctrl>;
	interrupts = <116 IRQ_TYPE_EDGE_RISING>;
	spi-cs-setup-delay-ns = <20>;
	spi-cs-hold-delay-ns = <20>;
	/*
	 * Per-device factory data from this Mac's own iBoot system container:
	 * the sealed calibration and the sealed root key.
	 */
	firmware-name = "apple/mesacal-j616s.bin", "apple/msrk-j616s.bin";
};

/* The Type-C retimers (ADT atcrt at 0x18/0x19/0x1a) sit on this bus; no driver yet. */
&i2c6 {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	/* SMC key gp1c powers the trackpad analog front end. */
	apple,afe-smc = <&smc>;

	multi-touch {
		firmware-name = "apple/tpmtfw-j616s.bin";
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <2>;
	};

	stm {
	};

	actuator {
	};

	tp-accel {
	};

	mtp {
	};
};

&smc_hwmon {
	/*
	 * TCMz and the 23 zone sensors after it must stay the first
	 * temperature children: the thermal zones name a sensor by its index,
	 * so the shared hwmon includes below only append after them.
	 *
	 * Every key below is in this machine's SMC key table as a readable
	 * float and was read on the J616s (SMC firmware of macOS 26.6.2).
	 * Keys that only ever read a fixed placeholder (Tz1*, Ta0*) or a
	 * fixed limit (TVMx, TVmS, TVms, PHPB, PHPM) are left out; rails that
	 * read 0 W while idle are kept. GPU (Tg*), P-cluster (Tp*) and
	 * E-cluster (Te*) labels follow load tests: Tg* only read live while
	 * the GPU is powered and rise with GPU load, Tp* and Te* rise with CPU
	 * load. Other names follow the SMC key groups and are not otherwise
	 * verified. SBA1-3 are the three cells of the 3S battery.
	 */
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Die Max";
	};

	temperature-Tex0 {
		apple,key-id = "Tex0";
		label = "E-cluster Tex0";
	};

	temperature-Tex1 {
