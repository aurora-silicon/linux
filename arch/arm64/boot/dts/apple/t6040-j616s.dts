// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (16-inch, M4 Pro)
 *
 * target-type: J616s
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6040.dtsi"
#include "t604x-j614-j616.dtsi"

/ {
	compatible = "apple,j616s", "apple,t6040", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M4 Pro)";
};

/* ADT /arm-io/wlan module-instance */
&wifi0 {
	brcm,board-type = "apple,hostomel";
};

&bluetooth0 {
	brcm,board-type = "apple,hostomel";
};

&smc {
	smc_gpio_low_stockholm: gpio-low {
		compatible = "apple,smc-low-gpio";
		gpio-controller;
		#gpio-cells = <2>;
		apple,output-templates = <0xe 0x00800000>;
	};
};

&aop_spmi0 {
	status = "okay";

	stockholm: nfc@9 {
		compatible = "apple,stockholm-nci";
		reg = <9 SPMI_USID>;
		interrupt-parent = <&aop_spmi0>;
		interrupts = <229 IRQ_TYPE_EDGE_RISING>,
			     <230 IRQ_TYPE_EDGE_RISING>,
			     <227 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wake", "data-ready", "error";
		enable-gpios = <&smc_gpio_low_stockholm 0xe GPIO_ACTIVE_HIGH>;
	};
};

&panel {
	compatible = "apple,panel-j616", "apple,panel-mini-led", "apple,panel";
	width-mm = <345>;
	height-mm = <223>;
	adj-height-mm = <216>;
	/* "Wide color (P3)" in the Apple technical specifications */
	apple,color-gamut = "display-p3";
};

&aop_audio {
	apple,chassis-name = "J616";
};

&sound {
	compatible = "apple,j616-macaudio", "apple,macaudio";
	model = "MacBook Pro J616";
};

&sound_jack {
	compatible = "apple,j616-macaudio-jack", "apple,macaudio";
	model = "MacBook Pro J616 Jack";
};

&mtp_mt {
	firmware-name = "apple/tpmtfw-j616s.bin";
};

/*
 * Per-device factory data from this Mac's own iBoot system container: the
 * sealed calibration and the sealed root key.
 */
&mesa {
	firmware-name = "apple/mesacal-j616s.bin", "apple/msrk-j616s.bin";
};

&ps_jpg {
	status = "okay";
};

&jpeg0_dart {
	status = "okay";
};

&jpeg0 {
	status = "okay";
};

&jpeg1_dart {
	status = "okay";
};

&jpeg1 {
	status = "okay";
};
