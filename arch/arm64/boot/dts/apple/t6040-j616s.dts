#include "t6040-j616s-usb3.dtsi"

/* External display chain, all disabled: the gate in drivers/soc/apple/display-gate.c enables it. */
#include "t6040-j616s-extdisp.dtsi"
#include "t6040-j616s-extdisp-mem-loader.dtsi"
#include "t6040-j616s-extdisp-hdmi.dtsi"
#include "t6040-j616s-extdisp-usbc.dtsi"
/* Additional Abbey PMICs on the two independent NUB SPMI buses. */
&nub_spmi1 {
	status = "okay";

	pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;
	};
};

&nub_spmi2 {
	status = "okay";

	pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;
	};
};

&ps_nub_spmi_ahb {
	status = "okay";
};

&ps_nub_spmi1 {
	status = "okay";
};

&ps_nub_spmi2 {
	status = "okay";
};

&pinctrl {
	sd_clkreq_pins: sd-clkreq-pins {
		pinmux = <APPLE_PINMUX(1, 1)>;
	};
};

&pcie0 {
	interrupts = <AIC_IRQ 1723 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1732 IRQ_TYPE_LEVEL_HIGH>;
	/* Widen bus-range only with the SD power/port ownership handoff. */
	iommu-map = <0x100 &pcie_dart 1 2>, <0x200 &apcie1_dart 1 1>;

	port01: pci@1,0 {
		device_type = "pci";
		reg = <0x800 0 0 0 0>;
		reset-gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&sd_clkreq_pins>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
				<0 0 0 2 &port01 0 0 0 1>,
				<0 0 0 3 &port01 0 0 0 2>,
				<0 0 0 4 &port01 0 0 0 3>;
		/* The SD power switch needs an SMC service binding. */
		status = "disabled";
	};
};

/*
 * The SMC owns automatic fan policy. Drop the host fan trip/map instances
 * after the board's thermal descriptions, retaining all passive and critical
 * protection. Keep this final policy separate from ladder descriptions so
 * independent ladder updates cannot restore autonomous SMC writes.
 */

#define J616S_DELETE_FAN_TRIPS \
	/delete-node/ trip-fan1; \
	/delete-node/ trip-fan2; \
	/delete-node/ trip-fan3; \
	/delete-node/ trip-fan4; \
	/delete-node/ trip-fan5;

/* Some CPU ladders also map full fan speed to the passive trip. */
#define J616S_DELETE_FAN_MAPS \
	/delete-node/ map-fan1; \
	/delete-node/ map-fan2; \
	/delete-node/ map-fan3; \
	/delete-node/ map-fan4; \
	/delete-node/ map-fan5; \
	/delete-node/ map-fan6;

/ {
	thermal-zones {
		cpu-die-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu0-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu1-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu2-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu3-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu4-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu5-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};

		gpu6-thermal {
			trips {
				J616S_DELETE_FAN_TRIPS
			};

			cooling-maps {
				J616S_DELETE_FAN_MAPS
			};
		};
	};
};

#undef J616S_DELETE_FAN_TRIPS
#undef J616S_DELETE_FAN_MAPS
