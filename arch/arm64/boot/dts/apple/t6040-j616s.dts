/*
 * MacBook Pro (16-inch, M4 Pro)
 *
 * target-type: J616s
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6040.dtsi"
#include "t604x-j614-j616.dtsi"

/ {
	compatible = "apple,j616s", "apple,t6040", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M4 Pro)";
};

/* ADT /arm-io/wlan module-instance */
&wifi0 {
	brcm,board-type = "apple,hostomel";
	/* WLAN host wake (PCIe WAKE#), active high */
	wake-gpios = <&pinctrl 39 GPIO_ACTIVE_HIGH>;
	wakeup-source;
};

&bluetooth0 {
	brcm,board-type = "apple,hostomel";
	/* Bluetooth host wake (PCIe WAKE#), active high */
	wake-gpios = <&pinctrl 40 GPIO_ACTIVE_HIGH>;
};

&smc {
	smc_gpio_low: gpio-low {
		compatible = "apple,smc-low-gpio";
		gpio-controller;
		#gpio-cells = <2>;
		apple,output-templates = <0xe 0x00800000>;
	};
};

&aop_spmi0 {
	status = "okay";

	stockholm: nfc@9 {
		compatible = "apple,stockholm-nci";
		reg = <9 SPMI_USID>;
		interrupt-parent = <&aop_spmi0>;
		interrupts = <229 IRQ_TYPE_EDGE_RISING>,
			     <230 IRQ_TYPE_EDGE_RISING>,
			     <227 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wake", "data-ready", "error";
		enable-gpios = <&smc_gpio_low 0xe GPIO_ACTIVE_HIGH>;
	};
};

&panel {
	compatible = "apple,panel-j616", "apple,panel-mini-led", "apple,panel";
	width-mm = <345>;
	height-mm = <223>;
	adj-height-mm = <216>;
};

&aop_audio {
	apple,chassis-name = "J616";
};

&sound {
	compatible = "apple,j616-macaudio", "apple,macaudio";
	model = "MacBook Pro J616";
};

&sound_jack {
	compatible = "apple,j616-macaudio-jack", "apple,macaudio";
	model = "MacBook Pro J616 Jack";
};

&mtp_mt {
	firmware-name = "apple/tpmtfw-j616s.bin";
};

/*
 * Per-device factory data from this Mac's own iBoot system container: the
 * sealed calibration and the sealed root key.
 */
&mesa {
	firmware-name = "apple/mesacal-j616s.bin", "apple/msrk-j616s.bin";
};

&i2c4 {
	sd_card_control: card-control@20 {
		compatible = "apple,t6041-sd-card-control", "apple,sd-card-control";
		reg = <0x20>;
		status = "disabled";
	};
};

&i2c8 {
	display_pcon: display-converter@8 {
		compatible = "apple,t6041-display-pcon", "apple,display-pcon";
		reg = <0x8>;
		status = "disabled";
	};
};

/*
 * Panel timing controller. Its chip select is AP GPIO 34.
 *
 * The downstream bus stays disabled: with the panel on, the controller
 * answers every access request with a refusal (acknowledgment 3), and
 * with the panel off its registers read back as zero, so the TMP103
 * panel sensors cannot be reached from the AP.
 */
&ps_spi4 {
	status = "okay";
};

&spi4 {
	cs-gpios = <&pinctrl 34 GPIO_ACTIVE_LOW>;
	status = "okay";

	tcon: panel-controller@0 {
		compatible = "parade,dp855";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;

		i2c {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			temperature-sensor@70 {
				compatible = "ti,tmp103";
				reg = <0x70>;
				read-only;
				status = "disabled";
			};

			/*
			 * 0x71 is also the panel source driver write-protect
			 * endpoint on this bus, which the driver never reaches.
			 */
			temperature-sensor@71 {
				compatible = "ti,tmp103";
				reg = <0x71>;
				read-only;
				status = "disabled";
			};

			temperature-sensor@72 {
				compatible = "ti,tmp103";
				reg = <0x72>;
				read-only;
				status = "disabled";
			};
		};
	};
};

&i2c6 {
	retimer@18 {
		compatible = "apple,t6041-atcrt", "apple,atcrt";
		reg = <0x18>;
		status = "disabled";
	};
	retimer@19 {
		compatible = "apple,t6041-atcrt", "apple,atcrt";
		reg = <0x19>;
		status = "disabled";
	};
	retimer@1a {
		compatible = "apple,t6041-atcrt", "apple,atcrt";
		reg = <0x1a>;
		status = "disabled";
	};
};

/* Scaler/CSC (MSR) and its DART, proven on this board. */
&ps_msr0 {
	status = "okay";
};

&ps_msr0_ase_core {
	status = "okay";
};

&scaler0_dart {
	status = "okay";
};

&scaler0 {
	status = "okay";
};

/*
 * ProRes encoder and its DART. The engine runs with SCODEC_STREAMING (and so
 * SCODEC) powered. The driver has built-in power-up rows for it; an optional
 * apple/prores-t6041-init.bin replaces them.
 */
&ps_fab1_soc {
	status = "okay";
};

&ps_scodec {
	status = "okay";
};

&ps_scodec_streaming {
	status = "okay";
};

&apr0_dart {
	status = "okay";
};

&apr0 {
	status = "okay";
};

/*
 * USB4/Thunderbolt on all three Type-C ports: typec0 (left back, ACIO0),
 * typec1 (left front, ACIO1) and typec2 (right, ACIO2). The loader hands
 * each router its router, adapter and NHI tuning and its DROM over. No PCIe
 * tunnels yet: host-to-host (XDomain, thunderbolt-net) and USB4 links only.
 */
&pmgr_cio {
	status = "okay";
};

&ps_atc0_cio {
	status = "okay";
};

&ps_atc0_pcie {
	status = "okay";
};

&ps_atc0_cio_pcie {
	status = "okay";
};

&ps_atc0_cio_usb {
	status = "okay";
};

&usb4_0_mbox {
	status = "okay";
};

&usb4_0_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_0_dart {
	/* ADT dart-acio0 vm-base: the NHI addresses its rings below 1 TiB + 4 GiB. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_0_nhi {
	status = "okay";
};

&ps_atc1_cio {
	status = "okay";
};

&ps_atc1_pcie {
	status = "okay";
};

&ps_atc1_cio_pcie {
	status = "okay";
};

&ps_atc1_cio_usb {
	status = "okay";
};

&usb4_1_mbox {
	status = "okay";
};

&usb4_1_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_1_dart {
	/* The same DVA window as the ACIO0 router DART. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_1_nhi {
	status = "okay";
};

&ps_atc2_cio {
	status = "okay";
};

&ps_atc2_pcie {
	status = "okay";
};

&ps_atc2_cio_pcie {
	status = "okay";
};

&ps_atc2_cio_usb {
	status = "okay";
};

&usb4_2_mbox {
	status = "okay";
};

&usb4_2_acio {
	/delete-property/ apple,pcie-tunnel;
	status = "okay";
};

&usb4_2_dart {
	/* The same DVA window as the ACIO0 router DART. */
	apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	status = "okay";
};

&usb4_2_nhi {
	status = "okay";
};

/*
 * The internal PCIe controller (Wi-Fi/Bluetooth, SD reader) needs APCIE_GP,
 * APCIE_SYS_GP and APCIE_PHY_SW on top of the always-on ANS/APCIE_ST*
 * states (ADT apcie0 clock-gates). iBoot leaves them on. The driver keeps
 * internal links up through suspend-to-idle and cannot retrain them after
 * a power cycle, so describe them as always-on: Linux now holds what it
 * needs instead of relying on iBoot's state.
 */
&ps_apcie_gp {
	apple,always-on;
	status = "okay";
};

&ps_apcie_sys_gp {
	apple,always-on;
	status = "okay";
};

&ps_apcie_phy_sw {
	apple,always-on;
	status = "okay";
};

&pcie0 {
	power-domains = <&ps_apcie_sys_gp>, <&ps_apcie_phy_sw>;
};

/* The debug UART on the DebugUSB port; it is not the console. */
&serial0 {
	status = "okay";
};

&ps_uart0 {
	status = "okay";
};

/* SIO AES engine, software keys only. */
&ps_aes {
	status = "okay";
};

&aes {
	status = "okay";
};
