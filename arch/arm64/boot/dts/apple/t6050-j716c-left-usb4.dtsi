			<&acio1_dart 27>;
		};
	};
};
/ {
	acio1_pcie_tunnel: pcie-tunnel-1 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		apciec1_dart: iommu@2ac000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0xac000000 0x0 0x20000>;
			interrupts = <AIC_IRQ 0 1438 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc1_pcie>;
			#iommu-cells = <1>;
			apple,bypass-sids = <253 255>;
			apple,full-error-reporting;
			apple,ctc-flush;
		};

		apciec1: pcie@1c60000000 {
			compatible = "apple,t6050-pciec";
			device_type = "pci";
			reg = <0x1c 0x60000000 0x0 0x10000000>,
			<0x2 0xac034000 0x0 0x4000>,
			<0x2 0xac020000 0x0 0x8000>,
			<0x2 0xac038000 0x0 0x4000>,
			<0x2 0xac060000 0x0 0x4000>,
			<0x2 0xac02c000 0x0 0x4000>,
			<0x2 0xac028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug", "ltssm", "intr2axi";

			interrupts = <AIC_IRQ 0 1437 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port0";
			power-domains = <&ps_atc1_pcie>;

			apple,pciec-kernel-init;

			msi-controller;
			msi-parent = <&apciec1>;
			msi-ranges = <&aic AIC_IRQ 0 1984 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <160>;

			iommu-map = <0x0 &apciec1_dart 0x0 0x40>;
			iommu-map-mask = <0x3f>;
			linux,pci-domain = <2>;
			bus-range = <0x0 0x7f>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0xc 0x0 0xc 0x0 0x2 0x0>,
			<0x02000000 0x0 0x00100000 0xe 0x00100000 0x0 0x3ff00000>,
			<0x42000000 0x0 0x40000000 0xe 0x40000000 0x0 0x40000000>;

			apciec1_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;

				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &apciec1_port 0 0 0 0>,
				<0 0 0 2 &apciec1_port 0 0 0 1>,
				<0 0 0 3 &apciec1_port 0 0 0 2>,
				<0 0 0 4 &apciec1_port 0 0 0 3>;
			};
		};
	};
};
