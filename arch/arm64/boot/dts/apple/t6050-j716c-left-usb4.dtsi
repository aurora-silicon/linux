	<&ps_atc1_common_dp_2>, <&ps_atc1_common_dp_3>;

	power-domain-names = "usb-aon", "common", "wrapper", "usb", "dp0", "dp1", "dp2", "dp3";
};
&acio1 {
	interrupts = <AIC_IRQ 0 1635 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 0 1636 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 0 1641 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 0 1642 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "dpin0", "dpin1", "dpin2", "dpin3";
};
&hpm1 { connector { ports { port@2 {
				reg = <2>;
				#address-cells = <1>; #size-cells = <0>;
				hpm1_dp0: endpoint@0 { reg = <0>; remote-endpoint = <&dcpext0_left1>; };
				hpm1_dp1: endpoint@1 { reg = <1>; remote-endpoint = <&dcpext2_left1>; };
			}; }; }; };
&dcpext0 {
	apple,typec-dptx-phys = <2 0 1>;
	apple,typec-mux-indices = <0 0 0>;
	phys = <&atc2_phy 6>, <&atc0_phy 6>, <&atc1_phy 6>;
	phy-names = "typec0", "typec1", "typec2";
	mux-controls = <&atc2_xbar 0>, <&atc2_xbar 1>, <&atc2_xbar 2>, <&atc2_xbar 3>, <&atc2_xbar 4>, <&atc0_dpxbar 0>, <&atc0_dpxbar 1>, <&atc0_dpxbar 2>, <&atc0_dpxbar 3>, <&atc0_dpxbar 4>, <&atc1_dpxbar 0>, <&atc1_dpxbar 1>, <&atc1_dpxbar 2>, <&atc1_dpxbar 3>, <&atc1_dpxbar 4>;
	mux-control-names = "typec0", "typec0-dpin0", "typec0-dpin1", "typec0-dpin2", "typec0-dpin3", "typec1", "typec1-dpin0", "typec1-dpin1", "typec1-dpin2", "typec1-dpin3", "typec2", "typec2-dpin0", "typec2-dpin1", "typec2-dpin2", "typec2-dpin3";
	typec-routes {
		route@1 { reg = <1>; mode-switch;
			port { dcpext0_left0: endpoint { remote-endpoint = <&hpm0_dp0>; }; };
		};
		route@2 { reg = <2>; mode-switch;
			port { dcpext0_left1: endpoint { remote-endpoint = <&hpm1_dp0>; }; };
		};
	};
};
&dcpext2 {
	apple,typec-dptx-phys = <2 0 1>;
	apple,typec-mux-indices = <4 4 4>;
	phys = <&atc2_phy 6>, <&atc0_phy 6>, <&atc1_phy 6>;
	phy-names = "typec0", "typec1", "typec2";
	mux-controls = <&atc2_xbar 0>, <&atc2_xbar 1>, <&atc2_xbar 2>, <&atc2_xbar 3>, <&atc2_xbar 4>, <&atc0_dpxbar 0>, <&atc0_dpxbar 1>, <&atc0_dpxbar 2>, <&atc0_dpxbar 3>, <&atc0_dpxbar 4>, <&atc1_dpxbar 0>, <&atc1_dpxbar 1>, <&atc1_dpxbar 2>, <&atc1_dpxbar 3>, <&atc1_dpxbar 4>;
	mux-control-names = "typec0", "typec0-dpin0", "typec0-dpin1", "typec0-dpin2", "typec0-dpin3", "typec1", "typec1-dpin0", "typec1-dpin1", "typec1-dpin2", "typec1-dpin3", "typec2", "typec2-dpin0", "typec2-dpin1", "typec2-dpin2", "typec2-dpin3";
	typec-routes {
		route@1 { reg = <1>; mode-switch;
			port { dcpext2_left0: endpoint { remote-endpoint = <&hpm0_dp1>; }; };
		};
		route@2 { reg = <2>; mode-switch;
			port { dcpext2_left1: endpoint { remote-endpoint = <&hpm1_dp1>; }; };
		};
	};
};

&usb_drd0 {
	status = "okay";
	compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
	reg = <0x2 0xa2280000 0x0 0xcd00>,
	<0x2 0xa228cd00 0x0 0x4b00>,
	<0x2 0xa2200000 0x0 0x4000>;
	reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
	interrupts = <AIC_IRQ 0 1419 IRQ_TYPE_LEVEL_HIGH>;
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "host";
	iommus = <&usb_drd0_dart_0 0>, <&usb_drd0_dart_1 1>;
	power-domains = <&ps_atc0_usb>;
	resets = <&atc0_phy 0>;
	phys = <&atc0_phy PHY_TYPE_USB2>, <&atc0_phy PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	apple,tunable-gbl-default = <0x64 0x2 0x0>, <0x10 0xfff80000 0x00680000>;
	apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
	<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
	<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
	<0x52c 0xff0000ff 0x08000008>, <0x580 0xffffffff 0x6f000006>,
	<0x584 0xffffffff 0x00060000>;
	apple,tunable-dbg = <0x0 0x8 0x8>;
	apple,tunable-cfg-host = <0x20 0xff 0x1b>;
	apple,tunable-link = <0x10 0xff000000 0xff000000>, <0x20 0x7ff00000 0x4e900000>,
	<0x24 0x001f8000 0x000b8000>, <0x60 0x0003ffff 0x00000600>;
	apple,tunable-cio = <0x20 0x00ff0000 0x001e0000>;

	port {
		usb_drd0_hs: endpoint {
			remote-endpoint = <&hpm0_hs>;
		};
	};
};

&usb_drd1 {
	port {
		usb_drd1_hs: endpoint {
			remote-endpoint = <&hpm1_hs>;
		};
	};
};

&atc1_phy {
	port {
		atc1_phy_ep: endpoint {
			remote-endpoint = <&hpm1_ss>;
		};
	};
};

/* Supply domains and IOMMUs shared with the disabled SoC inventory. */
&ps_fab0_piogw { status = "okay"; };
&ps_fab3_soc { status = "okay"; };
&usb_drd0_dart_0 { status = "okay"; };
&usb_drd0_dart_1 { status = "okay"; };
