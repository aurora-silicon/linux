/* J716c left USB and USB4 ports (ATC0 and ATC1). */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
	};
};
/ { aliases { atcphy0 = &atc0_phy; atcphy1 = &atc1_phy; }; };
&{/soc@200000000} {
	atc0_phy_mbox: mailbox@2a3148000 {
		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x2 0xa3148000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 841 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 842 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 843 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 844 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
	};
	atc0_phy: phy@2a3000000 {
		compatible = "apple,t6050-combo-phy";
		reg = <0x2 0xa3000000 0x0 0x2c000>,
		<0x2 0xa2a90000 0x0 0x4000>,
		<0x2 0xa2800000 0x0 0x4000>,
		<0x2 0xa3200000 0x0 0x4000>,
		<0x2 0xa3244000 0x0 0x4000>,
		<0x2 0xa0000000 0x0 0x8000>,
		<0x2 0xa0020000 0x0 0x4000>,
		<0x2 0xa3250000 0x0 0x4000>,
		<0x2 0xa3140000 0x0 0x4000>,
		<0x2 0xa30c0000 0x0 0x10000>,
		<0x2 0xa2a84000 0x0 0x4000>;
		reg-names = "core", "usb2phy", "usb2-digital", "reset", "fabric", "axi2af", "lioa",
		"common-cfg", "usb-control", "firmware-data", "pipehandler";
		#phy-cells = <1>;
		#reset-cells = <1>;
		apple,port-index = <0>;
		apple,guest-port-reserved;
		mode-switch;
		orientation-switch;
		mboxes = <&atc0_phy_mbox>;
		power-domains = <&ps_atc0_usb_aon>, <&ps_atc0_common>, <&ps_atc0_phymxwrap>,
		<&ps_atc0_usb>;
		power-domain-names = "usb-aon", "common", "wrapper", "usb";

		port {
			atc0_phy_ep: endpoint {
				remote-endpoint = <&hpm0_ss>;
			};
		};
	};

	usb_drd0_dart_0: iommu@2a2f00000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xa2f00000 0x0 0xc000>;
		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc0_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	};
	usb_drd0_dart_1: iommu@2a2f80000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xa2f80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc0_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
	};
};
&ps_atc0_common {
	status = "okay";
};
&ps_atc0_usb_aon {
	status = "okay";
};

&ps_atc0_usb {
	power-domains = <&ps_atc0_common>, <&ps_atc0_usb_aon>;
	status = "okay";
};

&ps_atc0_phymxwrap {
	power-domains = <&ps_atc0_common>, <&ps_atc0_usb_aon>;
	status = "okay";
};
&atc1_phy_mbox { status = "okay"; };
&atc1_phy { status = "okay"; };
&usb_drd1 { status = "okay"; };
&usb_drd1_dart_0 { status = "okay"; };
&usb_drd1_dart_1 { status = "okay"; };
&hpm0 {
	status = "okay";
	apple,reset-inherited-usb2-connection;
	connector {
		compatible = "usb-c-connector";
		label = "USB-C Left Rear";
		power-role = "dual";
		data-role = "host";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				hpm0_hs: endpoint {
					remote-endpoint = <&usb_drd0_hs>;
				};
			};

			port@1 {
				reg = <1>;
				hpm0_ss: endpoint {
					remote-endpoint = <&atc0_phy_ep>;
				};
			};
		};
	};

};
&hpm1 {
	status = "okay";
	connector {
		compatible = "usb-c-connector";
		label = "USB-C Left Front";
		power-role = "dual";
		data-role = "host";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				hpm1_hs: endpoint {
					remote-endpoint = <&usb_drd1_hs>;
				};
			};

			port@1 {
				reg = <1>;
				hpm1_ss: endpoint {
					remote-endpoint = <&atc1_phy_ep>;
				};
			};
		};
	};

};
/* Only the three router LSTX pins are available to GPIO clients. */
&pinctrl_aop { gpio-reserved-ranges = <0 77>, <78 1>, <80 1>, <82 3>; };

/* ATC0 router and PCIe tunnel. */
&ps_atc0_cio {
	power-domains = <&ps_atc0_common>;
	status = "okay";
};

&ps_atc0_cio_pcie {
	power-domains = <&ps_atc0_cio>;
	status = "okay";
};

&ps_atc0_cio_usb {
	power-domains = <&ps_atc0_cio>;
	status = "okay";
};

&ps_atc0_cio_auss {
	power-domains = <&ps_atc0_cio>, <&ps_auss>;
	status = "okay";
};

&ps_atc0_pcie {
	power-domains = <&ps_atc0_common>, <&ps_atc0_usb_aon>;
	status = "okay";
};
&pinctrl_aop {
	acio0_lstx_pins: acio0-lstx-pins {
		pinmux = <0x1004d>;
	};
};
&{/soc@200000000} {
	acio0_mbox: mailbox@2a1108000 {
		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x2 0xa1108000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 837 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 838 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 839 IRQ_TYPE_LEVEL_HIGH>,
		<AIC_IRQ 0 840 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
		"recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
	};
	acio0: acio@2a1ac0000 {
		compatible = "apple,t6050-usb4-acio";
		reg = <0x2 0xa1ac0000 0x0 0xc000>,
		<0x2 0xa1080000 0x0 0x26000>,
		<0x2 0xa1e44000 0x0 0x4000>,
		<0x2 0xa1100000 0x0 0x4000>,
		<0x2 0xa1c80000 0x0 0x4000>;
		reg-names = "rc", "sram", "pcie-adapter", "cpu", "router-ap-fw";
		mboxes = <&acio0_mbox>;
		resets = <&cio_reconfig0 0>;

		power-domains = <&ps_atc0_cio>, <&ps_atc0_cio_pcie>,
		<&ps_atc0_cio_usb>, <&ps_atc0_cio_auss>, <&ps_atc0_pcie>;
		thunderbolt-switch;
		apple,pcie-tunnel = <&acio0_pcie_tunnel>;
		pinctrl-0 = <&acio0_lstx_pins>;
		pinctrl-names = "lstx";
		lstx-gpios = <&pinctrl_aop 77 GPIO_ACTIVE_HIGH>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x2 0xa1000000 0x1000000>;
		nonposted-mmio;

		acio0_dart: iommu@a80000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0xa80000 0xc000>;
			interrupts = <AIC_IRQ 0 1606 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc0_cio>;
			#iommu-cells = <1>;
			apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
			apple,bypass-sids = <15>;
			apple,full-error-reporting;
			apple,ctc-flush;
		};

		acio0_nhi: nhi@f00000 {
			compatible = "apple,t6050-usb4-nhi";
			reg = <0xf00000 0x100000>;
			reg-names = "nhi";
			interrupts = <AIC_IRQ 0 1579 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1580 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1581 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1582 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1583 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1584 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1585 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1586 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1587 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1588 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1589 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1590 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1591 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1592 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1593 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1594 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1595 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1596 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1597 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1598 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1599 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1600 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1601 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1602 IRQ_TYPE_LEVEL_HIGH>,
			<AIC_IRQ 0 1608 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "txring0", "txring1", "txring2", "txring3", "txring4", "txring5",
			"txring6", "txring7", "txring8", "txring9", "txring10", "txring11",
			"rxring0", "rxring1", "rxring2", "rxring3", "rxring4", "rxring5",
			"rxring6", "rxring7", "rxring8", "rxring9", "rxring10", "rxring11",
			"parity";
			iommus = <&acio0_dart 0>,
			<&acio0_dart 1>,
			<&acio0_dart 2>,
			<&acio0_dart 3>,
			<&acio0_dart 4>,
			<&acio0_dart 5>,
			<&acio0_dart 6>,
			<&acio0_dart 7>,
			<&acio0_dart 8>,
			<&acio0_dart 9>,
			<&acio0_dart 10>,
			<&acio0_dart 11>,
			<&acio0_dart 16>,
			<&acio0_dart 17>,
			<&acio0_dart 18>,
			<&acio0_dart 19>,
			<&acio0_dart 20>,
			<&acio0_dart 21>,
			<&acio0_dart 22>,
			<&acio0_dart 23>,
			<&acio0_dart 24>,
			<&acio0_dart 25>,
			<&acio0_dart 26>,
			<&acio0_dart 27>;
		};
	};
};
/ {
	acio0_pcie_tunnel: pcie-tunnel-0 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		apciec0_dart: iommu@2a4000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0xa4000000 0x0 0x20000>;
			interrupts = <AIC_IRQ 0 1406 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc0_pcie>;
			#iommu-cells = <1>;
			apple,bypass-sids = <253 255>;
			apple,full-error-reporting;
			apple,ctc-flush;
		};

		apciec0: pcie@1c50000000 {
			compatible = "apple,t6050-pciec";
			device_type = "pci";
			reg = <0x1c 0x50000000 0x0 0x10000000>,
			<0x2 0xa4034000 0x0 0x4000>,
			<0x2 0xa4020000 0x0 0x8000>,
			<0x2 0xa4038000 0x0 0x4000>,
			<0x2 0xa4060000 0x0 0x4000>,
			<0x2 0xa402c000 0x0 0x4000>,
			<0x2 0xa4028000 0x0 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug", "ltssm", "intr2axi";

			interrupts = <AIC_IRQ 0 1405 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "port0";
			power-domains = <&ps_atc0_pcie>;

			apple,pciec-kernel-init;

			msi-controller;
			msi-parent = <&apciec0>;
			msi-ranges = <&aic AIC_IRQ 0 1952 IRQ_TYPE_EDGE_RISING 32>;
			apple,msi-vector-base = <128>;

			iommu-map = <0x0 &apciec0_dart 0x0 0x40>;
			iommu-map-mask = <0x3f>;
			linux,pci-domain = <1>;
			bus-range = <0x0 0x7f>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x43000000 0x8 0x0 0x8 0x0 0x2 0x0>,
			<0x02000000 0x0 0x00100000 0xa 0x00100000 0x0 0x3ff00000>,
			<0x42000000 0x0 0x40000000 0xa 0x40000000 0x0 0x40000000>;

			apciec0_port: pci@0,0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				external-facing;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;

				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &apciec0_port 0 0 0 0>,
				<0 0 0 2 &apciec0_port 0 0 0 1>,
				<0 0 0 3 &apciec0_port 0 0 0 2>,
				<0 0 0 4 &apciec0_port 0 0 0 3>;
			};
		};
	};
};
&atc0_phy {
	apple,tunable-lane0-rx-top-cio = <0x35c 0xe00 0x0>;
	apple,tunable-lane1-rx-top-cio = <0x35c 0xe00 0x0>;
};
&hpm0 {
	connector {
		ports {
			port@3 {
				reg = <3>;
				hpm0_usb4: endpoint {
					remote-endpoint = <&acio0_tbt>;
				};
			};
		};
	};
};
