				#address-cells = <1>; #size-cells = <0>;
				hpm0_dp0: endpoint@0 { reg = <0>; remote-endpoint = <&dcpext0_left0>; };
				hpm0_dp1: endpoint@1 { reg = <1>; remote-endpoint = <&dcpext2_left0>; };
			}; }; }; };
