// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Air (13-inch, M5) J813 with the internal ANS2 NVMe SSD.
 *
 * Addresses from the J813 ADT (/arm-io/ans, /arm-io/sart-ans, arm-io offset
 * 0x210000000). ANS is an ascwrap-v6 ASC with its mailbox at +0x8000, like the
 * SMC; the SART is coastguard sart-version 3. As on T8140, the NVMe registers
 * are used through the non-secure alias (ADT reg[9]) and the NVMMU through
 * the 0x60000 window (ADT reg[3]). iBoot leaves ANS running with the
 * controller disabled, so the driver wakes it with a fresh RTKit handshake.
 */


&pmgr {
	ps_apcie_gp: power-controller@2f0 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2f0 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_gp";
	};

	ps_ans: power-controller@300 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x300 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "ans";
		apple,always-on; /* handed over running, cannot be reset */
	};

	ps_apcie_sys_gp: power-controller@408 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x408 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_sys_gp";
		power-domains = <&ps_apcie_gp>;
	};

	ps_apcie_st: power-controller@410 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x410 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_st";
		power-domains = <&ps_ans>;
	};

	ps_apcie_sys_st: power-controller@520 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x520 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_sys_st";
		power-domains = <&ps_ans>, <&ps_apcie_st>;
	};

	ps_apcie_phy_sw: power-controller@560 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x560 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "apcie_phy_sw";
		power-domains = <&ps_apcie_sys_st>, <&ps_apcie_sys_gp>;
	};
};

&{/soc} {
	ans_mbox: mailbox@481608000 {
		compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x4 0x81608000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1143 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1144 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1145 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1146 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		power-domains = <&ps_ans>;
		#mbox-cells = <0>;
	};

	sart: iommu@485c50000 {
		compatible = "apple,t8142-sart", "apple,t6000-sart";
		reg = <0x4 0x85c50000 0x0 0xc000>;
		power-domains = <&ps_ans>;
	};

	nvme: nvme@4c5cc0000 {
		compatible = "apple,t8142-nvme-ans2", "apple,t8140-nvme-ans2";
		reg = <0x4 0xc5cc0000 0x0 0x30000>,
		      <0x4 0x81600000 0x0 0x4000>,
		      <0x4 0x85cc0000 0x0 0x60000>;
		reg-names = "nvme", "ans", "nvmmu";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1155 IRQ_TYPE_LEVEL_HIGH>;
		mboxes = <&ans_mbox>;
		apple,sart = <&sart>;
		power-domains = <&ps_ans>, <&ps_apcie_sys_st>,
				<&ps_apcie_phy_sw>;
		power-domain-names = "ans", "apcie0", "apcie_phy";
		resets = <&ps_ans>;
	};
};
