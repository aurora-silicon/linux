/dts-v1/;

#include "t8152.dtsi"
#include "t8152-j833ct-peripherals.dtsi"

/ {
	model = "Apple iMac (24-inch, M6)";
	compatible = "apple,j833ct", "apple,t8152", "apple,arm-platform";
};

&smc { status = "disabled"; };
&smc_mbox { status = "disabled"; };
&m6_e_cpufreq { status = "disabled"; };
&m6_pm_cpufreq { status = "disabled"; };

#include "t8152-j833ct-audio-topology.dtsi"
