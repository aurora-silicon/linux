/*
 * Apple iMac (24-inch, M6), J833ct.
 *
 * Booted from RAM by the loader (see t8152-common.dtsi); the console is the
 * framebuffer. The keyboard and trackpad are Bluetooth accessories: the board
 * has no MTP, keyboard backlight PWM or battery. Resources follow the J833ct
 * ADT.
 */
/dts-v1/;

#include "t8152-common.dtsi"

/ {
	compatible = "apple,j833ct", "apple,t8152", "apple,arm-platform";
	model = "Apple iMac (24-inch, M6)";
	chassis-type = "all-in-one";
};

&pinctrl_ap {
	/* ADT no-restore-gpio-pins */
	gpio-reserved-ranges = <78 2>, <208 1>;
};

/*
 * Hardware monitor: the shared power, voltage and current keys, and two
 * fans, as in the T8122 iMac description. The ADT does not list the fans;
 * the hwmon driver skips a fan whose speed key the SMC does not have, so a
 * single-fan machine shows one. The T8152 SMC spells the fan mode key in
 * lower case, as on J804. Temperatures are discovered from the SMC, so the
 * shared NAND temperature node is dropped (its key is discovered too).
 */
#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"

&smc_hwmon {
	/delete-node/ temperature-TH0x;

	fan-F0Ac {
		apple,fan-mode = "F0md";
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};
