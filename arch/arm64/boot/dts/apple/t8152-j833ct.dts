/*
 * Apple iMac (24-inch, M6), J833ct.
 *
 * Booted from RAM by the loader (see t8152-common.dtsi); the console is the
 * framebuffer. The keyboard and trackpad are Bluetooth accessories: the board
 * has no MTP, keyboard backlight PWM or battery. Resources follow the J833ct
 * ADT.
 */
/dts-v1/;

#include "t8152-common.dtsi"

/ {
	compatible = "apple,j833ct", "apple,t8152", "apple,arm-platform";
	model = "Apple iMac (24-inch, M6)";
	chassis-type = "all-in-one";
};

&pinctrl_ap {
	/* ADT no-restore-gpio-pins */
	gpio-reserved-ranges = <78 2>, <208 1>;
};

/*
 * USB-C PD: hpm0 (back-right) and hpm1 (back-right-middle) come from
 * t8152-common.dtsi; from the J833ct ADT, hpm2 (back-left-middle) and
 * hpm3 (back-left) are at SIDs 8 and 6 on the same bus.
 */
&nub_spmi_a0 {
	hpm2: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
	};

	hpm3: usb-pd@6 {
		compatible = "apple,sn201202x";
		reg = <0x6 SPMI_USID>;
	};
};
