/*
 * Apple M4 Mac mini, MacBook Air/Pro, iMac 24" (M4, 2024/2025)
 *
 * This file contains parts common to all Apple M4 devices using the t8132.
 *
 * target-type: J604, J623, J624, J713, J715, J773g
 *
 * Copyright The Asahi Linux Contributors
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	aliases {
		serial0 = &serial0;
		sep = &sep;
		ans = &nvme;
		ans-mbox = &ans_mbox;
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		bluetooth0 = &bluetooth0;
		nvram = &nvram;
		pmu-primary = &pmic1;
		pmp = &pmp;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0";

		linux-enablement-mac,disk-boot;
		linux-enablement-mac,dapf-handoff = "/arm-io/aop", "/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp_fe>, <&ps_dptx_phy>;
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x8 0 0x2 0>; /* To be filled by loader */
	};

	/* The boot NOR's PMU rail is always on; the ADT gives it no supply. */
	nor_flash_vcc: regulator-nor-flash-vcc {
		compatible = "regulator-fixed";
		regulator-name = "nor-flash-vcc";
		regulator-always-on;
	};
};

&serial0 {
	status = "okay";
};

/*
 * m1n1 programs the AOP DART's DAPF and reserves its firmware and DAPF
 * windows when /chosen asks for the handoff, or disables the AOP.
 */
&aop {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	/* A periodic report need not wake the system. */
	apple,hold-rx-in-sleep;
	status = "okay";
};

&admac0 {
	status = "okay";
};

&admac1 {
	status = "okay";
};

&cpufreq_e {
	status = "okay";
};

&cpufreq_p {
	status = "okay";
};

&cpuidle {
	status = "okay";
};

/* CS42L84 headphone codec: reset on nub GPIO 17, IRQ on AP GPIO 98. */
&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		vcc-supply = <&nor_flash_vcc>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				/* ADT /arm-io/qspi/spinor/anvram, flash-relative. */
				reg = <0x700000 0x100000>;
			};
		};
	};
};

&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&mcc {
	apple,boot-dma-devices = <&pmp>;
	status = "okay";
};

&pmc {
	apple,static-voters = <3>;
	status = "okay";
};

&sep_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};

	reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			<&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
			"boot_error_count", "panic_count";
	};
};

&smc_mbox {
	status = "okay";
};

&nub_spmi {
	status = "okay";

	pmic1: pmic@0 {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0x0 SPMI_USID>; /* To be filled by loader */

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

/* ATC0 and ATC1's port controllers. Boards label the connectors. */
&nub_spmi_a0 {
	status = "okay";

	hpm1: usb-pd@a {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec1: connector {
			compatible = "usb-c-connector";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec0: connector {
			compatible = "usb-c-connector";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

&atcphy0 {
	/* Leave the display crossbar at core + 0x4c000 to its own driver. */
	reg = <0x4 0x02a90000 0x0 0x4000>,
	      <0x4 0x02a84000 0x0 0x4000>,
	      <0x4 0x03000000 0x0 0x24000>,
	      <0x4 0x00000000 0x0 0x8000>,
	      <0x4 0x00020000 0x0 0x4000>,
	      <0x4 0x03044000 0x0 0x4000>,
	      <0x4 0x03050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy0 PHY_TYPE_USB2>, <&atcphy0 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	/* Leave the display crossbar at core + 0x4c000 to its own driver. */
	reg = <0x4 0x0aa90000 0x0 0x4000>,
	      <0x4 0x0aa84000 0x0 0x4000>,
	      <0x4 0x0b000000 0x0 0x24000>,
	      <0x4 0x08000000 0x0 0x8000>,
	      <0x4 0x08020000 0x0 0x4000>,
	      <0x4 0x0b044000 0x0 0x4000>,
	      <0x4 0x0b050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy1_typec_lanes: endpoint {
				remote-endpoint = <&typec1_connector_ss>;
			};
		};
	};
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>, <&atcphy1 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

/*
 * The radio port. m1n1 trains the link; Linux owns only the radio's
 * streams (ADT mapper-apcie0-wlan and -bt), RID-to-SID routing and MSI.
 * Power is the SMC's gP13, reset AP GPIO 163.
 */
&dart_apcie0 {
	apple,managed-sids = <1 2>;
	apple,dma-range = <0x100 0x00100000 0x0 0x3fe00000>;
	status = "okay";
};

&pcie0 {
	apple,managed-sids = <1 2>;
	iommu-map = <0x100 &dart_apcie0 1 2>;
	iommu-map-mask = <0xffff>;
	status = "okay";
};

&port00 {
	pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;

	/* brcm,board-type is "apple," + the ADT wlan module-instance. */
	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* Per-machine address and calibration supplied by m1n1. */
		local-bd-address = [00 00 00 00 00 00];
	};

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
	};
};
