					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p12_passive: trip-passive {
					temperature = <116000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-hot {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "hot";
				};

				trip-critical {
					temperature = <125000>;
					hysteresis = <0>;
