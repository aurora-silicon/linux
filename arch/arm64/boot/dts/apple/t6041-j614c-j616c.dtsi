						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		/*
		 * GPU zones, with the M4 Pro's trips: the GPU firmware limits
		 * itself from 101 C, where these shed CPU power (allocator on at
		 * 90 C), and they shut down at 118 C after three samples. Each
		 * zone reads one of the GPU's hotter sensors; which cluster each
		 * sits on is not known, and under load they read within 1 C.
		 */
		gpu0-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			critical-samples = <3>;
			thermal-sensors = <&smc_hwmon 23>;	/* Tg05 */

			trips {
				gpu0_switch_on: trip-switch-on {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu0_passive: trip-passive {
					temperature = <101000>;
					hysteresis = <5000>;
					type = "passive";
				};

				trip-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&gpu0_passive>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p0 {
					trip = <&gpu0_passive>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p04 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p05 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-p1 {
					trip = <&gpu0_passive>;
					cooling-device =
						<&cpu_p10 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p11 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p12 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p13 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p14 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p15 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu1-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			critical-samples = <3>;
			thermal-sensors = <&smc_hwmon 39>;	/* Tg1V */

