&cpuidle {
	status = "okay";
};

&wdt {
	timeout-sec = <140>;
};

&smc {
	status = "okay";

	smc_gpio_low: gpio-low {
		compatible = "apple,smc-low-gpio";
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&smc_mbox {
	status = "okay";
};

&nub_spmi0 {
	status = "okay";
};

&mcc {
	status = "okay";
};

&smc_hwmon {
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Die Max";
	};

	temperature-TCMb {
		apple,key-id = "TCMb";
		label = "CPU TCMb";
	};

	temperature-Tpx0 {
		apple,key-id = "Tpx0";
		label = "CPU Tpx0";
	};

	temperature-Tpx1 {
		apple,key-id = "Tpx1";
		label = "CPU Tpx1";
	};

	temperature-Tpx2 {
		apple,key-id = "Tpx2";
		label = "CPU Tpx2";
	};

	temperature-Tpx3 {
		apple,key-id = "Tpx3";
		label = "CPU Tpx3";
	};

	temperature-Tpx4 {
		apple,key-id = "Tpx4";
		label = "CPU Tpx4";
	};

	temperature-Tpx5 {
		apple,key-id = "Tpx5";
		label = "CPU Tpx5";
	};

	temperature-Tpx8 {
		apple,key-id = "Tpx8";
		label = "CPU Tpx8";
	};

	temperature-Tpx9 {
		apple,key-id = "Tpx9";
		label = "CPU Tpx9";
	};

	temperature-TpxA {
		apple,key-id = "TpxA";
		label = "CPU TpxA";
	};

	temperature-TpxB {
		apple,key-id = "TpxB";
		label = "CPU TpxB";
	};

	temperature-TpxC {
		apple,key-id = "TpxC";
		label = "CPU TpxC";
	};

	temperature-TpxD {
		apple,key-id = "TpxD";
		label = "CPU TpxD";
	};

	temperature-Tex0 {
		apple,key-id = "Tex0";
		label = "CPU Tex0";
	};

	temperature-Tex1 {
		apple,key-id = "Tex1";
		label = "CPU Tex1";
	};

	temperature-Tex2 {
		apple,key-id = "Tex2";
		label = "CPU Tex2";
	};

	temperature-Tex3 {
		apple,key-id = "Tex3";
		label = "CPU Tex3";
	};

	temperature-TH0x {
		apple,key-id = "TH0x";
		label = "NAND Flash Temperature";
	};

	temperature-TB0T {
		apple,key-id = "TB0T";
		label = "Battery Hotspot";
	};

	temperature-TCHP {
		apple,key-id = "TCHP";
		label = "Charge Regulator Temp";
	};

	temperature-TW0P {
		apple,key-id = "TW0P";
		label = "WiFi/BT Module Temp";
	};

	/*
	 * The 33 GPU sensors of the J614c SMC key table (macOS 26.6.2). All
	 * rose 15-17 C together under a GPU load. Sixteen read about 5.5 C
	 * above the other seventeen, idle and loaded; the GPU zones use those.
	 * While the GPU is powered off the SMC publishes placeholders below
	 * 10 C, as on the M4 Pro.
	 */
	temperature-Tg04 {
		apple,key-id = "Tg04";
		label = "GPU Tg04";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg05 {
		apple,key-id = "Tg05";
		label = "GPU Tg05";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0K {
		apple,key-id = "Tg0K";
