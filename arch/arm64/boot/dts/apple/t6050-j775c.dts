// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Mac Studio (M5 Max, 2026)
 *
 * target-type: J775c, board-id 0x10, chip-id 0x6050 (one die, 18 CPUs: 2x6 M + 6 P)
 *
 * The J775D (M5 Ultra) Studio's board on the one-die T6050 of the M5 Max, generated by
 * make-j775c-dts.py:
 * - the CPU, die-1 and GPU parts are t6050-j716c.dts's (M5 Max): die 1, its CPUs and buses go,
 *   each cluster's sixth core comes in, the GPU's OPP and AON tables are one die's (Aura fills
 *   them from the ADT), and the die-1 HPMs and nub-spmi-a2 go;
 * - the board parts are t6050-j775d.dts's: PCIe ports 2 (RTL8127A), 3 (ASM3142 USB-A) and 0 (N1),
 *   audio (SN012776 on i2c1 0x38, CS42L84 on i2c2 0x4b), the pins, console, DARTs, dual fans and
 *   the NVRAM partition.
 * Checked against the J775c ADT captured 2026-11-03 (macOS 26A425): the same PCIe endpoints (lan0
 * 10ec:8127, pcie-xhci 1b21:2142, centauri 106b:1901-1903; the GL9755 SD reader on port 1 is
 * described but disabled until trained by the bootloader), the same i2c addresses and GPIO pins
 * (amp 106/107, jack 134/139, N1 PERST# 80), the
 * same NVRAM (0x700000 + 0xc0000, 12 banks), ATC PHYs 1-3 and HPMs 0-3 on nub-spmi-a0 at J775D's
 * die-0 addresses, no nub-spmi-a2, and CPU MPIDRs 0x5/0x105/0x205 for each cluster's sixth core.
 * J775c-specific: the N1's platform ID and firmware name carry board 0x10.
 *
 * Not yet booted on J775c.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6050-j775c-legacy.dtsi"
#include "t6050-j775c-rebased-peripherals.dtsi"

/delete-node/ &cpu18;
/delete-node/ &cpu19;
/delete-node/ &cpu20;
/delete-node/ &cpu21;
/delete-node/ &cpu22;
/delete-node/ &cpu24;
/delete-node/ &cpu25;
/delete-node/ &cpu26;
/delete-node/ &cpu27;
/delete-node/ &cpu28;
/delete-node/ &cpu30;
/delete-node/ &cpu31;
/delete-node/ &cpu32;
/delete-node/ &cpu33;
/delete-node/ &cpu34;

/ {
	compatible = "apple,j775c", "apple,t6050", "apple,arm-platform";
	model = "Apple Mac Studio (M5 Max, 2026)";
	chassis-type = "desktop";

	aliases {
		serial0 = &dockchannel;
		/* the boot loader fills in the MAC address through this alias */
		ethernet0 = &ethernet0;
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
		/* Aura's kboot_setup_atc() fills this PHY's tunables from /arm-io/atc-phy2. */
		atcphy2 = &atc2_phy;
		/* And /arm-io/atc-phy0's (rear USB-C port 1, the DFU port). */
		atcphy0 = &atc0_phy;
		/* The same fills /arm-io/atc-phy1's (rear USB-C port 2, USB data). */
		atcphy1 = &atc1_phy;
		/* And rear port 4's (atc-phy3, die 0); J775D's die-1 PHYs 4 and 5 don't exist on J775c. */
		atcphy3 = &atc3_phy;
		/* asahi-bless and the boot loader's dt_set_nvram find the partition by this alias */
		nvram = &nvram;
	};

	/*
	 * No stdout-path: the boot loader passes the console on the command
	 * line when it wants one.
	 */
	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/*
		 * Normally replaced by the loader. With no console= named,
		 * NULL_TTY_DEFAULT_CONSOLE makes the console ttynull.
		 */
		bootargs = "maxcpus=1 rdinit=/init";
	};

	/*
	 * PCIe ports 2 (the onboard 10 Gb Ethernet) and 3 (the rear USB-A
	 * xHCI). The boot loader powers and trains both links and keeps power,
	 * clocks, the PHYs and PERST; Linux owns the routing, MSI and the
	 * DARTs. The boot loader disables a port, and its DART, whose link did
	 * not come up.
	 *
	 * Port 0 carries the N1 (Wi-Fi and Bluetooth), described disabled until the
	 * boot loader trains it (pci@0,0 below).
	 */
	pcie0: pcie@1cb0000000 {
		compatible = "apple,t6050-pcie";
		device_type = "pci";
		reg = <0x1c 0xb0000000 0x0 0x10000000>,
		      <0x4 0x14000000 0x0 0x4000>,
		      <0x4 0x12028000 0x0 0x8000>,
		      <0x4 0x17018000 0x0 0x4000>,
		      <0x4 0x12024000 0x0 0x4000>,
		      <0x4 0x13028000 0x0 0x8000>,
		      <0x4 0x1701c000 0x0 0x4000>,
		      <0x4 0x13024000 0x0 0x4000>,
		      <0x4 0x10028000 0x0 0x8000>,
		      <0x4 0x17010000 0x0 0x4000>,
		      <0x4 0x10024000 0x0 0x4000>,
		      <0x4 0x11028000 0x0 0x8000>,
		      <0x4 0x17014000 0x0 0x4000>,
		      <0x4 0x11024000 0x0 0x4000>;
		reg-names = "config", "rc", "port2", "phy2", "intr2axi2",
			    "port3", "phy3", "intr2axi3",
			    "port0", "phy0", "intr2axi0",
			    "port1", "phy1", "intr2axi1";
		nonposted-mmio;
		interrupts = <AIC_IRQ 0 1539 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1547 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1531 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "port2", "port3", "port0", "port1";

		/* One shared MSI domain for the GP ports: vectors 64-127 */
		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic AIC_IRQ 0 1888 IRQ_TYPE_EDGE_RISING 64>;
		apple,msi-vector-base = <64>;

		/*
		 * The boot loader numbers port 2's secondary bus 1 and port 3's 2;
		 * port 0's is 3 until a boot loader that trains it renumbers all three
		 * in the PCI core's order. The N1's three functions are on DART
		 * streams 1-3.
		 */
		iommu-map = <0x100 &dart_apcie2 1 1>,
			    <0x200 &dart_apcie3 1 1>,
			    <0x300 &dart_apcie0 1 3>,
			    <0x400 &dart_apcie1 1 1>;
		iommu-map-mask = <0xffff>;
		dma-coherent;
		linux,pci-domain = <0>;
		bus-range = <0 4>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>,
			 <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>;

		/* ADT apcie0/pci-bridge1/pcie-sdreader: Genesys GL9755, 17a0:9755.
		 * Aura powers it via SMC pcIO (0, 0x190000), trains the link,
		 * then enables this node and its DART and renumbers the buses.
		 */

		port02: pci@2,0 {
			device_type = "pci";
			reg = <0x1000 0 0 0 0>;
			bus-range = <1 1>;
			apple,link-trained-by-bootloader;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port02 0 0 0 0>,
					<0 0 0 2 &port02 0 0 0 1>,
					<0 0 0 3 &port02 0 0 0 2>,
					<0 0 0 4 &port02 0 0 0 3>;

			/* The RTL8127A keeps no MAC address of its own */
			ethernet0: ethernet@0,0 {
				reg = <0x10000 0x0 0x0 0x0 0x0>;
				/* To be filled by the loader */
				local-mac-address = [00 00 00 00 00 00];
			};
		};

		port03: pci@3,0 {
			device_type = "pci";
			reg = <0x1800 0 0 0 0>;
			bus-range = <2 2>;
			apple,link-trained-by-bootloader;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port03 0 0 0 0>,
					<0 0 0 2 &port03 0 0 0 1>,
					<0 0 0 3 &port03 0 0 0 2>,
					<0 0 0 4 &port03 0 0 0 3>;
		};

		/*
		 * The N1 Wi-Fi/Bluetooth (106b:1900, its ROM), trained by the bootloader after the SMC
		 * releases its reset. Its driver boots the firmware and has this port reset after the ROM
		 * stage; Control, Alpha (Wi-Fi) and Beta (Bluetooth) then answer at functions 0-2.
		 * Disabled with its DART: a bootloader that trains the port enables both and renumbers the
		 * buses here (bus-range, reg, iommu-map) to the PCI core's order, port 0 first.
		 */
		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0 0 0 0>;
			bus-range = <3 3>;
			apple,link-trained-by-bootloader;
			/*
			 * Its PERST# (pci-bridge0 function-perst): /arm-io/gpio0 pin 0x50, pad
			 * register 0x140 of pinctrl_ap, which owns the pad (and exposes it: see
			 * its gpio-reserved-ranges below). Driven only by the root-port reset after
			 * the N1's ROM stage.
			 */
			reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
			status = "disabled";

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
					<0 0 0 2 &port00 0 0 0 1>,
					<0 0 0 3 &port00 0 0 0 2>,
					<0 0 0 4 &port00 0 0 0 3>;

			/* The firmware: the chip's image with this board's ticket; platform ID is
			 * (board 0x10 << 16) | chip 0x6050, from J775c's /chosen board-id */
			n1_control: control@0,0 {
				compatible = "pci106b,1900";
				reg = <0x30000 0x0 0x0 0x0 0x0>;
				firmware-name = "apple/centauri/j775c-ftab.bin";
				apple,centauri-platform-id = <0x00106050>;
				apple,centauri-protocol = <27>;
			};

			n1_alpha: wifi@0,1 {
				compatible = "pci106b,1902";
				reg = <0x30100 0x0 0x0 0x0 0x0>;
				local-mac-address = [00 00 00 00 00 00];
			};

			n1_beta: bluetooth@0,2 {
				compatible = "pci106b,1903";
				reg = <0x30200 0x0 0x0 0x0 0x0>;
				local-bd-address = [00 00 00 00 00 00];
			};
		};
		port01: pci@1,0 {
			device_type = "pci";
			reg = <0x800 0 0 0 0>;
			bus-range = <4 4>;
			apple,link-trained-by-bootloader;
			status = "disabled";
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
					<0 0 0 2 &port01 0 0 0 1>,
					<0 0 0 3 &port01 0 0 0 2>,
					<0 0 0 4 &port01 0 0 0 3>;

			/* ADT card-detect-polarity = write-protect-polarity = 1. */
			sdcard@0,0 {
				compatible = "pci17a0,9755";
				reg = <0x40000 0 0 0 0>;
				cd-inverted;
				wp-inverted;
			};
		};
	};

	/*
	 * The jack (CS42L84) and the speaker (SN012776) through the AOP's audio services. The card waits
	 * for its CPU component, the AOP audio node, which exists only after Aura's AOP handoff.
	 */
	sound {
		compatible = "apple,j775c-macaudio", "apple,j775d-macaudio", "apple,macaudio";
		/*
		 * No variant letter, as on J375/J475/J575: userspace (speakersafetyd,
		 * the UCM profile, asahi-audio) keys on the card id "AppleJ775".
		 */
		model = "Mac Studio J775";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};

	/delete-node/ soc@6300000000;
	/delete-node/ soc@2308000000;
	/delete-node/ soc@6308000000;
	/delete-node/ soc@2220000000;
	/delete-node/ soc@4200000000;

	/*
	 * The memory cache controller of the one die: eight AMCCs of four planes (ADT /arm-io/mcc:
	 * amcc-count 8, dcs-count-per-amcc 4, die-enable-mask 1). The dtsi's node also lists die 1's
	 * planes, so it goes with the die-1 buses above. Without this one the system level cache
	 * never allocates: the boot loader leaves allocation disabled on every plane.
	 *
	 * Each plane window reaches past the DSID quota and occupancy registers (+0xa000 to
	 * +0xc300); the ADT gives each AMCC 0x140000, its planes 0x40000 apart.
	 */
	soc@2220000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0x22 0x20000000 0x22 0x20000000 0x0 0x10000000>;
		nonposted-mmio;

		memory-controller@2220000000 {
			compatible = "apple,t6050-mcc";
			reg = <0x22 0x20000000 0x0 0x10000>,
			      <0x22 0x20040000 0x0 0x10000>,
			      <0x22 0x20080000 0x0 0x10000>,
			      <0x22 0x200c0000 0x0 0x10000>,
			      <0x22 0x22000000 0x0 0x10000>,
			      <0x22 0x22040000 0x0 0x10000>,
			      <0x22 0x22080000 0x0 0x10000>,
			      <0x22 0x220c0000 0x0 0x10000>,
			      <0x22 0x24000000 0x0 0x10000>,
			      <0x22 0x24040000 0x0 0x10000>,
			      <0x22 0x24080000 0x0 0x10000>,
			      <0x22 0x240c0000 0x0 0x10000>,
			      <0x22 0x26000000 0x0 0x10000>,
			      <0x22 0x26040000 0x0 0x10000>,
			      <0x22 0x26080000 0x0 0x10000>,
			      <0x22 0x260c0000 0x0 0x10000>,
			      <0x22 0x28000000 0x0 0x10000>,
			      <0x22 0x28040000 0x0 0x10000>,
			      <0x22 0x28080000 0x0 0x10000>,
			      <0x22 0x280c0000 0x0 0x10000>,
			      <0x22 0x2a000000 0x0 0x10000>,
			      <0x22 0x2a040000 0x0 0x10000>,
			      <0x22 0x2a080000 0x0 0x10000>,
			      <0x22 0x2a0c0000 0x0 0x10000>,
			      <0x22 0x2c000000 0x0 0x10000>,
			      <0x22 0x2c040000 0x0 0x10000>,
			      <0x22 0x2c080000 0x0 0x10000>,
			      <0x22 0x2c0c0000 0x0 0x10000>,
			      <0x22 0x2e000000 0x0 0x10000>,
			      <0x22 0x2e040000 0x0 0x10000>,
			      <0x22 0x2e080000 0x0 0x10000>,
			      <0x22 0x2e0c0000 0x0 0x10000>;
			apple,boot-dma-devices = <&display>;
		};
	};

	/*
	 * The GPU's OPP tables for one die: four clusters, so four voltage cells per main state,
	 * and one per CS/AFR state. Aura fills them in, as on J775D.
	 */
	/delete-node/ opp-table-gpu;
	/delete-node/ opp-table-gpu-afr;
	/delete-node/ opp-table-gpu-cs;

	/* /arm-io/sgx perf-states: 14 states, one table per cluster */
	gpu_opp: opp-table-gpu {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp08 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp09 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp10 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp11 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp12 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};

		opp13 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0 0 0 0>;
			opp-microvolt-sram = <0 0 0 0>;
		};
	};

	/* afr-perf-states, one voltage */
	gpu_afr_opp: opp-table-gpu-afr {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp08 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp09 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp10 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp11 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp12 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp13 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
	};

	/* cs-perf-states, one voltage */
	gpu_cs_opp: opp-table-gpu-cs {
		compatible = "operating-points-v2";

		opp00 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp01 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp02 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp03 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp04 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp05 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp06 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp07 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp08 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp09 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp10 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp11 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp12 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};

		opp13 {
			opp-hz = /bits/ 64 <0>;
			opp-microvolt = <0>;
		};
	};
};


/* The AON power-telemetry records of one die (g0TR, g1TR, r0TR), which Aura fills */
&gpu {
	apple,aon-ptd = <0 0 0  0 0 0  0 0 0>;
	/* The J775c ADT's gpu-idleoff-standby-timer, 0xdac (the board default is 1500 us). */
	apple,idleoff-standby-timer = <3500>;
};

&{/cpus} {
	cpu-map {
		cluster0 {
			core0 {
				cpu = <&cpu0>;
			};
			core1 {
				cpu = <&cpu1>;
			};
			core2 {
				cpu = <&cpu2>;
			};
			core3 {
				cpu = <&cpu3>;
			};
			core4 {
				cpu = <&cpu4>;
			};
			core5 {
				cpu = <&cpu5>;
			};
		};
		cluster1 {
			core0 {
				cpu = <&cpu6>;
			};
			core1 {
				cpu = <&cpu7>;
			};
			core2 {
				cpu = <&cpu8>;
			};
			core3 {
				cpu = <&cpu9>;
			};
			core4 {
				cpu = <&cpu10>;
			};
			core5 {
				cpu = <&cpu11>;
			};
		};
		cluster2 {
			core0 {
				cpu = <&cpu12>;
			};
			core1 {
				cpu = <&cpu13>;
			};
			core2 {
				cpu = <&cpu14>;
			};
			core3 {
				cpu = <&cpu15>;
			};
			core4 {
				cpu = <&cpu16>;
			};
			core5 {
				cpu = <&cpu17>;
			};
		};
	};



};

/*
 * CPU PMUs, one per core type. A core's PMU interrupt is a FIQ (PMCR0
 * IMODE = FIQ, as XNU programs it), which AIC hands to the PMU whose FIQ
 * index lists that core. The ADT's per-core AIC interrupts (cpuN
 * "interrupts", 69 + 3n on cluster 0, 101 + 3n on cluster 1, 133 + 3n on
 * the P cluster) are not used. These live here rather than in t6050.dtsi
 * because the core list is the board's: one die, six cores per cluster.
 */
/ {

};


/* J775D's die-1 PD controllers (hpm4, hpm5 on nub-spmi-a2) don't exist on J775c */
/delete-node/ &hpm4;
/delete-node/ &hpm5;

&nub_spmi_a2 {
	status = "disabled";
};


/* The pins this board's nodes name, and no others */
&pinctrl_ap {
	/*
	 * Every pin reads cleanly (evidence/dt/2026-10-30-gpio-qualification.md), but only
	 * the pins a node in this file names are exposed: 80 (PCIe port 0's PERST#, ADT
	 * pci-bridge0 function-perst), 106 (amp IRQ), 107 (amp shutdown), 134 (jack IRQ)
	 * and 139 (jack codec reset), from the ADT's audio-speaker and audio-codec-output.
	 * A reserved line cannot be requested (gpiolib answers -EINVAL), so a node that
	 * names a new pin of pinctrl_ap opens it here too.
	 */
	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
};

&i2c1 {
	/*
	 * ADT speaker-config 00 14 00 02: playback slot 0, amp gain 20, I sense in slot 0
	 * and V sense in slot 2. The bytes are <slot, gain, I slot, V slot>: on J316 every
	 * amp's row matches its validated imon/vmon pair (00 0f 00 02 is imon 0, vmon 2;
	 * 01 0f 04 06 is imon 4, vmon 6), and J375/J473/J575 use imon 0, vmon 2 as well.
	 * The firmware's speaker frame is 250 BCLKs of 12 MHz (ADT
	 * iop-audio-controller/audio-speaker), which the amp's ratio detection rejects.
	 */
	speaker_amp: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
		ti,bclk-ratio = <250>;
	};
};

&i2c2 {
	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Jack";
	};
};

/*
 * The console is on the USB debug link, which drains only while a host reads
 * it; the machine also boots with nothing attached there.
 */
&dockchannel {
	apple,tx-never-wait;
	status = "okay";
};

&dart_apcie2 {
	status = "okay";
};

&dart_apcie3 {
	status = "okay";
};

#include "hwmon-fan-dual.dtsi"

/*
 * The Studio's SMC has F0Ac/F0Mn/F0Mx/F0Tg and F1*, but its mode keys are F0md/F1md (ui8, flags 0xd0:
 * readable, writable, a function key), not the F0Md/F1Md the dtsi names; with the dtsi's names fan
 * creation failed on the missing key. With the real keys the fans can be set by the kernel's
 * thermal policy (the M5 GPU governor, through macsmc_hwmon_fans_request()). No
 * apple,fan-manual-control: userspace still only reads them.
 */
&smc_hwmon {
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};

/*
 * The boot NOR's NVRAM: the loader fills the partition from ADT /arm-io/qspi/spinor/anvram reg
 * (0x700000, 0xc0000 here), 12 banks of 64 KiB (/chosen nvram-bank-count, nvram-bank-size). The
 * flash is spinor's CS0 (its reg's first cell; the second is 0x19, 25), clocked as on T8140's
 * J700. Only this partition is exposed (no MTD_PARTITIONED_MASTER), so the rest of the boot NOR
 * has no device node, and the controller's T8140 policy admits programs and erases only inside
 * this partition.
 */
&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		/* Single-wire, as on T8132's J713: no quad-enable status write at probe */
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				/* To be filled by the loader */
				reg = <0x0 0x0>;
				status = "disabled";
			};
		};
	};
};

/*
 * The always-on (NUB) GPIO block, ADT /arm-io/nub-gpio0 (61 pins, no power gate). Only pin 14 is
 * exposed: the rear USB-A hubs' reset, ADT spi3/usb3hub-flash/usb3hub-fw function-usb3hub_rst
 * (nub-gpio0 pin 14, flags 1). Behind the ASM3142 sits a VIA VL822 USB3.1/USB2.0 hub pair
 * (05ac:800e, 05ac:800d) that boots from its own SPI flash once released. The pin is left an
 * undriven input, which holds the hubs in reset; driven high, both hubs and the USB-A devices
 * behind them enumerate within a second (lobata, 2026-11-04), so the reset is active low.
 */
&{/soc} {
};

/*
 * Rear USB-C port 3 (HPM2, usb-pd@8, the display port): its USB controller, enabled with
 * atc2_phy as t6050.dtsi says, for USB beside DisplayPort.
 */
&usb_drd2 {
	status = "okay";
};

&usb_drd2_dart_0 {
	status = "okay";
};

&usb_drd2_dart_1 {
	status = "okay";
};

/*
 * The HDMI port. On the one-die J775c it hangs off die 0, where J775D has it on die 1
 * (dcpext4, lpdptx-phy1, dp2hdmi-gpio1, all deleted here with the die-1 buses). From the
 * J775c ADT (captured 2026-11-03, macOS 26A425; arm-io ranges child 0 -> 0x200000000):
 * - display-crossbar0 (display-crossbar,t6050) has no registers. Its dfp endpoint 4 is
 *   lpdptx-phy0 (dp-switch-dfp-endpoint 4, transports-supported 5); its ufp endpoints are
 *   dispext0..7. dcpext1 is ufp endpoint 1 (dcpext0, which takes the four rear USB-C
 *   ports, is 0), so the PHY's source select picks it (source-select-offset 1).
 * - lpdptx-phy0 (dptx-phy,t6050): reg 0x9c240000+0x10000 (dptx) and 0x9c200000+0x4000
 *   (core); power-gates and clock-gates 0xe5, PMGR device DPTX_PHY (ps-group 1 + 0x3f8,
 *   no parents); DCOCFG 3, DTCVREG 15, DTCCAL 2, DCDADJ 16, DLFCFG 3, pclkdrv-select 1;
 *   RODCOROLEAKCOMP and FD0FD1SWAP absent (0xffffffff).
 * - dp2hdmi-gpio0 (dp2hdmi-gpio-parent of lpdptx-phy0, pcon-stays-on): hdmi_hpd is
 *   aop-gpio0 pin 14, hdmi_pwr_en and dp2hdmi_pwr_en the SMC's pKW8 pcIO commands; the
 *   same pins as J775D's dp2hdmi-gpio1, which t6050.dtsi already describes (pinctrl_aop,
 *   smc_pcio).
 * - dcpext1 (iop-dcpext1-nub external-index 2), dispext1, dart-dcpext1, dart-dispext1:
 *   dcpext0's layout at +0x1e0000000 (child 0x1_92e00000), but dispext1's reg[4], the PMC
 *   metadata, is the one dispext0 names. Interrupts: mailbox 1195..1198 (ADT order
 *   0x4ac 0x4ab 0x4ae 0x4ad, as dcpext0's 0x464 0x463 0x466 0x465), both DARTs 1142.
 *   The bandwidth request is PMGR bwr-agent 4, DISP_EXT1 (BIRQ 0x3c, dispext1's
 *   bw_req_interrupt0); its scratch is 0x20000 + 0x4000 * agent, as DISP_INT (agent 0,
 *   J716c's dcp at 0x20000) and DISP_EXT0 (agent 3, dcpext0 at 0x2c000) have it.
 * iBoot leaves dcpext1 as it leaves dcpext0: powered (DISPEXT1_CPU 0x2806002e0 =
 * 0x1404024f), its ASC running, both DARTs locked (0xff / 0xb9) on the ADT's l1-tt roots
 * for SIDs 23, 0 and 16 (Aura's T6050 inventory on lobata, 2026-11-04). All disabled:
 * Aura's T6050 handoff enables dcpext1 with its nodes, the PHY and its power domain and
 * pinctrl_aop when the engine passes the same checks as dcpext0, and appends
 * dart_dispext1 to the display subsystem.
 */
&{/soc} {




};

/* The HDMI PHY's power gate (ADT pmgr DPTX_PHY, 0xe5); with no consumer it stays off */
&pmgr1 {
	ps_dptx_phy: power-controller@3f8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3f8 4>;
		label = "dptx_phy";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
	};
};

/*
 * The HDMI hotplug input is the only AOP GPIO pin the AP uses; the AOP owns the rest,
 * so only pin 14 is exposed (pin 15, force-dpfu, is never requested).
 */
&pinctrl_aop {
	gpio-reserved-ranges = <0 14>, <15 70>;
};

/*
 * The HDMI port's audio. On T6050 every display pipe has its own audio DMA controller (ADT
 * admac-dispextN, "admac,t6050", the AOP's ADMAC family), behind its own DART
 * (dart-dispextN-isoc, one mapper: dispextN-dpa, SID 30), feeding that pipe's DisplayPort
 * audio interface (dp-audioN+1). M1..M4 fed it from the SIO coprocessor instead; this
 * generation has no SIO DMA path for it (ADT dp-audio2 dma-parent = admac-dispext1), and
 * macOS drives it from the AP (AudioDMAController-T605x on admac-dispext1, channel DX10TX;
 * DCPAVAudioDMADelegate on dp-audio2). The DCP's audio service on port@0 does the rest.
 * From the J775c ADT (arm-io child 0 -> 0x200000000):
 * - admac-dispext1: reg 0x1_92140000+0x24000 and the shared 0x88328000+8 (the LLT vote
 *   register admac-base-ns names too; not needed here); one TX channel; interrupt 0x48c on
 *   irq-destination 0 (AIC), as admac-base-ns; channel-buffer-allocation 0x1900.
 * - dart-dispext1-isoc (dart,t8110): reg 0x1_92180000+0x20000 (and the shared PS_PROT block
 *   at 0x803f0000), interrupt 0x48d, vm-base 1 TiB, vm-size 64 GiB, no l1-tt: iBoot sets up
 *   no stream on it, so it is not locked.
 * - dp-audio2: power-gates/clock-gates 0x51 = PMGR DISPEXT1_ADMA (ps-group 0, 0x2d8, parent
 *   DISPEXT1_SYS, which iBoot leaves on with dcpext1); dma-parent admac-dispext1 channel 0.
 *   No AP-side registers. The ADMAC and the DART have no power gate of their own; both are
 *   given DISPEXT1_ADMA, which macOS turns on for the DPA.
 * The audio interface itself is always available: the display subsystem waits for it as a
 * component of dcpext1 (once Aura enables dcpext1), so it carries no power domain whose
 * failure could hold the display back. A DMA controller that does not come up only fails
 * the PCM's open.
 */
&{/soc} {

};

&pmgr0 {
	/* ADT pmgr DISPEXT1_ADMA (0x51): dispext1's audio DMA and DisplayPort audio */
	ps_dispext1_adma: power-controller@2d8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2d8 4>;
		label = "dispext1_adma";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
	};
};

&dcpext1 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dcpext1_audio: endpoint {
				remote-endpoint = <&dpaudio_dispext1_dcp>;
			};
		};
	};
};

/* ADT dp-audio2: no AP-side registers, so not on the SoC bus */
/ {
	dpaudio_dispext1: audio-controller-dispext1 {
		compatible = "apple,t6050-dpaudio", "apple,dpaudio";
		dmas = <&admac_dispext1 0>;
		dma-names = "tx";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dpaudio_dispext1_dcp: endpoint {
					remote-endpoint = <&dcpext1_audio>;
				};
			};
		};
	};
};

/*
 * DisplayPort audio on the rear USB-C ports: dcpext0's pipe, laid out as dcpext1's above.
 * ADT admac-dispext0 0xb2140000 (interrupt 0x444), dart-dispext0-isoc 0xb2180000 (interrupt
 * 0x445, SID 30, no l1-tt), dp-audio1 with power gate DISPEXT0_ADMA (0x44, pmgr0 0x270,
 * parent DISPEXT0_SYS).
 */
&{/soc} {

};

&pmgr0 {
	/* ADT pmgr DISPEXT0_ADMA (0x44): dispext0's audio DMA and DisplayPort audio */
	ps_dispext0_adma: power-controller@270 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x270 4>;
		label = "dispext0_adma";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
	};
};

&dcpext0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dcpext0_audio: endpoint {
				remote-endpoint = <&dpaudio_dispext0_dcp>;
			};
		};
	};
};

/* ADT dp-audio1 */
/ {
	dpaudio_dispext0: audio-controller-dispext0 {
		compatible = "apple,t6050-dpaudio", "apple,dpaudio";
		dmas = <&admac_dispext0 0>;
		dma-names = "tx";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dpaudio_dispext0_dcp: endpoint {
					remote-endpoint = <&dcpext0_audio>;
				};
			};
		};
	};
};

/* The untrained port's DART must not be probed; Aura enables it after link-up. */
&{/soc} {
};

