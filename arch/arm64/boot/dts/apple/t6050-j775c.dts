// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple Mac Studio (M5 Max, 2026)
 *
 * target-type: J775c, board-id: 0x10, chip-id: 0x6050
 * One die, 18 CPUs: two six-core M clusters and one six-core P cluster.
 *
 * Board support by Satya Benson.
 * Copyright The Asahi Linux Contributors
 *
 * This is the final board description, including the compatibility layout
 * required by installed Aura b6e6faf4. Keep the GPU below /soc@2300000000
 * and its ASC/SGX resources until a modern loader is qualified on J775c.
 * See Documentation/devicetree/apple-j775c-compatibility.rst.
 */

/dts-v1/;

/ {
	compatible = "apple,j775c", "apple,t6050", "apple,arm-platform";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <&aic>;
	model = "Apple Mac Studio (M5 Max, 2026)";
	chassis-type = "desktop";

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x00 0x00>;
	};

	/* The loader fills the reserved-memory ranges before starting Linux. */
	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		uat_handoff: uat-handoff {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		uat_l2_pagetables: uat-l2-pagetables {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		uat_pagetables: uat-pagetables {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		uat_ttbs: uat-ttbs {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		gpu_fw_text: gpu-fw-text {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		gpu_fw_data: gpu-fw-data {
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		ane_fw_text: ane-firmware-text@0 {
			compatible = "apple,asc-mem";
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};

		ane_fw_data: ane-firmware-data@0 {
			compatible = "apple,asc-mem";
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			status = "disabled";
		};
	};

	/* Single-die CPU inventory; the loader prunes cores that are not present. */
	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu0: cpu@40000 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40000>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu1: cpu@40001 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40001>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu2: cpu@40002 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40002>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu3: cpu@40003 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40003>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu4: cpu@40004 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40004>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu5: cpu@40005 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40005>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc00>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m00>;
		};

		cpu6: cpu@40100 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40100>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu7: cpu@40101 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40101>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu8: cpu@40102 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40102>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu9: cpu@40103 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40103>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu10: cpu@40104 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40104>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu11: cpu@40105 {
			compatible = "apple,sawtooth";
			capacity-dmips-mhz = <0x31a>;
			device_type = "cpu";
			reg = <0x00 0x40105>;
			enable-method = "spin-table";
			operating-points-v2 = <&mcluster_opp>;
			performance-domains = <&cpufreq_mc10>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_m01>;
		};

		cpu12: cpu@10200 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10200>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_0>;
		};

		cpu13: cpu@10201 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10201>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_1>;
		};

		cpu14: cpu@10202 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10202>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_2>;
		};

		cpu15: cpu@10203 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10203>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_3>;
		};

		cpu16: cpu@10204 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10204>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_4>;
		};

		cpu17: cpu@10205 {
			compatible = "apple,everest";
			capacity-dmips-mhz = <0x400>;
			device_type = "cpu";
			reg = <0x00 0x10205>;
			enable-method = "spin-table";
			operating-points-v2 = <&pcluster_opp>;
			performance-domains = <&cpufreq_pc0>;
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <&l2_cache_p0_5>;
		};

		l2_cache_m00: l2-cache-m00 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l2_cache_m01: l2-cache-m01 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l3_cache_p0: l3-cache-p0 {
			compatible = "cache";
			cache-level = <0x03>;
			cache-unified;
			cache-size = <0x1000000>;
		};

		l2_cache_p0_0: l2-cache-p0-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_1: l2-cache-p0-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_2: l2-cache-p0-2 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_3: l2-cache-p0-3 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_4: l2-cache-p0-4 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		l2_cache_p0_5: l2-cache-p0-5 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <&l3_cache_p0>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};
			};

			cluster1 {

				core0 {
					cpu = <&cpu6>;
				};

				core1 {
					cpu = <&cpu7>;
				};

				core2 {
					cpu = <&cpu8>;
				};

				core3 {
					cpu = <&cpu9>;
				};

				core4 {
					cpu = <&cpu10>;
				};

				core5 {
					cpu = <&cpu11>;
				};
			};

			cluster2 {

				core0 {
					cpu = <&cpu12>;
				};

				core1 {
					cpu = <&cpu13>;
				};

				core2 {
					cpu = <&cpu14>;
				};

				core3 {
					cpu = <&cpu15>;
				};

				core4 {
					cpu = <&cpu16>;
				};

				core5 {
					cpu = <&cpu17>;
				};
			};
		};
	};

	mcluster_opp: opp-table-mcluster {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <0x11e1a300>;
			opp-level = <0x01>;
		};

		opp02 {
			opp-hz = /bits/ 64 <0x501bd000>;
			opp-level = <0x02>;
		};

		opp03 {
			opp-hz = /bits/ 64 <0x61fd7300>;
			opp-level = <0x03>;
		};

		opp04 {
			opp-hz = /bits/ 64 <0x76bb8200>;
			opp-level = <0x04>;
		};

		opp05 {
			opp-hz = /bits/ 64 <0x89544000>;
			opp-level = <0x05>;
		};

		opp06 {
			opp-hz = /bits/ 64 <0x9e124f00>;
			opp-level = <0x06>;
		};

		opp07 {
			opp-hz = /bits/ 64 <0xb0ab0d00>;
			opp-level = <0x07>;
		};

		opp08 {
			opp-hz = /bits/ 64 <0xc11e7a00>;
			opp-level = <0x08>;
		};

		opp09 {
			opp-hz = /bits/ 64 <0xd0dacc00>;
			opp-level = <0x09>;
		};

		opp10 {
			opp-hz = /bits/ 64 <0xdc4c7c00>;
			opp-level = <0x0a>;
		};

		opp11 {
			opp-hz = /bits/ 64 <0xe7071100>;
			opp-level = <0x0b>;
		};

		opp12 {
			opp-hz = /bits/ 64 <0xf10a8b00>;
			opp-level = <0x0c>;
		};

		opp13 {
			opp-hz = /bits/ 64 <0xf8e8b400>;
			opp-level = <0x0d>;
		};

		opp14 {
			opp-hz = /bits/ 64 <0xff58a700>;
			opp-level = <0x0e>;
		};

		opp15 {
			opp-hz = /bits/ 64 <0x100c6dd00>;
			opp-level = <0x0f>;
		};

		opp16 {
			opp-hz = /bits/ 64 <0x105117f00>;
			opp-level = <0x10>;
		};
	};

	pcluster_opp: opp-table-pcluster {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <0x11e1a300>;
			opp-level = <0x01>;
		};

		opp02 {
			opp-hz = /bits/ 64 <0x4df67f00>;
			opp-level = <0x02>;
		};

		opp03 {
			opp-hz = /bits/ 64 <0x608f3d00>;
			opp-level = <0x03>;
		};

		opp04 {
			opp-hz = /bits/ 64 <0x76046700>;
			opp-level = <0x04>;
		};

		opp05 {
			opp-hz = /bits/ 64 <0x889d2500>;
			opp-level = <0x05>;
		};

		opp06 {
			opp-hz = /bits/ 64 <0x99c7ad00>;
			opp-level = <0x06>;
		};

		opp07 {
			opp-hz = /bits/ 64 <0xaba95000>;
			opp-level = <0x07>;
		};

		opp08 {
			opp-hz = /bits/ 64 <0xbd8af300>;
			opp-level = <0x08>;
		};

		opp09 {
			opp-hz = /bits/ 64 <0xcc902a00>;
			opp-level = <0x09>;
		};

		opp10 {
			opp-hz = /bits/ 64 <0xd9701000>;
			opp-level = <0x0a>;
		};

		opp11 {
			opp-hz = /bits/ 64 <0xe42aa500>;
			opp-level = <0x0b>;
		};

		opp12 {
			opp-hz = /bits/ 64 <0xed770400>;
			opp-level = <0x0c>;
		};

		opp13 {
			opp-hz = /bits/ 64 <0xf49e1200>;
			opp-level = <0x0d>;
		};

		opp14 {
			opp-hz = /bits/ 64 <0xf99fcf00>;
			opp-level = <0x0e>;
		};

		opp15 {
			opp-hz = /bits/ 64 <0xfc7c3b00>;
			opp-level = <0x0f>;
		};

		opp16 {
			opp-hz = /bits/ 64 <0xff58a700>;
			opp-level = <0x10>;
		};

		opp17 {
			opp-hz = /bits/ 64 <0x100c6dd00>;
			opp-level = <0x11>;
		};

		opp18 {
			opp-hz = /bits/ 64 <0x102351300>;
			opp-level = <0x12>;
		};

		opp19 {
			opp-hz = /bits/ 64 <0x107edeb00>;
			opp-level = <0x13>;
		};

		opp20 {
			opp-hz = /bits/ 64 <0x10cefa800>;
			opp-level = <0x14>;
		};

		opp21 {
			opp-hz = /bits/ 64 <0x112a88000>;
			opp-level = <0x15>;
		};
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
	};

	clk_405m: clock-405m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x1823cf40>;
		clock-output-names = "clk_405m";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&aic>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x00 0x02 0x04>, <0x01 0x00 0x03 0x04>, <0x01 0x00 0x00 0x04>,
			<0x01 0x00 0x01 0x04>;
	};

	cpu_pmu: pmu {
		compatible = "apple,t6050-pmu";
		interrupt-parent = <&aic>;
		interrupts = <0x01 0x00 0x05 0x04>;
	};

	die0: soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;

		cpufreq_mc00: performance-controller@210e20000 {
			compatible = "apple,t6050-cluster-cpufreq";
			reg = <0x02 0x10e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			apple,firmware-managed-thermal;
		};

		cpufreq_mc10: performance-controller@211e20000 {
			compatible = "apple,t6050-cluster-cpufreq";
			reg = <0x02 0x11e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			apple,firmware-managed-thermal;
		};

		cpufreq_pc0: performance-controller@212e20000 {
			compatible = "apple,t6050-cluster-cpufreq";
			reg = <0x02 0x12e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			apple,firmware-managed-thermal;
		};

		aic: interrupt-controller@280400000 {
			compatible = "apple,t6050-aic3", "apple,t8122-aic3";
			interrupt-controller;
			#interrupt-cells = <0x04>;
			reg = <0x02 0x80400000 0x00 0x1cc000>, <0x02 0x80440000 0x00 0x4000>;
			reg-names = "core", "event";
		};

		dockchannel: serial@288e3c000 {
			compatible = "apple,dockchannel-uart";
			reg = <0x02 0x88e3c000 0x00 0x30>, <0x02 0x88e38000 0x00 0x08>, <0x02
				0x88e0c000 0x00 0x18>;
			reg-names = "data", "config", "irq";
			interrupts = <0x00 0x00 0x168 0x04>;
			apple,channel = <0x01>;
			apple,sw-drain;
			status = "okay";
			apple,tx-never-wait;
		};

		wdt: watchdog@28836c000 {
			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
			reg = <0x02 0x8836c000 0x00 0x4000>;
			clocks = <&clkref>;
			interrupts = <0x00 0x00 0x2d1 0x04>;
		};

		smc_mbox: mailbox@28c608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0x8c608000 0x00 0x4000>;
			interrupts = <0x00 0x00 0x383 0x04>, <0x00 0x00 0x384 0x04>, <0x00 0x00
				0x385 0x04>, <0x00 0x00 0x386 0x04>;
			interrupt-names = "send-empty" , "send-not-empty" , "recv-empty" ,
				"recv-not-empty" ;
			#mbox-cells = <0x00>;
		};

		pinctrl_aop: pinctrl@290824000 {
			compatible = "apple,t6050-pinctrl", "apple,t8132-pinctrl";
			reg = <0x02 0x90824000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <&pinctrl_aop 0x00 0x00 0x55>;
			apple,npins = <0x55>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x23c 0x04>, <0x00 0x00 0x23d 0x04>, <0x00 0x00
				0x23e 0x04>;
			apple,irq-group-base = <0x04>;
			status = "okay";
			gpio-reserved-ranges = <0x00 0x0e>, <0x0f 0x3e>, <0x4e 0x01>, <0x50 0x01>,
				<0x52 0x01>, <0x54 0x01>;

			acio2_lstx_pins: acio2-lstx-pins {
				pinmux = <0x10051>;
			};

			acio0_lstx_pins: acio0-lstx-pins {
				pinmux = <0x1004d>;
			};

			acio1_lstx_pins: acio1-lstx-pins {
				pinmux = <0x1004f>;
			};

			acio3_lstx_pins: acio3-lstx-pins {
				pinmux = <0x10053>;
			};
		};

		smc: smc@28c600000 {
			compatible = "apple,t6050-smc";
			reg = <0x02 0x8c600000 0x00 0x4000>, <0x02 0x8de00000 0x00 0x140000>;
			reg-names = "smc", "sram";
			mboxes = <&smc_mbox>;

			smc_hwmon: hwmon {
				compatible = "apple,smc-hwmon";
				apple,discover-temperatures;
				apple,soc-die-keys = "TCMb";

				power-PD0R {
					apple,key-id = "PD0R";
					label = "DC Input Power";
				};

				fan-F0Ac {
					apple,key-id = "F0Ac";
					label = "Fan 1";
					apple,fan-minimum = "F0Mn";
					apple,fan-maximum = "F0Mx";
					apple,fan-target = "F0Tg";
					apple,fan-mode = "F0md";
				};

				fan-F1Ac {
					apple,key-id = "F1Ac";
					label = "Fan 2";
					apple,fan-minimum = "F1Mn";
					apple,fan-maximum = "F1Mx";
					apple,fan-target = "F1Tg";
					apple,fan-mode = "F1md";
				};
			};

			smc_reboot: reboot {
				compatible = "apple,smc-reboot";
				nvmem-cells = <&shutdown_flag
					&boot_stage
					&boot_error_count
					&panic_count
					&pm_setting>;
				nvmem-cell-names = "shutdown_flag" , "boot_stage" ,
					"boot_error_count" , "panic_count" , "pm_setting" ;
			};

			smc_pcio: gpio {
				compatible = "apple,smc-pcio-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				apple,output-commands = /bits/ 64 <0xf000000800000
					0x1a000000000000>;
			};

			smc_rtc: rtc {
				compatible = "apple,smc-rtc";
				nvmem-cells = <&rtc_offset>, <&rtc_ctrl>, <&rtc_alarm>,
					      <&rtc_alarm_mask>;
				nvmem-cell-names = "rtc_offset", "rtc_ctrl", "rtc_alarm",
						   "rtc_alarm_mask";
				/* The PMU's alarm: its peripheral interrupt 2 on nub-spmi0 (edge, rising). */
				interrupts-extended = <&nub_spmi0 0x02 0x01>;
				wakeup-source;
			};

			gpio-low {
				compatible = "apple,smc-low-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
			};
		};

		ans_sart: iommu@41dc50000 {
			compatible = "apple,t6050-sart";
			reg = <0x04 0x1dc50000 0x00 0xc000>;
		};

		ans_mbox: mailbox@419608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x04 0x19608000 0x00 0x4000>;
			interrupts = <0x00 0x00 0x543 0x04>, <0x00 0x00 0x544 0x04>, <0x00 0x00
				0x545 0x04>, <0x00 0x00 0x546 0x04>;
			interrupt-names = "send-empty" , "send-not-empty" , "recv-empty" ,
				"recv-not-empty" ;
			#mbox-cells = <0x00>;
		};

		nvme: nvme@45dcc0000 {
			compatible = "apple,t6050-nvme-ans2";
			reg = <0x04 0x5dcc0000 0x00 0x10000>, <0x04 0x19600000 0x00 0x4000>, <0x04
				0x1dcc0000 0x00 0x60000>;
			reg-names = "nvme", "ans", "nvmmu";
			interrupts = <0x00 0x00 0x922 0x04>;
			mboxes = <&ans_mbox>;
			apple,sart = <&ans_sart>;
		};

		dart_apcie2: iommu@412000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x04 0x12000000 0x00 0x20000>;
			interrupts = <0x00 0x00 0x604 0x04>;
			#iommu-cells = <0x01>;
			status = "okay";
		};

		dart_apcie0: iommu@410000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x04 0x10000000 0x00 0x20000>;
			interrupts = <0x00 0x00 0x5f4 0x04>;
			#iommu-cells = <0x01>;
			status = "disabled";
		};

		dart_apcie3: iommu@413000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x04 0x13000000 0x00 0x20000>;
			interrupts = <0x00 0x00 0x60c 0x04>;
			#iommu-cells = <0x01>;
			status = "okay";
		};

		nub_spmi0: spmi@28a014000 {
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a014000 0x00 0x4000>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			/* ADT /arm-io/nub-spmi0 interrupts[1]: AIC 726. Its peripheral interrupts carry the PMU's. */
			interrupts = <0x00 0x00 0x2d6 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			pmu: pmic@e {
				compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
				reg = <0x0e 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					rtc_ctrl: rtc-ctrl@2000 {
						reg = <0x2000 0x01>;
					};

					pm_setting: pm-setting@2001 {
						reg = <0x2001 0x01>;
					};

					rtc_alarm: rtc-alarm@2008 {
						reg = <0x2008 0x04>;
					};

					rtc_alarm_mask: rtc-alarm-mask@200e {
						reg = <0x200e 0x01>;
					};

					rtc_offset: rtc-offset@2100 {
						reg = <0x2100 0x06>;
					};

					boot_stage: boot-stage@f801 {
						reg = <0xf801 0x01>;
					};

					boot_error_count: boot-error-count@f802,0 {
						reg = <0xf802 0x01>;
						bits = <0x00 0x04>;
					};

					panic_count: panic-count@f802,4 {
						reg = <0xf802 0x01>;
						bits = <0x04 0x04>;
					};

					shutdown_flag: shutdown-flag@f80f,3 {
						reg = <0xf80f 0x01>;
						bits = <0x03 0x01>;
					};
				};
			};
		};

		dart_dcpext0: iommu@2b2340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x02 0xb2340000 0x00 0x20000>;
			interrupts = <0x00 0x00 0x42e 0x04>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x00 0x300 0x00>;
			status = "disabled";
		};

		dart_dispext0: iommu@2b2300000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x02 0xb2300000 0x00 0xc000>;
			interrupts = <0x00 0x00 0x42e 0x04>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x00 0x300 0x00>;
			status = "disabled";
		};

		dcpext0_mbox: mailbox@2b2e08000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0xb2e08000 0x00 0x4000>;
			interrupts = <0x00 0x00 0x463 0x04>, <0x00 0x00 0x464 0x04>, <0x00 0x00
				0x465 0x04>, <0x00 0x00 0x466 0x04>;
			interrupt-names = "send-empty" , "send-not-empty" , "recv-empty" ,
				"recv-not-empty" ;
			#mbox-cells = <0x00>;
			status = "disabled";
		};

		dcpext0_pmc: pmc-metadata@286700000 {
			reg = <0x02 0x86700000 0x00 0x114000>;
			#apple,bw-scratch-cells = <0x03>;
			status = "disabled";
		};

		pmc: power-management@286806000 {
			compatible = "apple,t6050-pmc";
			reg = <0x02 0x86806000 0x00 0x3000>, <0x02 0x86700000 0x00 0x14000>;
			reg-names = "rails", "voters";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			apple,static-voters = <0x01 0x03>;

			clpc: performance-controller@1 {
				compatible = "apple,t6050-clpc", "apple,t6041-clpc";
				reg = <0x01>;
				apple,smc = <&smc>;
			};
		};

		dcpext0: dcp@2b2e00000 {
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			reg = <0x02 0xb2e00000 0x00 0x4000>, <0x02 0xb0000000 0x00 0x4000000>, <0x02
				0xb2240000 0x00 0x10000>, <0x02 0xb23ac000 0x00 0x4000>, <0x02
				0xb2800000 0x00 0x800000>, <0x02 0x86700000 0x00 0x114000>, <0x02
				0xb2850000 0x00 0x4000>;
			reg-names = "coproc" , "disp-0" , "disp-1" , "disp-2" , "disp-3" , "disp-4"
				, "iop-vbar" ;
			mboxes = <&dcpext0_mbox>;
			mbox-names = "mbox";
			iommus = <&dart_dcpext0 0x17>;
			apple,bw-scratch = <&dcpext0_pmc 0x00 0x05 0x2c000>;
			apple,dcp-index = <0x01>;
			apple,clock-ids;
			apple,connector-type = "USB-C";
			apple,dptx-die = <0x00>;
			apple,typec-dptx-phys = <0x02 0x01 0x03 0x00>;
			apple,typec-mux-indices = <0x00 0x00 0x00 0x00>;
			phys = <&atc2_phy 0x06 &atc1_phy 0x06
				&atc3_phy 0x06 &atc0_phy 0x06>;
			phy-names = "typec0", "typec1", "typec2", "typec3";
			mux-controls = <&atc2_xbar 0x00 &atc1_xbar 0x00
				&atc3_xbar 0x00 &atc0_xbar 0x00>;
			mux-control-names = "typec0", "typec1", "typec2", "typec3";
			status = "disabled";

			piodma {
				iommus = <&dart_dispext0 0x10>;
			};

			typec-routes {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				route@0 {
					reg = <0x00>;
					mode-switch;

					port {

						dcpext0_typec: endpoint {
							remote-endpoint = <&hpm2_dp>;
						};
					};
				};

				route@1 {
					reg = <0x01>;
					mode-switch;

					port {

						dcpext0_typec1: endpoint {
							remote-endpoint = <&hpm1_dp>;
						};
					};
				};

				route@2 {
					reg = <0x02>;
					mode-switch;

					port {

						dcpext0_typec2: endpoint {
							remote-endpoint = <&hpm3_dp>;
						};
					};
				};

				route@3 {
					reg = <0x03>;
					mode-switch;

					port {

						dcpext0_typec3: endpoint {
							remote-endpoint = <&hpm0_dp>;
						};
					};
				};
			};

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					dcpext0_audio: endpoint {
						remote-endpoint = <&dpaudio_dispext0_dcp>;
					};
				};
			};
		};

		pmgr0: power-management@280600000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x02 0x80600000 0x00 0x4000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			ps_atc0_common: power-controller@208 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x208 0x04>;
				label = "atc0-common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&{/soc/power-management@280600000/power-controller@1e0}>;
				status = "okay";
			};

			ps_atc1_common: power-controller@210 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x210 0x04>;
				label = "atc1_common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				status = "okay";
			};

			ps_atc2_common: power-controller@238 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x238 0x04>;
				label = "atc2_common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				status = "okay";
			};

			ps_atc3_common: power-controller@240 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x240 0x04>;
				label = "atc3_common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				status = "okay";
			};

			ps_dispext1_adma: power-controller@2d8 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x2d8 0x04>;
				label = "dispext1_adma";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			ps_dispext0_adma: power-controller@270 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x270 0x04>;
				label = "dispext0_adma";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			ps_atc0_cio: power-controller@280 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x280 0x04>;
				label = "atc0-cio";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc0_common>;
				status = "okay";
			};

			ps_atc0_cio_pcie: power-controller@338 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x338 0x04>;
				label = "atc0-cio-pcie";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc0_cio>;
				status = "okay";
			};

			ps_atc0_cio_usb: power-controller@340 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x340 0x04>;
				label = "atc0-cio-usb";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc0_cio>;
				status = "okay";
			};

			ps_atc0_cio_auss: power-controller@348 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x348 0x04>;
				label = "atc0-cio-auss";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc0_cio
					&ps_auss>;
				status = "okay";
			};

			ps_atc1_cio: power-controller@290 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x290 0x04>;
				label = "atc1-cio";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc1_common>;
				status = "okay";
			};

			ps_atc1_cio_pcie: power-controller@350 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x350 0x04>;
				label = "atc1-cio-pcie";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc1_cio>;
				status = "okay";
			};

			ps_atc1_cio_usb: power-controller@358 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x358 0x04>;
				label = "atc1-cio-usb";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc1_cio>;
				status = "okay";
			};

			ps_atc1_cio_auss: power-controller@360 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x360 0x04>;
				label = "atc1-cio-auss";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc1_cio
					&ps_auss>;
				status = "okay";
			};

			ps_atc2_cio: power-controller@2e8 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x2e8 0x04>;
				label = "atc2-cio";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc2_common>;
				status = "okay";
			};

			ps_atc2_cio_pcie: power-controller@3f8 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x3f8 0x04>;
				label = "atc2-cio-pcie";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc2_cio>;
				status = "okay";
			};

			ps_atc2_cio_usb: power-controller@400 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x400 0x04>;
				label = "atc2-cio-usb";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc2_cio>;
				status = "okay";
			};

			ps_atc2_cio_auss: power-controller@408 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x408 0x04>;
				label = "atc2-cio-auss";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc2_cio
					&ps_auss>;
				status = "okay";
			};

			ps_atc3_cio: power-controller@2f8 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x2f8 0x04>;
				label = "atc3_cio";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc3_common>;
				status = "okay";
			};

			ps_atc3_cio_pcie: power-controller@410 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x410 0x04>;
				label = "atc3_cio_pcie";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc3_cio>;
				status = "okay";
			};

			ps_atc3_cio_usb: power-controller@418 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x418 0x04>;
				label = "atc3_cio_usb";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc3_cio>;
				status = "okay";
			};

			ps_atc3_cio_auss: power-controller@420 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x420 0x04>;
				label = "atc3_cio_auss";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&ps_atc3_cio
					&ps_auss>;
				status = "okay";
			};

			ps_auss: power-controller@248 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x248 0x04>;
				label = "auss";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
