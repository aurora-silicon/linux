// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Mac Studio (M5 Max, 2026)
 *
 * target-type: J775c
 *
 * One T6050 die (t6050-max.dtsi). Nobody has booted Linux on this board
 * yet: beyond the SoC this file only adds the board's hardware inventory
 * (t6050-peripherals.dtsi), all of it disabled, from the board's ADT.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6050-max.dtsi"

/ {
	compatible = "apple,j775c", "apple,t6050", "apple,arm-platform";
	model = "Apple Mac Studio (M5 Max, 2026)";
	chassis-type = "desktop";

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};
};

/* PCIe port 0 is not described for this board yet */
&pcie0 {
	status = "disabled";
};

#define T6050_J775C
#include "t6050-peripherals.dtsi"

/*
 * The boot chain hands AFR and GFX over with an auto-PM floor of clock-gated
 * (PS_MIN = 4), and the power-state driver writes back the floor it reads.
 * That holds the idle GFX domain at state 4. macOS runs both domains with a
 * floor of power-gated, where idle GFX rests at state 0; request the same.
 */
&ps_afr {
	apple,min-state = <0>;
};

&ps_gfx {
	apple,min-state = <0>;
};
