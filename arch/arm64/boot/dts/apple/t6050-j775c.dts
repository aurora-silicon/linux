		pinctrl_nub: pinctrl@2881e4000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x02 0x881e4000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <&pinctrl_nub 0x00 0x00 0x3d>;
			apple,npins = <0x3d>;
			gpio-reserved-ranges = <0x00 0x0e>, <0x0f 0x2e>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x00 0x2c2 0x04>, <0x00 0x00 0x2c4 0x04>, <0x00 0x00
				0x2c6 0x04>, <0x00 0x00 0x2c8 0x04>, <0x00 0x00 0x2ca 0x04>, <0x00
				0x00 0x2cc 0x04>, <0x00 0x00 0x2ce 0x04>;
			status = "okay";

			usb3hub-rst-hog {
				gpio-hog;
				gpios = <0x0e 0x01>;
				output-low;
				line-name = "usb3hub_rst";
			};
		};

		usb_drd0_dart_0: iommu@2a2f00000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x02 0xa2f00000 0x00 0xc000>;
