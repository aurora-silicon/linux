		avd: avd@2309080000 {
			compatible = "apple,t6050-avd", "apple,t8142-avd";
			reg = <0x23 0x9080000 0x00 0x14000>, <0x23 0x9094000 0x00 0x14000>, <0x23
				0x90a8000 0x00 0x4000>, <0x23 0x9100000 0x00 0x10000>;
			reg-names = "code", "sram", "mbox", "ctrl";
			interrupts = <0x00 0x00 0x971 0x04>, <0x00 0x00 0x972 0x04>;
			power-domains = <&ps_avd_sys>;
