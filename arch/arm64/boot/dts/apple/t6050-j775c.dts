		atc2_phy_mbox: mailbox@383148000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x03 0x83148000 0x00 0x4000>;
			interrupts = <0x00 0x00 0x35d 0x04>, <0x00 0x00 0x35e 0x04>, <0x00 0x00
				0x35f 0x04>, <0x00 0x00 0x360 0x04>;
			interrupt-names = "send-empty" , "send-not-empty" , "recv-empty" ,
				"recv-not-empty" ;
			#mbox-cells = <0x00>;
			status = "okay";
		};

		atc2_phy: phy@383000000 {
			compatible = "apple,t6050-combo-phy";
			reg = <0x03 0x83000000 0x00 0x2c000>, <0x03 0x82a90000 0x00 0x4000>, <0x03
				0x82800000 0x00 0x4000>, <0x03 0x83200000 0x00 0x4000>, <0x03
				0x83244000 0x00 0x4000>, <0x03 0x80000000 0x00 0x8000>, <0x03
				0x80020000 0x00 0x4000>, <0x03 0x83250000 0x00 0x4000>, <0x03
				0x83140000 0x00 0x4000>, <0x03 0x830c0000 0x00 0x10000>, <0x03
				0x82a84000 0x00 0x4000>;
			reg-names = "core" , "usb2phy" , "usb2-digital" , "reset" , "fabric" ,
				"axi2af" , "lioa" , "common-cfg" , "usb-control" , "firmware-data" ,
				"pipehandler" ;
			#phy-cells = <0x01>;
			#reset-cells = <0x01>;
			apple,port-index = <0x02>;
			apple,guest-port-reserved;
			mode-switch;
			orientation-switch;
			mboxes = <&atc2_phy_mbox>;
			power-domains = <&ps_atc2_usb_aon
				&ps_atc2_common
				&ps_atc2_phymxwrap
				&ps_atc2_usb>;
			power-domain-names = "usb-aon", "common", "wrapper", "usb";
			status = "okay";
			apple,tunable-lane0-rx-top-cio = <0x35c 0xe00 0x200>;
			apple,tunable-lane1-rx-top-cio = <0x35c 0xe00 0x200>;

			port {

				atc2_phy_ep: endpoint {
					remote-endpoint = <&hpm2_ss>;
				};
			};
		};

		atc2_xbar: mux@38324c000 {
			compatible = "apple,t6050-display-crossbar", "apple,t8142-display-crossbar";
			reg = <0x03 0x8324c000 0x00 0x4000>;
			#mux-control-cells = <0x01>;
			power-domains = <&ps_atc2_usb_aon
				&ps_atc2_common>;
			power-domain-names = "usb-aon", "common";
			status = "okay";
		};

		nub_spmi_a0: spmi@28a188000 {
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a188000 0x00 0x4000>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			status = "okay";

			hpm0: usb-pd@c {
				compatible = "apple,sn201202x";
				reg = <0x0c 0x00>;

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Back-right";
					power-role = "dual";
					data-role = "host";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							hpm0_hs: endpoint {
								remote-endpoint = <&usb_drd0_hs>;
							};
						};

						port@1 {
							reg = <0x01>;

							hpm0_ss: endpoint {
								remote-endpoint = <&atc0_phy_ep>;
							};
						};

						port@2 {
							reg = <0x02>;

							hpm0_dp: endpoint {
								remote-endpoint = <&dcpext0_typec3>;
							};
						};

						port@3 {
							reg = <0x03>;

							hpm0_usb4: endpoint {
								remote-endpoint = <&{/soc/acio@2a1ac0000/ports/port@1/endpoint}>;
							};
						};
					};
				};
			};

			hpm1: usb-pd@a {
				compatible = "apple,sn201202x";
				reg = <0x0a 0x00>;

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Back-right-middle";
					power-role = "dual";
					data-role = "host";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							hpm1_hs: endpoint {
								remote-endpoint = <&usb_drd1_hs>;
							};
						};

						port@1 {
							reg = <0x01>;

							hpm1_ss: endpoint {
								remote-endpoint = <&atc1_phy_ep>;
							};
						};

						port@2 {
							reg = <0x02>;

							hpm1_dp: endpoint {
								remote-endpoint = <&dcpext0_typec1>;
							};
						};

						port@3 {
							reg = <0x03>;

							hpm1_usb4: endpoint {
								remote-endpoint = <&{/soc/acio@2a9ac0000/ports/port@1/endpoint}>;
							};
						};
					};
				};
			};

			hpm2: usb-pd@8 {
				compatible = "apple,sn201202x";
				reg = <0x08 0x00>;
				status = "okay";

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Back-left-middle";
					power-role = "dual";
					data-role = "dual";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							hpm2_hs: endpoint {
								remote-endpoint = <&usb_drd2_hs>;
							};
						};

						port@1 {
							reg = <0x01>;

							hpm2_ss: endpoint {
								remote-endpoint = <&atc2_phy_ep>;
							};
						};

						port@2 {
							reg = <0x02>;

							hpm2_dp: endpoint {
								remote-endpoint = <&dcpext0_typec>;
							};
						};

						port@3 {
							reg = <0x03>;

							hpm2_usb4: endpoint {
								remote-endpoint = <&{/soc/acio@381ac0000/ports/port@1/endpoint}>;
							};
						};
					};
				};
			};

			hpm3: usb-pd@6 {
				compatible = "apple,sn201202x";
				reg = <0x06 0x00>;

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Back-left";
					power-role = "dual";
					data-role = "host";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							hpm3_hs: endpoint {
								remote-endpoint = <&usb_drd3_hs>;
							};
						};

						port@1 {
							reg = <0x01>;

							hpm3_ss: endpoint {
								remote-endpoint = <&atc3_phy_ep>;
							};
						};

						port@2 {
							reg = <0x02>;

							hpm3_dp: endpoint {
								remote-endpoint = <&dcpext0_typec2>;
							};
						};

						port@3 {
							reg = <0x03>;

							hpm3_usb4: endpoint {
								remote-endpoint = <&{/soc/acio@389ac0000/ports/port@1/endpoint}>;
							};
						};
					};
				};
			};
		};

