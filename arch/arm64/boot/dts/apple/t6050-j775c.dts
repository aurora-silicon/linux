		ane: ane@508000000 {
			compatible = "apple,t6050-ane";
			reg = <0x05 0x8000000 0x00 0x2000000>, <0x02 0x80900000 0x00 0x18000>, <0x02
				0x80921590 0x00 0x34>, <0x05 0x84000000 0x00 0x2000000>;
			reg-names = "engine", "pmgr", "pwgate", "xl";
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x3ba 0x04>, <0x00 0x00 0x3c7 0x04>;
			iommus = <&ane_dart0 0x00>, <&ane_dart1 0x00>, <&ane_dart2 0x00>;
			power-domains = <&ps_ane_sys>;
			memory-region = <&ane_fw_text>, <&ane_fw_data>;
			memory-region-names = "firmware-text", "firmware-data";
			apple,ane-type = <0x220>;
			apple,firmware-preloaded;
			apple,firmware-iovas = /bits/ 64 <0x10000000000 0x100000c0000>;
			apple,dapf-ranges = /bits/ 64 <0x2809003a8 0x2809003ab 0x2809003c0
				0x2809003d3 0x581668000 0x581668003 0x2302668000 0x2302668003
				0x6302668000 0x6302668003>;
			apple,clpc = <&clpc>;
			performance-domains = <&cpufreq_pc0>;
			status = "disabled";
		};

		i2c1: i2c@505014000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x05 0x5014000 0x00 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x560 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <&ps_i2c1>;

			speaker_amp: codec@38 {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x38>;
				shutdown-gpios = <&pinctrl_ap 0x6b 0x00>;
				interrupts-extended = <&pinctrl_ap 0x6a 0x08>;
				#sound-dai-cells = <0x00>;
				ti,imon-slot-no = <0x00>;
				ti,vmon-slot-no = <0x02>;
			};
		};

		i2c2: i2c@505018000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x05 0x5018000 0x00 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x561 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <&ps_i2c2>;

			jack_codec: codec@4b {
				compatible = "cirrus,cs42l84";
				reg = <0x4b>;
				reset-gpios = <&pinctrl_ap 0x8b 0x00>;
				interrupts-extended = <&pinctrl_ap 0x86 0x08>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Jack";
			};
		};

		qspi: spi@505118000 {
			compatible = "apple,t6050-qspi", "apple,t8140-qspi";
			reg = <0x05 0x5118000 0x00 0x4800>;
			clocks = <&clk_405m>;
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x55d 0x04>;
			power-domains = <&ps_qspi>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0x00>;
				spi-max-frequency = <0x17d7840>;
				spi-rx-bus-width = <0x01>;
				spi-tx-bus-width = <0x01>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					nvram: partition@700000 {
						label = "nvram";
						reg = <0x00 0x00>;
						status = "disabled";
					};
				};
			};
		};

		aop_mbox: mailbox@290608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0x90608000 0x00 0x4000>;
			interrupts = <0x00 0x00 0x242 0x04>, <0x00 0x00 0x243 0x04>, <0x00 0x00
				0x244 0x04>, <0x00 0x00 0x245 0x04>;
			interrupt-names = "send-empty" , "send-not-empty" , "recv-empty" ,
				"recv-not-empty" ;
			#mbox-cells = <0x00>;
			status = "disabled";
		};

		aop_dart: iommu@290fc0000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x02 0x90fc0000 0x00 0xc000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <&aic>;
			interrupts = <0x00 0x00 0x268 0x04>;
