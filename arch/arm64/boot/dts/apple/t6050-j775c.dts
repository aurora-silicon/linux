	soc@2300000000 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x23 0x00 0x23 0x00 0x00 0x4000000>;
		nonposted-mmio;

		/* Installed loader contract: retain this path and both ASC/SGX banks. */
		gpu: gpu@2302600000 {
			compatible = "apple,agx-g17c", "apple,agx-g17s", "apple,agx-t6050";
			reg = <0x23 0x2600000 0x00 0x88000>, <0x23 0x00 0x00 0x4000000>;
			reg-names = "asc", "sgx";
			mboxes = <&gfx_mbox
				&gfx1_mbox>;
			power-domains = <&ps_gfx>;
			memory-region = <&uat_ttbs
				&uat_pagetables &uat_handoff
				&gpu_fw_data
				&uat_l2_pagetables
				&gpu_fw_text>;
			memory-region-names = "ttbs" , "pagetables" , "handoff" , "fw-data" ,
				"l2-pagetables" , "fw-text" ;
			operating-points-v2 = <&gpu_opp>;
			apple,afr-opp = <&{/opp-table-gpuafr}>;
			apple,cs-opp = <&{/opp-table-gpucs}>;
			apple,clpc = <&clpc>;
			apple,csafr-min-sram-microvolt = <0x00>;
			apple,aon-ptd = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			status = "disabled";
		};

		gfx_mbox: mailbox@2302600000 {
			compatible = "apple,t6050-j775d-ascwrap-v6";
			reg = <0x23 0x2600000 0x00 0x88000>, <0x23 0x2050000 0x00 0x08>;
			reg-names = "wrapper", "iop-vbar";
			interrupts = <0x00 0x00 0xaed 0x04>, <0x00 0x00 0xaf0 0x04>;
			interrupt-names = "send-empty", "recv-not-empty";
			apple,firmware-role = "GFX";
			power-domains = <&ps_gfx>;
			#mbox-cells = <0x00>;
			status = "disabled";
		};

		gfx1_mbox: mailbox@2302e00000 {
			compatible = "apple,t6050-j775d-ascwrap-v6";
			reg = <0x23 0x2e00000 0x00 0x88000>, <0x23 0x2850000 0x00 0x08>;
			reg-names = "wrapper", "iop-vbar";
			interrupts = <0x00 0x00 0xaf1 0x04>, <0x00 0x00 0xaf4 0x04>;
			interrupt-names = "send-empty", "recv-not-empty";
			apple,firmware-role = "GFX1";
			power-domains = <&ps_gfx>;
			#mbox-cells = <0x00>;
			status = "disabled";
		};

		pmgr3: power-management@2300e80000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x23 0xe80000 0x00 0x4000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			status = "okay";

			ps_gpx: power-controller@0 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x00 0x04>;
				label = "gpx";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				status = "disabled";
			};

			ps_afr: power-controller@100 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x100 0x04>;
				label = "afr";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				status = "disabled";
			};

			ps_gfx: power-controller@110 {
				compatible = "apple,t6050-pmgr-pwrstate" ,
					"apple,t8103-pmgr-pwrstate" ;
				reg = <0x110 0x04>;
				label = "gfx";
				#power-domain-cells = <0x00>;
				power-domains = <&ps_afr
					&ps_gpx>;
				#reset-cells = <0x00>;
				status = "disabled";
			};
		};
	};

	aliases {
		serial0 = &dockchannel;
		ethernet0 = &ethernet0;
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
		atcphy2 = &atc2_phy;
		atcphy0 = &atc0_phy;
		atcphy1 = &atc1_phy;
		atcphy3 = &atc3_phy;
		nvram = &nvram;
		usb4-0-acio = &acio0;
		usb4-0-nhi = &acio0_nhi;
		usb4-1-acio = &acio1;
		usb4-1-nhi = &acio1_nhi;
		usb4-2-acio = &acio2;
		usb4-2-nhi = &acio2_nhi;
		usb4-3-acio = &acio3;
		usb4-3-nhi = &acio3_nhi;
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	pcie0: pcie@1cb0000000 {
		/* s2idle with the boot-loader-trained links left running (pcie-apple.c, #2488) */
		apple,s2idle-retain-adopted-links;
		compatible = "apple,t6050-pcie";
		device_type = "pci";
		reg = <0x1c 0xb0000000 0x00 0x10000000>, <0x04 0x14000000 0x00 0x4000>, <0x04
			0x12028000 0x00 0x8000>, <0x04 0x17018000 0x00 0x4000>, <0x04 0x12024000
			0x00 0x4000>, <0x04 0x13028000 0x00 0x8000>, <0x04 0x1701c000 0x00 0x4000>,
			<0x04 0x13024000 0x00 0x4000>, <0x04 0x10028000 0x00 0x8000>, <0x04
			0x17010000 0x00 0x4000>, <0x04 0x10024000 0x00 0x4000>, <0x04 0x11028000
			0x00 0x8000>, <0x04 0x17014000 0x00 0x4000>, <0x04 0x11024000 0x00 0x4000>;
		reg-names = "config" , "rc" , "port2" , "phy2" , "intr2axi2" , "port3" , "phy3" ,
			"intr2axi3" , "port0" , "phy0" , "intr2axi0" , "port1" , "phy1" ,
			"intr2axi1" ;
		nonposted-mmio;
		interrupts = <0x00 0x00 0x603 0x04>, <0x00 0x00 0x60b 0x04>, <0x00 0x00 0x5f3 0x04>,
			<0x00 0x00 0x5fb 0x04>;
		interrupt-names = "port2", "port3", "port0", "port1";
		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic 0x00 0x00 0x760 0x01 0x40>;
		apple,msi-vector-base = <0x40>;
		iommu-map = <0x100 &dart_apcie2 0x01 0x01 0x200 &dart_apcie3
			0x01 0x01 0x300 &dart_apcie0 0x01 0x03 0x400
			&dart_apcie1 0x01 0x01>;
		iommu-map-mask = <0xffff>;
		dma-coherent;
		linux,pci-domain = <0x00>;
		bus-range = <0x00 0x04>;
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		ranges = <0x2000000 0x00 0x80000000 0x0b 0x80000000 0x00 0x40000000>, <0x43000000
			0x0b 0xc0000000 0x0b 0xc0000000 0x00 0x20000000>;

		port02: pci@2,0 {
			device_type = "pci";
			reg = <0x1000 0x00 0x00 0x00 0x00>;
			bus-range = <0x01 0x01>;
			apple,link-trained-by-bootloader;
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 &port02 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x02 &port02 0x00 0x00
				0x00 0x01 0x00 0x00 0x00 0x03 &port02 0x00 0x00
				0x00 0x02 0x00 0x00 0x00 0x04 &port02 0x00 0x00
				0x00 0x03>;

			ethernet0: ethernet@0,0 {
				reg = <0x10000 0x00 0x00 0x00 0x00>;
				local-mac-address = [00 00 00 00 00 00];
			};
		};

		port03: pci@3,0 {
			device_type = "pci";
			reg = <0x1800 0x00 0x00 0x00 0x00>;
			bus-range = <0x02 0x02>;
			apple,link-trained-by-bootloader;
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 &port03 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x02 &port03 0x00 0x00
				0x00 0x01 0x00 0x00 0x00 0x03 &port03 0x00 0x00
				0x00 0x02 0x00 0x00 0x00 0x04 &port03 0x00 0x00
				0x00 0x03>;
		};

		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x00 0x00 0x00 0x00 0x00>;
			bus-range = <0x03 0x03>;
			apple,link-trained-by-bootloader;
			reset-gpios = <&pinctrl_ap 0x50 0x01>;
			status = "disabled";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 &port00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x02 &port00 0x00 0x00
				0x00 0x01 0x00 0x00 0x00 0x03 &port00 0x00 0x00
				0x00 0x02 0x00 0x00 0x00 0x04 &port00 0x00 0x00
				0x00 0x03>;

			n1_control: control@0,0 {
				compatible = "pci106b,1900";
				reg = <0x30000 0x00 0x00 0x00 0x00>;
				firmware-name = "apple/centauri/j775c-ftab.bin";
				apple,centauri-platform-id = <0x106050>;
				apple,centauri-protocol = <0x1b>;
			};

			n1_alpha: wifi@0,1 {
				compatible = "pci106b,1902";
				reg = <0x30100 0x00 0x00 0x00 0x00>;
				local-mac-address = [00 00 00 00 00 00];
			};

			n1_beta: bluetooth@0,2 {
				compatible = "pci106b,1903";
				reg = <0x30200 0x00 0x00 0x00 0x00>;
				local-bd-address = [00 00 00 00 00 00];
			};
		};

		port01: pci@1,0 {
			device_type = "pci";
			reg = <0x800 0x00 0x00 0x00 0x00>;
			bus-range = <0x04 0x04>;
			apple,link-trained-by-bootloader;
			status = "disabled";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			ranges;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 &port01 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x02 &port01 0x00 0x00
				0x00 0x01 0x00 0x00 0x00 0x03 &port01 0x00 0x00
				0x00 0x02 0x00 0x00 0x00 0x04 &port01 0x00 0x00
				0x00 0x03>;

			sdcard@0,0 {
				compatible = "pci17a0,9755";
				reg = <0x40000 0x00 0x00 0x00 0x00>;
				cd-inverted;
				wp-inverted;
			};
		};
	};

	sound {
		compatible = "apple,j775c-macaudio", "apple,macaudio";
		model = "Mac Studio J775";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		dai-link@0 {
			reg = <0x00>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0x00>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <0x01>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 0x03>;
			};

			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};

	dpaudio_dispext1: audio-controller-dispext1 {
		compatible = "apple,t6050-dpaudio", "apple,dpaudio";
		dmas = <&admac_dispext1 0x00>;
		dma-names = "tx";

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				dpaudio_dispext1_dcp: endpoint {
					remote-endpoint = <&dcpext1_audio>;
				};
			};
		};
	};

	dpaudio_dispext0: audio-controller-dispext0 {
		compatible = "apple,t6050-dpaudio", "apple,dpaudio";
		dmas = <&admac_dispext0 0x00>;
		dma-names = "tx";

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				dpaudio_dispext0_dcp: endpoint {
					remote-endpoint = <&dcpext0_audio>;
				};
			};
		};
	};

