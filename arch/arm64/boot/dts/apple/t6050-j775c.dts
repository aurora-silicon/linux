		usb_drd0: usb@2a2280000 {
			compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
			reg = <0x02 0xa2280000 0x00 0xcd00>, <0x02 0xa228cd00 0x00 0x4b00>, <0x02
				0xa2200000 0x00 0x4000>;
			reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
			interrupts = <0x00 0x00 0x58b 0x04>;
			dr_mode = "otg";
			usb-role-switch;
			role-switch-default-mode = "host";
			iommus = <&usb_drd0_dart_0 0x00 &usb_drd0_dart_1 0x01>;
			power-domains = <&ps_atc0_usb>;
			resets = <&atc0_phy 0x00>;
			phys = <&atc0_phy 0x03 &atc0_phy 0x04>;
			phy-names = "usb2-phy", "usb3-phy";
			apple,tunable-gbl-default = <0x64 0x02 0x00>, <0x10 0xfff80000 0x680000>;
			apple,tunable-gbl-host = <0x04 0x1ef00 0x2f00>, <0x1c 0x100 0x00>, <0x2c
				0xa07ff 0x800c8>, <0x100 0x2000100 0x2000100>, <0x504 0x1000 0x00>,
				<0x528 0xff0000ff 0x6000006>, <0x52c 0xff0000ff 0x8000008>, <0x580
				0xffffffff 0x6f000006>, <0x584 0xffffffff 0x60000>;
			apple,tunable-dbg = <0x00 0x08 0x08>;
			apple,tunable-cfg-host = <0x20 0xff 0x1b>;
			apple,tunable-link = <0x10 0xff000000 0xff000000>, <0x20 0x7ff00000
				0x4e900000>, <0x24 0x1f8000 0xb8000>, <0x60 0x3ffff 0x600>;
			apple,tunable-cio = <0x20 0xff0000 0x1e0000>;
			status = "okay";

			port {

				usb_drd0_hs: endpoint {
					remote-endpoint = <&hpm0_hs>;
				};
			};
		};

