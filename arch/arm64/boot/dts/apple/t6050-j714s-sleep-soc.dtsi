		<0xfa0005 6 0x8 0x10>,
		<0x3 6 0x4 0x20>,
		<0xfa0005 6 0x8 0x1>,
		<0x2 5 0x0 0x1>,
		<0x2 6 0x0 0x8000000>;
	/* The shared PHY parked in the commit window */
	apple,phy-park =
		<0x3 7 0x85c 0x4>,
		<0x2 7 0x494 0x1>,
		<0x20105 7 0x494 0xb>,
		<0x2 6 0x4 0x20>,
		<0x3 6 0x4 0x10>,
		<0x1 6 0x8 0x0>,
		<0x2 7 0x828 0x20>;
	/* Before APCIE_PHY_SW goes down */
	apple,phy-down =
		<0x3 6 0x0 0x8000000>;
	/* The clusters' CPM boot writes: cluster, offset, value */
	apple,cpm-boot = /bits/ 64 <
		0 0x8000 0x0
		0 0x8008 0x0
		0 0x40f8 0x1
		1 0x8000 0x0
		1 0x8008 0x0
		1 0x40f8 0x1
		2 0x8000 0x0
		2 0x8008 0x0
		2 0x40f8 0x1
		0 0x8000 0x0
		0 0x8008 0x0
		0 0x40f8 0x1
		1 0x8000 0x0
		1 0x8008 0x0
		1 0x40f8 0x1
		2 0x8000 0x0
		2 0x8008 0x0
		2 0x40f8 0x1
		0 0x40f8 0x1
		0 0x4008 0x8b0f
		0 0x4018 0x8a0f
		0 0x4028 0xd00f
		0 0x4038 0x8c0f
		0 0x4048 0x9c0f
		0 0x4058 0x800f
		0 0x4068 0x810f
		0 0x4078 0xd50f
		0 0x4088 0xb90f
		0 0x4098 0xbe0f
		0 0x40a8 0xbf0f
		0 0x40b8 0xd40f
		1 0x40f8 0x1
		1 0x4008 0x8b0f
		1 0x4018 0x8a0f
		1 0x4028 0xd00f
		1 0x4038 0x8c0f
		1 0x4048 0x9c0f
		1 0x4058 0x800f
		1 0x4068 0x810f
		1 0x4078 0xd50f
		1 0x4088 0xb90f
		1 0x4098 0xbe0f
		1 0x40a8 0xbf0f
		1 0x40b8 0xd40f
		2 0x40f8 0x1
		2 0x4008 0x8b0f
		2 0x4018 0x8a0f
		2 0x4028 0xd00f
		2 0x4038 0x8c0f
		2 0x4048 0x9c0f
		2 0x4058 0x800f
		2 0x4068 0x810f
		2 0x4078 0xd50f
		2 0x4088 0xb90f
		2 0x4098 0xbe0f
		2 0x40a8 0xbf0f
		2 0x40b8 0xd40f
		0 0x4180 0x0
		0 0x4188 0x0
		0 0x4190 0xffffffffffffffff
		0 0x4198 0xffffffffffffffff
		0 0x41a0 0xffffffffffffffff
		0 0x41a8 0xffffffffffffffff
		0 0x41b0 0x6665
		0 0x41b8 0x0
		0 0x4180 0x3
		1 0x4180 0x0
		1 0x4188 0x0
		1 0x4190 0xffffffffffffffff
		1 0x4198 0xffffffffffffffff
		1 0x41a0 0xffffffffffffffff
		1 0x41a8 0xffffffffffffffff
		1 0x41b0 0x6665
		1 0x41b8 0x0
		1 0x4180 0x3
		2 0x4180 0x0
		2 0x4188 0x0
		2 0x4190 0xffffffffffffffff
		2 0x4198 0xffffffffffffffff
		2 0x41a0 0xffffffffffffffff
		2 0x41a8 0xffffffffffffffff
		2 0x41b0 0x6665
		2 0x41b8 0x0
		2 0x4180 0x3>;
};

&pmp0 {
	/* The PMP firmware's SRAM kept over a sleep: offset, size */
	apple,sram-keep = <0x58000 0x9b000>;
};

&pmp0_report {
	/* The PMP's memory-cache channel and PPM-TO-SMC at boot: entry, value */
	apple,ptd-boot = /bits/ 64 <
		0x245 0x600000
		0x244 0x1002
		0xfff 2
		0xffe 0x261
		0xffe 0x266
		0xffe 0x267
		0xffe 0x268
		0xffe 0x25a
		0xffe 0x25b
		0xffe 0x25c
		0xffe 0x25d
		0x270 0x0002111100000000
		0x271 0
		0x272 0
		0x273 0
		0x274 0
		0x23c 0x0004000000000000
		0x23d 0
		0x23d 0
		0x23d 0
		0x23c 0
		0x23d 0
		0x23d 0
		0x23d 0
		0x245 0
		0x244 3
		0x23c 0x400000000
		0x23c 0
		0x243 0x400000000
		0x243 0
		0xfff 3
		0x245 0
		0x244 4
		0xfff 4
		0x243 0
		0x23c 0
		0x245 0
		0x244 5
		0x23c 0
		0x23d 0
		0x23d 0
		0x23d 0
		0x23c 0x600000000
		0xfff 5
		0x245 0
		0x244 6
		0xfff 6
		0x23c 0
		0x243 0
		0x23c 0
		0x245 0
		0x244 7
		0x23c 0
		0x23d 0
		0x23d 0
		0x23d 0
		0xfff 7
		0x245 0
		0x244 8
		0xfff 8>;
};

/* Each stopped DART's GAPF slice, and the slice's live and off values */
&sep_dart {
	apple,gapf-slice = <0xb00>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&pmp0_dart {
	apple,gapf-slice = <0x1c0>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&sio_dart {
	apple,gapf-slice = <0xac0>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&dart_apcie0 {
	apple,gapf-slice = <0x980>;
	apple,gapf-slice-values = <0x12 0x2>;
};

/*
 * The N1 over a sleep. The warm reset's writes to the key of apple,function-warm-reset (value,
 * wait after it in us), given by the host while port 0 is still down; and the N1 driver's SMC
 * writes around the sleep (key 'pcIO', the eight value bytes as two cells, wait after it in us).
 */
&port00 {
	apple,warm-reset-writes = <0x00010001 17000>, <0x00010001 20000>;
	apple,endpoint-sleep-smc-writes = <0x7063494f 0x00000000 0x00001900 0>;
	apple,endpoint-wake-smc-writes = <0x7063494f 0x01008000 0x00000e01 135000>,
					 <0x7063494f 0x01000000 0x00001900 0>;
};

/*
 * The J714s values the SIO, AOP, AOP2 and DockChannel HID drivers take from the DT, until the
 * boot loader supplies them.
 *
 * Include after t6050-j714s.dts's own includes, so that &sio is the node that
 * t6050-j714s-sleep.dtsi recreates.
 */

/* Each DMA channel's configuration words (previously sio_hw_t6050's fifo_threshold, cfg_word4) */
&sio {
	apple,channel-threshold = <0x600>;
	apple,channel-limit = <0x800>;
};

/*
 * AOP2: the INIT argument (previously AOP2_INIT_ARG), the sleep element's message words, the wake
 * element's, and the order its endpoints open in and the order they get the sleep message in
 * (previously t6050_aop2_open_order and t6050_aop2_stop_order in t6050-aop.c)
 */
&aop2 {
	apple,init-arg = <0x100>;
	apple,sleep-message = <0x0 0x4 0x2>;
	apple,wake-message = <0x0 0x4 0x4>;
	apple,open-endpoints = <0x20 0x2c 0x22 0x21 0x23 0x24>;
	apple,sleep-endpoints = <0x22 0x20 0x2c 0x21 0x23 0x24>;
};

/*
 * AOP: the order its endpoints stop in before a firmware-driven sleep, and the order they start in
 * after it (previously HW_CFG_T6050's sleep_endpoints and wake_endpoints in aop.rs)
 */
&aop {
	apple,sleep-endpoints = <0x2b 0x2c 0x21 0x2a 0x24 0x26 0x27 0x25 0x28 0x29 0x23 0x20 0x22>;
	apple,wake-endpoints = <0x22 0x28 0x27 0x23 0x21 0x20 0x29 0x24 0x2c 0x26 0x25 0x2a 0x2b>;
};

/* The feature report set on the actuator interface (index 4) before a firmware-driven sleep */
&mtp_hid {
	actuator {
		apple,sleep-report = /bits/ 8 <0x21 0x00>;
	};
};

/*
 * J714s values moved out of the DCP, DART, NVMe, PMP report and GPU drivers, until the boot
 * loader hands them over. Include after t6050-j714s.dts (it uses that tree's labels). Each value
 * is the one the code used before.
 */

/*
 * Firmware 27 display sleep RPC arguments (drivers/gpu/drm/apple/iomfb.c):
 * apple,sleep-power-args: A484 request bytes 8..15 (u32 0x01000001 LE, then u8 1, then zeros).
 * apple,sleep-a500-args: A500's 4-byte argument for the sleep (byte 1 = 1), then for the wake.
 */
&dcp {
	apple,sleep-power-args = /bits/ 8 <0x01 0x00 0x00 0x01 0x01 0x00 0x00 0x00>;
	apple,sleep-a500-args = /bits/ 8 <0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
};

/*
 * The internal panel's own power state around the sleep (drivers/gpu/drm/apple/iomfb.c,
 * dcp-v27-sleep.inc) and its HDCP interface's open call (epic/panelavep.c):
 * apple,sleep-display-power-args: plain A484 request bytes 8..15, all zero.
 * apple,sleep-display-stage-args: A414's 8-byte argument (zero), then A487's 4 (u32 1 LE).
 * apple,panel-hdcp-open-arg: the fifth word of the HDCP interface's open call.
 */
&dcp {
	apple,sleep-display-power-args = /bits/ 8 <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
	apple,sleep-display-stage-args = /bits/ 8 <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
						   0x01 0x00 0x00 0x00>;
	apple,panel-hdcp-open-arg = <3>;
	apple,panel-video-open-delay-us = <2500>;
};

&dcpext0 {
	apple,sleep-power-args = /bits/ 8 <0x01 0x00 0x00 0x01 0x01 0x00 0x00 0x00>;
	apple,sleep-a500-args = /bits/ 8 <0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
};

&dcpext1 {
	apple,sleep-power-args = /bits/ 8 <0x01 0x00 0x00 0x01 0x01 0x00 0x00 0x00>;
	apple,sleep-a500-args = /bits/ 8 <0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
};

&dcpext2 {
	apple,sleep-power-args = /bits/ 8 <0x01 0x00 0x00 0x01 0x01 0x00 0x00 0x00>;
	apple,sleep-a500-args = /bits/ 8 <0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
};

&dcpext3 {
	apple,sleep-power-args = /bits/ 8 <0x01 0x00 0x00 0x01 0x01 0x00 0x00 0x00>;
	apple,sleep-a500-args = /bits/ 8 <0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
};

/*
 * GAPF slices of the display coprocessors' DARTs (drivers/iommu/apple-dart-v27-late.inc):
 * offset in the sleep controller's "gapf" region (0x2803f0000), then <live off> values.
 * The external display DARTs (dart_dispext0, dispext1..3_dart) have none: they are retained.
 */
&dcp_dart {		/* 0x48a340000 -> 0x2803f0a80 */
	apple,gapf-slice = <0xa80>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&disp0_dart {		/* 0x48a300000 -> 0x2803f0a00 */
	apple,gapf-slice = <0xa00>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&dart_dcpext0 {		/* 0x2b2340000 -> 0x2803f0500 */
	apple,gapf-slice = <0x500>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&dcpext1_dart {		/* 0x392340000 -> 0x2803f0840 */
	apple,gapf-slice = <0x840>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&dcpext2_dart {		/* 0x302340000 -> 0x2803f06c0 */
	apple,gapf-slice = <0x6c0>;
	apple,gapf-slice-values = <0x12 0x2>;
};

&dcpext3_dart {		/* 0x306340000 -> 0x2803f0780 */
	apple,gapf-slice = <0x780>;
	apple,gapf-slice-values = <0x12 0x2>;
};

/* ANS2: the wait from the storage power being back to the co-processor restart (apple-m5-sleep.h) */
&nvme {
	apple,sleep-wake-delay-ms = <70>;
};

/* PMP report: the PTD entry the memory-cache channel echoes into (apple,ptd-boot's 0xfff steps) */
&pmp0_report {
	apple,ptd-echo-entry = <0x269>;
};

/*
 * GPU: the PS automatic state (bits 27:24) its domain is raised with after a sleep, and the floor
 * (bits 19:16) the boot leaves in its word (0x1404034f), which the wake's replay clears
 * (g17/sleep.c)
 */
&sgx {
	apple,sleep-ps-auto = <0xf>;
	apple,sleep-ps-min = <4>;
};

/*
 * TEST: the right port's USB4 router sleeping in place, with its tunnels kept, as macOS has
 * it (run mxt4; drivers/thunderbolt/apple-cio-sleep.c). The clock protection slices of the
 * NHI's and the tunnelled PCIe's DART are words 0x880 and 0x8c0 of the block the sleep
 * controller knows as "gapf": macOS writes each to its off value (bit 4 clear) right after
 * taking that DART down and back to the live value before using it again. The router's host
 * also needs the port's PHY, which it stops after the router and starts before it. The left
 * port's router was never up in a trace: it has none of this and is powered off for a sleep.
 */
&die0 {
	ps_prot: syscon@2803f0000 {
		compatible = "apple,t6050-ps-prot", "syscon";
		reg = <0x2 0x803f0000 0x0 0x4000>;
	};
};

&acio2 {
	apple,cio-phy = <&atc2_phy>;
};

&acio2_dart {
	apple,clock-protection = <&ps_prot 30>;
};

&apciec2_dart {
	apple,clock-protection = <&ps_prot 31>;
};
