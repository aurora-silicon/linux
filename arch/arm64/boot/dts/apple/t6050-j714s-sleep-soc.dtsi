/*
 * The J714s's (MacBook Pro 14-inch, M5 Pro) SoC values for the deep sleep that the drivers take
 * from the DT, until the boot loader hands them over.
 */

&sleep {

	/* The commit window's schedule, in us before the sleep timer, step by step */
	/* The commit window: from the SMC's idle notice to the timer */
	apple,commit-runway-us = <48000>;
	apple,commit-schedule-us = <41700 40900 39800 24700 23300 22300 20300 18010 18000
		2491 2296 2202 1552 1468 1382 950 730 650 550 500>;
	/* pmVC, then the spacings: warning to pmVC, pmVC to SLPA, SLPA to idle, idle to timer, wake to pmVC */
	apple,smc-sleep-policy = <0x101 42000 35000 10000 60000 58000>;
	/* Boot: the power words put on auto, SPI_P and ATC3_USB_AON on, the SPMI masks */
