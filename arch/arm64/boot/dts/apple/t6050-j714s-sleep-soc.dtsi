	apple,spmi-runtime-mask = <0x3f833ff1>;
	/*
	 * nub-spmi0: the PMU's interrupt source (the one apple,seq-boot enables at 0x400),
	 * latched in 0x600 bit 2. Acknowledged at every wake before the run-time mask goes
	 * back, as macOS does.
	 */
	apple,spmi-pmu-sources = <0x600 0x4>;
	/* The stage: the PMC's rail words */
	apple,seq-stage =
		<0x0 41 0x2000 0xb>,
		<0x0 41 0x2004 0xb>,
		<0x0 41 0x2008 0xb>,
		<0x0 41 0x200c 0xb>,
		<0x0 41 0x2028 0x40a>,
		<0x0 41 0x2020 0x10000>,
		<0x0 41 0x2020 0x0>;
	/* Commit: the auxiliary watchdog */
	apple,seq-commit-wdt =
		<0x0 37 0x2c 0x20>;
	/* Commit: AFR */
	apple,seq-commit-afr =
		<0x0 19 0x100 0x1004030f>,
		<0x0 19 0x100 0x0>;
	/* Commit: SIO, SIO_CPU, then the clock muxes parked */
	apple,seq-commit-sio =
		<0x0 17 0x290 0x400024f>,
		<0x0 17 0x2a0 0x400024f>,
		<0x1 51 0xa0 0x0>,
		<0x0 51 0xa0 0x80100400>,
		<0x1 51 0xa0 0x0>,
		<0x1 51 0xa4 0x0>,
		<0x0 51 0xa4 0x80100400>,
		<0x1 51 0xa4 0x0>,
