		<0x1 51 0x90 0x0>,
		<0x0 51 0x90 0x80100400>,
		<0x1 51 0x90 0x0>;
	/* The internal display's gate words at its stop */
	apple,seq-display-gate =
		<0x0 38 0x51c 0x3>,
		<0x0 38 0x540 0x0>;
	apple,ptd-sleep = <0x1e0 12 13 14 36>;
	apple,pmu-sleep-reads = <0xf801 1 0xf808 4 0xf802 1 0xf818 1 0xf819 2 0xf800 1 0xa7dc 4>;
