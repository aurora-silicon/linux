/*
 * Apple MacBook Air (13-inch and 15-inch, M4, 2025)
 *
 * The parts the J713 and J715 share. The J715 overrides the radio's
 * firmware island and the ATC PHY trims; each board adds its panel,
 * speakers and firmware names.
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t8132-board.dtsi"
#include "t8132-isp.dtsi"
#include "t8132-gpu.dtsi"
#include "t8132-dcp.dtsi"
#include "t8132-dcpext.dtsi"
#include "t8132-j713-pmgr.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	aliases {
		disp0_piodma = &disp0_piodma;
		keyboard = &keyboard;
	};

	chosen {
		linux-enablement-mac,dapf-handoff = "/arm-io/aop", "/arm-io/mtp",
			"/arm-io/pmp";
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/* The J713 loader tree has these placeholders. */
&gpu_ttbs {
	reg = <0 0 0 0>;
};

&gpu_pagetables {
	reg = <0 0 0 0>;
};

&gpu_handoff {
	reg = <0 0 0 0>;
};

&gpu_shared_l2 {
	reg = <0 0 0 0>;
};

&gpu_fw_text {
	reg = <0 0 0 0>;
};

&gpu_fw_data {
	reg = <0 0 0 0>;
};

&framebuffer0 {
	/delete-property/ power-domains;
	panel = <&fb_panel>;
};

&aop_audio {
	/*
	 * Microphones on LEAP; speakers and their sense on TX0/RX0; the jack
	 * on TX2/RX2.
	 */
	dmas = <&admac0 1>, <&admac1 0>, <&admac1 1>, <&admac1 4>, <&admac1 5>;
	dma-names = "dma", "spkr", "sense", "cout", "cin";
};

/* CS42L84 headphone codec: reset on nub GPIO 17, IRQ on AP GPIO 98. */
&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&nub_spmi_a0 {
	hpm1: usb-pd@a {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C MagSafe-adjacent";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C native client";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

/* The radio's firmware island: the J713's here, the J715 overrides it. */
&wifi0 {
	brcm,board-type = "apple,garden";
};

&bluetooth0 {
	brcm,board-type = "apple,garden";
};

&fpwm1 {
	status = "okay";
};

/* An external pipe's PMC enables follow its SYS state, before its FE. */
&ps_dispext0_fe {
	power-domains = <&ps_dispext0_sys>, <&pmc_dispext0>;
};

&ps_dispext1_fe {
	power-domains = <&ps_dispext1_sys>, <&pmc_dispext1>;
};

&smc_hwmon {
	current-ID0R {
		apple,key-id = "ID0R";
		label = "AC Input Current";
	};

	/* Panel and backlight supply; tracks brightness, idles when blanked. */
	current-Ib8f {
		apple,key-id = "Ib8f";
		label = "Display Supply Current";
	};

	power-PDTR {
		apple,key-id = "PDTR";
		label = "AC Input Power";
	};

	power-PMVC {
		apple,key-id = "PMVC";
		label = "3.8 V Rail Power";
	};

	power-PSTR {
		apple,key-id = "PSTR";
		label = "Total System Power";
	};

	temperature-TB0T {
		apple,key-id = "TB0T";
		label = "Battery Hotspot";
	};

	temperature-TCHP {
		apple,key-id = "TCHP";
		label = "Charge Regulator Temp";
	};

	temperature-TH0x {
		apple,key-id = "TH0x";
		label = "NAND Flash Temperature";
	};

	temperature-TW0P {
		apple,key-id = "TW0P";
		label = "WiFi/BT Module Temp";
	};

	voltage-SBAV {
		apple,key-id = "SBAV";
		label = "Battery Voltage";
	};

	voltage-VD0R {
		apple,key-id = "VD0R";
		label = "Charger Input Voltage";
	};
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 29 GPIO_ACTIVE_LOW>;

	multi-touch {
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};
};

/* Mesa fingerprint sensor: power on nub GPIO 28, data-ready on AP GPIO 199. */
&spi2 {
	status = "okay";
};

&mesa {
	enable-gpios = <&pinctrl_nub 28 GPIO_ACTIVE_HIGH>;
	interrupt-parent = <&pinctrl_ap>;
	interrupts = <199 IRQ_TYPE_EDGE_RISING>;
	spi-cs-setup-delay-ns = <20>;
	spi-cs-hold-delay-ns = <20>;
	status = "okay";
};

/* GPU: the outer TVM gate is the parent of the GFX domain. */
&gfx_tvm {
	status = "okay";
};

&gpu {
	status = "okay";
};

&agx_mbox {
	status = "okay";
};

&ps_gfx {
	power-domains = <&gfx_tvm>;
	/* The G16 firmware stays live across suspend-to-idle. */
	apple,sleep-retained;
	status = "okay";
};

/* The report provider owns readiness for shared PMP commands. */
&pmp {
	apple,pmp-report = <&pmp_report>;
};

/*
 * Internal display: the loader enables disp0_dart, piodma and the display
 * subsystem once it has validated the inherited frontend mappings.
 */
&dcp_mbox {
	status = "okay";
};

&dcp_dart {
	status = "okay";
};

&dcp {
	apple,j713-native-piodma;
	apple,j713-native-scanout;
	/* Full 2560x1664 panel including the notch rows, 224 ppi. */
	apple,panel-width-mm = <290>;
	apple,panel-height-mm = <188>;
	status = "okay";
};

/* External displays: both pipes, routed to either USB-C port. */
&dcpext0_mbox {
	status = "okay";
};

&dcpext0_dart {
	status = "okay";
};

&dispext0_dart {
	status = "okay";
};

&dcpext1_mbox {
	status = "okay";
};

&dcpext1_dart {
	status = "okay";
};

&dispext1_dart {
	status = "okay";
};

&atc0_dpxbar {
	status = "okay";
};

&atc1_dpxbar {
	status = "okay";
};

/*
 * dcpext0's Type-C routes, UFP mux selector 2 on both ATC crossbars
 * (cells 0/1/2: DP PHY, DP IN0, DP IN1). The ATC PHYs have no DP alt mode:
 * the routes are for DisplayPort tunnels, and DP alt mode is refused. The
 * routes are disabled here; the display gate enables them only for a dcpext
 * the boot loader handed over, since a USB-C port controller waits for every
 * available route.
 */
&dcpext0 {
	apple,connector-type = "USB-C";
	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>;
	phy-names = "typec0", "typec1";
	mux-controls = <&atc0_dpxbar 0>, <&atc1_dpxbar 0>,
		       <&atc0_dpxbar 1>, <&atc0_dpxbar 2>,
		       <&atc1_dpxbar 1>, <&atc1_dpxbar 2>;
	mux-control-names = "typec0", "typec1",
			    "typec0-dpin0", "typec0-dpin1",
			    "typec1-dpin0", "typec1-dpin1";
	apple,typec-mux-indices = <2 2>;
	apple,typec-dptx-phys = <0 1>;

	status = "okay";

	typec-routes {
		#address-cells = <1>;
		#size-cells = <0>;

		route@0 {
			reg = <0>;
			mode-switch;
			status = "disabled";

			port {
				dcpext0_typec0: endpoint {
					remote-endpoint = <&typec0_dcpext0>;
				};
			};
		};

		route@1 {
			reg = <1>;
			mode-switch;
			status = "disabled";

			port {
				dcpext0_typec1: endpoint {
					remote-endpoint = <&typec1_dcpext0>;
				};
			};
		};
	};
};

/*
 * dcpext1's Type-C routes, UFP mux selector 4 on both ATC crossbars
 * (cells 0/1/2: DP PHY, DP IN0, DP IN1). The ATC PHYs have no DP alt mode:
 * the routes are for DisplayPort tunnels, and DP alt mode is refused. The
 * routes are disabled here; the display gate enables them only for a dcpext
 * the boot loader handed over, since a USB-C port controller waits for every
 * available route.
 */
&dcpext1 {
	apple,connector-type = "USB-C";
	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>;
	phy-names = "typec0", "typec1";
	mux-controls = <&atc0_dpxbar 0>, <&atc1_dpxbar 0>,
		       <&atc0_dpxbar 1>, <&atc0_dpxbar 2>,
		       <&atc1_dpxbar 1>, <&atc1_dpxbar 2>;
	mux-control-names = "typec0", "typec1",
			    "typec0-dpin0", "typec0-dpin1",
			    "typec1-dpin0", "typec1-dpin1";
	apple,typec-mux-indices = <4 4>;
	apple,typec-dptx-phys = <0 1>;

	status = "okay";

	typec-routes {
		#address-cells = <1>;
		#size-cells = <0>;

		route@0 {
			reg = <0>;
			mode-switch;
			status = "disabled";

			port {
				dcpext1_typec0: endpoint {
					remote-endpoint = <&typec0_dcpext1>;
				};
			};
		};

		route@1 {
			reg = <1>;
			mode-switch;
			status = "disabled";

			port {
				dcpext1_typec1: endpoint {
					remote-endpoint = <&typec1_dcpext1>;
				};
			};
		};
	};
};

&typec0 {
	ports {
		port@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			typec0_dcpext0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dcpext0_typec0>;
			};

			typec0_dcpext1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dcpext1_typec0>;
			};
		};
	};
};

&typec1 {
	ports {
		port@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			typec1_dcpext0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dcpext0_typec1>;
			};

			typec1_dcpext1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dcpext1_typec1>;
			};
		};
	};
};

#include "t8132-j713-atcphy-tunables.dtsi"
#include "t8132-j713-usb4.dtsi"
#include "t8132-j713-usb4-tunables.dtsi"
#include "t8132-j713-pciec-tunables.dtsi"
