		/*
		 * USB-C Back-right: ADT atc-phy3 in CIO mode, see atc2_phy for the
		 * layout. The tunables are the atc-phy3 groups the CIO mode
		 * applies, in that order: the common and PLL defaults as
		 * common-a, the fabric, PLL and the other common groups as
		 * common-b, and each lane's groups.
		 */
		atc3_phy: phy@413000000 {
			compatible = "apple,t8152-atcphy";
			reg = <0x4 0x13000000 0x0 0x84000>;
			reg-names = "core";
			#phy-cells = <1>;
