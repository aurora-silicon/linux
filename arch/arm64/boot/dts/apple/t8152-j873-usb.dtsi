/*
 * J873g USB2 host bring-up: usb-drd1 (back-left port) and usb-drd2
 * (front ports via the on-board hub).
 * The loader powers the controllers and initialises the eUSB2 PHYs in host
 * mode before Linux starts (no PMGR, PHY or Type-C driver yet), so the
 * controllers are described as plain DWC3 hosts behind their two DARTs.
 * Resources are from the 26A434 ADT: dart-usb1/2, usb-drd1/2.
 */

/ {
	soc {
		usb1_dart0: iommu@40b020000 {
			compatible = "apple,t8152-dart", "apple,t8110-dart";
			reg = <0x4 0x0b020000 0x0 0xc000>;
			interrupts = <AIC_IRQ 1679 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		usb1_dart1: iommu@40b040000 {
			compatible = "apple,t8152-dart", "apple,t8110-dart";
			reg = <0x4 0x0b040000 0x0 0xc000>;
			interrupts = <AIC_IRQ 1679 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		usb1: usb@40a430000 {
			compatible = "snps,dwc3";
			reg = <0x4 0x0a430000 0x0 0xcd00>;
			interrupts = <AIC_IRQ 1692 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			maximum-speed = "high-speed";
			iommus = <&usb1_dart0 0>, <&usb1_dart1 1>;
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
		};

		usb2_dart0: iommu@383020000 {
			compatible = "apple,t8152-dart", "apple,t8110-dart";
			reg = <0x3 0x83020000 0x0 0xc000>;
			interrupts = <AIC_IRQ 1750 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		usb2_dart1: iommu@383040000 {
			compatible = "apple,t8152-dart", "apple,t8110-dart";
			reg = <0x3 0x83040000 0x0 0xc000>;
			interrupts = <AIC_IRQ 1750 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		/* usb-drd2: on-board VL822 hub behind the two front USB-C ports. */
		usb2: usb@382430000 {
			compatible = "snps,dwc3";
			reg = <0x3 0x82430000 0x0 0xcd00>;
			interrupts = <AIC_IRQ 1763 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			maximum-speed = "high-speed";
			iommus = <&usb2_dart0 0>, <&usb2_dart1 1>;
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
		};
	};
};
