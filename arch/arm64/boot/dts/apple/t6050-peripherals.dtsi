	/*
	 * The video encoder (ADT ave0): firmware that iBoot preloads, handed over by the boot
	 * loader. dart-ave0 serves streams 0 and 12 (the temporal filter) on both instances.
	 */
	ave0: video-encoder@2283100000 {
		compatible = "apple,t6050-ave";
		reg = <0x22 0x83100000 0x0 0x45c000>,
		      <0x22 0x83050000 0x0 0x4000>,
		      <0x22 0x83800000 0x0 0x800000>;
		reg-names = "codec", "mailbox", "coproc";
		interrupts = <AIC_IRQ 0 2435 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2790 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2789 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2792 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2791 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&ave0_dart 0>, <&ave0_dart 12>,
			 <&ave0_dart1 0>, <&ave0_dart1 12>;
		power-domains = <&ps_venc0_dma>, <&ps_venc0_pipe4>, <&ps_venc0_pipe5>,
				<&ps_venc0_me0>, <&ps_venc0_me1>;
		power-domain-names = "dma", "pipe4", "pipe5", "me0", "me1";
		clocks = <&peripheral_clocks 503>;
		status = "disabled";
	};

	ave0_dart: iommu@22830a0000 {
