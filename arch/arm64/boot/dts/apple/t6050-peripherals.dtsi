	ps_isp_sys: power-controller@3a0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3a0 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "isp-sys";
		power-domains = <&ps_fab9_soc>;
		status = "disabled";
	};
	/*
	 * ADT ANE_SYS. The ANE driver switches its children ANE_CPU and
	 * ANE_TDBASE (+0x3c8, +0x3d0) itself, as on T8140, so ps_ane_cpu stays
	 * disabled.
	 */
	ps_ane_sys: power-controller@3a8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3a8 4>;
		#power-domain-cells = <0>;
