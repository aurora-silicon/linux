	sio: dma-controller@505e00000 {
		compatible = "apple,t6050-sio", "apple,sio";
		reg = <0x5 0x5e00000 0x0 0x88000>,
		      <0x5 0x5850000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1392 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 1391 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 1394 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 1393 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&sio_dart 0>;
		power-domains = <&ps_sio_cpu>;
		clocks = <&peripheral_clocks 359>, <&peripheral_clocks 358>;
		#dma-cells = <1>;
		status = "disabled";
	};

	sio_dart: iommu@505060000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x5 0x5060000 0x0 0x20000>;
		interrupts = <AIC_IRQ 0 1387 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_sio>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	/* ADT pmp0 reg[2] (firmware SRAM) and reg[0] (ASC); iBoot loads the firmware, the OS starts it */
	pmp0: pmp@284e00000 {
		compatible = "apple,t6050-pmp-v2", "apple,t6000-pmp-v2";
		reg = <0x2 0x84500000 0x0 0x100000>,
		      <0x2 0x84e00000 0x0 0x4000>;
		reg-names = "pmp", "asc";
		mboxes = <&pmp0_mbox>;
		mbox-names = "mbox";
		iommus = <&pmp0_dart 0>;
		power-domains = <&ps_pmp>, <&ps_pms_sram>;
		status = "disabled";
	};

	pmp0_mbox: mailbox@284e08000 {
		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x2 0x84e08000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 396 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 397 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 398 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 399 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
		power-domains = <&ps_pmp>;
		status = "disabled";
	};

	/*
	 * PMP report (PTD): reads 16 bytes per entry from the base, writes 8 bytes per entry from
	 * base + 0x10000, which is pmp0's ptd-update register (ADT pmp0 reg[3]); together they are
	 * /arm-io/pmgr reg[7]. Entries are PMP soc-devices; an entry's reg is its soc-device ID - 1
	 * (ADT iop-pmp0-nub soc-device). Without requests the running PMP keeps the vote iBoot left.
	 */
	pmp0_report: pmp-report@284240000 {
		compatible = "apple,t6050-pmp-v2-report";
		reg = <0x2 0x84240000 0x0 0x20000>;
		power-domains = <&ps_pms_sram>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		/* The CPU clusters: MACC0, MACC1, PACC */
		report@c {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0xc>;
			label = "pmp-macc0";
			#power-domain-cells = <0>;
			apple,always-on;
		};

		report@d {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0xd>;
			label = "pmp-macc1";
			#power-domain-cells = <0>;
			apple,always-on;
		};

		report@e {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0xe>;
			label = "pmp-pacc";
			#power-domain-cells = <0>;
			apple,always-on;
		};

		/*
		 * The GPU (AGX), on the GPU's own power state, so the PMP is told the GPU is on only
		 * while it is powered (a request with the GPU off crashes the T6041 PMP). The GPU takes
		 * this domain on a board that enables the report.
		 */
		pmp0_gfx: report@f {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0xf>;
			label = "pmp-gfx";
			#power-domain-cells = <0>;
			power-domains = <&ps_gfx>;
		};

		/* The internal display (DISPINT) */
		report@12 {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0x12>;
			label = "pmp-dispint";
			#power-domain-cells = <0>;
			apple,always-on;
		};

		/* Storage (ANS) */
		report@24 {
			compatible = "apple,t6050-pmp-v2-report-entry",
				     "apple,t6000-pmp-v2-report-entry";
			reg = <0x24>;
			label = "pmp-ans";
			#power-domain-cells = <0>;
			apple,always-on;
		};
	};

	pmp0_dart: iommu@2841a0000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		/* ADT dart-pmp0 instance: DART, then DAPF */
		reg = <0x2 0x841a0000 0x0 0xc000>,
		      <0x2 0x841b0000 0x0 0x4000>;
		reg-names = "dart", "dapf";
		interrupts = <AIC_IRQ 0 371 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		/* ADT dart-pmp0 vm-base, vm-size */
		apple,dma-range = /bits/ 64 <0x10000000000 0x1000000000>;
		power-domains = <&ps_pmp>;
		status = "disabled";
	};

	aon_ptd: aon-ptd@28cdc0000 {
		compatible = "apple,t6050-aon-ptd", "apple,aon-ptd";
		reg = <0x2 0x8cdc0000 0x0 0x4000>,
		      <0x2 0x8cdd0000 0x0 0x4000>,
		      <0x2 0x8cdd8000 0x0 0x4000>,
		      <0x2 0x8cde0000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 904 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 905 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 906 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 907 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 908 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 909 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 910 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 911 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 912 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 913 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 914 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 915 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 916 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 917 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 918 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 919 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 920 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 921 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 922 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 923 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 924 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 925 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 926 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 927 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 928 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 929 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 930 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 931 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 932 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 933 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 934 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 935 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#address-cells = <0>;
		status = "disabled";
	};

	rsm: rsm@288825000 {
		compatible = "apple,t6050-rsm", "apple,rsm";
		reg = <0x2 0x88825000 0x0 0x4000>,
		      <0x2 0x888c0000 0x0 0x4>;
		interrupts = <AIC_IRQ 0 495 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&rsm_dart 0>;
		power-domains = <&ps_debug_gated>;
		status = "disabled";
	};

	rsm_dart: iommu@2889a0000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0x889a0000 0x0 0xc000>;
		interrupts = <AIC_IRQ 0 498 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	uart0: serial@505200000 {
		compatible = "apple,t6050-uart", "apple,s5l-uart";
		reg = <0x5 0x5200000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1359 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_uart0>;
		clocks = <&peripheral_clocks 457>, <&peripheral_clocks 4>;
		clock-names = "uart", "clk_uart_baud0";
		status = "disabled";
	};

	usb0_dart: iommu@2a2f00000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xa2f00000 0x0 0xc000>;
		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc0_usb>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	usb0_dart1: iommu@2a2f80000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xa2f80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc0_usb>;
		#iommu-cells = <1>;
		status = "disabled";
	};

	/* ADT usb-drd0: reg[0] (core and Apple regions) and reg[1] (drd-cfg), as usb_drd2 */
	usb_drd0: usb@2a2280000 {
		compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
		reg = <0x2 0xa2280000 0x0 0xcd00>,
		      <0x2 0xa228cd00 0x0 0x4b00>,
		      <0x2 0xa2200000 0x0 0x4000>;
		reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
		interrupts = <AIC_IRQ 0 1419 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&usb0_dart 0>, <&usb0_dart1 1>;
		power-domains = <&ps_atc0_usb>;
		status = "disabled";
	};

	auss0_dart: iommu@395d60000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
