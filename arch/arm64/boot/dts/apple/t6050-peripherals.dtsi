// SPDX-License-Identifier: GPL-2.0+ OR MIT
/* Shared hardware resources. No firmware, tuning or enable policy. */

#ifndef T6050_J775D
/*
 * Die 0's media block: its PMGR (ADT /arm-io/pmgr reg[46]) with the FAB1_SOC and AVD_SYS
 * states, and the video decoder's DART (dart-avd0). t6050-ultra.dtsi describes the same
 * nodes for the J775D; on a one-die part they stay disabled with the rest of the inventory.
 */
/ {
	soc@2308000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0x23 0x08000000 0x23 0x08000000 0x0 0x1404000>,
			 <0x23 0x80600000 0x23 0x80600000 0x0 0xc000>;
		nonposted-mmio;

		pmgr4: power-management@2380600000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x23 0x80600000 0x0 0xc000>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			ps_fab1_soc: power-controller@1b0 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x1b0 4>;
				label = "fab1_soc";
				#power-domain-cells = <0>;
				#reset-cells = <0>;
				status = "disabled";
			};

			ps_avd_sys: power-controller@1d8 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x1d8 4>;
				label = "avd_sys";
				#power-domain-cells = <0>;
				#reset-cells = <0>;
				power-domains = <&ps_fab1_soc>;
				status = "disabled";
			};
		};

		/*
		 * The video decoder (avd0): the M5's (T8142) Hibiscus layout. ADT reg[0]
		 * 0x2108000000 + 0x1404000 at the arm-io offset; CM3 code and SRAM 0x14000
		 * each, mailbox at +0x10a8000, ctrl at +0x1100000; IRQs 2417/2418.
		 */
		avd: avd@2309080000 {
			compatible = "apple,t6050-avd", "apple,t8142-avd";
			interrupts = <AIC_IRQ 0 2417 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 0 2418 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_avd_sys>;
			resets = <&ps_avd_sys>;
			reg = <0x23 0x09080000 0x0 0x14000>,
			      <0x23 0x09094000 0x0 0x14000>,
			      <0x23 0x090a8000 0x0 0x4000>,
			      <0x23 0x09100000 0x0 0x10000>;
			reg-names = "code", "sram", "mbox", "ctrl";
			iommus = <&avd_dart 0>, <&avd_dart 1>, <&avd_dart 2>;
			status = "disabled";
		};

		avd_dart: iommu@2309020000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x23 0x09020000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupts = <AIC_IRQ 0 2424 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_avd_sys>;
			status = "disabled";
		};
	};
};
#endif
/ {
	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;
	};
};

