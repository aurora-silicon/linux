		interrupts = <AIC_IRQ 0 2448 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2449 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2450 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2451 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 450 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2806 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2463 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 2465 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_gfx>;
		/* Raises the DRAM and fabric floors while GPU work is in flight */
		apple,clpc = <&clpc>;
		status = "disabled";
	};

