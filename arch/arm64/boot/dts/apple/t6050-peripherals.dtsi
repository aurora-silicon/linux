		status = "disabled";
	};
	ps_ane_cpu: power-controller@3c8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3c8 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "ane-cpu";
		power-domains = <&ps_ane_sys>;
		status = "disabled";
	};
#if defined(T6050_J775C) || defined(T6050_J775D) || defined(T6050_J873S)
	ps_dptx_phy: power-controller@3f8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
