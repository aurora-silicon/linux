	/*
	 * ADT ane0 ("ane,t8132exclave", ane-type 0x220): the T8140 (H17) model.
	 * The engine, the ANE PMGR window and the power gate at ADT reg[2]
	 * +0x1590; the other ADT windows, a CPU cluster's included, are not the
	 * ANE's. Inclusive DAPF bounds from dart-ane0 dapf-instance-0, in record
	 * order. A board adds the preload reservations its boot loader fills.
	 */
	ane0: neural-processor@508000000 {
		compatible = "apple,t6050-ane";
		reg = <0x5 0x8000000 0x0 0x2000000>,
		      <0x2 0x80900000 0x0 0x18000>,
		      <0x2 0x80921590 0x0 0x34>;
		reg-names = "engine", "pmgr", "pwgate";
		interrupts = <AIC_IRQ 0 954 IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_IRQ 0 967 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&ane0_dart 0>, <&ane0_dart1 0>, <&ane0_dart2 0>;
		power-domains = <&ps_ane_sys>;
		clocks = <&peripheral_clocks 335>, <&peripheral_clocks 334>, <&peripheral_clocks 381>;
		apple,firmware-preloaded;
		apple,firmware-iovas = /bits/ 64 <0x10000000000 0x100000c0000>;
		apple,dapf-ranges = /bits/ 64 <0x2809003a8 0x2809003ab>,
				    /bits/ 64 <0x2809003c0 0x2809003d3>,
				    /bits/ 64 <0x581668000 0x581668003>,
				    /bits/ 64 <0x2302668000 0x2302668003>,
				    /bits/ 64 <0x6302668000 0x6302668003>;
		status = "disabled";
	};

	/*
	 * The ANE DARTs, in ANE_SYS. SID0 is the host's; the ADT's static bypass
	 * streams (dart-ane0 bypass-10, bypass-13) stay in bypass.
	 */
	ane0_dart: iommu@509800000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x5 0x9800000 0x0 0xc000>,
		      <0x5 0x9810000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 955 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_ane_sys>;
		/* ADT vm-base 0x100_0000_0000, vm-size 0x300_0000_0000 */
		apple,dma-range = <0x0 0x0 0x400 0x0>;
		apple,bypass-sids = <10 13>;
		status = "disabled";
	};

	ane0_dart1: iommu@509820000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x5 0x9820000 0x0 0xc000>;
