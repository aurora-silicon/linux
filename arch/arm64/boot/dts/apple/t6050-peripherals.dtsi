/* Shared disabled peripheral resources. */

/ {
	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;
	};
};

&{/soc} {
	hw_i2c0: i2c@505010000 {
		compatible = "apple,t6050-i2c", "apple,t8103-i2c";
		reg = <0x5 0x5010000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1375 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_i2c6: i2c@505028000 {
		compatible = "apple,t6050-i2c", "apple,t8103-i2c";
		reg = <0x5 0x5028000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1381 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_i2c8: i2c@505030000 {
		compatible = "apple,t6050-i2c", "apple,t8103-i2c";
		reg = <0x5 0x5030000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1383 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks = <&clkref>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	hw_apcie0_piodma: dma-controller@410030000 {
		compatible = "apple,t6050-pcie-piodma", "apple,pcie-piodma";
		reg = <0x4 0x10030000 0x0 0x4000>,
		      <0x4 0x10034000 0x0 0x4000>,
		      <0x4 0x10038000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1525 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dart_apcie0 17>;
		status = "disabled";
	};

	hw_apciec0: pcie@1c50000000 {
		compatible = "apple,t6050-pciec", "apple,pciec";
		reg = <0x1c 0x50000000 0x0 0x10000000>,
		      <0x2 0xa4034000 0x0 0x4000>,
		      <0x2 0xa4020000 0x0 0x8000>,
		      <0x2 0xa4038000 0x0 0x4000>,
		      <0x2 0xa4060000 0x0 0x4000>,
		      <0x2 0xa0020000 0x0 0x4000>,
		      <0x2 0xa402c000 0x0 0x4000>,
		      <0x2 0xa4028000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1405 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1408 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1409 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1410 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1411 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 0 1412 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_dart_apciec0: iommu@2a4000000 {
		compatible = "apple,t6050-dart", "apple,dart";
		reg = <0x2 0xa4000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 0 1406 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_apciec0_piodma: dma-controller@2a4068000 {
		compatible = "apple,t6050-pciec-piodma", "apple,pciec-piodma";
		reg = <0x2 0xa4068000 0x0 0x4000>,
		      <0x2 0xa406c000 0x0 0x4000>,
		      <0x2 0xa4070000 0x0 0x4000>,
		      <0x2 0xa403c000 0x0 0x4000>;
		interrupts = <AIC_IRQ 0 1407 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&hw_dart_apciec0 254>;
		status = "disabled";
	};

	hw_dart_acio0: iommu@2a1a80000 {
		compatible = "apple,t6050-dart", "apple,dart";
		reg = <0x2 0xa1a80000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupts = <AIC_IRQ 0 1606 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	hw_acio_cpu0: usb4-coproc@2a1108000 {
		compatible = "apple,t6050-usb4-acio", "apple,usb4-acio";
		reg = <0x2 0xa1108000 0x0 0x4000>,
		      <0x2 0xa1100000 0x0 0x4000>;
