/* Property migration from Satya Benson's 86b1f365 J775c stack.
 * Retained board sources remain the baseline; this group is independently booted.
 * Copyright The Asahi Linux Contributors
 */
&{/pcie@1cb0000000} {
	msi-parent = <&{/pcie@1cb0000000}>;
	iommu-map = <0x100 &{/soc/iommu@412000000} 0x1 0x1 0x200 &{/soc/iommu@413000000} 0x1 0x1 0x300 &{/soc/iommu@410000000} 0x1 0x3 0x400 &{/soc/iommu@411000000} 0x1 0x1>;
};

&{/pcie@1cb0000000/pci@2,0} {
	interrupt-map = <0x0 0x0 0x0 0x1 &{/pcie@1cb0000000/pci@2,0} 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x2 &{/pcie@1cb0000000/pci@2,0} 0x0 0x0 0x0 0x1 0x0 0x0 0x0 0x3 &{/pcie@1cb0000000/pci@2,0} 0x0 0x0 0x0 0x2 0x0 0x0 0x0 0x4 &{/pcie@1cb0000000/pci@2,0} 0x0 0x0 0x0 0x3>;
};

&{/pcie@1cb0000000/pci@2,0/ethernet@0,0} {
};

&{/pcie@1cb0000000/pci@3,0} {
	interrupt-map = <0x0 0x0 0x0 0x1 &{/pcie@1cb0000000/pci@3,0} 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x2 &{/pcie@1cb0000000/pci@3,0} 0x0 0x0 0x0 0x1 0x0 0x0 0x0 0x3 &{/pcie@1cb0000000/pci@3,0} 0x0 0x0 0x0 0x2 0x0 0x0 0x0 0x4 &{/pcie@1cb0000000/pci@3,0} 0x0 0x0 0x0 0x3>;
};

&{/pcie@1cb0000000/pci@0,0} {
	reset-gpios = <&{/soc/pinctrl@29c000000} 0x50 0x1>;
	interrupt-map = <0x0 0x0 0x0 0x1 &{/pcie@1cb0000000/pci@0,0} 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x2 &{/pcie@1cb0000000/pci@0,0} 0x0 0x0 0x0 0x1 0x0 0x0 0x0 0x3 &{/pcie@1cb0000000/pci@0,0} 0x0 0x0 0x0 0x2 0x0 0x0 0x0 0x4 &{/pcie@1cb0000000/pci@0,0} 0x0 0x0 0x0 0x3>;
};

&{/pcie@1cb0000000/pci@0,0/control@0,0} {
};

&{/pcie@1cb0000000/pci@0,0/wifi@0,1} {
};

&{/pcie@1cb0000000/pci@0,0/bluetooth@0,2} {
};

&{/pcie@1cb0000000/pci@1,0} {
	interrupt-map = <0x0 0x0 0x0 0x1 &{/pcie@1cb0000000/pci@1,0} 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x2 &{/pcie@1cb0000000/pci@1,0} 0x0 0x0 0x0 0x1 0x0 0x0 0x0 0x3 &{/pcie@1cb0000000/pci@1,0} 0x0 0x0 0x0 0x2 0x0 0x0 0x0 0x4 &{/pcie@1cb0000000/pci@1,0} 0x0 0x0 0x0 0x3>;
};

&{/pcie@1cb0000000/pci@1,0/sdcard@0,0} {
};
