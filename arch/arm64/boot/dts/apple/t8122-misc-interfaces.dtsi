/* Disabled tunnel translation and miscellaneous interfaces. */

&soc {
	pciec0_dart: iommu@721008000 {
		compatible = "apple,t8122-dart", "apple,t8110-dart";
		reg = <0x7 0x21008000 0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 962 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_atc0_cio_pcie>;
		status = "disabled";
	};

	pciec1_dart: iommu@b21008000 {
		compatible = "apple,t8122-dart", "apple,t8110-dart";
		reg = <0xb 0x21008000 0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1020 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
		power-domains = <&ps_atc1_cio_pcie>;
		status = "disabled";
	};

	fpwm0: pwm@2a1040000 {
		compatible = "apple,t8122-fpwm", "apple,s5l-fpwm";
		reg = <0x2 0xa1040000 0 0x4000>;
		clocks = <&clkref>;
		power-domains = <&ps_fpwm0>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 789 IRQ_TYPE_LEVEL_HIGH>;
		#pwm-cells = <2>;
		status = "disabled";
	};

};
