// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Mac mini (M4, J773g) HDMI audio, the SIO half, as the ADT has it: the HDMI
 * port's display processor (dcp) has "audio" = dp-audio0, which is SIO DMA
 * channel 0x64 with power state DPA0 under DPA_P. dp-audio1 and dp-audio2
 * belong to dcpext0/1 (DisplayPort alt mode on the rear ports) and stay off.
 *
 * SIO supplies the sample stream. iBoot preloads its firmware; the boot
 * loader reserves it, publishes the boot tables (the T6041 layout: the ADT's
 * map-range, device-type, dmashim and asio-ascwrap-tunables records match it
 * key for key) and then enables the SIO node, which it finds by the alias.
 * Without such a loader the SIO stays disabled and nothing else changes.
 *
 * DPA0 is not linked to the dcp yet: the M4 display processor's own audio
 * service (dcpav-audio-interface, AV endpoint) has no driver on that path, so
 * the link would only make the dcp start a service it cannot drive.
 */

/ {
	aliases {
		sio = &sio;
	};

	dpaudio0: audio-controller-0 {
		compatible = "apple,t8132-dpaudio", "apple,dpaudio";
		dmas = <&sio 0x64>;
		dma-names = "tx";
		power-domains = <&ps_dpa0>;
		status = "disabled";
	};
};

/* Channel numbers run up to dp-audio2's 0x68, as on T8140. */
&sio {
	dma-channels = <128>;
};

/* The boot tables sit in the window above the preloaded segments (ADT vm-base, vm-size). */
&dart_sio0 {
	apple,dma-range = <0x100 0x1c000 0x2ff 0xfffe4000>;
	status = "okay";
};

&sio_mbox {
	status = "okay";
};

/*
 * The SIO firmware drives the SPI, UART and DP audio shims, so keep their
 * parents on while it runs, as on T6041 and T8140.
 */
&ps_sio_cpu {
	power-domains = <&ps_spi_p>, <&ps_uart_p>, <&ps_dpa_p>;
	status = "okay";
};

&ps_dpa_p {
	status = "okay";
};

&ps_dpa0 {
	status = "okay";
};
