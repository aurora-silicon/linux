// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Wired from the J773g ADT (macOS 26.6.2).
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include "t8132-board.dtsi"
#include "t8132-atc23.dtsi"
#include "t8132-apcie-port2.dtsi"
#include "t8132-gpu.dtsi"
#include "t8132-dcp.dtsi"
#include "t8132-dcpext.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";
	chassis-type = "desktop";

	aliases {
		ethernet0 = &ethernet0;
	};

	/*
	 * The speaker amp's shutdown line (SDZ, AP GPIO 15, the ADT
	 * function-reset; low = shutdown).
	 */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

/*
 * iBoot scans out through dispext0 to the HDMI port (dptx-phy and a
 * DP-to-HDMI converter at i2c0 0x08, hot-plug on AOP GPIO 41): keep the
 * power domains used for it on.
 */
&framebuffer0 {
	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
};

/*
 * The AOP audio component always runs a microphone stream, and this Mac
 * has no microphones (ADT iop-audio-controller has no audio-hp) and no
 * speaker sense, so it has no sound card yet. The AOP registers its audio
 * service by itself: without the node, no driver binds it.
 */
/delete-node/ &aop_audio;

/*
 * The SN012776 speaker amp (ADT /arm-io/i2c3/audio-speaker at 0x38, mono,
 * speaker-protection 0): interrupt on AP GPIO 14, level low. Disabled
 * until the speaker has a sound card and a protection profile.
 */
&i2c3 {
	status = "okay";

	speaker: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
		status = "disabled";
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c1/audio-codec-output at 0x4b).
 * Its reset line is nub GPIO 17, driven high to run the codec; its interrupt
 * is AP GPIO 98, level low.
 */
&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

/* The rear USB-C port controllers (ADT nub-spmi-a0 hpm0, hpm1 and hpm3). */
&nub_spmi_a0 {
	hpm3: usb-pd@8 {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec3: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec3_connector_hs: endpoint {
						remote-endpoint = <&dwc3_3_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec3_connector_ss: endpoint {
						remote-endpoint = <&atcphy3_typec_lanes>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Left";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Middle";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

&atcphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy3_typec_lanes: endpoint {
				remote-endpoint = <&typec3_connector_ss>;
			};
		};
	};
};

&dwc3_3_dart_0 {
	status = "okay";
};

&dwc3_3_dart_1 {
	status = "okay";
};

&dwc3_3 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&atcphy3 PHY_TYPE_USB2>, <&atcphy3 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_3_hs: endpoint {
				remote-endpoint = <&typec3_connector_hs>;
			};
		};
	};
};

/*
 * The two front USB-C ports: an on-board hub behind ATC2 (ADT usb-drd2,
 * hub firmware on spi3), with no port controller. The PHY only enters
 * USB3 mode from a Type-C mode switch, so the hub runs at high speed.
 */
&atcphy2 {
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	status = "okay";
	dr_mode = "host";
};

&wifi0 {
	/* ADT /arm-io/wlan module-instance */
	brcm,board-type = "apple,sakhalin";
};

&bluetooth0 {
	brcm,board-type = "apple,sakhalin";
};

/* The Gigabit Ethernet controller (ADT pci-bridge2/lan-1gb). */
&port02 {
	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"
