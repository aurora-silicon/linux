/* The zones below throttle the clusters through cpufreq. */
&cpu_e00 {
	#cooling-cells = <2>;
};

&cpu_e01 {
	#cooling-cells = <2>;
};

&cpu_p00 {
	#cooling-cells = <2>;
};

&cpu_p01 {
	#cooling-cells = <2>;
};

&cpu_p02 {
	#cooling-cells = <2>;
};

&cpu_p03 {
	#cooling-cells = <2>;
};

&cpu_p10 {
	#cooling-cells = <2>;
};

&cpu_p11 {
	#cooling-cells = <2>;
};

&cpu_p12 {
	#cooling-cells = <2>;
};

&cpu_p13 {
	#cooling-cells = <2>;
};

/ {
	/*
	 * One zone per sensor site on its hotspot key, throttling only the
	 * cluster the site sits on. The power allocator starts at 75 C, above
	 * the 46-66 C idle readings, and controls at 105 C. The E site also
	 * warms with the P clusters, so its zone starts at 85 C: the governor
	 * grants no power to an idle cluster and would park E at its lowest
	 * speed. A 180 s load on every CPU, with the fans under SMC control,
	 * peaks at 95 C on the hottest site and 87 C on the E site without
	 * any throttling, so these zones are a backstop. There is no hot or
	 * critical trip: the SMC drives the fans and keeps its own
	 * protection. sustainable-power is the energy model's four cores at
	 * 2448 MHz per P cluster and both cores at full speed for E.
	 */
	thermal-zones {
		cpu-e0-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <800>;
			thermal-sensors = <&smc_hwmon 11>;	/* Te02 */

			trips {
				cpu_e0_switch_on: trip-switch-on {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e0_control: trip-control {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_e00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_e01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p00-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <11600>;
			thermal-sensors = <&smc_hwmon 14>;	/* Tp02 */

			trips {
				cpu_p00_switch_on: trip-switch-on {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p00_control: trip-control {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p00_control>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p01-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <11600>;
			thermal-sensors = <&smc_hwmon 17>;	/* Tp06 */

			trips {
				cpu_p01_switch_on: trip-switch-on {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p01_control: trip-control {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p01_control>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p02-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <11600>;
			thermal-sensors = <&smc_hwmon 20>;	/* Tp0A */

			trips {
				cpu_p02_switch_on: trip-switch-on {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p02_control: trip-control {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p02_control>;
					cooling-device =
						<&cpu_p00 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p01 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p02 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p03 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-p03-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			sustainable-power = <11600>;
			thermal-sensors = <&smc_hwmon 23>;	/* Tp0E */

			trips {
				cpu_p03_switch_on: trip-switch-on {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p03_control: trip-control {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p03_control>;
