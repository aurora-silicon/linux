/*
 * GPU temperatures. The SMC publishes them only while the GPU is powered:
 * with the GPU off, Tg04/Tg0C read 0 C and Tg05/Tg0D read 9.2 C (they
 * track Tg04/Tg0C plus a fixed 9.2 C). Those placeholders are no data.
 */
&smc_hwmon {
	temperature-Tg04 {
		apple,key-id = "Tg04";
		label = "GPU Tg04";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg05 {
		apple,key-id = "Tg05";
		label = "GPU Tg05";
		apple,no-data-below-millicelsius = <15000>;
	};

	temperature-Tg0C {
		apple,key-id = "Tg0C";
		label = "GPU Tg0C";
		apple,no-data-below-millicelsius = <10000>;
	};

	temperature-Tg0D {
		apple,key-id = "Tg0D";
		label = "GPU Tg0D";
		apple,no-data-below-millicelsius = <15000>;
	};
};

/*
 * CPU temperatures, after the channels above so their numbers do not
 * change. Each sensor site has three keys: the reading (TpX0), the same
 * plus a fixed offset (TpX1: 9 C, Te01: 13.4 C), and a hotspot estimate
 * (TpX2) above both. TCMz is the hottest of the hotspot keys. Under
 * load on one cluster at a time, Tp00-Tp0I follow the first P cluster,
 * Tp0K-Tp0c the second, and Te00-Te02 the E cluster.
 */
&smc_hwmon {
	#thermal-sensor-cells = <1>;

	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "SoC Die Temperature";
	};

	temperature-Te00 {
		apple,key-id = "Te00";
		label = "E-cluster Te00";
	};

	temperature-Te01 {
		apple,key-id = "Te01";
		label = "E-cluster Te01";
	};

	temperature-Te02 {
		apple,key-id = "Te02";
		label = "E-cluster Te02";
	};

	temperature-Tp00 {
		apple,key-id = "Tp00";
		label = "P0-cluster Tp00";
	};

	temperature-Tp01 {
		apple,key-id = "Tp01";
		label = "P0-cluster Tp01";
	};

	temperature-Tp02 {
		apple,key-id = "Tp02";
		label = "P0-cluster Tp02";
	};

	temperature-Tp04 {
		apple,key-id = "Tp04";
		label = "P0-cluster Tp04";
	};

	temperature-Tp05 {
		apple,key-id = "Tp05";
		label = "P0-cluster Tp05";
	};

	temperature-Tp06 {
		apple,key-id = "Tp06";
		label = "P0-cluster Tp06";
	};

	temperature-Tp08 {
		apple,key-id = "Tp08";
		label = "P0-cluster Tp08";
	};

	temperature-Tp09 {
		apple,key-id = "Tp09";
		label = "P0-cluster Tp09";
	};

	temperature-Tp0A {
		apple,key-id = "Tp0A";
		label = "P0-cluster Tp0A";
	};

	temperature-Tp0C {
		apple,key-id = "Tp0C";
		label = "P0-cluster Tp0C";
	};

	temperature-Tp0D {
		apple,key-id = "Tp0D";
		label = "P0-cluster Tp0D";
	};

	temperature-Tp0E {
		apple,key-id = "Tp0E";
		label = "P0-cluster Tp0E";
	};

	temperature-Tp0G {
		apple,key-id = "Tp0G";
		label = "P0-cluster Tp0G";
	};

	temperature-Tp0H {
		apple,key-id = "Tp0H";
		label = "P0-cluster Tp0H";
	};

	temperature-Tp0I {
		apple,key-id = "Tp0I";
		label = "P0-cluster Tp0I";
	};

	temperature-Tp0K {
		apple,key-id = "Tp0K";
		label = "P1-cluster Tp0K";
	};

	temperature-Tp0L {
