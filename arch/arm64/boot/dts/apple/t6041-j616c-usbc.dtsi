// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * USB-C DisplayPort on the J616c's left-front port (typec1): dcpext1, the
 * ATC1 display crossbar and atcphy1 in DP alt mode, driven by hpm1.
 *
 * dcpext1, its DARTs, mailbox, crossbar and Type-C route are disabled, as
 * for HDMI: the boot loader enables them once it has filled dcpext1's
 * firmware memory. A disabled route is no mode switch, so typec1 then keeps
 * USB2 and PD as before.
 */

/ {
	aliases {
		dcpext1 = &dcpext1;
	};

	reserved-memory {
		dcpext1_data: dcpext1-data {
			compatible = "apple,asc-mem";
			reg = <0x0 0x0 0x0 0x4000>;
			no-map;
			status = "disabled";
		};

		dcpext1_heap: dcpext1-heap {
			compatible = "apple,asc-mem";
			reg = <0x0 0x0 0x0 0x4000>;
			no-map;
			status = "disabled";
		};
	};

	dcpext1: dcp@602e00000 {
		compatible = "apple,t6041-dcpext", "apple,dcpext";
		reg = <0x6 0x02e00000 0x0 0x4000>,
		      <0x6 0x00000000 0x0 0x4000000>,
		      <0x6 0x02240000 0x0 0x10000>,
		      <0x6 0x023a8000 0x0 0x4000>,
		      <0x6 0x02800000 0x0 0x800000>;
		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3";
		mboxes = <&dcpext1_mbox>;
		mbox-names = "mbox";
		iommus = <&dcpext1_dart 23>;
		apple,bw-scratch = <&pmgr_dcp 0 4 0x30000>;
		apple,dcp-endpoint = <2>;
		apple,iomfb-surfaces = <1 1 0 0>;
		apple,connector-type = "USB-C";
		phys = <&atcphy1 PHY_TYPE_DP>;
		phy-names = "typec1";
		mux-controls = <&atcphy1_xbar 0>;
		mux-control-names = "typec1";
		/* indexed by route */
		apple,typec-dptx-phys = <0 1 2>;
		apple,typec-mux-indices = <2 2 2>;
		memory-region = <&dcpext1_data>, <&dcpext1_heap>;
		memory-region-names = "data", "heap";
		status = "disabled";

		dispext1_piodma: piodma {
			iommus = <&dispext1_dart 16>;
		};

		typec-routes {
			#address-cells = <1>;
			#size-cells = <0>;

			route@1 {
				reg = <1>;
				mode-switch;
				status = "disabled";

				port {
					dcpext1_typec1: endpoint {
						remote-endpoint = <&typec1_dcpext1>;
					};
				};
			};
		};
	};

	dcpext1_mbox: mailbox@602e08000 {
		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x6 0x02e08000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1290 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1291 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1292 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1293 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
		status = "disabled";
	};

	atcphy1_xbar: mux@38b24c000 {
		compatible = "apple,t6041-display-crossbar";
		reg = <0x3 0x8b24c000 0x0 0x4000>;
		#mux-control-cells = <1>;
		power-domains = <&ps_atc1_usb>;
		status = "disabled";
	};
};

&dispext1_dart {
	apple,dma-range = <0x100 0x0 0x10 0x0>;
};

&dcpext1_dart {
	apple,dma-range = <0x100 0x0 0x10 0x0>;
};

&typec1 {
	ports {
		port@1 {
			reg = <1>;
			typec1_con_ss: endpoint {
				remote-endpoint = <&atcphy1_ss>;
			};
		};

		port@3 {
			reg = <3>;
			typec1_dcpext1: endpoint {
				remote-endpoint = <&dcpext1_typec1>;
			};
		};
	};
};

&atcphy1 {
	mode-switch;
	orientation-switch;

	apple,tunable-axi2af =
		<0x0 0x800000ff 0x8000001c>,
		<0x4 0x80ff00ff 0x801b0003>,
		<0x8 0x80ff00ff 0x801b0003>,
