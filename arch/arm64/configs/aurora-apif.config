# Native Aura guest providers. Apply after defconfig and asahi.config.
CONFIG_ARM64_16K_PAGES=y
CONFIG_AURORA_APIF_MMIO=y
CONFIG_APPLE_DART_APIF=y
# The alternate SART provider is built into the common SART consumer API.
CONFIG_APPLE_SART=y
CONFIG_APPLE_SART_APIF=y
CONFIG_NVME_APPLE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_APPLE_APIF=y
CONFIG_PM=y
CONFIG_RUST=y
CONFIG_APPLE_PMP=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_APPLE_SPMI_PMU=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_INPUT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
