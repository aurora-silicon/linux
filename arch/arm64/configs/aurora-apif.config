# Native Aura guest providers. Apply after defconfig and asahi.config.
CONFIG_ARM64_16K_PAGES=y
CONFIG_AURORA_APIF_MMIO=y
CONFIG_APPLE_DART_APIF=y
# The alternate SART provider is built into the common SART consumer API.
CONFIG_APPLE_SART=y
CONFIG_APPLE_SART_APIF=y
CONFIG_NVME_APPLE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_APPLE_APIF=y
CONFIG_PM=y
CONFIG_RUST=y
CONFIG_APPLE_PMP=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_APPLE_SPMI_PMU=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_INPUT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_PHY_APPLE_T6050_DP=y
CONFIG_MULTIPLEXER=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_WLAN_VENDOR_APPLE=y
CONFIG_APPLE_CENTAURI=y
CONFIG_APPLE_CENTAURI_WIFI=y
CONFIG_BT=y
CONFIG_BT_HCICENTAURI=y
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_APPLE=y
