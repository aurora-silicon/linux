CONFIG_PCIE_APPLE_PIODMA_DIAG=y
CONFIG_PCIEASPM=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=m
CONFIG_MT7932_FULLMAC=m
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_SPI_APPLE_QSPI=m
CONFIG_MACSMC_POWER=m
CONFIG_SENSORS_APPLE_PMP_J613=m
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_DRM=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ASAHI_G15=y
CONFIG_DRM_ASAHI_G16=y
