# Shared Apple Silicon hardware defaults for M1 and later, including Neo.
# Merge over ARM64 defconfig or a distribution base config, then run
# olddefconfig and verify that the requested settings survive resolution.
# Device-specific boot, debug and distribution policy stays in the base.
CONFIG_RUST=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_USER4K_EXPERIMENTAL=y
CONFIG_ARM64_MEMORY_MODEL_CONTROL=y
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_ENERGY_MODEL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y
CONFIG_BT_BRCMEXT=y
CONFIG_BT_HCIBCM4377=m
CONFIG_BT_MTK7932_PCIE=m
CONFIG_PCIE_APPLE=y
CONFIG_MMC_SDHCI_PCI=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_PCIE_APPLE_PIODMA_DIAG=y
CONFIG_PCIEASPM=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=m
CONFIG_MT7932_FULLMAC=m
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_SPI_APPLE_QSPI=m
CONFIG_MACSMC_POWER=m
CONFIG_SENSORS_APPLE_PMP_J613=m
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_DRM=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ASAHI_G15=y
CONFIG_DRM_ASAHI_G16=y
CONFIG_DRM_ADP=m
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T8132=y
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ANE=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_CS42L83=m
CONFIG_SND_SOC_CS42L84=m
CONFIG_SND_SOC_TAS2764=m
CONFIG_SND_SOC_TAS2770=m
CONFIG_HID_APPLE=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_APPLE_MTP_HAPTIC=m
CONFIG_HID_DOCKCHANNEL=m
CONFIG_SPI_HID_APPLE_OF=m
CONFIG_USB_DWC3_APPLE=m
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_TYPEC_SN201202X=m
CONFIG_RTC_DRV_APPLE_PMU=m
CONFIG_APPLE_SIO=m
CONFIG_APPLE_DART=y
CONFIG_APPLE_DART_J713_DCP=y
CONFIG_APPLE_DOCKCHANNEL=m
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_RTKIT_HELPER=m
CONFIG_TRUSTED_KEYS=y
# CONFIG_TRUSTED_KEYS_TPM is not set
# CONFIG_TRUSTED_KEYS_TEE is not set
CONFIG_APPLE_SEP=m
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMP=m
CONFIG_APPLE_PMP_THERMAL=m
CONFIG_APPLE_T8132_PLATFORM_HANDOFF=y
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
CONFIG_PHY_APPLE_ATC=m
CONFIG_PHY_APPLE_T6040_USB2=m
CONFIG_PHY_APPLE_DPTX=m
CONFIG_MUX_APPLE_DPXBAR=m
CONFIG_RESET_APPLE_CIO=y
CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_USER_ACCESS=m
CONFIG_INFINIBAND_USER_MAD=m
CONFIG_RDMA_RXE=m
CONFIG_RDMA_SIW=m
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
