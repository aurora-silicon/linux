# J700 retained radio bootstrap; merge after defconfig and asahi.config.
# System sleep is retained; active radio firmware cannot cross kexec.
# Firmware/calibration and runtime admission follow the MT7932 documentation.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_APPLE_DART=y
CONFIG_PCIE_APPLE_PIODMA_DIAG=y
CONFIG_CFG80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7932_FULLMAC=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_MTK7932_PCIE=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
