[Unit]
Description=Offer fingerprint at the GNOME login screen
Documentation=file:///usr/share/doc/aurora-sep/README.md
# Only prepares the login screen's shell, so it does not wait for Touch ID.
# The login screen right after boot takes the password anyway: as on macOS,
# where Touch ID is offered only after one password login since the restart,
# aurora-sep keeps require_password_after_boot = yes. Later login screens
# (after a log out) and the lock screen find the reader once it is up.
Before=gdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aurora-sep-greeter-fingerprint
ExecStop=/usr/local/sbin/aurora-sep-greeter-fingerprint stop

[Install]
WantedBy=gdm.service
