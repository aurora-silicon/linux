[Unit]
Description=Wait for the Touch ID device (/dev/sep-bio)
# apple-sep.service only runs modprobe; /dev/sep-bio appears a few seconds
# later, once the enclave is up. fprintd is ordered after this (its drop-in),
# so that it does not start, find no device and cache "No devices available"
# until it idles out, and so that its DeviceAllow=/dev/sep-bio finds the node.
After=apple-sep.service
Before=fprintd.service
ConditionPathExists=/dev/disk/by-partlabel/iBootSystemContainer

[Service]
Type=oneshot
# At most 15 s; fprintd then starts without the node, and its next start
# (fprintd exits when idle) finds it.
ExecStart=/bin/sh -c 'i=0; while [ ! -e /dev/sep-bio ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); done; exit 0'
