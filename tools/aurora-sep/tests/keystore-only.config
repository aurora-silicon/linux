# Minimal arm64 QEMU KUnit kernel, not a hardware boot configuration.
CONFIG_KUNIT=y
CONFIG_RUST=y
CONFIG_PRINTK=y
CONFIG_ARCH_APPLE=y
CONFIG_PM=y
CONFIG_OF=y
CONFIG_OF_DYNAMIC=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SPI=y
CONFIG_RUST_APPLE_MAILBOX=y
CONFIG_HW_RANDOM=y
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_CRYPTO=y
CONFIG_APPLE_SEP=y
CONFIG_APPLE_SEP_KUNIT_TEST=y
