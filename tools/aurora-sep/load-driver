#!/bin/sh
set -eu

keybag=/var/lib/aurora-sep-keybag.bin
refkey=/var/lib/aurora-sep-refkey.bin

modprobe apple_sep xart_writes=1 provision_keybag=1

work=$(mktemp -d /run/aurora-sep-load.XXXXXX)
cleanup() {
    case "$work" in
        /run/aurora-sep-load.*) rm -rf -- "$work" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

keyctl new_session aurora-sep-load >/dev/null
attempts=300
verified=false
while [ "$attempts" -gt 0 ]; do
    key_id=$(printf 'new 32' | keyctl padd trusted aurora-sep-check @s 2>/dev/null || true)
    if [ -n "$key_id" ]; then
        if keyctl pipe "$key_id" >"$work/sealed"; then
            { printf 'load '; tr -d '\n\r ' <"$work/sealed"; } >"$work/load"
            loaded_id=$(keyctl padd trusted aurora-sep-load-check @s <"$work/load" 2>/dev/null || true)
            if [ -n "$loaded_id" ]; then
                keyctl revoke "$loaded_id" >/dev/null 2>&1 || true
                verified=true
            fi
        fi
        keyctl revoke "$key_id" >/dev/null 2>&1 || true
    fi
    [ "$verified" = true ] && break
    sleep 0.1
    attempts=$((attempts - 1))
done

# The trusted-key seal and the ref-key file only exist on a Variant5 key store:
# ensure_machine_refkey() returns ENODEV for every other profile, so on a
# Sepos13 machine no ref-key is ever written and these checks can never pass.
# That takes the service down with exit 1, and fprintd (Requires=aurora-sep)
# never starts, even though Touch ID itself does not use the ref-key.
if [ "$verified" != true ]; then
    echo "apple_sep: trusted-key seal unavailable (expected on a Sepos13 key store)" >&2
fi
[ -s "$keybag" ] || { echo "apple_sep: no identity keybag at $keybag" >&2; exit 1; }
[ -s "$refkey" ] || echo "apple_sep: no ref-key file (expected on a Sepos13 key store)" >&2

attempts=300
while [ "$attempts" -gt 0 ] && [ ! -c /dev/sep-bio ]; do
    sleep 0.1
    attempts=$((attempts - 1))
done
[ -c /dev/sep-bio ] || exit 1
