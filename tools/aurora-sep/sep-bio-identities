#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""List Linux SEP identities and remove one fprintd orphan by its UUID.

The kernel limits both ioctls to the selected Linux SEP OS identity's built-in
user context. The kernel index may still hold a UUID after fprintd lost its
record, so the operator must identify the exact orphan. This utility has no
delete-all operation.
"""

import argparse
import fcntl
import os
import struct
import sys
import uuid

MAGIC = 0xB1
LIST_SIZE = 8 + 32 * 16
DELETE_SIZE = 16


def ioctl_number(direction, number, size):
    return (direction << 30) | (size << 16) | (MAGIC << 8) | number


LIST_ENCLAVE = ioctl_number(2, 0x0B, LIST_SIZE)
DELETE_ORPHAN = ioctl_number(1, 0x0C, DELETE_SIZE)


def list_identities(fd):
    reply = bytearray(LIST_SIZE)
    fcntl.ioctl(fd, LIST_ENCLAVE, reply, True)
    count, reserved = struct.unpack_from("=II", reply)
    if reserved != 0 or count > 32:
        raise ValueError("invalid SEP identity-list reply")
    return [uuid.UUID(bytes=bytes(reply[8 + 16 * i:24 + 16 * i]))
            for i in range(count)]


def check_target(before, target, keep):
    if target not in before:
        raise ValueError("identity is absent from the Linux-lane list")
    if len(before) > 1 and not keep:
        raise ValueError("name the identity to preserve with --keep before deleting")
    if target in keep or any(identity not in before for identity in keep):
        raise ValueError("--keep must list a different identity present in the Linux lane")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--delete-orphan", type=uuid.UUID, metavar="UUID",
                        help="delete exactly this Linux-lane identity with no fprintd record")
    parser.add_argument("--keep", type=uuid.UUID, action="append", default=[], metavar="UUID",
                        help="identity that must remain; required when more than one is listed")
    args = parser.parse_args()

    try:
        with os.fdopen(os.open("/dev/sep-bio", os.O_RDWR | os.O_CLOEXEC), "rb", closefd=True) as device:
            fd = device.fileno()
            before = list_identities(fd)
            if args.delete_orphan is None:
                for identity in before:
                    print(identity)
                return 0
            check_target(before, args.delete_orphan, args.keep)
            fcntl.ioctl(fd, DELETE_ORPHAN, args.delete_orphan.bytes)
            after = list_identities(fd)
            if args.delete_orphan in after:
                raise RuntimeError("SEP still lists the identity after deletion")
            if any(identity not in after for identity in args.keep):
                raise RuntimeError("a protected identity is absent after deletion")
            print("deleted orphan", args.delete_orphan)
            print("Linux-lane identities:", len(before), "->", len(after))
            return 0
    except (OSError, ValueError, RuntimeError) as error:
        print(f"sep-bio-identities: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
